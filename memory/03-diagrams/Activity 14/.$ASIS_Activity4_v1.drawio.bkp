        <!-- Nodes -->
        <mxCell id="T2_n1" value="สั่งพิมพ์ฟอร์มเสนอ 1 หน้า (จากระบบ PCMS)&lt;br&gt;ออกมาเป็นกระดาษแบบ Manual" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=20;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="700" y="240" width="400" height="80" as="geometry" />
        </mxCell>

        <mxCell id="T2_n2" value="นำเอกสารกระดาษเสนอตามลำดับชั้น&lt;br&gt;ให้ ผอ. ศรร. และ ผอ. กบค. (ส่วนกลาง)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=20;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="700" y="360" width="400" height="80" as="geometry" />
        </mxCell>

        <mxCell id="T2_n3" value="ผู้บริหารพิจารณาลงนามหมึกสด (Wet Signature)&lt;br&gt;เพื่อมอบหมายหน่วยงานรับผิดชอบ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=20;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="700" y="480" width="400" height="80" as="geometry" />
        </mxCell>

        <mxCell id="T2_n4" value="นำเอกสารที่ลงนามแล้ว ไปสแกน (Scan)&lt;br&gt;อัปโหลดกลับเข้าสู่ระบบ PCMS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=20;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="700" y="600" width="400" height="80" as="geometry" />
        </mxCell>

        <mxCell id="T2_n5" value="กดส่งต่อ (Route) ในระบบ PCMS&lt;br&gt;ไปยังสำนัก/เขต และรวบรวมเอกสารจริงส่งไปรษณีย์" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=20;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="700" y="720" width="400" height="80" as="geometry" />
        </mxCell>

        <mxCell id="T2_n6" value="ธุรการ ปปท. เขต / สำนัก ตรวจสอบ Inbox PCMS&lt;br&gt;และสั่งพิมพ์เอกสารออกมาเป็นกระดาษอีกครั้ง" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=20;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="700" y="840" width="400" height="80" as="geometry" />
        </mxCell>

        <mxCell id="T2_n7" value="นำเอกสารเสนอ ผอ. เขต / ผอ. สำนัก&lt;br&gt;เพื่อพิจารณาลงนามมอบหมายนักสืบ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=20;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="700" y="960" width="400" height="80" as="geometry" />
        </mxCell>

        <mxCell id="T2_n8" value="ธุรการสแกนเอกสารกลับเข้า PCMS&lt;br&gt;และเลือกชื่อนักสืบในระบบเพื่อมอบหมาย" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=20;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="700" y="1080" width="400" height="80" as="geometry" />
        </mxCell>

        <mxCell id="T2_n9" value="นักสืบสวนสอบสวนต้องพิมพ์ข้อมูลเดิมซ้ำ (Re-key)&lt;br&gt;ลงในระบบไต่สวนฯ (Legacy) เพื่อออกเลขคดี" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=20;align=center;verticalAlign=middle;" vertex="1" parent="1">
