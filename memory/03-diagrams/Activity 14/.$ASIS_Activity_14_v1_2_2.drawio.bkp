        <mxCell id="pSf0xRJ7wRpsozZYqhgA-19" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;autosizeText=1;fontColor=#000000;darkOpacity=0.05;fillColor=#f8cecc;strokeColor=#b85450;fillStyle=solid;fontSize=18;align=left;" value="&lt;div&gt;&lt;b&gt;ปัญหาของกระบวนงานเดิม (As-Is Pain Points)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;1. &lt;b&gt;ช่องทางกระจัดกระจาย:&lt;/b&gt; ผู้ใช้สอบถามผ่านหลายช่องทาง ทำให้ยากต่อการติดตามสถานะ&lt;/div&gt;&lt;div&gt;2. &lt;b&gt;ไม่มีฐานข้อมูลความรู้ (Knowledge Base):&lt;/b&gt; เจ้าหน้าที่ต้องตอบคำถามเดิมๆ ซ้ำซ้อน เสียเวลาทำงาน&lt;/div&gt;&lt;div&gt;3. &lt;b&gt;ตรวจสอบย้อนหลังไม่ได้:&lt;/b&gt; ไม่มีประวัติการแจ้งปัญหาที่เป็นระบบ ทำให้วิเคราะห์สถิติปัญหาเพื่อปรับปรุงงานไม่ได้&lt;/div&gt;" vertex="1">
          <mxGeometry height="161" width="550" x="1160" y="1679" as="geometry" />
        </mxCell>
        <mxCell id="rWlbNcn2cSDk0W778sjs-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 50px;&quot;&gt;N/A&lt;/font&gt;" vertex="1">
