        <mxCell id="k4wd4xnySshyFPz00ake-2" parent="TfmAicmHsrV-eNI4E_E2-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=24;fontFamily=Arial;align=left;verticalAlign=middle;spacing=8;" value="&lt;div style=&quot;&quot;&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;สีส้ม&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;คือ&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-family: Helvetica; font-size: 20px;&quot;&gt;&lt;b&gt;ThaiD / DOPA (ภายนอก)&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
