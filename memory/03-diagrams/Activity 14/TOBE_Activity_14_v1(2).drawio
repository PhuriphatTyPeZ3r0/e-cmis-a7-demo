          <mxGeometry height="100" width="850" x="110" y="148" as="geometry" />
        </mxCell>
        <mxCell id="_Kc1kdu0fhZlNw4F85TF-55" parent="vbP6P-6LUNncu1pCtR7t-1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF9B2;fontSize=18;align=left;" value="&lt;div&gt;&lt;b&gt;TOR 14.5.2 การจัดกลุ่มประเภทเหตุการณ์ (Log Categorization)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;- ระบบรองรับการตั้งค่าเงื่อนไขเพื่อแยกกลุ่ม Log (เช่น หมวดความมั่นคง, หมวดการใช้งาน, หมวดระบบงาน)&lt;/div&gt;&lt;div&gt;- ข้อมูลที่ผ่านการคัดกรองจะช่วยให้การทำ Audit Trail และสรุปรายงานรวดเร็วและแม่นยำขึ้น&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="850" x="120" y="1621" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
