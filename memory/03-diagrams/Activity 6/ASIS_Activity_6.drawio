          <mxGeometry height="80" width="450" x="675" y="360" as="geometry" />
        </mxCell>
        <mxCell id="T3_n3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=20;align=center;verticalAlign=middle;" value="คณะกรรมการ ป.ป.ท. ประชุมพิจารณาอุทธรณ์&lt;br&gt;และวินิจฉัยชี้ขาด (คำสั่งถือเป็นที่สุด)" vertex="1">
          <mxGeometry height="80" width="450" x="675" y="480" as="geometry" />
