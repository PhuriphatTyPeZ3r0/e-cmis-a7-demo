  <diagram id="tab4_monitoring" name="6.4 การรายงานและติดตามผล">
    <mxGraphModel dx="2000" dy="1500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="T4_title" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=20;align=center;verticalAlign=middle;" value="AS-IS : กิจกรรมที่ 6 ระบบฐานข้อมูลการดำเนินการคุ้มครองพยาน&lt;br&gt;6.4 ระบบรายงานการคุ้มครองพยานและการประสานงาน (Monitoring)" vertex="1">
          <mxGeometry height="78" width="1740" x="30" y="20" as="geometry" />
        </mxCell>
        <mxCell id="T4_start" parent="1" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.start_1;whiteSpace=wrap;fillColor=#b0e3e6;strokeColor=#0e8088;fontStyle=1;fontSize=20;" value="เริ่มต้น" vertex="1">
          <mxGeometry height="60" width="150" x="825" y="140" as="geometry" />
        </mxCell>
        <mxCell id="T4_n1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=20;align=center;verticalAlign=middle;" value="ส่งหนังสือประสานงานไปยังหน่วยงานภายนอก&lt;br&gt;(ตำรวจพื้นที่ / สคพ.) เพื่อจัดกำลังคุ้มครอง" vertex="1">
          <mxGeometry height="80" width="450" x="675" y="240" as="geometry" />
        </mxCell>
        <mxCell id="T4_n2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=20;align=center;verticalAlign=middle;" value="หน่วยงานภายนอกส่งรายงานผลปฏิบัติงาน&lt;br&gt;(คบ.13) กลับมาที่ ป.ป.ท. ทุกเดือน" vertex="1">
          <mxGeometry height="80" width="450" x="675" y="360" as="geometry" />
        </mxCell>
        <mxCell id="T4_n3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=20;align=center;verticalAlign=middle;" value="เจ้าหน้าที่ตรวจสอบรอบระยะเวลาคุ้มครอง&lt;br&gt;3 เดือน / 6 เดือน โดยการเปิดแฟ้มตรวจสอบ" vertex="1">
          <mxGeometry height="80" width="450" x="675" y="480" as="geometry" />
        </mxCell>
        <mxCell id="T4_gw1" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=18;align=center;verticalAlign=middle;" value="ภัยคุกคามยัง&lt;br&gt;คงอยู่หรือไม่?" vertex="1">
          <mxGeometry height="120" width="220" x="790" y="600" as="geometry" />
        </mxCell>
        <mxCell id="T4_n4_extend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=20;align=center;verticalAlign=middle;" value="ทำบันทึกเสนอเลขาธิการ ป.ป.ท.&lt;br&gt;เพื่อขออนุมัติขยายระยะเวลาคุ้มครอง" vertex="1">
          <mxGeometry height="80" width="450" x="1150" y="620" as="geometry" />
        </mxCell>
        <mxCell id="T4_n5_stop" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=20;align=center;verticalAlign=middle;" value="ดำเนินการสรุปผลและยุติตามระเบียบ&lt;br&gt;(พยานลงนามยินยอมยุติ คบ.7)" vertex="1">
          <mxGeometry height="80" width="450" x="675" y="780" as="geometry" />
        </mxCell>
        <mxCell id="T4_end" parent="1" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.start_1;whiteSpace=wrap;fillColor=#b0e3e6;strokeColor=#0e8088;fontStyle=1;fontSize=20;" value="สิ้นสุด" vertex="1">
