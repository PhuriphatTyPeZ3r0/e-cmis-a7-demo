        <mxCell id="T2_n3_no" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=20;align=center;verticalAlign=middle;" value="แจ้งคำสั่งยกคำร้องให้พยานทราบ&lt;br&gt;และแจ้งสิทธิในการอุทธรณ์" vertex="1">
