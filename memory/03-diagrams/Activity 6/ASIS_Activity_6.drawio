  <diagram id="tab3_appeal" name="6.3 การพิจารณาอุทธรณ์">
    <mxGraphModel dx="2000" dy="1500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="T3_title" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=20;align=center;verticalAlign=middle;" value="AS-IS : กิจกรรมที่ 6 ระบบฐานข้อมูลการดำเนินการคุ้มครองพยาน&lt;br&gt;6.3 ระบบยื่นอุทธรณ์คำร้องขอและการพิจารณาอุทธรณ์" vertex="1">
          <mxGeometry height="78" width="1740" x="30" y="20" as="geometry" />
        </mxCell>
        <mxCell id="T3_start" parent="1" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.start_1;whiteSpace=wrap;fillColor=#b0e3e6;strokeColor=#0e8088;fontStyle=1;fontSize=20;" value="เริ่มต้น" vertex="1">
          <mxGeometry height="60" width="150" x="825" y="140" as="geometry" />
        </mxCell>
        <mxCell id="T3_n1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=20;align=center;verticalAlign=middle;" value="พยานยื่นคำร้องอุทธรณ์ต่อคณะกรรมการ ป.ป.ท.&lt;br&gt;ภายใน 30 วัน นับแต่วันรับแจ้งคำสั่ง" vertex="1">
          <mxGeometry height="80" width="450" x="675" y="240" as="geometry" />
