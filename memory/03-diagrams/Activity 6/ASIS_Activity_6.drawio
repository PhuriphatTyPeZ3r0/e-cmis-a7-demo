      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="T1_title" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=20;align=center;verticalAlign=middle;" value="AS-IS : กิจกรรมที่ 6 ระบบฐานข้อมูลการดำเนินการคุ้มครองพยาน&lt;br&gt;6.1 ระบบสร้างคำร้องขอคุ้มครองพยาน (Intake &amp; Request Creation)" vertex="1">
