        <mxCell id="T1_start" parent="1" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.start_1;whiteSpace=wrap;fillColor=#b0e3e6;strokeColor=#0e8088;fontStyle=1;fontSize=20;" value="เริ่มต้น" vertex="1">
          <mxGeometry height="60" width="150" x="825" y="140" as="geometry" />
        </mxCell>
        <mxCell id="T1_n1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=20;align=center;verticalAlign=middle;" value="พยานร้องขอ หรือ เจ้าของสำนวน&lt;br&gt;พบเหตุภยันตรายที่คุกคามพยาน" vertex="1">
          <mxGeometry height="80" width="450" x="675" y="240" as="geometry" />
        </mxCell>
        <mxCell id="T1_n2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=20;align=center;verticalAlign=middle;" value="แจ้งสิทธิพยาน บันทึกข้อเท็จจริงลงแบบฟอร์ม&lt;br&gt;กระดาษ (คบ.1 / คบ.2) และลงนาม MOU" vertex="1">
          <mxGeometry height="80" width="450" x="675" y="360" as="geometry" />
        </mxCell>
        <mxCell id="T1_n3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=20;align=center;verticalAlign=middle;" value="เจ้าหน้าที่ตรวจสอบเลขคดีจากระบบไต่สวน&lt;br&gt;และ Re-key ข้อมูลลงในแบบฟอร์ม (Manual)" vertex="1">
          <mxGeometry height="80" width="450" x="675" y="480" as="geometry" />
        </mxCell>
        <mxCell id="T1_end" parent="1" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.start_1;whiteSpace=wrap;fillColor=#b0e3e6;strokeColor=#0e8088;fontStyle=1;fontSize=20;" value="สิ้นสุด" vertex="1">
