        <mxCell id="T2_e4" edge="1" parent="1" source="T2_gw1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;endFill=1;exitX=0;exitY=0.5;" target="T2_n3_no">
