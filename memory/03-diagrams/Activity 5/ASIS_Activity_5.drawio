        <mxCell id="T2_n5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=20;align=center;verticalAlign=middle;" value="เสนอรายงานผ่านแฟ้มกระดาษต่อผู้บังคับบัญชา&lt;br&gt;ตามลำดับชั้น (ผอ.กลุ่ม -&gt; ผอ.สำนัก/เขต)" vertex="1">
          <mxGeometry height="80" width="450" x="675" y="780" as="geometry" />
