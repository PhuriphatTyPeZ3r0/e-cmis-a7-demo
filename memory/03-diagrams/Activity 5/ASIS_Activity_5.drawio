        </mxCell>
        <mxCell id="T1_e3" edge="1" parent="1" source="T1_n2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;endFill=1;" target="T1_n3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="T1_e4" edge="1" parent="1" source="T1_n3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;endFill=1;" target="T1_n4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="T1_e5" edge="1" parent="1" source="T1_n4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;endFill=1;" target="T1_n5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="T1_e6" edge="1" parent="1" source="T1_n5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;endFill=1;" target="T1_end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="tab2_preliminary" name="5.2 การไต่สวนเบื้องต้น">
