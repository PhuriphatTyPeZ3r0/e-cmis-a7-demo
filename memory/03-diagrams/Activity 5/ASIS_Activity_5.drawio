<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/29.6.6 Chrome/144.0.7559.236 Electron/40.8.4 Safari/537.36" version="29.6.6" pages="4">
  <diagram id="tab1_assignment" name="5.1 การมอบหมายผู้รับผิดชอบ">
    <mxGraphModel dx="2000" dy="1500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="T1_title" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=20;align=center;verticalAlign=middle;" value="AS-IS : กิจกรรมที่ 5 ระบบกระบวนการดำเนินงานเรื่องร้องเรียนกล่าวหา&lt;br&gt;5.1 ระบบการมอบหมายผู้รับผิดชอบสำนวนคดี" vertex="1">
          <mxGeometry height="78" width="1740" x="30" y="20" as="geometry" />
        </mxCell>
        <mxCell id="T1_start" parent="1" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.start_1;whiteSpace=wrap;fillColor=#b0e3e6;strokeColor=#0e8088;fontStyle=1;fontSize=20;" value="เริ่มต้น" vertex="1">
          <mxGeometry height="60" width="150" x="825" y="140" as="geometry" />
        </mxCell>
        <mxCell id="T1_n1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=20;align=center;verticalAlign=middle;" value="เจ้าหน้าที่ ศรร. รับเรื่อง บันทึกข้อมูลเข้า PCMS&lt;br&gt;และส่งต่อข้อมูลผ่านระบบไปยังสำนัก/เขต" vertex="1">
          <mxGeometry height="80" width="450" x="675" y="240" as="geometry" />
        </mxCell>
        <mxCell id="T1_n2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=20;align=center;verticalAlign=middle;" value="ธุรการคดีประจำสำนัก/เขต ตรวจสอบคดีในระบบ&lt;br&gt;และสั่งพิมพ์ (Print) ข้อมูลออกมาเป็นเอกสารกระดาษ" vertex="1">
          <mxGeometry height="80" width="450" x="675" y="360" as="geometry" />
        </mxCell>
        <mxCell id="T1_n3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=20;align=center;verticalAlign=middle;" value="เจ้าหน้าที่ธุรการนำแฟ้มเอกสารเสนอ&lt;br&gt;ต่อ ผู้อำนวยการสำนัก/เขต" vertex="1">
          <mxGeometry height="80" width="450" x="675" y="480" as="geometry" />
        </mxCell>
        <mxCell id="T1_n4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=20;align=center;verticalAlign=middle;" value="ผู้อำนวยการสำนัก/เขต ลงนามอนุมัติมอบหมายงาน&lt;br&gt;บนเอกสารกระดาษ (Wet Signature)" vertex="1">
          <mxGeometry height="80" width="450" x="675" y="600" as="geometry" />
        </mxCell>
        <mxCell id="T1_n5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=20;align=center;verticalAlign=middle;" value="ธุรการสแกนและคีย์ข้อมูล (Key-In) กลับเข้าสู่ระบบ&lt;br&gt;เพื่อผลักสิทธิ์การมองเห็นไปให้นักสืบสวนสอบสวน" vertex="1">
          <mxGeometry height="80" width="450" x="675" y="720" as="geometry" />
        </mxCell>
        <mxCell id="T1_end" parent="1" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.start_1;whiteSpace=wrap;fillColor=#b0e3e6;strokeColor=#0e8088;fontStyle=1;fontSize=20;" value="สิ้นสุด" vertex="1">
          <mxGeometry height="60" width="150" x="825" y="840" as="geometry" />
        </mxCell>
        <mxCell id="T1_e1" edge="1" parent="1" source="T1_start" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;endFill=1;" target="T1_n1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="T1_e2" edge="1" parent="1" source="T1_n1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;endFill=1;" target="T1_n2">
