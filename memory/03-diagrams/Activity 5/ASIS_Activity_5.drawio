        <mxCell id="T2_end" parent="1" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.start_1;whiteSpace=wrap;fillColor=#b0e3e6;strokeColor=#0e8088;fontStyle=1;fontSize=20;" value="สิ้นสุด" vertex="1">
