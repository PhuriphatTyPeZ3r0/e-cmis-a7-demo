        <mxCell id="T3_n2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=20;align=center;verticalAlign=middle;" value="เจ้าหน้าที่คีย์บันทึกข้อมูลคำสั่งแต่งตั้งคณะอนุฯ&lt;br&gt;/พนักงานไต่สวนเข้าสู่ระบบไต่สวน (Manual)" vertex="1">
