        </mxCell>
        <mxCell id="T2_lbl_yes" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontColor=#009900;fontStyle=1;" value="ทัน" vertex="1">
