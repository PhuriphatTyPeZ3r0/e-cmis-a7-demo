        <mxCell id="T3_n1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=20;align=center;verticalAlign=middle;" value="คณะกรรมการ ป.ป.ท. พิจารณาเห็นชอบ&lt;br&gt;ให้รับเรื่องไว้ไต่สวน" vertex="1">
          <mxGeometry height="80" width="450" x="675" y="240" as="geometry" />
