        <mxCell id="T2_n1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=20;align=center;verticalAlign=middle;" value="นักสืบสวนสอบสวนรับสำนวนและ&lt;br&gt;ดำเนินการแสวงหาข้อเท็จจริง (สอบปากคำ/ลงพื้นที่)" vertex="1">
          <mxGeometry height="80" width="450" x="675" y="240" as="geometry" />
        </mxCell>
        <mxCell id="T2_n2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=20;align=center;verticalAlign=middle;" value="อัปเดต &quot;บันทึกความก้าวหน้า&quot; ในระบบ&lt;br&gt;และสแกนไฟล์หลักฐานแนบเข้าระบบ" vertex="1">
          <mxGeometry height="80" width="450" x="675" y="360" as="geometry" />
        </mxCell>
        <mxCell id="T2_gw1" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=18;align=center;verticalAlign=middle;" value="สามารถดำเนินการ&lt;br&gt;ทันกรอบเวลา (60 วัน)?" vertex="1">
          <mxGeometry height="120" width="220" x="790" y="480" as="geometry" />
        </mxCell>
        <mxCell id="T2_n3_no" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=20;align=center;verticalAlign=middle;" value="ดำเนินการทำเรื่อง &quot;ขอขยายระยะเวลา&quot;&lt;br&gt;(ครั้งละ 15 วัน หรือ 60 วันตามเงื่อนไข)" vertex="1">
          <mxGeometry height="80" width="400" x="290" y="500" as="geometry" />
        </mxCell>
        <mxCell id="T2_n4_yes" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=20;align=center;verticalAlign=middle;" value="จัดทำ &quot;รายงานไต่สวนเบื้องต้น&quot; ในรูปแบบกระดาษ&lt;br&gt;และแนบไฟล์เข้าระบบเพื่อเสนอผู้บังคับบัญชา" vertex="1">
          <mxGeometry height="80" width="450" x="675" y="660" as="geometry" />
