        <mxCell id="T3_n4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=20;align=center;verticalAlign=middle;" value="คณะกรรมการ ป.ป.ท. พิจารณามีมติชี้มูลความผิด&lt;br&gt;(อาญาและ/หรือวินัย)" vertex="1">
