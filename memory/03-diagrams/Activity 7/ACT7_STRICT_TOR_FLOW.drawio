        <mxCell id="t2v2_res_other" value="&lt;b&gt;ส่งมติคืนหน่วยงานที่เกี่ยวข้อง&lt;/b&gt;&lt;br&gt;(กรณีส่ง ป.ป.ช., ยุติเรื่อง, ไต่สวนเพิ่มเติม)&lt;div style=&quot;margin-top:3px;&quot;&gt;&lt;span style=&quot;background-color:#E3F2FD;color:#0D47A1;padding:1px 5px;border-radius:3px;font-size:9px;font-weight:bold;border:1px solid #90CAF9;&quot;&gt;TOR ๗.๒.๑.๒&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#3F51B5;strokeWidth=1.5;align=center;verticalAlign=middle;shadow=1;fontFamily=Google Sans, Sarabun, sans-serif;" parent="1" vertex="1">
