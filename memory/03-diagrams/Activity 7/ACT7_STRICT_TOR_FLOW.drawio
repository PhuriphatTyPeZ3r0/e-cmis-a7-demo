        </mxCell>
        <mxCell id="t1v2_sys3" value="&lt;b&gt;บันทึกการลงนามดิจิทัล&lt;/b&gt;&lt;br&gt;และส่งต่อสำนวนเสนอประธานฯ บรรจุวาระ" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#0288D1;strokeWidth=1.5;align=center;verticalAlign=middle;shadow=1;fontFamily=Google Sans, Sarabun, sans-serif;" parent="1" vertex="1">
