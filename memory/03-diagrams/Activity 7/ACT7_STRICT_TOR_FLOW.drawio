        <mxCell id="t2v2_sys_sign" value="&lt;b&gt;แสดงรายงานชี้มูลรอลงนาม&lt;/b&gt;&lt;br&gt;ระบบลงนามดิจิทัล (Digital Signature)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#0288D1;strokeWidth=1.5;align=center;verticalAlign=middle;shadow=1;fontFamily=Google Sans, Sarabun, sans-serif;" parent="1" vertex="1">
