        <mxCell id="t1v2_sys6" value="&lt;b&gt;ระบบตรวจสอบความซ้ำซ้อนสำนวน&lt;/b&gt;&lt;br&gt;ตรวจความซ้ำซ้อนอัตโนมัติ และค้นหาประวัติวาระ&lt;div style=&quot;margin-top:3px;&quot;&gt;&lt;span style=&quot;background-color:#E3F2FD;color:#0D47A1;padding:1px 5px;border-radius:3px;font-size:9px;font-weight:bold;border:1px solid #90CAF9;&quot;&gt;TOR ๗.๑.๓.๗, ๗.๑.๓.๘&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#0288D1;strokeWidth=1.5;align=center;verticalAlign=middle;shadow=1;fontFamily=Google Sans, Sarabun, sans-serif;" parent="1" vertex="1">
