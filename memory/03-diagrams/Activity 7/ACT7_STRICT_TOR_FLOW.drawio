        <mxCell id="t2v2_res3" value="&lt;b&gt;มอบหมายผู้รับผิดชอบจัดทำคำสั่ง&lt;/b&gt;&lt;br&gt;จัดทำคำสั่งแต่งตั้ง (ม.๒๔)&lt;div style=&quot;margin-top:3px;&quot;&gt;&lt;span style=&quot;background-color:#E3F2FD;color:#0D47A1;padding:1px 5px;border-radius:3px;font-size:9px;font-weight:bold;border:1px solid #90CAF9;&quot;&gt;TOR ๗.๒.๒.๑&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#8E24AA;strokeWidth=1.5;align=center;verticalAlign=middle;shadow=1;fontFamily=Google Sans, Sarabun, sans-serif;" parent="1" vertex="1">
