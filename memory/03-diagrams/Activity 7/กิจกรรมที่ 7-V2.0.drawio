        </mxCell>
        <mxCell id="p1x4" value="&lt;b&gt;หน่วยงานต้นสังกัดของผู้ถูกกล่าวหา&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="p1-1">
          <mxGeometry x="1320" y="515" width="300" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p1x5" value="&lt;b&gt;ระบบ e-สารบรรณ (เลขหนังสือ / เลขคำสั่ง)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;นอกขอบเขต E-CMIS — คีย์เลขกลับเข้าระบบเอง&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;" vertex="1" parent="p1-1">
          <mxGeometry x="1320" y="590" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p1x6" value="&lt;b&gt;ผู้ให้บริการ CA / ThaiD Sign&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;รอยืนยันผู้ให้บริการ (Open Issue)&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;fontSize=11;" vertex="1" parent="p1-1">
          <mxGeometry x="1320" y="670" width="300" height="60" as="geometry" />
        </mxCell>

        <mxCell id="p1p" value="&lt;b&gt;Digital Platform Services (ใช้ร่วมทุกโมดูลของกิจกรรมที่ 7)&lt;/b&gt;" style="swimlane;html=1;startSize=34;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="p1-1">
          <mxGeometry x="120" y="760" width="1500" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p1p1" value="&lt;b&gt;Auto-fill / Data Mapping&lt;/b&gt;&lt;br&gt;ดึงข้อมูลตั้งต้นจากฐานกลาง E-CMIS ไม่คีย์ซ้ำ" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;" vertex="1" parent="p1p">
          <mxGeometry x="15" y="44" width="235" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p1p2" value="&lt;b&gt;Validation Rules Engine&lt;/b&gt;&lt;br&gt;ตรวจความครบถ้วนเอกสาร สถานะคดี และอายุความ" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;" vertex="1" parent="p1p">
          <mxGeometry x="260" y="44" width="235" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p1p3" value="&lt;b&gt;Auto Routing / Manual Assign&lt;/b&gt;&lt;br&gt;Role-based + Round-Robin อนุกลั่นกรองฯ 1-8 (≤ 40 เรื่อง/คณะ)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;" vertex="1" parent="p1p">
          <mxGeometry x="505" y="44" width="235" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p1p4" value="&lt;b&gt;e-Approval + Digital Signature&lt;/b&gt;&lt;br&gt;Sequential Approval / Multi-signer (ปปท. ๗-๐๒)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;" vertex="1" parent="p1p">
          <mxGeometry x="750" y="44" width="235" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p1p5" value="&lt;b&gt;Mail-Merge Template Engine&lt;/b&gt;&lt;br&gt;ปปท. ๕-๐๑/๕-๐๔/๗-๐๒/๘-๐๕/๘-๐๖ แล้วล็อก PDF" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;" vertex="1" parent="p1p">
          <mxGeometry x="995" y="44" width="235" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p1p6" value="&lt;b&gt;SLA Timer / Notification / RBAC / Audit Log&lt;/b&gt;&lt;br&gt;เตือนล่วงหน้า 3 วัน และ 1 วัน + Escalation" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;" vertex="1" parent="p1p">
          <mxGeometry x="1240" y="44" width="245" height="70" as="geometry" />
        </mxCell>

        <mxCell id="p1e1" value="สำนวนเห็นควรไม่รับไว้ไต่สวน / คำขอแยก-รวมสำนวนหลังออกเลข PCMS" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.25;" edge="1" parent="p1-1" source="p1a4" target="p1core">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1e2" value="ขาเข้า: รายงาน 213 / รายงาน 644 / คำขอขยายเวลาไต่สวน&#10;ขาออก: มติทุกประเภท + คำสั่งแต่งตั้งคณะไต่สวน ม.24" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;fontSize=10;startArrow=classic;startFill=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.4;" edge="1" parent="p1-1" source="p1a5" target="p1core">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1e3" value="คำร้องขอคุ้มครองพยาน / อุทธรณ์คำสั่ง — มติอนุมัติ-ไม่อนุมัติ" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;fontSize=10;startArrow=classic;startFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.6;" edge="1" parent="p1-1" source="p1a6" target="p1core">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1e4" value="ขาออก: มติชี้มูลอาญา/วินัย (Auto-pull)&#10;ขาเข้า: ผลลงโทษ ม.38 / ทบทวนมติ ม.40 / เพิกเฉย ม.41 / ก.พ.ค. ม.43" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;fontSize=10;startArrow=classic;startFill=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.75;" edge="1" parent="p1-1" source="p1a8" target="p1core">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1e5" value="ขาเข้า: อัยการสั่งไม่ฟ้อง / หมายเรียกศาลปกครอง / คำร้องเปิดเผยข้อมูล&#10;ขาออก: มติเห็นแย้ง / มติมอบอำนาจสู้คดี" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;fontSize=10;startArrow=classic;startFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.9;" edge="1" parent="p1-1" source="p1a10" target="p1core">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1e6" value="User Role ทุกชั้น / ผู้พิจารณาสำรอง / กลไก Digital Signature (TOR 14.4.3, 14.6)" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;fontSize=10;dashed=1;exitX=1;exitY=0.5;entryX=0.25;entryY=1;" edge="1" parent="p1-1" source="p1a14" target="p1core">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="p1e7" value="มติส่งเรื่องให้ ป.ป.ช. + หนังสือนำส่งสำนวน (SLA 30 วัน / บังคับอัปโหลดไฟล์สแกน)" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;fontSize=10;exitX=1;exitY=0.25;entryX=0;entryY=0.5;" edge="1" parent="p1-1" source="p1core" target="p1x1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1e8" value="สำนวนชี้มูลอาญา (เล่มกระดาษ + อัปโหลดสแกนกลับ) — เห็นแย้ง ม.46 ว.3 ส่ง อสส. ชี้ขาด" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;fontSize=10;startArrow=classic;startFill=1;exitX=1;exitY=0.4;entryX=0;entryY=0.5;" edge="1" parent="p1-1" source="p1core" target="p1x2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1e9" value="ใบมอบอำนาจสู้คดี (ประธานฯ ลงนาม) / คำแก้อุทธรณ์ — รับหมายเรียกและคำพิพากษา" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;fontSize=10;startArrow=classic;startFill=1;exitX=1;exitY=0.6;entryX=0;entryY=0.5;" edge="1" parent="p1-1" source="p1core" target="p1x3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1e10" value="หนังสือแจ้งลงโทษทางวินัย (ปปท. ๘-๐๕ / ๘-๐๖) — รายงานผลกลับ ม.38 (60/30/90 วัน)" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;fontSize=10;startArrow=classic;startFill=1;exitX=1;exitY=0.8;entryX=0;entryY=0.5;" edge="1" parent="p1-1" source="p1core" target="p1x4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1e11" value="ขอเลขหนังสือ / เลขคำสั่ง แล้วคีย์กลับ (Manual — ต้องออก Change Request หากจะเชื่อม API)" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;fontSize=10;dashed=1;startArrow=classic;startFill=1;exitX=1;exitY=0.95;entryX=0;entryY=0.5;" edge="1" parent="p1-1" source="p1core" target="p1x5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1e12" value="ยืนยันตัวตนและลงลายมือชื่ออิเล็กทรอนิกส์" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;fontSize=10;dashed=1;startArrow=classic;startFill=1;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="p1-1" source="p1p4" target="p1x6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1e13" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;dashed=1;endArrow=none;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="p1-1" source="p1core" target="p1p">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="p1n" value="&lt;b&gt;หมายเหตุขอบเขต (Scope Note)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;จุดเริ่มต้นของกิจกรรมที่ 7 คือเลขาธิการคณะกรรมการ ป.ป.ท.&lt;/b&gt; — การจัดทำรายงาน 213 และการเสนอตามลำดับชั้น (เจ้าของสำนวน → หัวหน้ากลุ่มงาน → ผอ.กอง/เขต → ผู้ช่วย/รองเลขาธิการฯ) เป็นกระบวนงานภายในกอง/สำนักงาน ป.ป.ท. เขต ซึ่งอยู่ในกิจกรรมที่ 5&lt;br&gt;• e-Meeting / ลงมติ Real-time แบบออนไลน์ ไม่ได้กำหนดใน TOR 7.1-7.4 → ขอบเขตปัจจุบันคือ &quot;บันทึกมติเข้าระบบ&quot; หากต้องการต้องออก Change Request&lt;br&gt;• เรื่อง ก.ก.ม. และผังภายในคณะอนุกลั่นกรองฯ ยังไม่มีคำนิยาม/กระบวนงาน → รอยืนยันก่อนออกแบบ&lt;br&gt;• กิจกรรมที่ 9 (ขอออกหมายจับ) ยืนยันว่าไม่เข้าสู่การพิจารณาของบอร์ด จึงไม่มีเส้นเชื่อมกับกิจกรรมที่ 7" style="rounded=1;html=1;whiteSpace=wrap;align=left;spacingLeft=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;verticalAlign=middle;" vertex="1" parent="p1-1">
          <mxGeometry x="120" y="920" width="1500" height="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="TO-BE P2 Core Workflow (Swimlane)" id="tobe_p2_core">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3500" pageHeight="3600" math="0" shadow="0">
      <root>
        <mxCell id="p2-0" />
        <mxCell id="p2-1" parent="p2-0" />

        <mxCell id="p2t" value="&lt;b&gt;Page 2 — Core TO-BE Workflow กิจกรรมที่ 7 (รับสำนวน → เสนอวาระ → พิจารณามติ → ลงนามดิจิทัล → ส่งต่อมติและติดตามผล)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;b style=&quot;color:#ffd966&quot;&gt;★ กิจกรรมที่ 7 เริ่มต้นที่เลขาธิการคณะกรรมการ ป.ป.ท. — Lane เทาเส้นประคือการเสนอตามลำดับชั้นภายในกอง/เขต ซึ่งอยู่ในกิจกรรมที่ 5&lt;/b&gt;&lt;br&gt;■ ขั้นตอนภายใน ป.ป.ท. (ผ่านระบบ E-CMIS) | ■ การทำงานอัตโนมัติของระบบ / จุดเชื่อมโยงกิจกรรม | ■ หน่วยงานภายนอก | ◇ จุดตัดสินใจ | เส้นประ = การตีกลับ / วนกลับ&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fillColor=#1f3864;fontColor=#ffffff;rounded=1;" vertex="1" parent="p2-1">
          <mxGeometry x="40" y="20" width="3360" height="80" as="geometry" />
        </mxCell>

        <mxCell id="L1" value="⟵ นอกขอบเขต กจ.7 (อยู่ใน กจ.5)&#10;ผู้รับผิดชอบสำนวน / เจ้าของเรื่อง (กอง / สนง. ป.ป.ท. เขต)" style="swimlane;html=1;horizontal=1;startSize=60;fillColor=#ececec;strokeColor=#999999;dashed=1;fontColor=#666666;fontSize=12;fontStyle=1;swimlaneFillColor=#ffffff;" vertex="1" parent="p2-1">
          <mxGeometry x="40" y="120" width="260" height="3400" as="geometry" />
        </mxCell>
        <mxCell id="L2" value="⟵ นอกขอบเขต กจ.7 (อยู่ใน กจ.5)&#10;หัวหน้ากลุ่มงาน / ผอ.กอง — ผอ.สนง. ป.ป.ท. เขต" style="swimlane;html=1;horizontal=1;startSize=60;fillColor=#ececec;strokeColor=#999999;dashed=1;fontColor=#666666;fontSize=12;fontStyle=1;swimlaneFillColor=#ffffff;" vertex="1" parent="p2-1">
          <mxGeometry x="300" y="120" width="260" height="3400" as="geometry" />
        </mxCell>
        <mxCell id="L3" value="เลขาธิการคณะกรรมการ ป.ป.ท.&#10;★ จุดเริ่มต้นของกิจกรรมที่ 7" style="swimlane;html=1;horizontal=1;startSize=60;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1;swimlaneFillColor=#ffffff;" vertex="1" parent="p2-1">
          <mxGeometry x="560" y="120" width="260" height="3400" as="geometry" />
        </mxCell>
        <mxCell id="L4" value="คณะอนุกรรมการสนับสนุน&#10;เลขาธิการฯ (2 คณะ)" style="swimlane;html=1;horizontal=1;startSize=60;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1;swimlaneFillColor=#ffffff;" vertex="1" parent="p2-1">
          <mxGeometry x="820" y="120" width="260" height="3400" as="geometry" />
        </mxCell>
        <mxCell id="L5" value="ผอ.กองบริหารคดี (ผอ.กบค.)&#10;/ กลุ่มงานบริหารคดีและบริหารทั่วไป" style="swimlane;html=1;horizontal=1;startSize=60;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1;swimlaneFillColor=#ffffff;" vertex="1" parent="p2-1">
          <mxGeometry x="1080" y="120" width="260" height="3400" as="geometry" />
        </mxCell>
        <mxCell id="L6" value="ฝ่ายธุรการ /&#10;หน้าห้องประธานกรรมการ ป.ป.ท." style="swimlane;html=1;horizontal=1;startSize=60;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1;swimlaneFillColor=#ffffff;" vertex="1" parent="p2-1">
          <mxGeometry x="1340" y="120" width="260" height="3400" as="geometry" />
        </mxCell>
        <mxCell id="L7" value="ประธานกรรมการ ป.ป.ท." style="swimlane;html=1;horizontal=1;startSize=60;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1;swimlaneFillColor=#ffffff;" vertex="1" parent="p2-1">
          <mxGeometry x="1600" y="120" width="260" height="3400" as="geometry" />
        </mxCell>
        <mxCell id="L8" value="คณะอนุกรรมการกลั่นกรอง&#10;เรื่องไต่สวนข้อเท็จจริง (คณะที่ 1-8)" style="swimlane;html=1;horizontal=1;startSize=60;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1;swimlaneFillColor=#ffffff;" vertex="1" parent="p2-1">
          <mxGeometry x="1860" y="120" width="260" height="3400" as="geometry" />
        </mxCell>
        <mxCell id="L9" value="ฝ่ายเลขานุการบอร์ด (กบค.)&#10;กลุ่มงานกิจการฯ + กลุ่มงานคำวินิจฉัยและมติฯ" style="swimlane;html=1;horizontal=1;startSize=60;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1;swimlaneFillColor=#ffffff;" vertex="1" parent="p2-1">
          <mxGeometry x="2120" y="120" width="260" height="3400" as="geometry" />
        </mxCell>
        <mxCell id="L10" value="คณะกรรมการ ป.ป.ท.&#10;(บอร์ดใหญ่ 7 ท่าน)" style="swimlane;html=1;horizontal=1;startSize=60;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1;swimlaneFillColor=#ffffff;" vertex="1" parent="p2-1">
          <mxGeometry x="2380" y="120" width="260" height="3400" as="geometry" />
        </mxCell>
        <mxCell id="L11" value="กลุ่มงานบริหารติดตามคดี&#10;(กบต.)" style="swimlane;html=1;horizontal=1;startSize=60;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1;swimlaneFillColor=#ffffff;" vertex="1" parent="p2-1">
          <mxGeometry x="2640" y="120" width="260" height="3400" as="geometry" />
        </mxCell>
        <mxCell id="L12" value="ระบบ E-CMIS&#10;(Automation / Integration)" style="swimlane;html=1;horizontal=1;startSize=60;fillColor=#e8f5e9;strokeColor=#82b366;fontSize=12;fontStyle=1;swimlaneFillColor=#ffffff;" vertex="1" parent="p2-1">
          <mxGeometry x="2900" y="120" width="260" height="3400" as="geometry" />
        </mxCell>
        <mxCell id="L13" value="หน่วยงานภายนอก&#10;(ป.ป.ช. / อัยการ / ต้นสังกัด)" style="swimlane;html=1;horizontal=1;startSize=60;fillColor=#fff4e6;strokeColor=#d79b00;fontSize=12;fontStyle=1;swimlaneFillColor=#ffffff;" vertex="1" parent="p2-1">
          <mxGeometry x="3160" y="120" width="260" height="3400" as="geometry" />
        </mxCell>

        <mxCell id="n_start" value="&lt;b&gt;ต้นทาง&lt;/b&gt;&lt;br&gt;รับเรื่องจากกิจกรรมที่ 5" style="ellipse;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;strokeWidth=2;" vertex="1" parent="L1">
          <mxGeometry x="30" y="80" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="sys1" value="&lt;b&gt;[Integration ← กจ.5]&lt;/b&gt;&lt;br&gt;Auto Sync + Auto-fill: ผู้กล่าวหา / ผู้ถูกกล่าวหา / พฤติการณ์ / ฐานความผิด / เลข PCMS จากฐานข้อมูลกลาง E-CMIS (ไม่คีย์ซ้ำ)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="L12">
          <mxGeometry x="15" y="80" width="230" height="95" as="geometry" />
        </mxCell>

        <mxCell id="t1" value="&lt;b&gt;[นอกขอบเขต กจ.7]&lt;/b&gt; จัดทำ / ยืนยันรายงาน 213 หรือ 644 แนบไฟล์ดิจิทัล (Word/PDF) และเสนอเข้าระบบ E-CMIS" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ececec;strokeColor=#999999;dashed=1;fontColor=#666666;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="L1">
          <mxGeometry x="20" y="190" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="sys2" value="&lt;b&gt;[Validation Rules]&lt;/b&gt;&lt;br&gt;ตรวจความครบถ้วนเอกสาร + สถานะคดีปัจจุบัน + วันครบอายุความ — บล็อกการส่งหากไม่ผ่านเกณฑ์" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="L12">
          <mxGeometry x="15" y="190" width="230" height="90" as="geometry" />
        </mxCell>

        <mxCell id="t2" value="&lt;b&gt;[นอกขอบเขต กจ.7]&lt;/b&gt; หัวหน้ากลุ่มงาน (นสส./ชพ.) ตรวจทานรายงานและเสนอความเห็นผ่าน e-Approval" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ececec;strokeColor=#999999;dashed=1;fontColor=#666666;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="L2">
          <mxGeometry x="20" y="300" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="sys3" value="&lt;b&gt;[SLA Timer + Notification]&lt;/b&gt;&lt;br&gt;เริ่มจับเวลารายขั้น แจ้งเตือนล่วงหน้า 3 วัน และ 1 วัน (Admin ตั้งค่าจำนวนวันได้ — TOR 7.2.1.3)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="L12">
          <mxGeometry x="15" y="300" width="230" height="90" as="geometry" />
        </mxCell>

        <mxCell id="t3" value="&lt;b&gt;[นอกขอบเขต กจ.7]&lt;/b&gt; ผอ.กอง / ผอ.สนง. ป.ป.ท. เขต พิจารณากลั่นกรองและเห็นชอบตามลำดับชั้น (ลงนามดิจิทัล)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ececec;strokeColor=#999999;dashed=1;fontColor=#666666;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="L2">
          <mxGeometry x="20" y="410" width="220" height="90" as="geometry" />
        </mxCell>

        <mxCell id="t4" value="&lt;b&gt;[นอกขอบเขต กจ.7]&lt;/b&gt; ผู้ช่วยเลขาธิการฯ → รองเลขาธิการฯ พิจารณาแบบ Sequential Approval เสนอเลขาธิการฯ" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ececec;strokeColor=#999999;dashed=1;fontColor=#666666;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="L3">
          <mxGeometry x="20" y="520" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="sys4" value="&lt;b&gt;[Return / Recall Engine — TOR 7.2.1.2]&lt;/b&gt;&lt;br&gt;Return: ตีกลับพร้อม Reason Code บังคับกรอก | Recall: ดึงเรื่องกลับได้ตราบใดที่ชั้นถัดไปยังไม่ลงนาม (รายละเอียดที่ Page 3)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="L12">
          <mxGeometry x="15" y="520" width="230" height="100" as="geometry" />
        </mxCell>

        <mxCell id="t5" value="★ &lt;b&gt;S1 — จุดเริ่มต้นกิจกรรมที่ 7&lt;/b&gt;&lt;br&gt;เลขาธิการฯ พิจารณาและ&lt;b&gt;ลงนามดิจิทัล&lt;/b&gt; บนรายงาน 213 / 644&lt;br&gt;⏱ SLA 213: รอลงนาม 5 วัน / ลงนามเสร็จ 3 วัน — 644: เสนอ 15 วัน / ลงนาม 15 วัน" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=3;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="L3">
          <mxGeometry x="20" y="630" width="220" height="100" as="geometry" />
        </mxCell>

        <mxCell id="g1" value="&lt;b&gt;G1&lt;/b&gt; เป็นเรื่องยุ่งยากซับซ้อน หรือความเห็นในสายบังคับบัญชาไม่ตรงกัน?" style="rhombus;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="L3">
          <mxGeometry x="30" y="750" width="200" height="110" as="geometry" />
        </mxCell>

        <mxCell id="t6" value="&lt;b&gt;T6&lt;/b&gt; คณะอนุกรรมการสนับสนุนเลขาธิการฯ กลั่นกรองข้อกฎหมาย / ประเด็นซับซ้อน และเสนอความเห็นกลับ" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="L4">
          <mxGeometry x="20" y="880" width="220" height="90" as="geometry" />
        </mxCell>

        <mxCell id="g2" value="&lt;b&gt;G2&lt;/b&gt; ความเห็นสอดคล้องกับผู้รับผิดชอบสำนวน?" style="rhombus;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="L4">
          <mxGeometry x="30" y="990" width="200" height="110" as="geometry" />
        </mxCell>

        <mxCell id="g3" value="&lt;b&gt;G3&lt;/b&gt; มีใบด่วนขอบรรจุวาระเร่งด่วน (ใกล้ขาดอายุความ)?" style="rhombus;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="L3">
          <mxGeometry x="30" y="1120" width="200" height="110" as="geometry" />
        </mxCell>

        <mxCell id="t7" value="&lt;b&gt;T7&lt;/b&gt; ผอ.กบค. ลงนามรับรองเหตุผลความจำเป็นเร่งด่วนบนใบด่วนในระบบ&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;จุดควบคุม: ไม่มีลายเซ็นนี้ = Bypass ดำเนินการไม่ได้&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="L5">
          <mxGeometry x="20" y="1250" width="220" height="100" as="geometry" />
        </mxCell>

        <mxCell id="t8" value="&lt;b&gt;T8&lt;/b&gt; หน้าห้องประธานฯ ลงรับสำนวนอิเล็กทรอนิกส์ คัดกรอง และนำเสนอประธานกรรมการ ป.ป.ท." style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="L6">
          <mxGeometry x="20" y="1370" width="220" height="90" as="geometry" />
        </mxCell>

        <mxCell id="g4" value="&lt;b&gt;G4&lt;/b&gt; ประธานกรรมการ ป.ป.ท. สั่งการอย่างไร?" style="rhombus;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="L7">
          <mxGeometry x="30" y="1480" width="200" height="110" as="geometry" />
        </mxCell>

        <mxCell id="t10" value="&lt;b&gt;T9&lt;/b&gt; กบค. กระจายสำนวนอิเล็กทรอนิกส์เข้าคณะอนุกลั่นกรองฯ 1-8&lt;br&gt;&lt;b&gt;[Auto Routing]&lt;/b&gt; Round-Robin ไม่เกิน 40 เรื่อง/คณะ + Manual Assign ได้" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="L5">
          <mxGeometry x="20" y="1610" width="220" height="100" as="geometry" />
        </mxCell>

        <mxCell id="t11" value="&lt;b&gt;T10&lt;/b&gt; คณะอนุกลั่นกรองฯ ประชุมพิจารณา บันทึก &quot;มติ + ความเห็น/ข้อสังเกต&quot; เข้าระบบ ⏱ SLA 15 วัน" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="L8">
          <mxGeometry x="20" y="1720" width="220" height="90" as="geometry" />
        </mxCell>

        <mxCell id="t9" value="&lt;b&gt;T11&lt;/b&gt; ประธานกรรมการ ป.ป.ท. ลงนามสั่งบรรจุวาระการประชุม (Digital Signature)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="L7">
          <mxGeometry x="20" y="1830" width="220" height="90" as="geometry" />
        </mxCell>

        <mxCell id="t12" value="&lt;b&gt;T12&lt;/b&gt; ฝ่ายเลขานุการบอร์ด จัดระเบียบวาระ + หนังสือเชิญประชุม (Mail-Merge) และกำหนด &quot;ชั้นความลับ&quot; ตาม ม.19/1&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;ม.13 ต้องแจ้งนัดเป็นหนังสือล่วงหน้าไม่น้อยกว่า 3 วัน เว้นแต่เร่งด่วน ประธานฯ นัดเป็นอย่างอื่นได้&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="L9">
          <mxGeometry x="20" y="1940" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="sys5" value="&lt;b&gt;[Auto]&lt;/b&gt; De-duplication Check (เลขบัตร ปชช. + พฤติการณ์ → Warning Badge รวม/แยกสำนวน) | Mail-Merge Template Generator | แจ้งเตือนกรรมการอ่านวาระล่วงหน้า 3 วัน" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="L12">
          <mxGeometry x="15" y="1940" width="230" height="110" as="geometry" />
        </mxCell>

        <mxCell id="t13" value="&lt;b&gt;T13&lt;/b&gt; คณะกรรมการ ป.ป.ท. ประชุมพิจารณาตามระเบียบวาระ&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;ม.12 องค์ประชุมไม่น้อยกว่ากึ่งหนึ่งของกรรมการเท่าที่มีอยู่ | ม.15 มติ = เสียงข้างมากของกรรมการทั้งหมดเท่าที่มีอยู่ ประธานชี้ขาดเมื่อเท่ากัน | ม.20 กันผู้มีส่วนได้เสียออกต้องมีมติบอร์ด&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="L10">
          <mxGeometry x="20" y="2060" width="220" height="110" as="geometry" />
        </mxCell>

        <mxCell id="t14" value="&lt;b&gt;T14&lt;/b&gt; กลุ่มงานคำวินิจฉัยและมติฯ บันทึกรายละเอียดมติ Real-time + ล็อกไฟล์ PDF + Auto-compile รายงานการประชุมรวมทุกเรื่องในวันเดียวกัน&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;ม.16 ต้องมีรายงานการประชุมเป็นหนังสือ และบันทึกความเห็นแย้งพร้อมเหตุผลของกรรมการฝ่ายข้างน้อย&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="L9">
          <mxGeometry x="20" y="2190" width="220" height="110" as="geometry" />
        </mxCell>

        <mxCell id="g5" value="&lt;b&gt;G5&lt;/b&gt; ประเภทผลมติของคณะกรรมการ ป.ป.ท.?" style="rhombus;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="L10">
          <mxGeometry x="30" y="2320" width="200" height="110" as="geometry" />
        </mxCell>

        <mxCell id="a1" value="&lt;b&gt;มติ 1: รับไว้ไต่สวน&lt;/b&gt;&lt;br&gt;จัดทำและบันทึกมติเข้าระบบ (ล็อก PDF) + ออกคำสั่งแต่งตั้งผู้ไต่สวน — &lt;b&gt;ม.24 ว.1 องค์คณะไม่น้อยกว่า 2 คน ตามที่เลขาธิการแต่งตั้ง ประกอบด้วยพนักงาน ป.ป.ท. อย่างน้อย 1 คน และเจ้าหน้าที่ ป.ป.ท. ไม่เกิน 2 คน หากจำเป็นต้องเกิน 2 คน ต้องมีพนักงาน ป.ป.ท. ไม่น้อยกว่ากึ่งหนึ่งของจำนวนเจ้าหน้าที่ ป.ป.ท.&lt;/b&gt; / &lt;b&gt;ม.24 ว.3 คณะอนุกรรมการไต่สวน เฉพาะเรื่องสำคัญ-ซับซ้อน ตามข้อเสนอแนะของเลขาธิการฯ (บอร์ดแต่งตั้ง)&lt;/b&gt; จาก Template ปปท. ๕-๐๑ / ๕-๐๔ และลงนามดิจิทัล" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="L9">
          <mxGeometry x="20" y="2460" width="220" height="204" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="&lt;b&gt;[Integration → กจ.5]&lt;/b&gt;&lt;br&gt;ยิงมติ + คำสั่งกลับอัตโนมัติ เปลี่ยนสถานะคดีเป็น &quot;อยู่ระหว่างไต่สวน&quot;&lt;br&gt;⏱ ออกคำสั่ง 5 วันทำการ / ส่งคืนหน่วยงาน 3 วันทำการ" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="L12">
          <mxGeometry x="15" y="2460" width="230" height="115" as="geometry" />
        </mxCell>

        <mxCell id="b1" value="&lt;b&gt;มติ 2: ไม่รับเรื่องไว้พิจารณา / สั่งจำหน่ายเรื่อง / ข้อกล่าวหาไม่มีมูล&lt;/b&gt;&lt;br&gt;จัดทำและบันทึกมติเข้าระบบ E-CMIS (ล็อกไฟล์ PDF)&lt;br&gt;&lt;b&gt;ระบบบังคับเลือก 1 ใน 3 สถานะตามตัวบท:&lt;/b&gt;&lt;br&gt;• &lt;b&gt;ไม่รับเรื่องไว้พิจารณา (ม.25 ห้ามเด็ดขาด / ม.26 ดุลพินิจ)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;สั่งจำหน่ายเรื่อง (ม.26)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;ข้อกล่าวหาไม่มีมูล (ม.32)&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="L9">
          <mxGeometry x="20" y="2600" width="220" height="156" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="บันทึกรับมติในระบบ และแจ้งผลการพิจารณาไปยังผู้ถูกกล่าวหา&lt;br&gt;⏱ &lt;b&gt;ม.32: ไม่ช้ากว่า 15 วันนับแต่วันที่บอร์ดมีมติ&lt;/b&gt; (เตือน 3 วัน และ 1 วัน)&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;กรอบ 15 วันนี้ใช้กับสถานะ &quot;ข้อกล่าวหาไม่มีมูล (ม.32)&quot; เท่านั้น มิใช่กับการไม่รับเรื่องไว้พิจารณา (ม.25/ม.26) หรือการสั่งจำหน่ายเรื่อง (ม.26)&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="L1">
          <mxGeometry x="20" y="2600" width="220" height="140" as="geometry" />
        </mxCell>
        <mxCell id="b3" value="&lt;b&gt;[Integration → กจ.5]&lt;/b&gt;&lt;br&gt;อัปเดตสถานะเป็น Closed Case อัตโนมัติ" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="L12">
          <mxGeometry x="15" y="2600" width="230" height="90" as="geometry" />
        </mxCell>

        <mxCell id="c1" value="&lt;b&gt;มติ 3: ส่งเรื่องให้ ป.ป.ช.&lt;/b&gt; (อยู่นอกอำนาจ ป.ป.ท.)&lt;br&gt;จัดทำมติ + หนังสือนำส่งสำนวนจาก Template แล้วส่งคืนผู้รับผิดชอบสำนวน" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="L9">
          <mxGeometry x="20" y="2720" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="พิมพ์และลงนามหนังสือนำส่ง ส่งมอบสำนวนให้ ป.ป.ช. ด้วยตนเอง&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;ระบบบังคับอัปโหลดไฟล์สแกนฉบับลงนามกลับ (TOR 7.2.1.5)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;ระบบบังคับคัดสำเนาสำนวนเก็บรักษาไว้เป็นหลักฐาน (ม.18/1 (ก)(3))&lt;/font&gt;&lt;br&gt;⏱ &lt;b&gt;SLA 15 วัน ตาม ม.18/1&lt;/b&gt; — (ก)(3) นับแต่วันได้รับแจ้งมติ ป.ป.ช. / (ข)(1) และ (ข)(3) นับแต่วันที่ได้รับเรื่อง" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="L1">
          <mxGeometry x="20" y="2720" width="220" height="156" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;สำนักงาน ป.ป.ช.&lt;/b&gt;&lt;br&gt;รับเรื่องและดำเนินการตามอำนาจหน้าที่ที่กฎหมายกำหนด" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="L13">
          <mxGeometry x="20" y="2720" width="220" height="90" as="geometry" />
        </mxCell>

        <mxCell id="d1" value="&lt;b&gt;มติ 4: ชี้มูลความผิด (อาญา และ/หรือ วินัย)&lt;/b&gt;&lt;br&gt;กลุ่มงานกิจการคณะกรรมการ จัดทำรายงานวินิจฉัยชี้มูล (ปปท. ๗-๐๒) จาก Mail-Merge เสนอคณะกรรมการลงนาม" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="L9">
          <mxGeometry x="20" y="2860" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="ประธานฯ / คณะกรรมการ ป.ป.ท. ลงนามในรายงานวินิจฉัยชี้มูล&lt;br&gt;&lt;b&gt;Multi-signer Digital Signature&lt;/b&gt; (ลงนามหลายคนในเอกสารฉบับเดียว)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="L10">
          <mxGeometry x="20" y="2860" width="220" height="100" as="geometry" />
        </mxCell>

        <mxCell id="d3" value="&lt;b&gt;สายอาญา&lt;/b&gt; จัดทำหนังสือนำส่งสำนวนถึงพนักงานอัยการ พิมพ์-ลงนามสด และอัปโหลดไฟล์สแกนฉบับลงนามกลับเข้าระบบ ⏱ SLA 30 วัน" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="L1">
          <mxGeometry x="20" y="2990" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="d4" value="&lt;b&gt;พนักงานอัยการ (ม.44)&lt;/b&gt; ดำเนินคดีอาญาโดยถือว่าสำนวนไต่สวนของบอร์ดเป็นสำนวนการสอบสวนตาม ป.วิ.อาญา&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;เห็นควรสั่งไม่ฟ้อง → ดู Page 3 EX-07 (ม.44 ว.3)&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="L13">
          <mxGeometry x="20" y="2990" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="d5" value="&lt;b&gt;[Integration → กจ.8 / กจ.10]&lt;/b&gt;&lt;br&gt;Auto-pull มติชี้มูลอาญาเข้า Work Inbox + เริ่มนับ SLA 30 วัน&lt;br&gt;(&quot;วันที่ส่งอัยการ&quot; เจ้าของสำนวนคีย์เอง)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="L12">
          <mxGeometry x="15" y="2990" width="230" height="115" as="geometry" />
        </mxCell>

        <mxCell id="d6" value="&lt;b&gt;สายวินัย (ม.38)&lt;/b&gt; จัดทำหนังสือแจ้งลงโทษทางวินัยจาก Template ปปท. ๘-๐๕ / ๘-๐๖ — &lt;b&gt;ผู้ลงนามแจ้งคือประธานกรรมการ ป.ป.ท.&lt;/b&gt; และต้องแนบมติ + รายงานการไต่สวนที่บอร์ดเห็นชอบแล้ว" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="L9">
          <mxGeometry x="20" y="3120" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="d7" value="กบต. ส่งหนังสือลงโทษทางวินัยถึงหน่วยงานต้นสังกัดและติดตามผล&lt;br&gt;⏱ &lt;b&gt;ม.38 ว.3: ต้นสังกัดพิจารณาโทษภายใน 60 วันนับแต่ได้รับแจ้ง โดยไม่ต้องตั้งคณะกรรมการสอบสวนวินัยอีก&lt;/b&gt; / รายงานกลับ 30 วัน / เตือนเมื่อเกิน 90 วัน" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="L11">
          <mxGeometry x="20" y="3120" width="220" height="115" as="geometry" />
        </mxCell>
        <mxCell id="d8" value="&lt;b&gt;หน่วยงานต้นสังกัด&lt;/b&gt;&lt;br&gt;ลงโทษทางวินัยตามฐานความผิดที่บอร์ดมีมติ และรายงานผลกลับ&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;เพิกเฉย → ม.41 / ไม่มีอำนาจ → ม.42 รายงานนายกรัฐมนตรี (ดู Page 3 EX-06)&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="L13">
          <mxGeometry x="20" y="3120" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="d9" value="&lt;b&gt;[Integration → กจ.8]&lt;/b&gt;&lt;br&gt;Auto-pull มติวินัยไม่ต้องคีย์ซ้ำลง Excel + Executive Dashboard ติดตามคดีล่าช้าแบบ Real-time" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="L12">
          <mxGeometry x="15" y="3120" width="230" height="110" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="&lt;b&gt;มติ 5: มติอื่น ๆ&lt;/b&gt; (ไต่สวนเพิ่มเติม / ส่งกองกฎหมาย / เลื่อนการพิจารณา / ถอนเรื่อง / อนุมัติรวม-แยกสำนวน)&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;&lt;b&gt;ชั้น 7.2:&lt;/b&gt; ม.24 ว.4 บังคับระบุ &quot;เหตุผล&quot; ของการสั่งไต่สวนเพิ่มเติม/ไต่สวนเองใหม่ (ใช้เมื่อผู้ไต่สวนตาม ว.1/ว.3 ไต่สวนเสร็จแล้ว) — &lt;b&gt;ชั้น 7.1:&lt;/b&gt; เป็นข้อกำหนดตามระเบียบคณะกรรมการ ป.ป.ท. (ฐาน ม.24 วรรคท้าย) มิใช่ ม.24 ว.4&lt;br&gt;ระบบบังคับระบุผู้รับผิดชอบและกำหนดส่งกลับ&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="L9">
          <mxGeometry x="20" y="3250" width="220" height="172" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="ดำเนินการตามคำสั่งที่ประชุม แล้วรายงานความคืบหน้าเพื่อเสนอบรรจุวาระอีกครั้ง&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;ถอน/เลื่อนวาระต้องได้เลขวาระใหม่เสมอ (ดู Page 3)&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="L1">
          <mxGeometry x="20" y="3250" width="220" height="110" as="geometry" />
        </mxCell>

