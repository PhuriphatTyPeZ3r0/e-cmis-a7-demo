        <mxCell id="p1lg1" value="โมดูลกิจกรรมที่ 7 (In Scope)" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="p1lg">
