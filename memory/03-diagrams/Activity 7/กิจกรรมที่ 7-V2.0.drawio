        </mxCell>

        <mxCell id="p1x1" value="&lt;b&gt;สำนักงาน ป.ป.ช.&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="p1-1">
          <mxGeometry x="1320" y="290" width="300" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p1x2" value="&lt;b&gt;สำนักงานอัยการสูงสุด / พนักงานอัยการ&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="p1-1">
          <mxGeometry x="1320" y="365" width="300" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p1x3" value="&lt;b&gt;ศาลปกครอง&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="p1-1">
