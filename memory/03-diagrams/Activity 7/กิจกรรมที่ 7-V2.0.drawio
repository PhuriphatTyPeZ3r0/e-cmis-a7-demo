          <mxGeometry x="10" y="58" width="290" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p1lg3" value="หน่วยงาน / ระบบภายนอก ป.ป.ท." style="rounded=1;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="p1lg">
          <mxGeometry x="10" y="84" width="290" height="24" as="geometry" />
