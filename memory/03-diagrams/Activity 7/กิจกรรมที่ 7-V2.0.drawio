        <mxCell id="p1core" value="&lt;b&gt;กิจกรรมที่ 7 — ระบบมติคณะกรรมการ ป.ป.ท.&lt;/b&gt;" style="swimlane;html=1;startSize=40;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="p1-1">
