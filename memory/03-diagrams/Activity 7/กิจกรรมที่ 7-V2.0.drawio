        <mxCell id="p1a10" value="&lt;b&gt;กิจกรรมที่ 10&lt;/b&gt; กฎหมายในทางคดี (ผ่านกองกฎหมาย กกม.)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="p1-1">
