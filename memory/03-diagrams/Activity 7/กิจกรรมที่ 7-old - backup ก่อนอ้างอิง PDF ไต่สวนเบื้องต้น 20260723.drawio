          <mxGeometry height="60" width="200" x="830" y="3690" as="geometry" />
        </mxCell>
        <mxCell id="p9_n1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#d4edda;strokeColor=#28a745;fontSize=11;" value="&lt;b&gt;กองบริหารคดี (ธุรการสารบรรณกลาง)&lt;/b&gt;&lt;br&gt;มอบหมายสำนวนให้คณะอนุกรรมการกลั่นกรองฯ ตามลำดับ โดยจำกัดคณะละไม่เกิน 40 เรื่อง แล้ววนไปคณะถัดไป (คณะที่ 1-8)" vertex="1">
          <mxGeometry height="90" width="360" x="470" y="5540" as="geometry" />
        </mxCell>
        <mxCell id="p9_n2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#d4edda;strokeColor=#28a745;fontSize=11;" value="&lt;b&gt;ฝ่ายเลขานุการฯ คณะอนุกรรมการกลั่นกรองฯ&lt;/b&gt;&lt;br&gt;ตรวจสอบสำนวนครบถ้วน จัดทำหนังสือเชิญประชุม นัดหมายวันประชุมคณะอนุกรรมการฯ" vertex="1">
          <mxGeometry height="80" width="360" x="470" y="5660" as="geometry" />
        </mxCell>
        <mxCell id="p9_n3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#d4edda;strokeColor=#28a745;fontSize=11;" value="&lt;b&gt;คณะอนุกรรมการกลั่นกรองฯ (คณะที่ได้รับมอบหมาย)&lt;/b&gt;&lt;br&gt;ประชุมพิจารณาข้อเท็จจริงและข้อกฎหมาย ตั้งข้อสังเกต / ให้ความเห็นทางคดี" vertex="1">
          <mxGeometry height="90" width="360" x="470" y="5770" as="geometry" />
        </mxCell>
        <mxCell id="p9_n4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#d4edda;strokeColor=#28a745;fontSize=11;" value="&lt;b&gt;ประธานคณะอนุกรรมการกลั่นกรองฯ&lt;/b&gt;&lt;br&gt;ลงนามรับรองมติ / ความเห็นของคณะอนุกรรมการฯ" vertex="1">
          <mxGeometry height="80" width="360" x="470" y="5890" as="geometry" />
        </mxCell>
        <mxCell id="p9_n5a" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#d4edda;strokeColor=#28a745;fontSize=11;" value="&lt;b&gt;ฝ่ายเลขานุการฯ คณะอนุกรรมการกลั่นกรองฯ&lt;/b&gt;&lt;br&gt;ทำหนังสือแจ้งมติ/ความเห็น ส่งกลับผู้รับผิดชอบสำนวน (กอง/สำนักงาน ป.ป.ท. เขต) เพื่อเตรียมชี้แจงต่อบอร์ด" vertex="1">
          <mxGeometry height="100" width="330" x="190" y="6020" as="geometry" />
        </mxCell>
        <mxCell id="p9_n5b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#d4edda;strokeColor=#28a745;fontSize=11;" value="&lt;b&gt;ฝ่ายเลขานุการฯ คณะอนุกรรมการกลั่นกรองฯ&lt;/b&gt;&lt;br&gt;ทำหนังสือนำส่งมติ+สำนวนคดี ผ่านกองบริหารคดี (กลุ่มงานกิจการคณะกรรมการ) เรียนประธานกรรมการ ป.ป.ท." vertex="1">
