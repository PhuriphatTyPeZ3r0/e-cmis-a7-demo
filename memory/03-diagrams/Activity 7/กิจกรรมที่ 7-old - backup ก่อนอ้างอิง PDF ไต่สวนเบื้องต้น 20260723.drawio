        <mxCell id="p6_n2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#d4edda;strokeColor=#28a745;fontSize=11;" value="&lt;b&gt;คณะกรรมการ ป.ป.ท.&lt;/b&gt;&lt;br&gt;มีมติ &quot;มอบอำนาจ&quot; ให้นิติกร หรือพนักงานอัยการ ดำเนินคดีแทน" vertex="1">
