          <mxGeometry height="70" width="340" x="470" y="470" as="geometry" />
        </mxCell>
        <mxCell id="p4_n3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#d4edda;strokeColor=#28a745;fontSize=11;" value="&lt;b&gt;นิติกรผู้รับผิดชอบสำนวน&lt;/b&gt;&lt;br&gt;ตรวจสอบเนื้อหา วิเคราะห์ความเห็นอัยการเทียบกับมติชี้มูลเดิมของ ป.ป.ท." vertex="1">
          <mxGeometry height="90" width="340" x="470" y="570" as="geometry" />
        </mxCell>
        <mxCell id="p4_n4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#d4edda;strokeColor=#28a745;fontSize=11;" value="&lt;b&gt;นิติกรผู้รับผิดชอบสำนวน&lt;/b&gt;&lt;br&gt;จัดทำบันทึกความเห็นทางกฎหมาย เสนอตามลำดับชั้น (หัวหน้ากลุ่มงาน → ผอ.กองกฎหมาย → ผู้ช่วย/รองเลขาธิการ → เลขาธิการ ป.ป.ท.)" vertex="1">
          <mxGeometry height="100" width="340" x="470" y="690" as="geometry" />
