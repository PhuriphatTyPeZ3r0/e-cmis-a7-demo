        <mxCell id="p1_note3" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#d6b656;fontSize=10;size=14;align=left;spacing=6;" value="⏱ กรอบเวลาดำเนินการหลังมีมติ: ปกติ ≤15 วัน | เร่งด่วน ≤7 วัน | รวมทั้งหมด ≤20 วัน" vertex="1">
