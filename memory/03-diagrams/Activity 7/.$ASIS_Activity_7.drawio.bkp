        <mxCell id="T1_start" parent="1" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.start_1;whiteSpace=wrap;fillColor=#b0e3e6;strokeColor=#0e8088;fontStyle=1;fontSize=20;" value="เริ่มต้น" vertex="1">
          <mxGeometry height="60" width="150" x="825" y="140" as="geometry" />
        </mxCell>
        <mxCell id="T1_n1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=20;align=center;verticalAlign=middle;" value="ผู้รับผิดชอบ (เขต/กองปราบ) ส่งรายงานไต่สวน&lt;br&gt;เข้ามายังส่วนกลาง (กระดาษ/ไฟล์)" vertex="1">
