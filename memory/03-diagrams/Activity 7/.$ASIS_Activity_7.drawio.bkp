        <mxCell id="T1_n2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=20;align=center;verticalAlign=middle;" value="เจ้าหน้าที่ส่วนกลางสั่งพิมพ์ (Print) รายงานออกมา&lt;br&gt;เพื่อทำสำเนาตามจำนวนกรรมการ (7-11 ชุด)" vertex="1">
          <mxGeometry height="80" width="450" x="675" y="360" as="geometry" />
