        <mxCell id="T1_n3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=20;align=center;verticalAlign=middle;" value="จัดทำ &quot;ทะเบียนคุม&quot; ใน Microsoft Excel (Manual)&lt;br&gt;เพื่อบันทึกสถานะและกำหนดวาระเข้าบอร์ด" vertex="1">
