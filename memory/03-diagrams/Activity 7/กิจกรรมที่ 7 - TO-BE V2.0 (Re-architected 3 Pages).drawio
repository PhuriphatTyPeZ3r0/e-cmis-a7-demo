          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="p1n" value="&lt;b&gt;หมายเหตุขอบเขต (Scope Note)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;จุดเริ่มต้นของกิจกรรมที่ 7 คือเลขาธิการคณะกรรมการ ป.ป.ท.&lt;/b&gt; — การจัดทำรายงาน 213 และการเสนอตามลำดับชั้น (เจ้าของสำนวน → หัวหน้ากลุ่มงาน → ผอ.กอง/เขต → ผู้ช่วย/รองเลขาธิการฯ) เป็นกระบวนงานภายในกอง/สำนักงาน ป.ป.ท. เขต ซึ่งอยู่ในกิจกรรมที่ 5&lt;br&gt;• e-Meeting / ลงมติ Real-time แบบออนไลน์ ไม่ได้กำหนดใน TOR 7.1-7.4 → ขอบเขตปัจจุบันคือ &quot;บันทึกมติเข้าระบบ&quot; หากต้องการต้องออก Change Request&lt;br&gt;• เรื่อง ก.ก.ม. และผังภายในคณะอนุกลั่นกรองฯ ยังไม่มีคำนิยาม/กระบวนงาน → รอยืนยันก่อนออกแบบ&lt;br&gt;• กิจกรรมที่ 9 (ขอออกหมายจับ) ยืนยันว่าไม่เข้าสู่การพิจารณาของบอร์ด จึงไม่มีเส้นเชื่อมกับกิจกรรมที่ 7" style="rounded=1;html=1;whiteSpace=wrap;align=left;spacingLeft=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;verticalAlign=middle;" vertex="1" parent="p1-1">
          <mxGeometry x="120" y="920" width="1500" height="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="TO-BE P2 Core Workflow (Swimlane)" id="tobe_p2_core">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3500" pageHeight="3600" math="0" shadow="0">
      <root>
        <mxCell id="p2-0" />
        <mxCell id="p2-1" parent="p2-0" />

        <mxCell id="p2t" value="&lt;b&gt;Page 2 — Core TO-BE Workflow กิจกรรมที่ 7 (รับสำนวน → เสนอวาระ → พิจารณามติ → ลงนามดิจิทัล → ส่งต่อมติและติดตามผล)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;b style=&quot;color:#ffd966&quot;&gt;★ กิจกรรมที่ 7 เริ่มต้นที่เลขาธิการคณะกรรมการ ป.ป.ท. — Lane เทาเส้นประคือการเสนอตามลำดับชั้นภายในกอง/เขต ซึ่งอยู่ในกิจกรรมที่ 5&lt;/b&gt;&lt;br&gt;■ ขั้นตอนภายใน ป.ป.ท. (ผ่านระบบ E-CMIS) | ■ การทำงานอัตโนมัติของระบบ / จุดเชื่อมโยงกิจกรรม | ■ หน่วยงานภายนอก | ◇ จุดตัดสินใจ | เส้นประ = การตีกลับ / วนกลับ&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fillColor=#1f3864;fontColor=#ffffff;rounded=1;" vertex="1" parent="p2-1">
          <mxGeometry x="40" y="20" width="3360" height="80" as="geometry" />
        </mxCell>

        <mxCell id="L1" value="⟵ นอกขอบเขต กจ.7 (อยู่ใน กจ.5)&#10;ผู้รับผิดชอบสำนวน / เจ้าของเรื่อง (กอง / สนง. ป.ป.ท. เขต)" style="swimlane;html=1;horizontal=1;startSize=60;fillColor=#ececec;strokeColor=#999999;dashed=1;fontColor=#666666;fontSize=12;fontStyle=1;swimlaneFillColor=#ffffff;" vertex="1" parent="p2-1">
          <mxGeometry x="40" y="120" width="260" height="3400" as="geometry" />
        </mxCell>
        <mxCell id="L2" value="⟵ นอกขอบเขต กจ.7 (อยู่ใน กจ.5)&#10;หัวหน้ากลุ่มงาน / ผอ.กอง — ผอ.สนง. ป.ป.ท. เขต" style="swimlane;html=1;horizontal=1;startSize=60;fillColor=#ececec;strokeColor=#999999;dashed=1;fontColor=#666666;fontSize=12;fontStyle=1;swimlaneFillColor=#ffffff;" vertex="1" parent="p2-1">
          <mxGeometry x="300" y="120" width="260" height="3400" as="geometry" />
        </mxCell>
        <mxCell id="L3" value="เลขาธิการคณะกรรมการ ป.ป.ท.&#10;★ จุดเริ่มต้นของกิจกรรมที่ 7" style="swimlane;html=1;horizontal=1;startSize=60;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1;swimlaneFillColor=#ffffff;" vertex="1" parent="p2-1">
          <mxGeometry x="560" y="120" width="260" height="3400" as="geometry" />
        </mxCell>
        <mxCell id="L4" value="คณะอนุกรรมการสนับสนุน&#10;เลขาธิการฯ (2 คณะ)" style="swimlane;html=1;horizontal=1;startSize=60;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1;swimlaneFillColor=#ffffff;" vertex="1" parent="p2-1">
          <mxGeometry x="820" y="120" width="260" height="3400" as="geometry" />
        </mxCell>
        <mxCell id="L5" value="ผอ.กองบริหารคดี (ผอ.กบค.)&#10;/ กลุ่มงานบริหารคดีและบริหารทั่วไป" style="swimlane;html=1;horizontal=1;startSize=60;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1;swimlaneFillColor=#ffffff;" vertex="1" parent="p2-1">
          <mxGeometry x="1080" y="120" width="260" height="3400" as="geometry" />
        </mxCell>
        <mxCell id="L6" value="ฝ่ายธุรการ /&#10;หน้าห้องประธานกรรมการ ป.ป.ท." style="swimlane;html=1;horizontal=1;startSize=60;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1;swimlaneFillColor=#ffffff;" vertex="1" parent="p2-1">
          <mxGeometry x="1340" y="120" width="260" height="3400" as="geometry" />
        </mxCell>
        <mxCell id="L7" value="ประธานกรรมการ ป.ป.ท." style="swimlane;html=1;horizontal=1;startSize=60;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1;swimlaneFillColor=#ffffff;" vertex="1" parent="p2-1">
          <mxGeometry x="1600" y="120" width="260" height="3400" as="geometry" />
        </mxCell>
        <mxCell id="L8" value="คณะอนุกรรมการกลั่นกรอง&#10;เรื่องไต่สวนข้อเท็จจริง (คณะที่ 1-8)" style="swimlane;html=1;horizontal=1;startSize=60;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1;swimlaneFillColor=#ffffff;" vertex="1" parent="p2-1">
          <mxGeometry x="1860" y="120" width="260" height="3400" as="geometry" />
        </mxCell>
        <mxCell id="L9" value="ฝ่ายเลขานุการบอร์ด (กบค.)&#10;กลุ่มงานกิจการฯ + กลุ่มงานคำวินิจฉัยและมติฯ" style="swimlane;html=1;horizontal=1;startSize=60;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1;swimlaneFillColor=#ffffff;" vertex="1" parent="p2-1">
          <mxGeometry x="2120" y="120" width="260" height="3400" as="geometry" />
        </mxCell>
        <mxCell id="L10" value="คณะกรรมการ ป.ป.ท.&#10;(บอร์ดใหญ่ 7 ท่าน)" style="swimlane;html=1;horizontal=1;startSize=60;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1;swimlaneFillColor=#ffffff;" vertex="1" parent="p2-1">
          <mxGeometry x="2380" y="120" width="260" height="3400" as="geometry" />
        </mxCell>
        <mxCell id="L11" value="กลุ่มงานบริหารติดตามคดี&#10;(กบต.)" style="swimlane;html=1;horizontal=1;startSize=60;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1;swimlaneFillColor=#ffffff;" vertex="1" parent="p2-1">
          <mxGeometry x="2640" y="120" width="260" height="3400" as="geometry" />
        </mxCell>
        <mxCell id="L12" value="ระบบ E-CMIS&#10;(Automation / Integration)" style="swimlane;html=1;horizontal=1;startSize=60;fillColor=#e8f5e9;strokeColor=#82b366;fontSize=12;fontStyle=1;swimlaneFillColor=#ffffff;" vertex="1" parent="p2-1">
          <mxGeometry x="2900" y="120" width="260" height="3400" as="geometry" />
        </mxCell>
        <mxCell id="L13" value="หน่วยงานภายนอก&#10;(ป.ป.ช. / อัยการ / ต้นสังกัด)" style="swimlane;html=1;horizontal=1;startSize=60;fillColor=#fff4e6;strokeColor=#d79b00;fontSize=12;fontStyle=1;swimlaneFillColor=#ffffff;" vertex="1" parent="p2-1">
          <mxGeometry x="3160" y="120" width="260" height="3400" as="geometry" />
        </mxCell>

        <mxCell id="n_start" value="&lt;b&gt;ต้นทาง&lt;/b&gt;&lt;br&gt;รับเรื่องจากกิจกรรมที่ 5" style="ellipse;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;strokeWidth=2;" vertex="1" parent="L1">
          <mxGeometry x="30" y="80" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="sys1" value="&lt;b&gt;[Integration ← กจ.5]&lt;/b&gt;&lt;br&gt;Auto Sync + Auto-fill: ผู้กล่าวหา / ผู้ถูกกล่าวหา / พฤติการณ์ / ฐานความผิด / เลข PCMS จากฐานข้อมูลกลาง E-CMIS (ไม่คีย์ซ้ำ)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="L12">
          <mxGeometry x="15" y="80" width="230" height="95" as="geometry" />
        </mxCell>

        <mxCell id="t1" value="&lt;b&gt;[นอกขอบเขต กจ.7]&lt;/b&gt; จัดทำ / ยืนยันรายงาน 213 หรือ 644 แนบไฟล์ดิจิทัล (Word/PDF) และเสนอเข้าระบบ E-CMIS" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ececec;strokeColor=#999999;dashed=1;fontColor=#666666;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="L1">
          <mxGeometry x="20" y="190" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="sys2" value="&lt;b&gt;[Validation Rules]&lt;/b&gt;&lt;br&gt;ตรวจความครบถ้วนเอกสาร + สถานะคดีปัจจุบัน + วันครบอายุความ — บล็อกการส่งหากไม่ผ่านเกณฑ์" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="L12">
          <mxGeometry x="15" y="190" width="230" height="90" as="geometry" />
        </mxCell>

        <mxCell id="t2" value="&lt;b&gt;[นอกขอบเขต กจ.7]&lt;/b&gt; หัวหน้ากลุ่มงาน (นสส./ชพ.) ตรวจทานรายงานและเสนอความเห็นผ่าน e-Approval" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ececec;strokeColor=#999999;dashed=1;fontColor=#666666;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="L2">
          <mxGeometry x="20" y="300" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="sys3" value="&lt;b&gt;[SLA Timer + Notification]&lt;/b&gt;&lt;br&gt;เริ่มจับเวลารายขั้น แจ้งเตือนล่วงหน้า 3 วัน และ 1 วัน (Admin ตั้งค่าจำนวนวันได้ — TOR 7.2.1.3)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="L12">
          <mxGeometry x="15" y="300" width="230" height="90" as="geometry" />
        </mxCell>

        <mxCell id="t3" value="&lt;b&gt;[นอกขอบเขต กจ.7]&lt;/b&gt; ผอ.กอง / ผอ.สนง. ป.ป.ท. เขต พิจารณากลั่นกรองและเห็นชอบตามลำดับชั้น (ลงนามดิจิทัล)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ececec;strokeColor=#999999;dashed=1;fontColor=#666666;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="L2">
          <mxGeometry x="20" y="410" width="220" height="90" as="geometry" />
        </mxCell>

        <mxCell id="t4" value="&lt;b&gt;[นอกขอบเขต กจ.7]&lt;/b&gt; ผู้ช่วยเลขาธิการฯ → รองเลขาธิการฯ พิจารณาแบบ Sequential Approval เสนอเลขาธิการฯ" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ececec;strokeColor=#999999;dashed=1;fontColor=#666666;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="L3">
          <mxGeometry x="20" y="520" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="sys4" value="&lt;b&gt;[Return / Recall Engine — TOR 7.2.1.2]&lt;/b&gt;&lt;br&gt;Return: ตีกลับพร้อม Reason Code บังคับกรอก | Recall: ดึงเรื่องกลับได้ตราบใดที่ชั้นถัดไปยังไม่ลงนาม (รายละเอียดที่ Page 3)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="L12">
          <mxGeometry x="15" y="520" width="230" height="100" as="geometry" />
        </mxCell>

        <mxCell id="t5" value="★ &lt;b&gt;S1 — จุดเริ่มต้นกิจกรรมที่ 7&lt;/b&gt;&lt;br&gt;เลขาธิการฯ พิจารณาและ&lt;b&gt;ลงนามดิจิทัล&lt;/b&gt; บนรายงาน 213 / 644&lt;br&gt;⏱ SLA 213: รอลงนาม 5 วัน / ลงนามเสร็จ 3 วัน — 644: เสนอ 15 วัน / ลงนาม 15 วัน" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=3;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="L3">
          <mxGeometry x="20" y="630" width="220" height="100" as="geometry" />
        </mxCell>

        <mxCell id="g1" value="&lt;b&gt;G1&lt;/b&gt; เป็นเรื่องยุ่งยากซับซ้อน หรือความเห็นในสายบังคับบัญชาไม่ตรงกัน?" style="rhombus;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="L3">
          <mxGeometry x="30" y="750" width="200" height="110" as="geometry" />
        </mxCell>

        <mxCell id="t6" value="&lt;b&gt;T6&lt;/b&gt; คณะอนุกรรมการสนับสนุนเลขาธิการฯ กลั่นกรองข้อกฎหมาย / ประเด็นซับซ้อน และเสนอความเห็นกลับ" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="L4">
          <mxGeometry x="20" y="880" width="220" height="90" as="geometry" />
        </mxCell>

        <mxCell id="g2" value="&lt;b&gt;G2&lt;/b&gt; ความเห็นสอดคล้องกับผู้รับผิดชอบสำนวน?" style="rhombus;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="L4">
          <mxGeometry x="30" y="990" width="200" height="110" as="geometry" />
        </mxCell>

        <mxCell id="g3" value="&lt;b&gt;G3&lt;/b&gt; มีใบด่วนขอบรรจุวาระเร่งด่วน (ใกล้ขาดอายุความ)?" style="rhombus;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="L3">
          <mxGeometry x="30" y="1120" width="200" height="110" as="geometry" />
        </mxCell>

        <mxCell id="t7" value="&lt;b&gt;T7&lt;/b&gt; ผอ.กบค. ลงนามรับรองเหตุผลความจำเป็นเร่งด่วนบนใบด่วนในระบบ&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;จุดควบคุม: ไม่มีลายเซ็นนี้ = Bypass ดำเนินการไม่ได้&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="L5">
          <mxGeometry x="20" y="1250" width="220" height="100" as="geometry" />
        </mxCell>

        <mxCell id="t8" value="&lt;b&gt;T8&lt;/b&gt; หน้าห้องประธานฯ ลงรับสำนวนอิเล็กทรอนิกส์ คัดกรอง และนำเสนอประธานกรรมการ ป.ป.ท." style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="L6">
          <mxGeometry x="20" y="1370" width="220" height="90" as="geometry" />
        </mxCell>

        <mxCell id="g4" value="&lt;b&gt;G4&lt;/b&gt; ประธานกรรมการ ป.ป.ท. สั่งการอย่างไร?" style="rhombus;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="L7">
          <mxGeometry x="30" y="1480" width="200" height="110" as="geometry" />
        </mxCell>

        <mxCell id="t10" value="&lt;b&gt;T9&lt;/b&gt; กบค. กระจายสำนวนอิเล็กทรอนิกส์เข้าคณะอนุกลั่นกรองฯ 1-8&lt;br&gt;&lt;b&gt;[Auto Routing]&lt;/b&gt; Round-Robin ไม่เกิน 40 เรื่อง/คณะ + Manual Assign ได้" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="L5">
          <mxGeometry x="20" y="1610" width="220" height="100" as="geometry" />
        </mxCell>

        <mxCell id="t11" value="&lt;b&gt;T10&lt;/b&gt; คณะอนุกลั่นกรองฯ ประชุมพิจารณา บันทึก &quot;มติ + ความเห็น/ข้อสังเกต&quot; เข้าระบบ ⏱ SLA 15 วัน" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="L8">
          <mxGeometry x="20" y="1720" width="220" height="90" as="geometry" />
        </mxCell>

        <mxCell id="t9" value="&lt;b&gt;T11&lt;/b&gt; ประธานกรรมการ ป.ป.ท. ลงนามสั่งบรรจุวาระการประชุม (Digital Signature)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="L7">
          <mxGeometry x="20" y="1830" width="220" height="90" as="geometry" />
        </mxCell>

        <mxCell id="t12" value="&lt;b&gt;T12&lt;/b&gt; ฝ่ายเลขานุการบอร์ด จัดระเบียบวาระ + หนังสือเชิญประชุม (Mail-Merge) และกำหนด &quot;ชั้นความลับ&quot; ตาม ม.19/1&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;ม.13 ต้องแจ้งนัดเป็นหนังสือล่วงหน้าไม่น้อยกว่า 3 วัน เว้นแต่เร่งด่วน ประธานฯ นัดเป็นอย่างอื่นได้&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="L9">
          <mxGeometry x="20" y="1940" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="sys5" value="&lt;b&gt;[Auto]&lt;/b&gt; De-duplication Check (เลขบัตร ปชช. + พฤติการณ์ → Warning Badge รวม/แยกสำนวน) | Mail-Merge Template Generator | แจ้งเตือนกรรมการอ่านวาระล่วงหน้า 3 วัน" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="L12">
          <mxGeometry x="15" y="1940" width="230" height="110" as="geometry" />
        </mxCell>

        <mxCell id="t13" value="&lt;b&gt;T13&lt;/b&gt; คณะกรรมการ ป.ป.ท. ประชุมพิจารณาตามระเบียบวาระ&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;ม.12 องค์ประชุมไม่น้อยกว่ากึ่งหนึ่งของกรรมการเท่าที่มีอยู่ | ม.15 มติ = เสียงข้างมากของกรรมการทั้งหมดเท่าที่มีอยู่ ประธานชี้ขาดเมื่อเท่ากัน | ม.20 กันผู้มีส่วนได้เสียออกต้องมีมติบอร์ด&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="L10">
          <mxGeometry x="20" y="2060" width="220" height="110" as="geometry" />
        </mxCell>

        <mxCell id="t14" value="&lt;b&gt;T14&lt;/b&gt; กลุ่มงานคำวินิจฉัยและมติฯ บันทึกรายละเอียดมติ Real-time + ล็อกไฟล์ PDF + Auto-compile รายงานการประชุมรวมทุกเรื่องในวันเดียวกัน&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;ม.16 ต้องมีรายงานการประชุมเป็นหนังสือ และบันทึกความเห็นแย้งพร้อมเหตุผลของกรรมการฝ่ายข้างน้อย&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="L9">
          <mxGeometry x="20" y="2190" width="220" height="110" as="geometry" />
        </mxCell>

        <mxCell id="g5" value="&lt;b&gt;G5&lt;/b&gt; ประเภทผลมติของคณะกรรมการ ป.ป.ท.?" style="rhombus;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="L10">
          <mxGeometry x="30" y="2320" width="200" height="110" as="geometry" />
        </mxCell>

        <mxCell id="a1" value="&lt;b&gt;มติ 1: รับไว้ไต่สวน&lt;/b&gt;&lt;br&gt;จัดทำและบันทึกมติเข้าระบบ (ล็อก PDF) + ออกคำสั่งแต่งตั้งผู้ไต่สวน — &lt;b&gt;ม.24 ว.1 องค์คณะพนักงาน ป.ป.ท. ไม่น้อยกว่า 2 คน (เลขาธิการฯ แต่งตั้ง)&lt;/b&gt; / &lt;b&gt;ม.24 ว.3 คณะอนุกรรมการไต่สวน เฉพาะเรื่องสำคัญ-ซับซ้อน ตามข้อเสนอแนะของเลขาธิการฯ (บอร์ดแต่งตั้ง)&lt;/b&gt; จาก Template ปปท. ๕-๐๑ / ๕-๐๔ และลงนามดิจิทัล" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="L9">
          <mxGeometry x="20" y="2460" width="220" height="115" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="&lt;b&gt;[Integration → กจ.5]&lt;/b&gt;&lt;br&gt;ยิงมติ + คำสั่งกลับอัตโนมัติ เปลี่ยนสถานะคดีเป็น &quot;อยู่ระหว่างไต่สวน&quot;&lt;br&gt;⏱ ออกคำสั่ง 5 วันทำการ / ส่งคืนหน่วยงาน 3 วันทำการ" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="L12">
          <mxGeometry x="15" y="2460" width="230" height="115" as="geometry" />
        </mxCell>

        <mxCell id="b1" value="&lt;b&gt;มติ 2: ไม่รับไว้ไต่สวน / ยุติเรื่อง&lt;/b&gt;&lt;br&gt;จัดทำและบันทึกมติเข้าระบบ E-CMIS (ล็อกไฟล์ PDF)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="L9">
          <mxGeometry x="20" y="2600" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="บันทึกรับมติในระบบ และแจ้งผลการพิจารณาไปยังผู้ถูกกล่าวหา&lt;br&gt;⏱ &lt;b&gt;ม.32: ไม่ช้ากว่า 15 วันนับแต่วันที่บอร์ดมีมติ&lt;/b&gt; (เตือน 3 วัน และ 1 วัน)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="L1">
          <mxGeometry x="20" y="2600" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b3" value="&lt;b&gt;[Integration → กจ.5]&lt;/b&gt;&lt;br&gt;อัปเดตสถานะเป็น Closed Case อัตโนมัติ" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="L12">
          <mxGeometry x="15" y="2600" width="230" height="90" as="geometry" />
        </mxCell>

        <mxCell id="c1" value="&lt;b&gt;มติ 3: ส่งเรื่องให้ ป.ป.ช.&lt;/b&gt; (อยู่นอกอำนาจ ป.ป.ท.)&lt;br&gt;จัดทำมติ + หนังสือนำส่งสำนวนจาก Template แล้วส่งคืนผู้รับผิดชอบสำนวน" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="L9">
          <mxGeometry x="20" y="2720" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="พิมพ์และลงนามหนังสือนำส่ง ส่งมอบสำนวนให้ ป.ป.ช. ด้วยตนเอง&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;ระบบบังคับอัปโหลดไฟล์สแกนฉบับลงนามกลับ (TOR 7.2.1.5)&lt;/font&gt; ⏱ SLA 30 วัน" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="L1">
          <mxGeometry x="20" y="2720" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;สำนักงาน ป.ป.ช.&lt;/b&gt;&lt;br&gt;รับเรื่องและดำเนินการตามอำนาจหน้าที่ที่กฎหมายกำหนด" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="L13">
          <mxGeometry x="20" y="2720" width="220" height="90" as="geometry" />
        </mxCell>

        <mxCell id="d1" value="&lt;b&gt;มติ 4: ชี้มูลความผิด (อาญา และ/หรือ วินัย)&lt;/b&gt;&lt;br&gt;กลุ่มงานกิจการคณะกรรมการ จัดทำรายงานวินิจฉัยชี้มูล (ปปท. ๗-๐๒) จาก Mail-Merge เสนอคณะกรรมการลงนาม" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="L9">
          <mxGeometry x="20" y="2860" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="ประธานฯ / คณะกรรมการ ป.ป.ท. ลงนามในรายงานวินิจฉัยชี้มูล&lt;br&gt;&lt;b&gt;Multi-signer Digital Signature&lt;/b&gt; (ลงนามหลายคนในเอกสารฉบับเดียว)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="L10">
          <mxGeometry x="20" y="2860" width="220" height="100" as="geometry" />
        </mxCell>

        <mxCell id="d3" value="&lt;b&gt;สายอาญา&lt;/b&gt; จัดทำหนังสือนำส่งสำนวนถึงพนักงานอัยการ พิมพ์-ลงนามสด และอัปโหลดไฟล์สแกนฉบับลงนามกลับเข้าระบบ ⏱ SLA 30 วัน" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="L1">
          <mxGeometry x="20" y="2990" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="d4" value="&lt;b&gt;พนักงานอัยการ (ม.44)&lt;/b&gt; ดำเนินคดีอาญาโดยถือว่าสำนวนไต่สวนของบอร์ดเป็นสำนวนการสอบสวนตาม ป.วิ.อาญา&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;เห็นควรสั่งไม่ฟ้อง → ดู Page 3 EX-07 (ม.44 ว.3)&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="L13">
          <mxGeometry x="20" y="2990" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="d5" value="&lt;b&gt;[Integration → กจ.8 / กจ.10]&lt;/b&gt;&lt;br&gt;Auto-pull มติชี้มูลอาญาเข้า Work Inbox + เริ่มนับ SLA 30 วัน&lt;br&gt;(&quot;วันที่ส่งอัยการ&quot; เจ้าของสำนวนคีย์เอง)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="L12">
          <mxGeometry x="15" y="2990" width="230" height="115" as="geometry" />
        </mxCell>

        <mxCell id="d6" value="&lt;b&gt;สายวินัย (ม.38)&lt;/b&gt; จัดทำหนังสือแจ้งลงโทษทางวินัยจาก Template ปปท. ๘-๐๕ / ๘-๐๖ — &lt;b&gt;ผู้ลงนามแจ้งคือประธานกรรมการ ป.ป.ท.&lt;/b&gt; และต้องแนบมติ + รายงานการไต่สวนที่บอร์ดเห็นชอบแล้ว" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="L9">
          <mxGeometry x="20" y="3120" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="d7" value="กบต. ส่งหนังสือลงโทษทางวินัยถึงหน่วยงานต้นสังกัดและติดตามผล&lt;br&gt;⏱ &lt;b&gt;ม.38 ว.3: ต้นสังกัดพิจารณาโทษภายใน 60 วันนับแต่ได้รับแจ้ง โดยไม่ต้องตั้งคณะกรรมการสอบสวนวินัยอีก&lt;/b&gt; / รายงานกลับ 30 วัน / เตือนเมื่อเกิน 90 วัน" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="L11">
          <mxGeometry x="20" y="3120" width="220" height="115" as="geometry" />
        </mxCell>
        <mxCell id="d8" value="&lt;b&gt;หน่วยงานต้นสังกัด&lt;/b&gt;&lt;br&gt;ลงโทษทางวินัยตามฐานความผิดที่บอร์ดมีมติ และรายงานผลกลับ&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;เพิกเฉย → ม.41 / ไม่มีอำนาจ → ม.42 รายงานนายกรัฐมนตรี (ดู Page 3 EX-06)&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="L13">
          <mxGeometry x="20" y="3120" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="d9" value="&lt;b&gt;[Integration → กจ.8]&lt;/b&gt;&lt;br&gt;Auto-pull มติวินัยไม่ต้องคีย์ซ้ำลง Excel + Executive Dashboard ติดตามคดีล่าช้าแบบ Real-time" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="L12">
          <mxGeometry x="15" y="3120" width="230" height="110" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="&lt;b&gt;มติ 5: มติอื่น ๆ&lt;/b&gt; (ไต่สวนเพิ่มเติม / ส่งกองกฎหมาย / เลื่อนการพิจารณา / ถอนเรื่อง / อนุมัติรวม-แยกสำนวน)&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;ม.24 ว.4 บังคับให้ระบุ &quot;เหตุผล&quot; ของการสั่งไต่สวนเพิ่มเติม/ไต่สวนเองใหม่ + ระบบบังคับระบุผู้รับผิดชอบและกำหนดส่งกลับ&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="L9">
          <mxGeometry x="20" y="3250" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="ดำเนินการตามคำสั่งที่ประชุม แล้วรายงานความคืบหน้าเพื่อเสนอบรรจุวาระอีกครั้ง&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;ถอน/เลื่อนวาระต้องได้เลขวาระใหม่เสมอ (ดู Page 3)&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="L1">
          <mxGeometry x="20" y="3250" width="220" height="110" as="geometry" />
        </mxCell>

        <mxCell id="end1" value="&lt;b&gt;สิ้นสุด&lt;/b&gt;&lt;br&gt;กระบวนงานกิจกรรมที่ 7" style="ellipse;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;strokeWidth=3;" vertex="1" parent="L10">
          <mxGeometry x="40" y="3290" width="180" height="70" as="geometry" />
        </mxCell>

        <mxCell id="p2x1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="p2-1" source="n_start" target="t1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2x2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=open;" edge="1" parent="p2-1" source="sys1" target="t1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2x3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=open;" edge="1" parent="p2-1" source="sys2" target="t1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2x4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="p2-1" source="t1" target="t2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2x5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=open;" edge="1" parent="p2-1" source="sys3" target="t2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2x6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="p2-1" source="t2" target="t3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2x7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="p2-1" source="t3" target="t4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2x8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=open;" edge="1" parent="p2-1" source="sys4" target="t4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2x9" value="ส่งคืนสายงานต้นทาง (ออกจาก กจ.7 → กจ.5)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#b85450;fontColor=#b85450;fontSize=10;" edge="1" parent="p2-1" source="t3" target="t1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2x10" value="ส่งคืนภายในกอง/เขต (นอกขอบเขต กจ.7)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#b85450;fontColor=#b85450;fontSize=10;" edge="1" parent="p2-1" source="t4" target="t2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2x11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="p2-1" source="t4" target="t5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2x12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="p2-1" source="t5" target="g1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2x13" value="ใช่ (ซับซ้อน)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;" edge="1" parent="p2-1" source="g1" target="t6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2x14" value="ไม่ซับซ้อน" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;" edge="1" parent="p2-1" source="g1" target="g3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2x15" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="p2-1" source="t6" target="g2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2x16" value="สอดคล้อง → Bypass ข้ามอนุกลั่นกรองฯ 1-8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#9673a6;fontColor=#9673a6;strokeWidth=2;" edge="1" parent="p2-1" source="g2" target="t8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2x17" value="ไม่สอดคล้อง (เข้าเส้นทางปกติ)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;" edge="1" parent="p2-1" source="g2" target="g3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2x18" value="ใช่ (มีใบด่วน)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;" edge="1" parent="p2-1" source="g3" target="t7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2x19" value="ปกติ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;" edge="1" parent="p2-1" source="g3" target="t8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2x20" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="p2-1" source="t7" target="t8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2x21" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="p2-1" source="t8" target="g4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2x22" value="ส่งกลั่นกรองปกติ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;" edge="1" parent="p2-1" source="g4" target="t10"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2x23" value="สั่งบรรจุวาระด่วน / Bypass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#9673a6;fontColor=#9673a6;strokeWidth=2;" edge="1" parent="p2-1" source="g4" target="t9"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2x24" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="p2-1" source="t10" target="t11"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2x25" value="เสนอมติอนุกลั่นกรองฯ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;" edge="1" parent="p2-1" source="t11" target="t9"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2x26" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="p2-1" source="t9" target="t12"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2x27" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=open;" edge="1" parent="p2-1" source="sys5" target="t12"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2x28" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="p2-1" source="t12" target="t13"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2x29" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="p2-1" source="t13" target="t14"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2x30" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="p2-1" source="t14" target="g5"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="p2x31" value="1. รับไว้ไต่สวน" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;" edge="1" parent="p2-1" source="g5" target="a1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2x32" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="p2-1" source="a1" target="a2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2x33" value="สำนวนเข้าสู่ชั้นไต่สวนวินิจฉัยชี้มูล (7.2)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;dashed=1;" edge="1" parent="p2-1" source="a2" target="end1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="p2x34" value="2. ไม่รับไว้ไต่สวน / ยุติเรื่อง" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;" edge="1" parent="p2-1" source="g5" target="b1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2x35" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="p2-1" source="b1" target="b2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2x36" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="p2-1" source="b2" target="b3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2x37" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;" edge="1" parent="p2-1" source="b3" target="end1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="p2x38" value="3. ส่งเรื่องให้ ป.ป.ช." style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;" edge="1" parent="p2-1" source="g5" target="c1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2x39" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="p2-1" source="c1" target="c2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2x40" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="p2-1" source="c2" target="c3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2x41" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;" edge="1" parent="p2-1" source="c3" target="end1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="p2x42" value="4. ชี้มูลความผิด" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeWidth=2;" edge="1" parent="p2-1" source="g5" target="d1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2x43" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="p2-1" source="d1" target="d2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2x44" value="สายอาญา" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;" edge="1" parent="p2-1" source="d2" target="d3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2x45" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="p2-1" source="d3" target="d4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2x46" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=open;" edge="1" parent="p2-1" source="d3" target="d5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2x47" value="สายวินัย" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;" edge="1" parent="p2-1" source="d2" target="d6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2x48" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="p2-1" source="d6" target="d7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2x49" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="p2-1" source="d7" target="d8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2x50" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=open;" edge="1" parent="p2-1" source="d7" target="d9"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2x51" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;" edge="1" parent="p2-1" source="d9" target="end1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="p2x52" value="5. มติอื่น ๆ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;" edge="1" parent="p2-1" source="g5" target="e1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2x53" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="p2-1" source="e1" target="e2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2x54" value="เสนอบรรจุวาระการประชุมอีกครั้ง (ได้เลขวาระใหม่)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;dashed=1;strokeColor=#9673a6;fontColor=#9673a6;strokeWidth=2;" edge="1" parent="p2-1" source="e2" target="t12"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="TO-BE P3 Exception และ Alternative Flows" id="tobe_p3_exception">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2900" pageHeight="1900" math="0" shadow="0">
      <root>
        <mxCell id="p3-0" />
        <mxCell id="p3-1" parent="p3-0" />

        <mxCell id="p3t" value="&lt;b&gt;Page 3 — Exception และ Alternative Flows กิจกรรมที่ 7&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;กระบวนงานทางเลือกและกรณีข้อยกเว้นที่แตกออกจาก Core Workflow (Page 2) — ทุก Flow วนกลับเข้าสู่ Core Workflow ที่จุดที่ระบุ&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fillColor=#1f3864;fontColor=#ffffff;rounded=1;" vertex="1" parent="p3-1">
          <mxGeometry x="40" y="20" width="2710" height="70" as="geometry" />
        </mxCell>

        <mxCell id="s1" value="&lt;b&gt;EX-01 : การตีกลับ (Return) และการดึงเรื่องกลับ (Recall) — TOR 7.2.1.2 / 7.2.2.4 / 7.2.3.5&lt;/b&gt;" style="swimlane;html=1;startSize=40;fillColor=#fce4ec;strokeColor=#b85450;fontSize=12;" vertex="1" parent="p3-1">
          <mxGeometry x="40" y="120" width="640" height="500" as="geometry" />
        </mxCell>
        <mxCell id="s1a" value="&lt;b&gt;Trigger:&lt;/b&gt; ผู้พิจารณาชั้นใดชั้นหนึ่ง (T2–T5 หรือประธานฯ) เห็นว่าสำนวนไม่สมบูรณ์ / มีความเห็นแย้ง" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="s1">
          <mxGeometry x="30" y="50" width="580" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s1b" value="&lt;b&gt;X1.1&lt;/b&gt; ระบบบังคับกรอก &quot;เหตุผลการตีกลับ&quot; แบบ Reason Code (ตัวเลือกสำเร็จรูป) + ช่องพิมพ์อิสระ + แนบไฟล์ประกอบได้" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="s1">
          <mxGeometry x="30" y="140" width="580" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s1c" value="&lt;b&gt;X1.2 [Decision]&lt;/b&gt; เป็น Return (ผู้บริหารส่งคืนย้อนขั้น) หรือ Recall (เจ้าของเรื่องดึงกลับก่อนชั้นถัดไปลงนาม)?" style="rhombus;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="s1">
          <mxGeometry x="150" y="228" width="340" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s1d" value="&lt;b&gt;X1.3&lt;/b&gt; เจ้าของสำนวนแก้ไขในระบบ → เสนอกลับ &quot;ตรงไปยังผู้ที่กดตีกลับ&quot; (Fast Re-route) ไม่ต้องไล่ทุกชั้นใหม่&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;ระบบ Pause SLA ระหว่างแก้ไข และ Resume เมื่อส่งกลับ&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="s1">
          <mxGeometry x="30" y="332" width="580" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s1e" value="&lt;b&gt;กลับสู่ Core Workflow ที่ T2–T5&lt;/b&gt; | &lt;b&gt;[Integration → กจ.5]&lt;/b&gt; หากแก้ไขกระทบเนื้อหาการไต่สวน ระบบแจ้ง กจ.5 เพื่อปรับรายงานต้นทาง" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="s1">
          <mxGeometry x="30" y="422" width="580" height="65" as="geometry" />
        </mxCell>
        <mxCell id="s1e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="p3-1" source="s1a" target="s1b"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s1e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="p3-1" source="s1b" target="s1c"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s1e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="p3-1" source="s1c" target="s1d"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s1e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="p3-1" source="s1d" target="s1e"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="s2" value="&lt;b&gt;EX-02 : มติให้ไต่สวนเพิ่มเติม และการขอขยายระยะเวลาไต่สวน&lt;/b&gt;" style="swimlane;html=1;startSize=40;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="p3-1">
          <mxGeometry x="730" y="120" width="640" height="500" as="geometry" />
        </mxCell>
        <mxCell id="s2a" value="&lt;b&gt;Trigger:&lt;/b&gt; บอร์ดมีมติ &quot;ให้ไต่สวนเพิ่มเติม&quot; (แตกจาก G5 มติ 5) หรือเจ้าของสำนวนยื่นคำขอขยายเวลาผ่าน กจ.5" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="s2">
          <mxGeometry x="30" y="50" width="580" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s2b" value="&lt;b&gt;X2.1&lt;/b&gt; ระบบเดินนาฬิกา 2 ชั้นซ้อนกัน:&lt;br&gt;• &lt;b&gt;กรอบกฎหมาย (ม.23):&lt;/b&gt; เริ่มไต่สวนภายใน 60 วัน และไต่สวน-วินิจฉัยให้เสร็จภายใน 2 ปี ขยายได้เท่าที่จำเป็นแต่ไม่เกิน 3 ปี (ต่างประเทศไม่เกิน 5 ปี) — &lt;b&gt;ผู้อนุมัติขยายคือคณะกรรมการ ป.ป.ท.&lt;/b&gt;&lt;br&gt;• &lt;b&gt;กรอบภายใน:&lt;/b&gt; ไต่สวนเพิ่มเติม 2 เดือน (เบื้องต้น) / 4 เดือน (ชี้มูล) &lt;font color=&quot;#b85450&quot;&gt;รอยืนยัน&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="s2">
          <mxGeometry x="30" y="140" width="580" height="88" as="geometry" />
        </mxCell>
        <mxCell id="s2c" value="&lt;b&gt;X2.2 [Decision]&lt;/b&gt; ดำเนินการเสร็จภายในกรอบเวลาหรือไม่?" style="rhombus;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="s2">
          <mxGeometry x="150" y="228" width="340" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s2d" value="&lt;b&gt;X2.3 (ไม่ทัน)&lt;/b&gt; ยื่นคำขอขยายระยะเวลาเข้าโมดูล 7.3 (มติเรื่องทั่วไป) เสนอตามลำดับชั้น → เลขาธิการฯ → ประธานฯ สั่งบรรจุวาระ → บอร์ดอนุมัติ-ไม่อนุมัติ" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="s2">
          <mxGeometry x="30" y="332" width="580" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s2e" value="&lt;b&gt;X2.4 (ทัน)&lt;/b&gt; รายงานผลไต่สวนเพิ่มเติม → &lt;b&gt;กลับสู่ Core Workflow ที่ T12&lt;/b&gt; (จัดระเบียบวาระ) โดยได้เลขวาระใหม่" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="s2">
          <mxGeometry x="30" y="422" width="580" height="65" as="geometry" />
        </mxCell>
        <mxCell id="s2e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="p3-1" source="s2a" target="s2b"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s2e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="p3-1" source="s2b" target="s2c"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s2e3" value="ไม่ทัน" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;" edge="1" parent="p3-1" source="s2c" target="s2d"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s2e4" value="เสร็จทันกำหนด" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;exitX=1;exitY=0.5;" edge="1" parent="p3-1" source="s2c" target="s2e"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="s3" value="&lt;b&gt;EX-03 : การเลื่อน / ถอนวาระ และการขอแก้ไข-ทบทวนมติ&lt;/b&gt;" style="swimlane;html=1;startSize=40;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="p3-1">
          <mxGeometry x="1420" y="120" width="640" height="500" as="geometry" />
        </mxCell>
        <mxCell id="s3a" value="&lt;b&gt;Trigger:&lt;/b&gt; บอร์ดมีมติเลื่อน / ถอนเรื่อง | &lt;b&gt;ม.40&lt;/b&gt; ผู้บังคับบัญชาขอทบทวนมติภายใน &lt;b&gt;30 วัน&lt;/b&gt; นับแต่วันได้รับแจ้ง เฉพาะเมื่อมีพยานหลักฐานใหม่ | &lt;b&gt;ม.43&lt;/b&gt; ก.พ.ค. วินิจฉัยว่าอุทธรณ์ฟังขึ้น → ส่งคำวินิจฉัยให้บอร์ดทบทวน" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="s3">
          <mxGeometry x="30" y="50" width="580" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s3b" value="&lt;b&gt;X3.1 [Decision]&lt;/b&gt; เป็นการเลื่อน/ถอนวาระ หรือการแก้ไข-ทบทวนมติที่ลงแล้ว?" style="rhombus;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="s3">
          <mxGeometry x="150" y="138" width="340" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s3c" value="&lt;b&gt;X3.2 (เลื่อน/ถอน)&lt;/b&gt; ระบบปิดเลขวาระเดิม และบังคับออก &quot;เลขวาระใหม่&quot; ทุกครั้งที่กลับเข้าประชุม + นับจำนวนครั้งที่เลื่อน และ Escalate ผู้บริหารเมื่อเกินเพดาน" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="s3">
          <mxGeometry x="30" y="248" width="580" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s3d" value="&lt;b&gt;X3.3 (แก้ไข/ทบทวน)&lt;/b&gt; ระบบเก็บ &lt;b&gt;Version History&lt;/b&gt; ของมติ: มติเดิมไม่ถูกลบ ผูกคู่กับมติใหม่พร้อมเหตุผลและวันที่ + Audit Log ผู้แก้ไข (สิทธิ์แก้ไขเฉพาะ 7 คน: 6 เจ้าหน้าที่กลุ่มงานกิจการฯ + ผอ.กบค.)&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;ม.40 ว.2: เมื่อบอร์ดมีมติทบทวนเป็นประการใด ต้นสังกัดต้องดำเนินการตามมตินั้น — มติใหม่จึงมีผลแทนมติเดิม&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="s3">
          <mxGeometry x="30" y="342" width="580" height="95" as="geometry" />
        </mxCell>
        <mxCell id="s3e" value="&lt;b&gt;กลับสู่ Core Workflow ที่ T12&lt;/b&gt; (บรรจุวาระอีกครั้ง) และ &lt;b&gt;[Integration → กจ.5 / กจ.8]&lt;/b&gt; แจ้งมติฉบับล่าสุด" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="s3">
          <mxGeometry x="30" y="440" width="580" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s3e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="p3-1" source="s3a" target="s3b"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s3e2" value="เลื่อน / ถอน" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;" edge="1" parent="p3-1" source="s3b" target="s3c"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s3e3" value="แก้ไข / ทบทวนมติ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;exitX=1;exitY=0.5;" edge="1" parent="p3-1" source="s3b" target="s3d"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s3e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="p3-1" source="s3c" target="s3e"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s3e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="p3-1" source="s3d" target="s3e"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="s4" value="&lt;b&gt;EX-04 : องค์ประชุมไม่ครบ และกรรมการมีส่วนได้เสียต้องถอนตัว&lt;/b&gt;" style="swimlane;html=1;startSize=40;fillColor=#fff8e1;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="p3-1">
          <mxGeometry x="40" y="660" width="640" height="500" as="geometry" />
        </mxCell>
        <mxCell id="s4a" value="&lt;b&gt;Trigger:&lt;/b&gt; ก่อนเปิดวาระ ระบบตรวจพบกรรมการที่มีส่วนได้เสียกับสำนวน (จับคู่จากเลขบัตรประชาชน / หน่วยงานที่เกี่ยวข้อง)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="s4">
          <mxGeometry x="30" y="50" width="580" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s4b" value="&lt;b&gt;X4.1 (ม.20)&lt;/b&gt; การกันออกไม่ใช่การถอนตัวเอง — ต้องให้ &lt;b&gt;คณะกรรมการ ป.ป.ท. มีมติ&lt;/b&gt; มิให้ผู้มีส่วนได้เสียเข้าร่วมไต่สวน/พิจารณา/วินิจฉัย ระบบจึงตั้ง Flag &quot;ถูกกันออกโดยมติ&quot; แยกจาก &quot;ผู้เข้าร่วมประชุม&quot; แล้วกันสิทธิ์ลงมติในวาระนั้น&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;กรณีผู้ไต่สวนใช้ ม.30: แจ้งเองโดยเร็ว → บอร์ดวินิจฉัยใน 7 วัน / ผู้ถูกกล่าวหาคัดค้านได้ใน 30 วัน และให้ระงับปฏิบัติหน้าที่ไว้ก่อน&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="s4">
          <mxGeometry x="30" y="140" width="580" height="93" as="geometry" />
        </mxCell>
        <mxCell id="s4c" value="&lt;b&gt;X4.2 [Decision] (ม.12 + ม.10)&lt;/b&gt; องค์ประชุมครบ &quot;ไม่น้อยกว่ากึ่งหนึ่งของกรรมการทั้งหมดเท่าที่มีอยู่&quot; และมีกรรมการเหลืออยู่ไม่ต่ำกว่า 5 คนหรือไม่?" style="rhombus;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="s4">
          <mxGeometry x="150" y="233" width="340" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s4d" value="&lt;b&gt;X4.3 (ไม่ครบ)&lt;/b&gt; ระบบแสดง Warning &quot;มติอาจไม่ชอบด้วยกฎหมาย&quot; และ &lt;b&gt;บล็อกการบันทึกมติ&lt;/b&gt; → เลื่อนวาระไปครั้งถัดไป (เข้า EX-03)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="s4">
          <mxGeometry x="30" y="337" width="580" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s4e" value="&lt;b&gt;X4.4 (ครบ) (ม.15 + ม.16)&lt;/b&gt; ระบบนับมติด้วย &quot;เสียงข้างมากของกรรมการทั้งหมดเท่าที่มีอยู่&quot; (ไม่ใช่เสียงข้างมากของผู้เข้าประชุม) คะแนนเท่ากันประธานในที่ประชุมออกเสียงชี้ขาดอีกหนึ่งเสียง + บังคับบันทึกความเห็นแย้งพร้อมเหตุผลลงรายงานการประชุม → &lt;b&gt;กลับสู่ T14&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="s4">
          <mxGeometry x="30" y="430" width="580" height="68" as="geometry" />
        </mxCell>
        <mxCell id="s4e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="p3-1" source="s4a" target="s4b"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s4e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="p3-1" source="s4b" target="s4c"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s4e3" value="ไม่ครบองค์ประชุม" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;" edge="1" parent="p3-1" source="s4c" target="s4d"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s4e4" value="ครบ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;exitX=1;exitY=0.5;" edge="1" parent="p3-1" source="s4c" target="s4e"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="s5" value="&lt;b&gt;EX-05 : ผู้พิจารณาไม่อยู่ปฏิบัติหน้าที่ และ SLA เกินกำหนด (Escalation)&lt;/b&gt;" style="swimlane;html=1;startSize=40;fillColor=#fff8e1;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="p3-1">
          <mxGeometry x="730" y="660" width="640" height="500" as="geometry" />
        </mxCell>
        <mxCell id="s5a" value="&lt;b&gt;Trigger:&lt;/b&gt; งานค้างที่ผู้พิจารณาเกิน SLA หรือผู้พิจารณาลา / ไปราชการ / ตำแหน่งว่าง" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="s5">
          <mxGeometry x="30" y="50" width="580" height="65" as="geometry" />
        </mxCell>
        <mxCell id="s5b" value="&lt;b&gt;X5.1&lt;/b&gt; ระบบแจ้งเตือนล่วงหน้า 3 วัน และ 1 วัน → เมื่อเลยกำหนดเตือนซ้ำและ &lt;b&gt;Escalate&lt;/b&gt; ขึ้นผู้บังคับบัญชาเหนือขึ้นไป 1 ระดับ" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="s5">
          <mxGeometry x="30" y="132" width="580" height="75" as="geometry" />
        </mxCell>
        <mxCell id="s5c" value="&lt;b&gt;X5.2 [Decision]&lt;/b&gt; มีผู้รักษาราชการแทน / ปฏิบัติราชการแทน ที่ตั้งค่าไว้ใน กจ.14 หรือไม่?" style="rhombus;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="s5">
          <mxGeometry x="150" y="225" width="340" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s5d" value="&lt;b&gt;X5.3 (มี)&lt;/b&gt; Auto Re-assign ไปยังผู้รักษาราชการแทน + ระบบสลับข้อความท้ายลายเซ็นเป็น &quot;ปฏิบัติราชการแทน&quot; / &quot;รักษาราชการแทน&quot; ตามสถานะจริง" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="s5">
          <mxGeometry x="30" y="330" width="580" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s5e" value="&lt;b&gt;X5.4 (ไม่มี)&lt;/b&gt; ผู้บังคับบัญชา / System Admin กด Manual Re-assign พร้อมบันทึกเหตุผลลง Audit Log → &lt;b&gt;กลับสู่ Core Workflow ขั้นเดิม&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="s5">
          <mxGeometry x="30" y="423" width="580" height="67" as="geometry" />
        </mxCell>
        <mxCell id="s5e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="p3-1" source="s5a" target="s5b"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s5e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="p3-1" source="s5b" target="s5c"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s5e3" value="มี" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;" edge="1" parent="p3-1" source="s5c" target="s5d"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s5e4" value="ไม่มี" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;exitX=1;exitY=0.5;" edge="1" parent="p3-1" source="s5c" target="s5e"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="s6" value="&lt;b&gt;EX-06 : หน่วยงานต้นสังกัดเพิกเฉยผลชี้มูลวินัย (ม.41) — เชื่อมกิจกรรมที่ 8&lt;/b&gt;" style="swimlane;html=1;startSize=40;fillColor=#f3e5f5;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="p3-1">
          <mxGeometry x="1420" y="660" width="640" height="500" as="geometry" />
        </mxCell>
        <mxCell id="s6a" value="&lt;b&gt;Trigger [จาก กจ.8]:&lt;/b&gt; ครบ SLA ดำเนินการ 60 วัน / รายงานกลับ 30 วัน แล้วต้นสังกัดยังไม่รายงานผล (เกิน 90 วัน)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="s6">
          <mxGeometry x="30" y="50" width="580" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s6b" value="&lt;b&gt;X6.1&lt;/b&gt; Executive Dashboard ยกคดีขึ้นเป็นสถานะ &quot;ค้างเกินกำหนด&quot; และ กบต. ออกหนังสือติดตามครั้งที่ 2 อัตโนมัติจาก Template" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="s6">
          <mxGeometry x="30" y="140" width="580" height="75" as="geometry" />
        </mxCell>
        <mxCell id="s6c" value="&lt;b&gt;X6.2&lt;/b&gt; กบต. เสนอเรื่องเข้าโมดูล 7.3 (มติเรื่องทั่วไป) ผ่านลำดับชั้น → เลขาธิการฯ → ประธานฯ สั่งบรรจุวาระ" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="s6">
          <mxGeometry x="30" y="233" width="580" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s6d" value="&lt;b&gt;X6.3 [แยก 2 กรณีตามกฎหมาย]&lt;/b&gt;&lt;br&gt;&lt;b&gt;(ก) ม.41 เพิกเฉยโดยไม่มีเหตุอันสมควร&lt;/b&gt; → ถือว่าผู้บังคับบัญชาจงใจปฏิบัติหน้าที่ขัดต่อกฎหมาย = ผิดวินัยร้ายแรง/ทุจริตต่อหน้าที่ → ตั้งเรื่องกล่าวหารายใหม่&lt;br&gt;&lt;b&gt;(ข) ม.42 ต้นสังกัดไม่มีอำนาจตามกฎหมายบริหารงานบุคคล&lt;/b&gt; → บอร์ด &lt;b&gt;รายงานนายกรัฐมนตรี&lt;/b&gt; ให้สั่งลงโทษ/ให้พ้นจากตำแหน่งโดยไม่ต้องสอบสวนอีก" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="s6">
          <mxGeometry x="30" y="321" width="580" height="88" as="geometry" />
        </mxCell>
        <mxCell id="s6e" value="&lt;b&gt;กลับสู่ Core Workflow ที่ T12 → G5 (มติ 3: ส่ง ป.ป.ช.)&lt;/b&gt; และ &lt;b&gt;[Integration → กจ.8]&lt;/b&gt; ปิดรอบติดตามวินัย" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="s6">
          <mxGeometry x="30" y="409" width="580" height="65" as="geometry" />
        </mxCell>
        <mxCell id="s6e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="p3-1" source="s6a" target="s6b"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s6e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="p3-1" source="s6b" target="s6c"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s6e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="p3-1" source="s6c" target="s6d"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s6e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="p3-1" source="s6d" target="s6e"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="s7" value="&lt;b&gt;EX-07 : กรณีอัยการเห็นควรสั่งไม่ฟ้อง — บอร์ดยืนยันให้ฟ้อง (ม.44 ว.3-ว.4)&lt;/b&gt;" style="swimlane;html=1;startSize=40;fillColor=#f3e5f5;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="p3-1">
          <mxGeometry x="40" y="1200" width="640" height="500" as="geometry" />
        </mxCell>
        <mxCell id="s7a" value="&lt;b&gt;Trigger [จาก กจ.10]:&lt;/b&gt; พนักงานอัยการเห็นควรสั่งไม่ฟ้อง / ไม่ยื่นอุทธรณ์-ฎีกา / ถอนฟ้อง-ถอนอุทธรณ์-ถอนฎีกา (ม.44 ว.4 ให้ใช้กฎเดียวกัน — เกิดซ้ำได้ 3 รอบตามชั้นคดี)&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;อีกกรณี: อัยการเห็นว่าสำนวนไม่สมบูรณ์ → แจ้งให้ไต่สวนเพิ่มเติม โดยระบุข้อไม่สมบูรณ์ให้ครบในคราวเดียว (ม.44 ว.2)&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="s7">
          <mxGeometry x="30" y="50" width="580" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s7b" value="&lt;b&gt;X7.1&lt;/b&gt; นิติกรกองกฎหมาย (กกม.) วิเคราะห์และจัดทำบันทึกความเห็นทางกฎหมาย เสนอเข้าวาระบอร์ดผ่านโมดูล 7.3" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="s7">
          <mxGeometry x="30" y="142" width="580" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s7c" value="&lt;b&gt;X7.2 [Decision]&lt;/b&gt; บอร์ดเห็นชอบตามอัยการ หรือมีมติยืนยันให้ฟ้อง? &lt;font color=&quot;#b85450&quot;&gt;(เห็นชอบ-เห็นแย้งบางคน/บางกรรม/บางข้อหาในคดีเดียวกันได้)&lt;/font&gt;" style="rhombus;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="s7">
          <mxGeometry x="150" y="230" width="340" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s7d" value="&lt;b&gt;X7.3 (เห็นชอบ)&lt;/b&gt; ยุติคดีอาญา ปิดสำนวน และ &lt;b&gt;[Integration → กจ.10 / กจ.8]&lt;/b&gt; อัปเดตสถานะคดี" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="s7">
          <mxGeometry x="30" y="335" width="580" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s7e" value="&lt;b&gt;X7.4 (ยืนยันให้ฟ้อง)&lt;/b&gt; กองกฎหมายจัดทำหนังสือแจ้งมติ + นำส่งสำนวนถึง &lt;b&gt;อัยการสูงสุด&lt;/b&gt; เพื่อวินิจฉัย &lt;b&gt;และคำวินิจฉัยของ อสส. ให้เป็นที่สุด (ม.44 ว.3)&lt;/b&gt; + บังคับอัปโหลดไฟล์สแกนฉบับลงนาม&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;กรณีผู้ถูกกล่าวหาอยู่ในอำนาจศาลทหาร ให้ อสส. เป็นอัยการทหาร (ม.45)&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="s7">
          <mxGeometry x="30" y="418" width="580" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s7e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="p3-1" source="s7a" target="s7b"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s7e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="p3-1" source="s7b" target="s7c"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s7e3" value="เห็นชอบ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;" edge="1" parent="p3-1" source="s7c" target="s7d"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s7e4" value="เห็นแย้ง" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;exitX=1;exitY=0.5;" edge="1" parent="p3-1" source="s7c" target="s7e"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="s8" value="&lt;b&gt;EX-08 : คดีปกครอง — มอบอำนาจสู้คดี และการอุทธรณ์ (เชื่อมกิจกรรมที่ 10)&lt;/b&gt;" style="swimlane;html=1;startSize=40;fillColor=#f3e5f5;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="p3-1">
          <mxGeometry x="730" y="1200" width="640" height="500" as="geometry" />
        </mxCell>
        <mxCell id="s8a" value="&lt;b&gt;Trigger [ภายนอก]:&lt;/b&gt; ศาลปกครองออกหมายเรียก (ป.ป.ท. ถูกฟ้อง) หรือมีคำพิพากษาศาลปกครองชั้นต้น" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="s8">
          <mxGeometry x="30" y="50" width="580" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s8b" value="&lt;b&gt;X8.1&lt;/b&gt; กองกฎหมายจัดทำใบมอบอำนาจและร่างคำให้การ เสนอเข้าวาระบอร์ดผ่านโมดูล 7.3 (SLA ผูกกับกำหนดยื่นคำให้การของศาล)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="s8">
          <mxGeometry x="30" y="140" width="580" height="75" as="geometry" />
        </mxCell>
        <mxCell id="s8c" value="&lt;b&gt;X8.2&lt;/b&gt; บอร์ดมีมติมอบอำนาจสู้คดี → &lt;b&gt;ประธานกรรมการ ป.ป.ท. ลงนามใบมอบอำนาจ&lt;/b&gt; (Digital Signature)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="s8">
          <mxGeometry x="30" y="233" width="580" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s8d" value="&lt;b&gt;X8.3 [Decision]&lt;/b&gt; หลังคำพิพากษา บอร์ดมีมติอุทธรณ์หรือไม่อุทธรณ์?" style="rhombus;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="s8">
          <mxGeometry x="150" y="318" width="340" height="85" as="geometry" />
        </mxCell>
        <mxCell id="s8e" value="&lt;b&gt;อุทธรณ์:&lt;/b&gt; ผอ.กองกฎหมาย ลงนามบันทึกความเห็นประกอบร่างคำแก้อุทธรณ์ (ไม่ใช่ประธานฯ) | &lt;b&gt;ไม่อุทธรณ์:&lt;/b&gt; ปิดสำนวนคดีปกครอง" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="s8">
          <mxGeometry x="30" y="418" width="580" height="72" as="geometry" />
        </mxCell>
        <mxCell id="s8e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="p3-1" source="s8a" target="s8b"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s8e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="p3-1" source="s8b" target="s8c"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s8e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="p3-1" source="s8c" target="s8d"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s8e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="p3-1" source="s8d" target="s8e"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="s9" value="&lt;b&gt;EX-09 : Bypass ถูกปฏิเสธ / อุทธรณ์เปิดเผยข้อมูล / คุ้มครองพยานเร่งด่วน&lt;/b&gt;" style="swimlane;html=1;startSize=40;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="p3-1">
          <mxGeometry x="1420" y="1200" width="640" height="500" as="geometry" />
        </mxCell>
        <mxCell id="s9a" value="&lt;b&gt;A. ใบด่วนไม่ได้รับการรับรอง&lt;/b&gt; — ผอ.กบค. ไม่เซ็นกำกับเหตุผลเร่งด่วน (Exception ของ RES004/RES013) → ระบบตัดสิทธิ์ Bypass และบังคับกลับเข้าเส้นทางปกติที่ &lt;b&gt;T9 (ส่งอนุกลั่นกรองฯ)&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="s9">
          <mxGeometry x="30" y="50" width="580" height="85" as="geometry" />
        </mxCell>
        <mxCell id="s9b" value="&lt;b&gt;B. อุทธรณ์คำขอเปิดเผยข้อมูลข่าวสาร&lt;/b&gt; — ยื่นอุทธรณ์ภายใน 30 วัน ผ่านคณะอนุกรรมการกลั่นกรองการเปิดเผยฯ → บอร์ดต้องพิจารณาให้เสร็จภายใน 60 วัน (ฐานอำนาจ: พ.ร.บ.ข้อมูลข่าวสารฯ ม.11 + ป.ป.ท. ม.19/1)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="s9">
          <mxGeometry x="30" y="152" width="580" height="95" as="geometry" />
        </mxCell>
        <mxCell id="s9c" value="&lt;b&gt;C. คำขอคุ้มครองพยานเร่งด่วน (กจ.6)&lt;/b&gt; — ยื่นตามลำดับชั้นถึงเลขาธิการฯ แล้ว &lt;b&gt;ยิงตรงเข้าระเบียบวาระบอร์ด&lt;/b&gt; ข้ามคณะอนุกลั่นกรองฯ (ไม่ใช่เนื้อหาคดี) → กลับสู่ &lt;b&gt;T12&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="s9">
          <mxGeometry x="30" y="264" width="580" height="85" as="geometry" />
        </mxCell>
        <mxCell id="s9d" value="&lt;b&gt;D. วาระพาดพิงสำนวนคดี&lt;/b&gt; — ระบบตั้งฟิลด์ &quot;ชั้นความลับ&quot; แยกอิสระจากหมวดหมู่เอกสาร: หนังสือเชิญประชุมที่แนบระเบียบวาระเต็มถูกจัดเป็นชั้นความลับทันที และจำกัดผู้มีสิทธิ์เข้าถึง" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="s9">
          <mxGeometry x="30" y="366" width="580" height="90" as="geometry" />
        </mxCell>

        <mxCell id="s10" value="&lt;b&gt;EX-10 : กลไก &quot;มติโดยปริยาย&quot; ของเลขาธิการฯ (ม.28) และ Validation ห้ามรับเรื่อง (ม.25-27)&lt;/b&gt;" style="swimlane;html=1;startSize=40;fillColor=#e0f2f1;strokeColor=#00897b;fontSize=12;" vertex="1" parent="p3-1">
          <mxGeometry x="2110" y="120" width="640" height="500" as="geometry" />
        </mxCell>
        <mxCell id="s10a" value="&lt;b&gt;X10.1 (ม.25 ห้ามรับเด็ดขาด) — Hard Validation Rule&lt;/b&gt;&lt;br&gt;ระบบบล็อกการเสนอวาระเมื่อ: ป.ป.ช. รับไว้/วินิจฉัยเสร็จเด็ดขาดแล้ว | บอร์ดวินิจฉัยเสร็จเด็ดขาดแล้วและไม่มีพยานหลักฐานใหม่ | ศาลประทับฟ้อง/พิพากษาเสร็จเด็ดขาด | ผู้ถูกกล่าวหาตาย | พ้นจากเจ้าหน้าที่ของรัฐก่อนถูกกล่าวหาเกิน 5 ปี" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="s10">
          <mxGeometry x="30" y="50" width="580" height="105" as="geometry" />
        </mxCell>
        <mxCell id="s10b" value="&lt;b&gt;X10.2 (ม.26-27) — Soft Rule (บอร์ดใช้ดุลพินิจ)&lt;/b&gt;&lt;br&gt;ระบบแสดง Warning ให้บอร์ดเลือกไม่รับ/สั่งจำหน่าย เช่น ไม่ระบุพยานหลักฐานชัดเจน / เกิน 5 ปีนับแต่วันเกิดเหตุ / ไม่ใช่ความผิดวินัยร้ายแรง&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;ม.27 ว.2: เลขาธิการฯ ส่งเรื่องให้ผู้บังคับบัญชาดำเนินการทางวินัยเองแล้วรายงานบอร์ดทราบ&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="s10">
          <mxGeometry x="30" y="168" width="580" height="105" as="geometry" />
        </mxCell>
        <mxCell id="s10c" value="&lt;b&gt;X10.3 (ม.28) — Timer-based Auto Resolution ที่ยังไม่มีในผังใด&lt;/b&gt;&lt;br&gt;เลขาธิการฯ สั่งรับ / ไม่รับ / จำหน่ายเรื่องเป็นเบื้องต้น → ระบบ Auto-compile รายงานเสนอบอร์ด &lt;b&gt;ทุก 15 วัน&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="s10">
          <mxGeometry x="30" y="286" width="580" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s10d" value="&lt;b&gt;X10.4 [Decision]&lt;/b&gt; บอร์ดมีมติเป็นอย่างอื่นภายใน 15 วันนับแต่รับรายงานหรือไม่?" style="rhombus;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="s10">
          <mxGeometry x="150" y="376" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s10e" value="&lt;b&gt;ไม่มีมติ → ระบบตั้งสถานะ &quot;ถือว่าบอร์ดมีมติตามคำสั่งเลขาธิการฯ&quot; โดยอัตโนมัติ&lt;/b&gt; และออกมติจาก Template | &lt;b&gt;มีมติเป็นอย่างอื่น →&lt;/b&gt; ใช้มติบอร์ดแทน" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="s10">
          <mxGeometry x="30" y="446" width="580" height="44" as="geometry" />
        </mxCell>
        <mxCell id="s10x1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="p3-1" source="s10b" target="s10c"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s10x2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="p3-1" source="s10c" target="s10d"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s10x3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="p3-1" source="s10d" target="s10e"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="s11" value="&lt;b&gt;EX-11 : มติชี้มูลที่ก่อความเสียหาย-ละเมิด และการเพิกถอนเอกสารสิทธิ (ม.46)&lt;/b&gt;" style="swimlane;html=1;startSize=40;fillColor=#f3e5f5;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="p3-1">
          <mxGeometry x="2110" y="660" width="640" height="500" as="geometry" />
        </mxCell>
        <mxCell id="s11a" value="&lt;b&gt;Trigger:&lt;/b&gt; บอร์ดมีมติวินิจฉัยชี้มูล และปรากฏว่าการกระทำก่อให้เกิดความเสียหาย/เป็นการละเมิดต่อหน่วยงานของรัฐ หรือมีการออกเอกสารสิทธิ/ก่อสิทธิแก่บุคคลใดโดยมิชอบ" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="s11">
          <mxGeometry x="30" y="50" width="580" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s11b" value="&lt;b&gt;X11.1&lt;/b&gt; ระบบสร้าง &quot;สายที่สาม&quot; เพิ่มจากสายอาญาและสายวินัย: หนังสือแจ้งหน่วยงานของรัฐที่เกี่ยวข้องให้หาตัวผู้รับผิดชดใช้ความเสียหาย หรือพิจารณาเพิกถอนเอกสารสิทธิ/สิทธินั้นโดยเร็ว" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="s11">
          <mxGeometry x="30" y="143" width="580" height="85" as="geometry" />
        </mxCell>
        <mxCell id="s11c" value="&lt;b&gt;X11.2 [Decision]&lt;/b&gt; หน่วยงานของรัฐดำเนินการและรายงานกลับภายในเวลาอันสมควรหรือไม่?" style="rhombus;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="s11">
          <mxGeometry x="150" y="241" width="340" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s11d" value="&lt;b&gt;X11.3 (ไม่ดำเนินการ)&lt;/b&gt; บอร์ดรายงานให้ &lt;b&gt;คณะรัฐมนตรี&lt;/b&gt; ทราบ และ &lt;b&gt;เผยแพร่ข้อมูลให้ประชาชนทราบเป็นการทั่วไป&lt;/b&gt; (ม.46 ว.2) — ระบบต้องมี Template หนังสือถึง ครม. และช่องทางเผยแพร่สาธารณะ" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="s11">
          <mxGeometry x="30" y="334" width="580" height="85" as="geometry" />
        </mxCell>
        <mxCell id="s11e" value="&lt;b&gt;X11.4 (ดำเนินการแล้ว)&lt;/b&gt; บันทึกรายงานผลเข้าระบบ ปิดรอบติดตาม และ &lt;b&gt;[Integration → กจ.8]&lt;/b&gt; อัปเดต Dashboard" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="s11">
          <mxGeometry x="30" y="432" width="580" height="58" as="geometry" />
        </mxCell>
        <mxCell id="s11x1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="p3-1" source="s11a" target="s11b"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s11x2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="p3-1" source="s11b" target="s11c"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s11x3" value="ไม่ดำเนินการ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;" edge="1" parent="p3-1" source="s11c" target="s11d"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s11x4" value="ดำเนินการแล้ว" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;exitX=1;exitY=0.5;" edge="1" parent="p3-1" source="s11c" target="s11e"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="s12" value="&lt;b&gt;EX-12 : เส้นทางที่กฎหมายกำหนดแต่ยังไม่ปรากฏในผัง AS-IS/TO-BE เดิม&lt;/b&gt;" style="swimlane;html=1;startSize=40;fillColor=#fce4ec;strokeColor=#b85450;fontSize=12;" vertex="1" parent="p3-1">
          <mxGeometry x="2110" y="1200" width="640" height="500" as="geometry" />
        </mxCell>
        <mxCell id="s12a" value="&lt;b&gt;A. หมายจับ (ม.19/2) — ขัดกับข้อสรุปที่ประชุม 22/07/2569&lt;/b&gt;&lt;br&gt;กฎหมายกำหนดว่าการขอศาลออกหมายจับต้องเกิด &lt;b&gt;หลังบอร์ดมีมติวินิจฉัยชี้มูลผิดวินัยตาม ม.38 และเป็นความผิดอาญาด้วย&lt;/b&gt; + มีเหตุเชื่อว่าจะหลบหนี โดยบอร์ดหรือผู้ที่บอร์ดมอบหมายเป็นผู้ยื่น → &lt;b&gt;กจ.7 จึงเป็นต้นน้ำของ กจ.9 เสมอ&lt;/b&gt; ต้องยืนยันซ้ำ" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="s12">
          <mxGeometry x="30" y="50" width="580" height="105" as="geometry" />
        </mxCell>
        <mxCell id="s12b" value="&lt;b&gt;B. ส่งเรื่องคืน ป.ป.ช. ตามกำหนดเวลาแข็ง (ม.18/1-18/3)&lt;/b&gt;&lt;br&gt;• ป.ป.ช. มีมติจะทำเอง → ส่งเรื่อง+สำนวนคืนภายใน 15 วันนับแต่รับแจ้งมติ (ต้องคัดสำเนาเก็บไว้เป็นหลักฐาน)&lt;br&gt;• พบว่าไม่อยู่ในอำนาจ ป.ป.ท. → ส่งคืนภายใน 15 วันนับแต่วันที่ทราบ&lt;br&gt;• เหลืออายุความไม่ถึง 6 เดือนและทำไม่ทัน → ส่งคืนไม่ช้ากว่า 15 วัน" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="s12">
          <mxGeometry x="30" y="168" width="580" height="110" as="geometry" />
        </mxCell>
        <mxCell id="s12c" value="&lt;b&gt;C. คำร้องขอคัดสำเนาสำนวนเพื่อใช้สิทธิอุทธรณ์ (ม.39)&lt;/b&gt;&lt;br&gt;ผู้ถูกกล่าวหายื่นคำร้องขอคัดสำเนาสำนวนการไต่สวน → บอร์ดอนุญาตตามหลักเกณฑ์ที่กำหนด ภายใต้ข้อจำกัด ม.19/1 ว.2 (ห้ามเปิดเผยชื่อผู้กล่าวหา/ผู้แจ้งเบาะแส/พยาน) → เป็น sub-flow ของโมดูล 7.3" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="s12">
          <mxGeometry x="30" y="291" width="580" height="95" as="geometry" />
        </mxCell>
        <mxCell id="s12d" value="&lt;b&gt;D. บทลงโทษเมื่อทำงานล่าช้าเกินกรอบ ม.23 / ม.31 (ม.23 ว.2 + ม.38 ว.4)&lt;/b&gt;&lt;br&gt;หากไต่สวน-วินิจฉัยพ้นกำหนดเวลา บอร์ดต้อง &lt;b&gt;สอบสวนและลงโทษผู้เกี่ยวข้องที่จงใจ/ปล่อยปละละเลย/ประมาทเลินเล่อ&lt;/b&gt; และต้องไต่สวนหาเหตุแห่งความล่าช้าแล้ว &lt;b&gt;ประกาศให้ประชาชนทราบ&lt;/b&gt; → Executive Dashboard ต้องมีตัวชี้วัดคดีเลยกรอบเวลาเป็นรายบุคคล" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="s12">
          <mxGeometry x="30" y="399" width="580" height="91" as="geometry" />
        </mxCell>

        <mxCell id="p3n" value="&lt;b&gt;✔ ประเด็นที่ปิดได้แล้วด้วย พ.ร.บ. มาตรการของฝ่ายบริหารในการป้องกันและปราบปรามการทุจริต พ.ศ. 2551 แก้ไขถึงฉบับที่ 4 พ.ศ. 2568 (ไม่ต้องรอ ป.ป.ท. ยืนยันอีก)&lt;/b&gt;&lt;br&gt;องค์ประชุม = ไม่น้อยกว่ากึ่งหนึ่งของกรรมการเท่าที่มีอยู่ และต้องเหลือกรรมการไม่ต่ำกว่า 5 คน (ม.12 + ม.10) | เกณฑ์ลงมติ = เสียงข้างมากของกรรมการทั้งหมดเท่าที่มีอยู่ ประธานชี้ขาดเมื่อเสียงเท่ากัน (ม.15) | ต้องมีรายงานการประชุมเป็นหนังสือและบันทึกความเห็นแย้งพร้อมเหตุผล (ม.16)&lt;br&gt;นัดประชุมเป็นหนังสือล่วงหน้าไม่น้อยกว่า 3 วัน เว้นแต่เร่งด่วนประธานนัดเป็นอย่างอื่นได้ = ฐานอำนาจของ &quot;ใบด่วน/Bypass&quot; (ม.13) | กรรมการมีส่วนได้เสียต้องให้ &quot;บอร์ดมีมติ&quot; กันออก ไม่ใช่ถอนตัวเอง (ม.20) | ประธานฯ มอบหมายให้เลขาธิการลงนามเอกสารแทนได้ (ม.18 ว.3)&lt;br&gt;กรอบเวลาไต่สวน 2 ปี ขยายไม่เกิน 3 ปี (ต่างประเทศ 5 ปี) และผู้อนุมัติขยายคือบอร์ด (ม.23) | แจ้งผู้ถูกกล่าวหาไม่ช้ากว่า 15 วัน (ม.32) | ต้นสังกัดลงโทษวินัยภายใน 60 วันโดยไม่ต้องตั้ง กก.สอบสวนอีก และ &lt;b&gt;ประธานฯ เป็นผู้แจ้ง&lt;/b&gt; (ม.38) | ขอทบทวนมติภายใน 30 วัน (ม.40)&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;&lt;b&gt;⚠ แก้การอ้างอิงกฎหมายใน Google Sheet:&lt;/b&gt; กรณีอัยการสั่งไม่ฟ้องแล้วบอร์ดยืนยันให้ฟ้อง → ส่ง อสส. วินิจฉัยชี้ขาด อยู่ใน &lt;b&gt;ม.44 วรรคสาม&lt;/b&gt; (ไม่ใช่ ม.46 วรรคสาม) — ม.46 เป็นเรื่องความเสียหาย/ละเมิด/เพิกถอนเอกสารสิทธิ (ดู EX-11)&lt;/font&gt;&lt;br&gt;&lt;b&gt;○ ยังต้องรอ ป.ป.ท. ยืนยัน:&lt;/b&gt; สิทธิ์กดตีกลับรายชั้นและการ Re-route หลังแก้ไข (EX-01) | องค์ประชุมของคณะอนุกลั่นกรองฯ 1-8 (ระเบียบภายใน ไม่ใช่ พ.ร.บ.) | SLA รายตำแหน่งของชั้นกลางและจุดเริ่มนับ 15 วัน | เกณฑ์ลายลักษณ์อักษรของ &quot;เรื่องเร่งด่วน&quot; | ผู้ให้บริการ CA และกลไก Multi-signer | การเวียนมตินอกที่ประชุม | นิยามและผังของ &quot;เรื่อง ก.ก.ม.&quot;" style="rounded=1;html=1;whiteSpace=wrap;align=left;spacingLeft=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;verticalAlign=middle;" vertex="1" parent="p3-1">
          <mxGeometry x="40" y="1740" width="2710" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
