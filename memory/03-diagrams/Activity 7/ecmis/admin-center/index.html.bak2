<script>
function doExport(){ Swal.fire({icon:'info',title:'Export (Mock)',text:'ผู้ใช้งาน · Excel/PDF · บันทึกประวัติเรียกดู (FR-054/055/056)'}); }
function openAddUser(){ Swal.fire({title:'เพิ่มผู้ใช้ (Mock)', html:'<div style=\"text-align:left\"><label>ชื่อ-สกุล<br><input id=\"sw-name\" class=\"swal2-input\" placeholder=\"เช่น นายสมชาย ใจดี\"></label><br><label>หน่วยงาน<br><select id=\"sw-dept\" class=\"swal2-input\"><option>ส่วนกลาง</option><option>เขต 1</option><option>เขต 2</option></select></label></div>', showCancelButton:true, confirmButtonText:'สร้าง', preConfirm:()=>{ const v=document.getElementById('sw-name').value.trim(); if(!v) {Swal.showValidationMessage('กรอกชื่อ'); return false} return true; }}).then(r=>{if(r.isConfirmed) Swal.fire('สร้างแล้ว','รอแจ้งผลทางอีเมล (FR-007)','success')}); }
function openImport(){ Swal.fire('นำเข้า','Mock: นำเข้าไฟล์ Excel รายชื่อผู้ใช้ (ตรวจซ้ำ FR-004 + ThaiD verify FR-003)','info'); }
function openNews(kind){ Swal.fire({title:`สร้าง${kind} (Mock)`, html:'<div style=\"text-align:left\"><label>หัวข้อ<br><input class=\"swal2-input\" placeholder=\"หัวข้อข่าว\"></label><br><label>กำหนดกลุ่มผู้รับ (SYS02 FR-059)<br><select class=\"swal2-input\"><option>ทุกคน</option><option>เขต 1</option><option>บทบาท Officer</option></select></label><br><small style=\"color:#62738a\">SYS03 ต้องมี Preview (FR-086) + เผยแพร่ตามเวลา (FR-089) + ประวัติ version (FR-090)</small><br><label>แนบไฟล์/รูป/วิดีโอ (FR-058)<br><input type=\"file\" class=\"swal2-input\"></label></div>', showCancelButton:true, confirmButtonText:'บันทึก'}); }
function submitReg(){ const nm=document.getElementById('reg-name').value.trim(), em=document.getElementById('reg-email').value.trim(); if(!nm) return Swal.fire('กรอกชื่อ','FR-004 ตรวจความครบถ้วน','warning'); if(em && !em.includes('@')) return Swal.fire('อีเมลไม่ถูกต้อง','','warning'); Swal.fire('ส่งคำขอแล้ว','ส่งให้ Admin หน่วยงานพิจารณา (FR-005) · บันทึกผล (FR-006) · แจ้งผล (FR-007)','success'); }

// ===== mock data =====
const USERS=[
  {u:"somsak.p",name:"นายสมศักดิ์ ใจดี",dept:"ส่วนกลาง",pos:"นักสืบสวน",role:"OFFICER",st:"Active",last:"2026-08-16 09:12"},
  {u:"wilai.k",name:"นางวิไล ขยัน",dept:"เขต 1",pos:"ผอ.กลุ่ม",role:"DIV_DIRECTOR",st:"Active",last:"2026-08-16 08:44"},
  {u:"prasert.t",name:"นายประเสริฐ ดีเยี่ยม",dept:"เขต 2",pos:"ผอ.กอง",role:"BUREAU_DIRECTOR",st:"Active",last:"2026-08-15 16:20"},
  {u:"newuser01",name:"นายทดสอบ หนึ่ง",dept:"เขต 1",pos:"เจ้าหน้าที่",role:"OFFICER",st:"รออนุมัติ",last:"—"},
  {u:"locked01",name:"นายถูกล็อก ทดสอบ",dept:"กบด.",pos:"เจ้าหน้าที่",role:"OFFICER",st:"ถูกล็อก",last:"2026-08-14 11:03"},
];
const PENDING=[
  {d:"2026-08-15",name:"นางสาวดาว เรือง",dept:"เขต 2",pos:"นักวิชาการ",role:"OFFICER",thaid:"ยืนยันแล้ว"},
  {d:"2026-08-14",name:"นายมานะ พากเพียร",dept:"เขต 1",pos:"นิติกร",role:"OFFICER",thaid:"ยืนยันแล้ว"},
  {d:"2026-08-13",name:"นางสุดา ใจงาม",dept:"ส่วนกลาง",pos:"เจ้าหน้าที่",role:"ORG_ADMIN",thaid:"รอตรวจ"},
];
