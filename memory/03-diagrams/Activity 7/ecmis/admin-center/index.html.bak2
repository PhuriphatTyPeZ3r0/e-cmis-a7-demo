<!doctype html>
<html lang="th">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>E-CMIS ก14 · ระบบบริหารกลางและสนับสนุน (SYS01-06 / FR144)</title>
<link rel="stylesheet" href="./assets/fontawesome/css/all.min.css">
<link rel="stylesheet" href="./assets/sweetalert2/sweetalert2.min.css">
<link rel="stylesheet" href="./assets/mockup.css">
<style>
@font-face{font-family:"Kanit";font-style:normal;font-weight:400;src:url("./assets/fonts/Kanit-Regular.ttf") format("truetype")}
:root{--navy:#10284b;--navy2:#1d3975;--gold:#c6a13d;--ink:#172943;--muted:#62738a;--line:#d6e0ea;--ok:#24714a;--warn:#8a6111;--bad:#ad3f3d}
.badge{padding:2px 8px;border-radius:999px;font-size:11px;font-weight:600;display:inline-flex;align-items:center;gap:4px}
.badge-ok{background:#d1e7dd;color:#0f5132}.badge-warn{background:#fff3cd;color:#664d03}.badge-bad{background:#f8d7da;color:#842029}.badge-info{background:#cfe2ff;color:#084298}.badge-muted{background:#e2e3e5;color:#41464b}
.kpi-row{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:12px 0}
.kpi{background:#fff;border:1px solid var(--line);border-radius:10px;padding:12px}
.kpi strong{font-size:18px;color:var(--navy)} .kpi small{color:var(--muted)}
.card{background:#fff;border:1px solid var(--line);border-radius:10px;padding:14px;margin:10px 0}
.card-head{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:8px;flex-wrap:wrap}
.table-wrap{overflow:auto;border:1px solid var(--line);border-radius:10px;background:#fff}
table{width:100%;border-collapse:collapse;font-size:12px}
th,td{padding:7px 8px;border-bottom:1px solid #eef2f7;text-align:left;white-space:nowrap}
th{background:#f8fafc;color:var(--muted);font-weight:600}
.toolbar{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin:8px 0}
.toolbar input,.toolbar select{border:1px solid var(--line);border-radius:8px;padding:6px 8px;min-height:32px;font-size:12px}
.btn{border:1px solid var(--line);background:#fff;border-radius:8px;padding:6px 10px;font-size:12px;cursor:pointer}
.btn-primary{background:var(--navy);color:#fff;border-color:var(--navy)}
.btn-sm{padding:4px 8px;font-size:11px}
.nav-link.active{background:rgba(255,255,255,.09)!important;color:#fff!important;border-color:rgba(201,154,46,.35)!important}
.subtabs{display:flex;gap:6px;flex-wrap:wrap;margin:8px 0}
.subtabs button{border:1px solid var(--line);background:#fff;border-radius:999px;padding:6px 12px;font-size:12px;cursor:pointer}
.subtabs button.active{background:var(--navy);color:#fff;border-color:var(--navy)}
.subpanel{display:none}.subpanel.active{display:block}
.matrix{overflow:auto}
.matrix table th:first-child{position:sticky;left:0;background:#f8fafc;z-index:1}
.matrix table td:first-child{position:sticky;left:0;background:#fff;z-index:1;font-weight:500}
.fr-tag{font-size:10px;color:#7a8aa0;background:#eef2f7;border-radius:4px;padding:1px 5px;font-family:monospace}
.coverage{font-size:11px;color:#62738a;background:#fff;border:1px dashed #c6d4e6;border-radius:8px;padding:8px 10px;margin:8px 0}
@media(max-width:900px){.kpi-row{grid-template-columns:1fr 1fr}}
</style>
</head>
<body>
<div class="app" style="display:grid;grid-template-columns:268px 1fr;min-height:100vh">
<aside class="side" style="background:#0d1b3e;color:#cbd5e1;display:flex;flex-direction:column">
  <div style="padding:14px 16px;border-bottom:1px solid rgba(255,255,255,.08);display:flex;gap:12px;align-items:center">
    <img src="./assets/images/pacc-logo.webp" alt="" style="width:44px;height:44px;border-radius:50%;border:2px solid #c99a2e;background:#f4d56d;object-fit:cover">
    <div><strong style="color:#fff">E-CMIS</strong><small style="display:block;color:#e4be52;font-size:11px">ก14 · บริหารกลางและสนับสนุน</small><small style="display:block;color:#91a2c3;font-size:10px">SYS01-06 · 30 ย่อย · FR144 · 24 razor</small></div>
  </div>
  <nav style="padding:10px;flex:1;overflow:auto;display:flex;flex-direction:column;gap:2px">
    <div style="font-size:10px;letter-spacing:.06em;color:#91a2c3;padding:6px 8px 2px">SYS01 สิทธิ์และผู้ใช้งาน (10 ย่อย)</div>
    <button class="nav-link" data-h="#/users"><i class="fa-solid fa-users"></i> ผู้ใช้งาน & ลงทะเบียน</button>
    <button class="nav-link" data-h="#/roles"><i class="fa-solid fa-shield-halved"></i> บทบาท/สิทธิ์ (SYS01.09-10)</button>
    <div style="font-size:10px;letter-spacing:.06em;color:#91a2c3;padding:8px 8px 2px">SYS02 ขับเคลื่อน + SYS03 ประชาสัมพันธ์</div>
    <button class="nav-link" data-h="#/drive"><i class="fa-solid fa-bullhorn"></i> ขับเคลื่อน (SYS02 6 ย่อย)</button>
    <button class="nav-link" data-h="#/news"><i class="fa-solid fa-newspaper"></i> ประชาสัมพันธ์ (SYS03)</button>
    <div style="font-size:10px;letter-spacing:.06em;color:#91a2c3;padding:8px 8px 2px">SYS04 ฐานกลาง / SYS05 Audit / SYS06 ลายเซ็น</div>
    <button class="nav-link" data-h="#/master"><i class="fa-solid fa-database"></i> ฐานกลาง & API (SYS04)</button>
    <button class="nav-link" data-h="#/audit"><i class="fa-solid fa-clipboard-list"></i> บันทึกเหตุการณ์ (SYS05)</button>
    <button class="nav-link" data-h="#/sign"><i class="fa-solid fa-signature"></i> ลายเซ็นดิจิทัล (SYS06)</button>
    <div style="margin-top:10px;padding:10px 8px;border-top:1px solid rgba(255,255,255,.08);font-size:11px;color:#91a2c3;line-height:1.6">
      เส้นทางเดิม: #/users|roles|news|master|audit|sign<br>
      เพิ่ม: #/drive (SYS02) + แยก #/news เป็น SYS03 เต็ม<br>
      sub-tab ครอบ 24 razor / FR144<br>
      <span style="color:#e4be52">Super Admin · Org Admin · User</span><br>ThaiD + OTP · PDPA · JWT/RBAC
    </div>
  </nav>
  <div style="padding:10px;border-top:1px solid rgba(255,255,255,.08);display:flex;gap:10px;align-items:center">
    <div style="width:32px;height:32px;border-radius:50%;background:#1d3975;display:grid;place-items:center;color:#fff;font-weight:700;font-size:12px">ส</div>
    <div><strong style="color:#fff;font-size:12px">Super Admin</strong><small style="display:block;color:#bac7dd;font-size:10px">ส่วนกลาง · จัดการได้ทุกหน่วย</small></div>
  </div>
</aside>
<main style="background:#f1f5f9;min-width:0">
  <div class="top" style="height:52px;background:#fff;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 14px;gap:8px;flex-wrap:wrap">
    <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap"><span class="badge badge-info">MOCK</span><strong id="ttl">ผู้ใช้งาน</strong><small id="sub" style="color:var(--muted)">SYS01 · FR-SYS-001~042</small><span id="covBadge" class="badge badge-ok" style="margin-left:6px">FR144 ครบ</span></div>
    <div style="display:flex;gap:6px;align-items:center">
      <select id="scopePick" style="border:1px solid var(--line);border-radius:8px;padding:4px 8px;font-size:12px"><option>Super Admin (ทุกหน่วย)</option><option>Org Admin (เขต 1)</option><option>Org Admin (เขต 2)</option></select>
      <button class="btn" onclick="doExport()"><i class="fa-solid fa-file-excel"></i> Export</button>
    </div>
  </div>
  <div class="content" style="padding:14px">

    <!-- ===================== SYS01 Users (FR 001-042 subset + transfers/phone etc) ===================== -->
    <section id="v-users">
      <div class="coverage"><strong>FR ครอบ:</strong> FR-SYS-001~008 ลงทะเบียน / 009~019 เข้าใช้งาน-รหัสผ่าน-โปรไฟล์-ขอแก้ไข / 020~042 Admin/Super Admin — ครบ SYS01.01~01.10 + ตารางรายงาน · <span class="fr-tag">5 razor: Users, Registrations, Transfers, Support, SuperAdminDashboard</span></div>
      <div class="kpi-row">
        <div class="kpi"><small>ผู้ใช้งานทั้งหมด</small><br><strong>342</strong> <small>บัญชี</small><br><small style="color:var(--ok)">Active 318 · Inactive 24</small><br><small class="fr-tag">FR-024/035</small></div>
        <div class="kpi"><small>รอการอนุมัติ</small><br><strong style="color:var(--warn)">7</strong> <small>คำขอลงทะเบียนใหม่</small><br><small>ThaiD ยืนยันแล้ว 5</small><br><small class="fr-tag">FR-003/005/021</small></div>
        <div class="kpi"><small>คำขอย้ายหน่วยงาน</small><br><strong>4</strong> <small>รอต้นทาง/ปลายทาง</small><br><small class="fr-tag">FR-015/026/027/094-095</small></div>
        <div class="kpi"><small>คำขอแก้สิทธิ์</small><br><strong>6</strong> <small>รออนุมัติ</small><br><small class="fr-tag">FR-016/028/029</small></div>
      </div>
      <div class="subtabs" id="st-users">
        <button class="active" data-t="u-list">รายการผู้ใช้ <span class="fr-tag">024·035</span></button>
        <button data-t="u-reg">ลงทะเบียน/อนุมัติ <span class="fr-tag">001~008·020~021</span></button>
        <button data-t="u-trans">ย้ายหน่วยงาน <span class="fr-tag">094-096</span></button>
        <button data-t="u-permreq">ขอแก้สิทธิ์ <span class="fr-tag">028·037-039</span></button>
        <button data-t="u-auth">เข้าใช้งาน/รหัสผ่าน <span class="fr-tag">009~012</span></button>
        <button data-t="u-report">รายงานผู้ใช้ <span class="fr-tag">051~056</span></button>
      </div>
      <!-- sub: list -->
      <div class="subpanel active" id="p-u-list">
        <div class="toolbar">
          <input id="q-users" placeholder="ค้นหา ชื่อ/อีเมล/หน่วยงาน" style="flex:1;min-width:220px">
          <select id="f-users-status"><option value="">สถานะ ทั้งหมด</option><option>Active</option><option>Inactive</option><option>รออนุมัติ</option><option>ถูกล็อก</option></select>
          <select id="f-users-dept"><option value="">หน่วยงาน ทั้งหมด</option><option>ส่วนกลาง</option><option>เขต 1</option><option>เขต 2</option><option>กบด.</option></select>
          <button class="btn btn-primary" onclick="openAddUser()"><i class="fa-solid fa-user-plus"></i> เพิ่มผู้ใช้ (FR-035)</button>
          <button class="btn" onclick="openImport()"><i class="fa-solid fa-file-import"></i> นำเข้า</button>
          <button class="btn" onclick="Swal.fire('Mock','ThaiD OAuth2 + JWT · ตรวจซ้ำก่อนบันทึก (FR-003/004/010)','info')">ThaiD</button>
        </div>
        <div class="table-wrap"><table><thead><tr><th>ชื่อผู้ใช้</th><th>ชื่อ-สกุล</th><th>หน่วยงาน</th><th>ตำแหน่ง</th><th>บทบาท</th><th>สถานะ</th><th>เข้าใช้ล่าสุด</th><th>Log</th><th></th></tr></thead><tbody id="tb-users"></tbody></table></div>
        <div id="detail-users" style="margin-top:10px"></div>
      </div>
      <div class="subpanel" id="p-u-reg">
        <div class="card"><div class="card-head"><strong>คำขอลงทะเบียนรออนุมัติ (7)</strong><small style="color:var(--muted)">SYS01.01-02 · FR-001~008 · ตรวจซ้ำ + ThaiD + ส่งให้ Admin หน่วยงาน (FR-005)</small><span class="badge badge-warn">FR-020·021</span></div><div class="table-wrap"><table><thead><tr><th>วันที่ขอ</th><th>ชื่อผู้ขอ</th><th>หน่วยงาน</th><th>ตำแหน่ง</th><th>บทบาทที่ขอ</th><th>ThaiD</th><th></th></tr></thead><tbody id="tb-pending"></tbody></table></div></div>
        <div class="card"><div class="card-head"><strong>สมัครใหม่ (จำลองฟอร์ม FR-001/002/004)</strong></div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
            <label>ชื่อ-สกุล <input id="reg-name" class="btn" style="width:100%;text-align:left;background:#fff" placeholder="นายทดสอบ ระบบ"></label>
            <label>หน่วยงาน <select id="reg-dept" style="width:100%;border:1px solid var(--line);border-radius:8px;padding:6px"><option>ส่วนกลาง</option><option>เขต 1</option><option>เขต 2</option></select></label>
            <label>อีเมล <input id="reg-email" class="btn" style="width:100%;text-align:left;background:#fff" placeholder="name@pacc.go.th"></label>
            <label>เบอร์โทร <input class="btn" style="width:100%;text-align:left;background:#fff" placeholder="02-xxx-xxxx"></label>
          </div>
          <div class="toolbar"><button class="btn btn-primary" onclick="submitReg()">ส่งคำขอลงทะเบียน (FR-005)</button><small style="color:var(--muted)">→ บันทึกผลอนุมัติ/ไม่อนุมัติ (FR-006) + แจ้งผลทางอีเมล (FR-007) + ตั้งรหัสผ่านครั้งแรก (FR-008/011)</small></div>
        </div>
      </div>
      <div class="subpanel" id="p-u-trans">
        <div class="card"><div class="card-head"><strong>คำขอย้าย/แก้ไขหน่วยงาน (SYS01.07 · FR-015·026·027·094·095)</strong><small style="color:var(--muted)">ผู้ใช้ส่งคำขอ → Admin ต้นทาง + ปลายทางพิจารณา → อัปเดตหน่วยงานให้ระบบที่เกี่ยวข้อง (FR-096) + บันทึกประวัติ (FR-097)</small></div><div class="table-wrap"><table><thead><tr><th>วันที่</th><th>ผู้ขอ</th><th>จาก</th><th>ไป</th><th>เหตุผล</th><th>สถานะ</th><th></th></tr></thead><tbody id="tb-transfers"></tbody></table></div></div>
      </div>
      <div class="subpanel" id="p-u-permreq">
        <div class="card"><div class="card-head"><strong>คำขอแก้ไขสิทธิ์ (SYS01.08 · FR-016·028·029·038)</strong><small>ตรวจหน้าที่งาน + กำหนด/ปรับบทบาท + Super Admin สร้าง Role (FR-039)</small></div><div class="table-wrap"><table><thead><tr><th>วันที่</th><th>ผู้ขอ</th><th>สิทธิ์เดิม</th><th>สิทธิ์ที่ขอ</th><th>เหตุผล</th><th>สถานะ</th><th></th></tr></thead><tbody id="tb-permreq"></tbody></table></div></div>
      </div>
      <div class="subpanel" id="p-u-auth">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
          <div class="card"><div class="card-head"><strong>เข้าใช้งาน (FR-009·010·013·018·019)</strong></div>
            <div style="font-size:12px;line-height:1.8;color:var(--muted)">
              • Username/Password (FR-009) + ThaiD OAuth2/JWT (FR-010)<br>• ตรวจสิทธิ์ก่อนแสดงเมนู/ข้อมูล (FR-013·049)<br>• บันทึก + แสดงประวัติเข้าใช้งาน (FR-018) · รายงาน Log (FR-019)
            </div>
            <div class="table-wrap" style="margin-top:8px"><table><thead><tr><th>เวลา</th><th>ผู้ใช้</th><th>ช่องทาง</th><th>ผล</th><th>IP</th></tr></thead><tbody id="tb-authlog"></tbody></table></div>
          </div>
          <div class="card"><div class="card-head"><strong>จัดการรหัสผ่าน (FR-011·012·023·034)</strong></div>
            <div class="toolbar"><button class="btn btn-primary" onclick="Swal.fire('Mock','บังคับเปลี่ยนรหัสผ่านครั้งแรก (FR-011)','info')">บังคับเปลี่ยนครั้งแรก</button><button class="btn" onclick="Swal.fire('Mock','ลืมรหัสผ่าน → ขอกำหนดใหม่ + Admin ช่วยรีเซ็ต (FR-012/023/034)','info')">ลืมรหัสผ่าน</button></div>
            <div style="font-size:12px;color:var(--muted)">นโยบาย: 8 ตัวขึ้นไป · ตัวใหญ่/เล็ก/เลข/อักขระพิเศษ · หมดอายุ 90 วัน · ล็อก 5 ครั้งผิด · ประวัติห้ามซ้ำ 5 ครั้งล่าสุด</div>
            <div class="table-wrap" style="margin-top:8px"><table><thead><tr><th>ผู้ใช้</th><th>เปลี่ยนล่าสุด</th><th>หมดอายุ</th><th>สถานะ</th><th></th></tr></thead><tbody id="tb-pwd"></tbody></table></div>
          </div>
        </div>
        <div class="card"><div class="card-head"><strong>ข้อมูลส่วนตัวของฉัน (FR-014)</strong><small>ดู/แก้ไขตามสิทธิ์ + ประวัติเข้าใช้งาน</small></div><div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;font-size:12px"><div><strong>นายสมศักดิ์ ใจดี</strong><br>อีเมล: somsak.p@pacc.go.th<br>หน่วย: ส่วนกลาง · บทบาท: OFFICER</div><div><button class="btn" onclick="Swal.fire('Mock','แก้ไขข้อมูลส่วนตัว (FR-014) — ชื่อ/อีเมล/เบอร์โทร','info')">แก้ไขข้อมูลส่วนตัว</button> <button class="btn" onclick="Swal.fire('Mock','ประวัติดำเนินการของฉัน (FR-030/042)','info')">ประวัติของฉัน</button></div></div></div>
      </div>
      <div class="subpanel" id="p-u-report">
        <div class="card"><div class="card-head"><strong>รายงานผู้ใช้งาน (SYS01.10 · FR-051~056)</strong><small>ค้นหา/กรอง (FR-052) · แสดงตามสิทธิ์ (FR-053) · Export Excel/PDF (FR-054/055) · บันทึกประวัติเรียกดู/ส่งออก (FR-056)</small></div>
          <div class="toolbar"><select><option>ทั้งหมด</option><option>Active</option><option>รออนุมัติ</option></select><select><option>ส่วนกลาง</option><option>เขต 1</option><option>เขต 2</option></select><button class="btn btn-primary" onclick="Swal.fire('Mock','ส่งออกรายงาน Excel/PDF + บันทึกประวัติเรียกดู (FR-054~056)','info')"><i class="fa-solid fa-file-export"></i> Export Excel/PDF</button></div>
          <div class="table-wrap"><table><thead><tr><th>รายงาน</th><th>คำอธิบาย</th><th>สิทธิ</th><th></th></tr></thead><tbody><tr><td>รายงานผู้ใช้งานตามหน่วยงาน</td><td>สรุป Active/Inactive/รออนุมัติ แยกหน่วย</td><td>Super/Admin</td><td><button class="btn btn-sm" onclick="doExport()">ดู</button></td></tr><tr><td>รายงาน Log เข้าใช้งาน</td><td>ประวัติเข้าใช้งานตามช่วงเวลา (FR-019)</td><td>ผู้ดูแล</td><td><button class="btn btn-sm">ดู</button></td></tr><tr><td>รายงานประวัติ Admin</td><td>การดำเนินการของ Admin/Super Admin (FR-030/042)</td><td>Super</td><td><button class="btn btn-sm">ดู</button></td></tr></tbody></table></div>
        </div>
      </div>
    </section>

    <!-- ===================== SYS01.09 Roles ===================== -->
    <section id="v-roles" style="display:none">
      <div class="coverage"><strong>FR ครอบ:</strong> FR-043~050 Role/Permission · FR-029·038·039 สร้าง/ปรับบทบาท · กลุ่มระบบ/เมนู FR-124~129 เชื่อมโยง — <span class="fr-tag">razor: Roles, SystemsManagement</span></div>
      <div class="kpi-row">
        <div class="kpi"><small>บทบาททั้งหมด</small><br><strong>14</strong> <small>กลุ่มสิทธิ์</small><br><small>Super Admin / Org Admin / Officer / …</small></div>
        <div class="kpi"><small>เมนูที่ต้องกำหนดสิทธิ์</small><br><strong>42</strong> <small>เมนู · ก4-14</small><br><small class="fr-tag">FR-044</small></div>
