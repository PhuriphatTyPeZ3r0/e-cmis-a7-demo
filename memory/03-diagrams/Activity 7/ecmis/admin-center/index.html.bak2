        <div class="table-wrap"><table><thead><tr><th>เวลา</th><th>ผู้ดำเนินการ</th><th>เหตุการณ์ (FR-131)</th><th>เป้าหมาย</th><th>ประเภท (FR-132)</th><th>ผล</th><th>รายละเอียด (FR-134)</th><th>IP</th></tr></thead><tbody id="tb-audit"></tbody></table></div>
      </div>
