    {t:"2026-08-14 09:00",n:"ประกาศรับสมัคร",a:"ยกเลิกเผยแพร่ (FR-089)",u:"admin-pr",v:"v1"},
  ].map(r=>`<tr><td>${r.t}</td><td>${r.n}</td><td>${r.a}</td><td>${r.u}</td><td>${r.v}</td></tr>`).join('');
}
