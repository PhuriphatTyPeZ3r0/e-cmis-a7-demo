  ["ก4 รับเรื่อง","✓","✓","✓","","","✓"],
  ["ก5 ไต่สวน","✓","✓","✓","","","✓"],
  ["ก6 คุ้มครองพยาน","✓","","","","✓",""],
  ["ก7 มติ กก.","✓","","","","✓",""],
  ["ก8 ตรวจประวัติ (CHK001/002/003)","✓","✓","✓","","✓","✓"],
  ["ก9 หมายจับ","✓","✓","✓","","✓",""],
  ["ก10 กฎหมายในคดี","✓","✓","✓","","","✓"],
  ["ก12 วิเคราะห์ (12.1-12.12)","✓","","","","","✓"],
  ["ก13 เชื่อมโยง","✓","","","","",""],
  ["ก14 บริหารกลาง","✓","✓","✓","✓","✓","✓"],
];
const TRANSFERS=[
  {d:"2026-08-15",name:"นายมานะ พากเพียร",from:"เขต 1",to:"ส่วนกลาง",reason:"ย้ายตามคำสั่ง",st:"รอปลายทาง"},
  {d:"2026-08-14",name:"นางวิไล ขยัน",from:"เขต 1",to:"เขต 2",reason:"ช่วยราชการ",st:"รอต้นทาง"},
  {d:"2026-08-10",name:"นายทดสอบ หนึ่ง",from:"กบด.",to:"เขต 1",reason:"ปรับโครงสร้าง",st:"อนุมัติแล้ว"},
];
const PERMREQS=[
  {d:"2026-08-15",name:"นายสมศักดิ์ ใจดี",from:"OFFICER",to:"DIV_DIRECTOR",reason:"รักษาการ ผอ.กลุ่ม",st:"รออนุมัติ"},
  {d:"2026-08-14",name:"นางสุดา ใจงาม",from:"OFFICER",to:"ORG_ADMIN",reason:"ดูแลระบบเขต",st:"อนุมัติแล้ว"},
];

function fillUsers(){
  const q=(document.getElementById('q-users')?.value||"").toLowerCase();
  const fs=document.getElementById('f-users-status')?.value||"", fd=document.getElementById('f-users-dept')?.value||"";
  const rows=USERS.filter(r=>(!q||`${r.u} ${r.name} ${r.dept}`.toLowerCase().includes(q))&&(!fs||r.st===fs)&&(!fd||r.dept===fd));
  const tb=document.getElementById('tb-users');
  if(tb) tb.innerHTML=rows.map(r=>`<tr><td><code>${r.u}</code></td><td>${r.name}</td><td>${r.dept}</td><td>${r.pos}</td><td><span class="badge badge-info">${r.role}</span></td><td><span class="badge ${r.st==='Active'?'badge-ok':r.st==='รออนุมัติ'?'badge-warn':r.st==='ถูกล็อก'?'badge-bad':'badge-muted'}">${r.st}</span></td><td>${r.last}</td><td>${r.st==='Active'?'<span class="badge badge-ok">FR-018</span>':'—'}</td><td><button class="btn btn-sm" onclick="Swal.fire('Mock','จัดการผู้ใช้: แก้ไข/กำหนดสถานะ Active/Inactive (FR-022/033) · ย้ายหน่วยงาน 2 ขั้น (FR-027) · ขอสิทธิ์ (FR-028)','info')">จัดการ</button></td></tr>`).join('')||`<tr><td colspan="9" style="text-align:center;color:#62738a;padding:12px">ไม่พบ</td></tr>`;
  const tp=document.getElementById('tb-pending');
  if(tp) tp.innerHTML=PENDING.map(r=>`<tr><td>${r.d}</td><td>${r.name}</td><td>${r.dept}</td><td>${r.pos}</td><td><span class="badge badge-info">${r.role}</span></td><td><span class="badge ${r.thaid==='ยืนยันแล้ว'?'badge-ok':'badge-warn'}">${r.thaid} (FR-003)</span></td><td><button class="btn btn-primary btn-sm" onclick="Swal.fire('อนุมัติ','อนุมัติ ${r.name} · สร้างบัญชี + แจ้งอีเมล (FR-006/007)','success')">อนุมัติ (FR-021)</button> <button class="btn btn-sm" onclick="Swal.fire('ปฏิเสธ','ปฏิเสธคำขอ ${r.name} (FR-006)','info')">ปฏิเสธ</button></td></tr>`).join('');
  const tf=document.getElementById('tb-transfers');
  if(tf) tf.innerHTML=TRANSFERS.map(r=>`<tr><td>${r.d}</td><td>${r.name}</td><td>${r.from}</td><td>${r.to}</td><td>${r.reason}</td><td><span class="badge ${r.st.includes('รอ')?'badge-warn':'badge-ok'}">${r.st}</span></td><td><button class="btn btn-sm" onclick="Swal.fire('Mock','พิจารณาคำขอย้าย — ต้นทาง/ปลายทาง (FR-027/095)','info')">พิจารณา</button></td></tr>`).join('');
  const pr=document.getElementById('tb-permreq');
  if(pr) pr.innerHTML=PERMREQS.map(r=>`<tr><td>${r.d}</td><td>${r.name}</td><td><span class="badge badge-info">${r.from}</span></td><td><span class="badge badge-warn">${r.to}</span></td><td>${r.reason}</td><td><span class="badge ${r.st==='รออนุมัติ'?'badge-warn':'badge-ok'}">${r.st}</span></td><td><button class="btn btn-sm" onclick="Swal.fire('Mock','รับ/พิจารณาคำขอแก้ไขสิทธิ์ (FR-028) + กำหนดบทบาท (FR-029)','info')">พิจารณา</button></td></tr>`).join('');
  const al=document.getElementById('tb-authlog');
  if(al) al.innerHTML=[
    {t:"2026-08-16 09:12",u:"somsak.p",ch:"รหัสผ่าน",rs:"สำเร็จ"},
    {t:"2026-08-16 08:44",u:"wilai.k",ch:"ThaiD",rs:"สำเร็จ"},
    {t:"2026-08-15 11:03",u:"unknown",ch:"รหัสผ่าน",rs:"ล้มเหลว"},
  ].map(r=>`<tr><td>${r.t}</td><td>${r.u}</td><td>${r.ch}</td><td><span class="badge ${r.rs==='สำเร็จ'?'badge-ok':'badge-bad'}">${r.rs}</span></td><td>10.1.2.34</td></tr>`).join('');
  const pw=document.getElementById('tb-pwd');
  if(pw) pw.innerHTML=[
    {u:"somsak.p",last:"2026-07-16",exp:"2026-10-14",st:"ปกติ"},
    {u:"wilai.k",last:"2026-05-01",exp:"2026-07-30",st:"หมดอายุ"},
  ].map(r=>`<tr><td>${r.u}</td><td>${r.last}</td><td>${r.exp}</td><td><span class="badge ${r.st==='ปกติ'?'badge-ok':'badge-bad'}">${r.st}</span></td><td><button class="btn btn-sm" onclick="Swal.fire('Mock','Admin รีเซ็ตรหัสผ่าน (FR-023/034)','info')">รีเซ็ต</button></td></tr>`).join('');
}
function fillMatrix(){
  const el=document.getElementById('tb-matrix');
  if(el) el.innerHTML=MENUS.map(m=>`<tr><td>${m[0]}</td>`+m.slice(1).map(v=>`<td style="text-align:center">${v==="✓"?'<input type="checkbox" checked>':'<input type="checkbox">'}</td>`).join('')+"</tr>").join('');
  const rl=document.getElementById('tb-roles');
  if(rl) rl.innerHTML=[
    {r:"SUPER_ADMIN",d:"ผู้ดูแลส่วนกลาง",c:2,st:"Active"},
    {r:"ORG_ADMIN",d:"Admin หน่วยงาน (เขต)",c:8,st:"Active"},
    {r:"BUREAU_DIRECTOR",d:"ผอ.กอง",c:4,st:"Active"},
    {r:"DIV_DIRECTOR",d:"ผอ.กลุ่ม",c:12,st:"Active"},
    {r:"OFFICER",d:"เจ้าหน้าที่ปฏิบัติงาน",c:298,st:"Active"},
  ].map(x=>`<tr><td><span class="badge badge-info">${x.r}</span></td><td>${x.d}</td><td>${x.c}</td><td><span class="badge badge-ok">${x.st}</span></td><td><span class="badge badge-muted">FR-050</span></td><td><button class="btn btn-sm" onclick="Swal.fire('Mock','แก้ไขบทบาท (FR-039) + บันทึกประวัติ (FR-050)','info')">แก้ไข</button></td></tr>`).join('');
  const sy=document.getElementById('tb-systems');
  if(sy) sy.innerHTML=[
    {g:"ก14 บริหารกลาง",sub:"สิทธิ์/ฐานกลาง/Audit/ลายเซ็น",m:"42 เมนู",o:"ศทส.",r:"SUPER_ADMIN"},
    {g:"ก5 ไต่สวน",sub:"รับเรื่อง/ไต่สวน",m:"18 เมนู",o:"กบด.",r:"OFFICER"},
  ].map(r=>`<tr><td>${r.g}</td><td>${r.sub}</td><td>${r.m}</td><td>${r.o}</td><td><span class="badge badge-info">${r.r}</span></td><td><span class="badge badge-ok">Active</span></td></tr>`).join('');
}
function fillDrive(){
  const an=document.getElementById('tb-announce');
  if(an) an.innerHTML=[
    {d:"2026-08-15",t:"ซ้อมแผนรับมือเหตุฉุกเฉิน",a:"ทุกคน",f:"PDF 2 ไฟล์",s:"เผยแพร่"},
    {d:"2026-08-14",t:"อบรม ThaiD สำหรับ จนท. เขต 1",a:"เขต 1",f:"รูป 3",s:"ร่าง"},
  ].map(r=>`<tr><td>${r.d}</td><td>${r.t}</td><td><span class="badge badge-info">${r.a}</span></td><td>${r.f}</td><td><span class="badge ${r.s==='เผยแพร่'?'badge-ok':'badge-warn'}">${r.s}</span></td><td><button class="btn btn-sm">ดู (FR-061)</button></td></tr>`).join('');
  const man=document.getElementById('tb-manual');
  if(man) man.innerHTML=[
    {n:"คู่มือลงทะเบียนผู้ใช้",f:"PDF",d:"2026-08-10",s:"เผยแพร่"},
    {n:"คู่มือ ThaiD",f:"PDF",d:"2026-08-12",s:"เผยแพร่"},
  ].map(r=>`<tr><td>${r.n}</td><td>${r.f}</td><td>${r.d}</td><td><span class="badge badge-ok">${r.s}</span></td></tr>`).join('');
  const vid=document.getElementById('tb-video');
  if(vid) vid.innerHTML=[
    {t:"สาธิตลงทะเบียนผู้ใช้",l:"youtube.com/...",a:"ทุกคน",s:"เผยแพร่"},
    {t:"สาธิตยื่นคำขอย้ายหน่วยงาน",l:"youtube.com/...",a:"ทุกคน",s:"เผยแพร่"},
  ].map(r=>`<tr><td>${r.t}</td><td><a href="#">${r.l}</a></td><td>${r.a}</td><td><span class="badge badge-ok">${r.s}</span></td></tr>`).join('');
  const faq=document.getElementById('tb-faq');
  if(faq) faq.innerHTML=[
    {c:"ใช้งานระบบ",q:"ลืมรหัสผ่านทำอย่างไร",a:"กดลืมรหัสผ่าน → กรอกอีเมล → รับลิงก์ (FR-012)",s:"เผยแพร่"},
    {c:"ไต่สวน",q:"ขอขยายเวลา 213 ทำอย่างไร",a:"เมนูขยายเวลา → กรอกเหตุผล → เสนอ ผอ.",s:"เผยแพร่"},
    {c:"คุ้มครองพยาน",q:"ยื่น คบ.1 ช่องทางใด",a:"เมนูคุ้มครองพยาน → สร้างคำร้อง",s:"ร่าง"},
  ].map(r=>`<tr><td><span class="badge badge-info">${r.c}</span></td><td>${r.q}</td><td>${r.a}</td><td><span class="badge ${r.s==='เผยแพร่'?'badge-ok':'badge-warn'}">${r.s} (FR-066)</span></td><td><span class="badge badge-muted">FR-069</span></td><td><button class="btn btn-sm">อ่าน (FR-068)</button></td></tr>`).join('');
  const tk=document.getElementById('tb-ticket');
  if(tk) tk.innerHTML=[
    {id:"TK-001",t:"เข้า ThaiD ไม่ได้",u:"somsak.p",cat:"Auth",st:"รับเรื่องแล้ว",o:"ศทส."},
    {id:"TK-002",t:"พิมพ์รายงานไม่ออก",u:"wilai.k",cat:"Report",st:"กำลังแก้ไข",o:"ศทส."},
    {id:"TK-003",t:"เชื่อม API หมดอายุ",u:"api-user",cat:"API",st:"ปิดแล้ว",o:"ศทส."},
  ].map(r=>`<tr><td><code>${r.id}</code></td><td>${r.t}</td><td>${r.u}</td><td>${r.cat} (FR-073)</td><td><span class="badge ${r.st==='ปิดแล้ว'?'badge-ok':r.st==='รับเรื่องแล้ว'?'badge-warn':'badge-info'}">${r.st} (FR-074)</span></td><td>${r.o}</td><td><button class="btn btn-sm" onclick="Swal.fire('Mock','FR-075 ปิดงาน + แจ้งผลกลับผู้แจ้ง · FR-076 ประวัติ','info')">ติดตาม</button></td></tr>`).join('');
  const ph=document.getElementById('tb-phone');
  if(ph) ph.innerHTML=[
    {n:"นายสมศักดิ์ ใจดี",d:"ส่วนกลาง",p:"นักสืบสวน",tel:"02-123-4567",mail:"somsak.p@pacc.go.th",s:"ทุกคน"},
    {n:"นางวิไล ขยัน",d:"เขต 1",p:"ผอ.กลุ่ม",tel:"02-123-4568",mail:"wilai.k@pacc.go.th",s:"เขต 1"},
    {n:"ศูนย์เทคโนโลยีสารสนเทศ",d:"ส่วนกลาง",p:"Helpdesk",tel:"02-123-4599",mail:"helpdesk@pacc.go.th",s:"ทุกคน"},
  ].map(r=>`<tr><td>${r.n}</td><td>${r.d}</td><td>${r.p}</td><td>${r.tel}</td><td>${r.mail}</td><td><span class="badge badge-info">${r.s} (FR-079)</span></td></tr>`).join('');
}
function fillPublicNews(){
  const el=document.getElementById('tb-publicnews');
  if(el) el.innerHTML=[
    {d:"2026-08-16",t:"ป.ป.ท. เปิดศูนย์รับเรื่องร้องเรียนใหม่",cat:"ข่าวประชาสัมพันธ์",f:"รูป 5",s:"เผยแพร่",until:"2026-09-16"},
    {d:"2026-08-12",t:"ประกาศรับสมัครเจ้าหน้าที่",cat:"ประกาศ",f:"PDF",s:"หมดอายุ",until:"2026-08-15"},
    {d:"2026-08-10",t:"กิจกรรมวันต่อต้านทุจริต",cat:"กิจกรรม",f:"วิดีโอ",s:"ร่าง",until:"—"},
  ].map(r=>`<tr><td>${r.d}</td><td>${r.t}</td><td>${r.cat} (FR-084)</td><td>${r.f}</td><td><span class="badge ${r.s==='เผยแพร่'?'badge-ok':r.s==='ร่าง'?'badge-warn':'badge-muted'}">${r.s}</span></td><td>${r.until} (FR-089)</td><td><button class="btn btn-sm" onclick="Swal.fire('Mock','Preview (FR-086) / ตรวจสอบ (FR-087)','info')">Preview</button></td></tr>`).join('');
  const cats=document.getElementById('tb-newscats');
  if(cats) cats.innerHTML=[
    {c:"ข่าวประชาสัมพันธ์",n:32},{c:"ประกาศ",n:12},{c:"กิจกรรม",n:8},{c:"บทความ",n:4},
  ].map(r=>`<tr><td>${r.c}</td><td>${r.n}</td><td>—</td><td><span class="badge badge-ok">ประชาชนค้นหาได้ (FR-088)</span></td><td><button class="btn btn-sm">จัดการ</button></td></tr>`).join('');
  const pv=document.getElementById('tb-preview');
  if(pv) pv.innerHTML=[
    {t:"กิจกรรมวันต่อต้านทุจริต",cat:"กิจกรรม",u:"admin-pr"},
  ].map(r=>`<tr><td>${r.t}</td><td>${r.cat}</td><td>${r.u}</td><td><button class="btn btn-sm" onclick="Swal.fire('Preview (FR-086)','แสดงตัวอย่างก่อนเผยแพร่','info')">Preview</button></td><td><button class="btn btn-sm" onclick="Swal.fire('ตรวจทาน (FR-087)','ตรวจสอบก่อนเผยแพร่','info')">ตรวจ</button></td><td><button class="btn btn-sm btn-primary">เผยแพร่ (FR-087)</button></td></tr>`).join('');
  const sc=document.getElementById('tb-schedule');
  if(sc) sc.innerHTML=[
    {t:"ป.ป.ท. เปิดศูนย์รับเรื่องใหม่",s:"2026-08-16",e:"2026-09-16",st:"เผยแพร่"},
    {t:"ประกาศรับสมัคร",s:"2026-08-10",e:"2026-08-15",st:"หมดอายุ (FR-089)"},
  ].map(r=>`<tr><td>${r.t}</td><td>${r.s}</td><td>${r.e}</td><td><span class="badge ${r.st.includes('เผยแพร่')?'badge-ok':'badge-muted'}">${r.st}</span></td><td><button class="btn btn-sm">แก้ไขเวลา</button></td></tr>`).join('');
  const hs=document.getElementById('tb-newshist');
  if(hs) hs.innerHTML=[
    {t:"2026-08-16 10:00",n:"ศูนย์รับเรื่องใหม่",a:"เผยแพร่",u:"admin-pr",v:"v3"},
