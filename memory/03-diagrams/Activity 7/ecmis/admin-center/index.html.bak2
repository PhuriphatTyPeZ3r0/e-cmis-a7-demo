    {t:"2026-08-15 16:21",d:"รายงาน ตว.1",u:"ผอ.กลุ่ม",ev:"sha256:9f33… ts:2026-08-15T16:21Z",rs:"สำเร็จ"},
  ].map(r=>`<tr><td>${r.t}</td><td>${r.d}</td><td>${r.u}</td><td><code>${r.ev} (FR-143)</code></td><td><span class="badge badge-ok">${r.rs} (FR-144)</span></td></tr>`).join('');
}

function route(){
  const h=location.hash||"#/users";
  document.querySelectorAll('.nav-link').forEach(b=>{
    const active=h.startsWith(b.dataset.h);
    b.classList.toggle('active',active);
  });
  document.querySelectorAll('section[id^="v-"]').forEach(s=>s.style.display='none');
  const map={"#/users":"v-users","#/roles":"v-roles","#/drive":"v-drive","#/news":"v-news","#/master":"v-master","#/audit":"v-audit","#/sign":"v-sign"};
  const key=Object.keys(map).find(k=>h.startsWith(k))||"#/users";
  const sec=document.getElementById(map[key]);
  if(sec) sec.style.display='block';
  const titles={"#/users":["ผู้ใช้งาน & ลงทะเบียน","SYS01 · FR-001~042 · 5 sub-tabs"],"#/roles":["บทบาท/สิทธิ์","SYS01.09-10 · FR-043~050 · FR-124~129"],"#/drive":["ขับเคลื่อนกระบวนงาน","SYS02 · FR-057~082 · 5 sub-tabs"],"#/news":["ประชาสัมพันธ์","SYS03 · FR-083~090 · 5 sub-tabs"],"#/master":["ฐานกลาง & API Keys","SYS04 · FR-091~129 · 6 sub-tabs"],"#/audit":["บันทึกเหตุการณ์","SYS05 · FR-130~136 · 4 sub-tabs"],"#/sign":["ลายเซ็นดิจิทัล","SYS06 · FR-137~144 · 5 sub-tabs"]};
  const t=titles[key]||titles["#/users"];
  document.getElementById('ttl').textContent=t[0];
  document.getElementById('sub').textContent=t[1];
}
function bindSubtabs(){
  document.querySelectorAll('.subtabs').forEach(g=>{
    g.querySelectorAll('button').forEach(btn=>{
      btn.addEventListener('click',()=>{
        g.querySelectorAll('button').forEach(b=>b.classList.remove('active'));
        btn.classList.add('active');
        const t=btn.dataset.t;
        const sec=g.closest('section');
        sec.querySelectorAll('.subpanel').forEach(p=>p.classList.remove('active'));
        const target=sec.querySelector('#p-'+t);
        if(target) target.classList.add('active');
      });
    });
  });
}

document.querySelectorAll('.nav-link').forEach(b=>b.addEventListener('click',()=>{location.hash=b.dataset.h}));
window.addEventListener('hashchange',route);
document.getElementById('q-users')?.addEventListener('input',fillUsers);
document.getElementById('f-users-status')?.addEventListener('change',fillUsers);
document.getElementById('f-users-dept')?.addEventListener('change',fillUsers);
document.getElementById('q-audit')?.addEventListener('input',fillAudit);
document.getElementById('q-qa')?.addEventListener('input',()=>{/* filter handled in fillDrive */});
bindSubtabs();
route(); fillUsers(); fillMatrix(); fillDrive(); fillPublicNews(); fillMaster(); fillAudit(); fillCert();
</script>
<script>
// Auth guard — require login, else redirect to login.html
(function(){
  try{
    const needLogin = !localStorage.getItem('ecmis-transform-auth-v1');
    if(needLogin){
      const next = encodeURIComponent(location.pathname + location.search);
      // from activity subfolder, login is at ../login.html
      location.replace('../login.html?next=' + next);
    }
  }catch(e){}
})();
</script>


<script>
/* ==========================================================================
   บัญชีจริงของระบบสาธิต + ตารางสิทธิ์ — อ่านจาก shared-assets/auth.js
   ก14 มีหน้าที่ "เห็นทุกคน + จัดสิทธิ์" จึงต้องผูกกับ AUTH_USERS ตัวจริง
   (ตารางเดิมด้านบนคงไว้ เพราะจำลองบัญชีระดับองค์กรคนละชุด)

   แก้ 2026-08-18: บัญชีเปลี่ยนจาก 11 บัญชีตามโฟลเดอร์ เป็น 28 คนจริงตามตำแหน่ง
   ตารางจึงสลับแกนเป็น คน(แถว) × กิจกรรม(คอลัมน์) และจัดกลุ่มตามหน่วยงาน
   ========================================================================== */
(function(){
  var A = window.ECMISAuth;
  if(!A) return;
  var ACTS = A.ACT_KEYS;
  function esc(x){ return String(x==null?"":x).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;"); }

  function card(title, sub, inner){
    return '<div class="card" style="margin-bottom:16px">'
      + '<div class="card-head"><div><h2>'+title+'</h2><p>'+sub+'</p></div>'
      + '<span class="badge"><i class="fa-solid fa-lock"></i> บังคับใช้จริง</span></div>'
      + inner + '</div>';
  }

  /* ---- บัญชีผู้ใช้ จัดตามกิจกรรมที่สังกัด ---- */
  var groups = A.usersByAct();
  var accRows = groups.map(function(g){
    return '<tr><td colspan="4" style="background:#f3f6fa;font-weight:600;color:#14294a;font-size:12px">'
         + '<i class="fa-solid ' + g.icon + '" style="color:#16558f;margin-right:6px"></i>' + esc(g.th)
         + ' <span style="color:#7a8aa3;font-weight:400">' + g.users.length + ' คน</span></td></tr>'
         + g.users.map(function(u){
             var tags = (u.readOnly ? '<span class="badge">ดูอย่างเดียว</span> ' : '')
                      + (u.manageUsers ? '<span class="badge badge-ok">จัดสิทธิ์ได้</span>' : '');
             return '<tr><td><strong>' + esc(u.u) + '</strong><br><small>รหัส ' + esc(u.p) + '</small></td>'
                  + '<td>' + esc(u.name) + '</td>'
                  + '<td><small>' + esc(u.title) + '</small><br><small style="color:#8ea0b5">' + esc(u.org||'') + '</small></td>'
                  + '<td>' + (tags || '<small style="color:#8ea0b5">—</small>') + '</td></tr>';
           }).join('');
  }).join('');

  var accounts = card("ผู้ใช้งานระบบ — แยกตามกิจกรรม (" + A.USERS.length + " บัญชี)",
    "ผู้ใช้งานหนึ่งคนสังกัดกิจกรรมเดียว · รายชื่อมาจากบทบาทที่แต่ละกิจกรรมนิยามไว้เอง · แก้ได้ที่ shared-assets/auth.js",
    '<div class="table-wrap"><table><thead><tr><th>ชื่อผู้ใช้</th><th>ชื่อ-สกุล</th><th>ตำแหน่ง / หน่วยงาน</th>'
    + '<th>คุณสมบัติพิเศษ</th></tr></thead><tbody>' + accRows + '</tbody></table></div>');

  /* ---- ตารางสิทธิ์: กิจกรรม × จำนวนผู้ใช้ ---- */
  var matRows = groups.map(function(g){
    return '<tr><td><strong>' + esc(g.short) + '</strong><br><small style="color:#8ea0b5">' + esc(g.th) + '</small></td>'
         + '<td style="text-align:center"><strong>' + g.users.length + '</strong></td>'
         + '<td><small>' + g.users.map(function(u){ return esc(u.title); }).join(' · ') + '</small></td></tr>';
  }).join('');
  var matrix = card("สิทธิ์เข้าถึงกิจกรรม",
    "ผู้ใช้งานเข้าได้เฉพาะกิจกรรมที่ตัวเองสังกัด — บังคับด้วยฉากกั้นทุกหน้า",
    '<div class="table-wrap"><table><thead><tr><th>กิจกรรม</th><th style="text-align:center">ผู้ใช้งาน</th>'
    + '<th>ตำแหน่งในกิจกรรม</th></tr></thead><tbody>' + matRows + '</tbody></table></div>');

  function mount(){
    var vu = document.getElementById("v-users");
    if(vu && !document.getElementById("realAccounts")){
      var d = document.createElement("div"); d.id="realAccounts"; d.innerHTML = accounts;
      vu.insertBefore(d, vu.firstChild);
    }
    var vr = document.getElementById("v-roles");
    if(vr && !document.getElementById("realMatrix")){
      var m = document.createElement("div"); m.id="realMatrix"; m.innerHTML = matrix;
      vr.insertBefore(m, vr.firstChild);
    }
  }
  if(document.readyState==="loading") document.addEventListener("DOMContentLoaded", function(){ setTimeout(mount,150); });
  else setTimeout(mount,150);
  setTimeout(mount, 700);
})();
</script>
</body>
</html>
