  ].map(r=>`<tr><td>${r.d}</td><td>${r.seq} (FR-142)</td><td>${r.u}</td><td><span class="badge ${r.st.includes('รอ')?'badge-warn':'badge-ok'}">${r.st}</span></td><td><button class="btn btn-sm btn-primary" onclick="Swal.fire('ลงนาม (FR-141)','ตรวจสิทธิ์ + ลงลายมือชื่อดิจิทัลตามลำดับ (FR-142) + บันทึกหลักฐาน (FR-143)','info')">ลงนาม</button></td></tr>`).join('');
