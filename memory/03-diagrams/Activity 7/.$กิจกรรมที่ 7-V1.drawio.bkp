        <mxCell id="p6_p5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#d4edda;strokeColor=#28a745;fontSize=11;" value="&lt;b&gt;นิติกร&lt;/b&gt;&lt;br&gt;จัดส่งร่างคำแก้อุทธรณ์ที่ลงนามแล้ว พร้อมสำนวนคดี ไปยังสำนักงานอัยการคดีปกครองที่รับผิดชอบ" vertex="1">
