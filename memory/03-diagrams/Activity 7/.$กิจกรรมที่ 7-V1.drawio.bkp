  <diagram id="XIyImaDH-9ulPseUoCId" name="อนุกรรมการกลั่นกรอง">
    <mxGraphModel dx="2213" dy="722" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="yLv_6xZ0DZcu6ZDXFtWu-1" parent="1" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];fontSize=16;fontStyle=1;fontColor=#003366;" value="▼ รายละเอียดกระบวนงานกลั่นกรองสำนวน คณะอนุกรรมการกลั่นกรองฯ 1-8 (ใช้ร่วมกันทั้งขั้นไต่สวนเบื้องต้นและขั้นไต่สวนชี้มูล ด้านบน)" vertex="1">
          <mxGeometry height="30" width="1100" x="115" y="60" as="geometry" />
        </mxCell>
        <mxCell id="yLv_6xZ0DZcu6ZDXFtWu-2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#d4edda;strokeColor=#28a745;fontSize=11;" value="&lt;b&gt;กองบริหารคดี (ธุรการสารบรรณกลาง)&lt;/b&gt;&lt;br&gt;มอบหมายสำนวนให้คณะอนุกรรมการกลั่นกรองฯ ตามลำดับ โดยจำกัดคณะละไม่เกิน 40 เรื่อง แล้ววนไปคณะถัดไป (คณะที่ 1-8)" vertex="1">
          <mxGeometry height="90" width="360" x="365" y="120" as="geometry" />
        </mxCell>
        <mxCell id="yLv_6xZ0DZcu6ZDXFtWu-3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#d4edda;strokeColor=#28a745;fontSize=11;" value="&lt;b&gt;ฝ่ายเลขานุการฯ คณะอนุกรรมการกลั่นกรองฯ&lt;/b&gt;&lt;br&gt;ตรวจสอบสำนวนครบถ้วน จัดทำหนังสือเชิญประชุม นัดหมายวันประชุมคณะอนุกรรมการฯ" vertex="1">
          <mxGeometry height="80" width="360" x="365" y="240" as="geometry" />
        </mxCell>
        <mxCell id="yLv_6xZ0DZcu6ZDXFtWu-4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#d4edda;strokeColor=#28a745;fontSize=11;" value="&lt;b&gt;คณะอนุกรรมการกลั่นกรองฯ (คณะที่ได้รับมอบหมาย)&lt;/b&gt;&lt;br&gt;ประชุมพิจารณาข้อเท็จจริงและข้อกฎหมาย ตั้งข้อสังเกต / ให้ความเห็นทางคดี" vertex="1">
          <mxGeometry height="90" width="360" x="365" y="350" as="geometry" />
        </mxCell>
        <mxCell id="yLv_6xZ0DZcu6ZDXFtWu-5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#d4edda;strokeColor=#28a745;fontSize=11;" value="&lt;b&gt;ประธานคณะอนุกรรมการกลั่นกรองฯ&lt;/b&gt;&lt;br&gt;ลงนามรับรองมติ / ความเห็นของคณะอนุกรรมการฯ" vertex="1">
          <mxGeometry height="80" width="360" x="365" y="470" as="geometry" />
        </mxCell>
        <mxCell id="yLv_6xZ0DZcu6ZDXFtWu-6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#d4edda;strokeColor=#28a745;fontSize=11;" value="&lt;b&gt;ฝ่ายเลขานุการฯ คณะอนุกรรมการกลั่นกรองฯ&lt;/b&gt;&lt;br&gt;ทำหนังสือแจ้งมติ/ความเห็น ส่งกลับผู้รับผิดชอบสำนวน (กอง/สำนักงาน ป.ป.ท. เขต) เพื่อเตรียมชี้แจงต่อบอร์ด" vertex="1">
          <mxGeometry height="100" width="330" x="85" y="600" as="geometry" />
        </mxCell>
        <mxCell id="yLv_6xZ0DZcu6ZDXFtWu-7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#d4edda;strokeColor=#28a745;fontSize=11;" value="&lt;b&gt;ฝ่ายเลขานุการฯ คณะอนุกรรมการกลั่นกรองฯ&lt;/b&gt;&lt;br&gt;ทำหนังสือนำส่งมติ+สำนวนคดี ผ่านกองบริหารคดี (กลุ่มงานกิจการคณะกรรมการ) เรียนประธานกรรมการ ป.ป.ท." vertex="1">
          <mxGeometry height="100" width="330" x="455" y="600" as="geometry" />
        </mxCell>
        <mxCell id="yLv_6xZ0DZcu6ZDXFtWu-8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#d4edda;strokeColor=#28a745;fontSize=11;" value="&lt;b&gt;ประธานกรรมการ ป.ป.ท.&lt;/b&gt;&lt;br&gt;สั่งบรรจุเป็นระเบียบวาระการประชุมคณะกรรมการ ป.ป.ท. (บอร์ดใหญ่)" vertex="1">
          <mxGeometry height="90" width="360" x="365" y="750" as="geometry" />
        </mxCell>
        <mxCell id="yLv_6xZ0DZcu6ZDXFtWu-9" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;" value="" vertex="1">
          <mxGeometry height="30" width="30" x="530" y="880" as="geometry" />
        </mxCell>
        <mxCell id="yLv_6xZ0DZcu6ZDXFtWu-10" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=none;" value="" vertex="1">
          <mxGeometry height="20" width="20" x="535" y="885" as="geometry" />
        </mxCell>
        <mxCell id="yLv_6xZ0DZcu6ZDXFtWu-11" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#d6b656;fontSize=10;size=14;align=left;spacing=6;" value="จ่ายคดีให้คณะที่ 1 จนครบ 40 เรื่อง จึงเปลี่ยนไปจ่ายคณะที่ 2 วนตามลำดับจนครบคณะที่ 8 แล้ววนกลับคณะที่ 1" vertex="1">
          <mxGeometry height="90" width="280" x="865" y="120" as="geometry" />
        </mxCell>
        <mxCell id="yLv_6xZ0DZcu6ZDXFtWu-12" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#d6b656;fontSize=10;size=14;align=left;spacing=6;" value="เป็น &quot;มติ + ความเห็น/ข้อสังเกตทางคดี&quot; เท่านั้น ไม่ใช่คำชี้ขาด ใช้เป็นข้อมูลกรองก่อนเข้าบอร์ดใหญ่" vertex="1">
          <mxGeometry height="90" width="280" x="865" y="240" as="geometry" />
        </mxCell>
        <mxCell id="yLv_6xZ0DZcu6ZDXFtWu-13" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#d6b656;fontSize=10;size=14;align=left;spacing=6;" value="กรณีสำนวนเกี่ยวโยงกับคณะที่เคยพิจารณามาก่อน / กรณีอนุกรรมการมีส่วนได้เสียต้องถอนตัว — ควรสอบถามผู้ใช้งานเพิ่มเติม" vertex="1">
          <mxGeometry height="130" width="280" x="865" y="350" as="geometry" />
        </mxCell>
        <mxCell id="yLv_6xZ0DZcu6ZDXFtWu-14" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#d6b656;fontSize=10;size=14;align=left;spacing=6;" value="แหล่งข้อมูลในโครงการไม่ตรงกัน บางส่วนระบุว่า &quot;ผู้รับผิดชอบสำนวน&quot; เป็นผู้ชี้แจง บางส่วนระบุว่า (เฉพาะคดีไต่สวนเบื้องต้น) &quot;ฝ่ายเลขานุการฯ&quot; ชี้แจงแทน — ยืนยันกับทีมก่อนใช้อ้างอิงจริง" vertex="1">
          <mxGeometry height="140" width="280" x="865" y="500" as="geometry" />
        </mxCell>
        <mxCell id="yLv_6xZ0DZcu6ZDXFtWu-15" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#d6b656;fontSize=10;size=14;align=left;spacing=6;" value="📄 เอกสารที่ต้องจัดทำ&#xa;หนังสือเชิญประชุม, บันทึกมติ/ความเห็น (ลงนามโดยประธานอนุฯ), หนังสือแจ้งมติกลับกอง/สำนัก, หนังสือนำส่งมติ+สำนวนถึงประธาน กก.ป.ป.ท." vertex="1">
          <mxGeometry height="130" width="280" x="-45" y="750" as="geometry" />
        </mxCell>
        <mxCell id="yLv_6xZ0DZcu6ZDXFtWu-16" edge="1" parent="1" source="yLv_6xZ0DZcu6ZDXFtWu-2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;" target="yLv_6xZ0DZcu6ZDXFtWu-3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="yLv_6xZ0DZcu6ZDXFtWu-17" edge="1" parent="1" source="yLv_6xZ0DZcu6ZDXFtWu-3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;" target="yLv_6xZ0DZcu6ZDXFtWu-4">
