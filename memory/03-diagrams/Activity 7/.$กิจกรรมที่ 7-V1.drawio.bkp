        </mxCell>
        <mxCell id="p6_p3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#d4edda;strokeColor=#28a745;fontSize=11;" value="&lt;b&gt;นิติกร&lt;/b&gt;&lt;br&gt;จัดทำคำแก้อุทธรณ์ (ค้นหาเนื้อหาด้วยมือจากสำนวนกระดาษ ไม่มีระบบสนับสนุน)" vertex="1">
