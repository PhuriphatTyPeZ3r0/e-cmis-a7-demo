        <mxCell id="p8_a2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffe0b2;strokeColor=#e65100;fontSize=11;" value="&lt;b&gt;ผู้รับผิดชอบสำนวน&lt;/b&gt;&lt;br&gt;ขอเพิ่มผู้ถูกกล่าวหา ระหว่างไต่สวนเบื้องต้นหรือไต่สวนชี้มูล" vertex="1">
          <mxGeometry height="70" width="380" x="70" y="800" as="geometry" />
        </mxCell>
        <mxCell id="p8_a3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffe0b2;strokeColor=#e65100;fontSize=11;" value="&lt;b&gt;ผู้รับผิดชอบสำนวน&lt;/b&gt;&lt;br&gt;ขอกันบุคคลใดบุคคลหนึ่งไว้เป็นพยาน" vertex="1">
