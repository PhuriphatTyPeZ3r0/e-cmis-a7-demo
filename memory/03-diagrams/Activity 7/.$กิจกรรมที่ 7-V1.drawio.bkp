        <mxCell id="p4_n1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#d4edda;strokeColor=#28a745;fontSize=11;" value="&lt;b&gt;เจ้าหน้าที่ธุรการ (กองกฎหมาย)&lt;/b&gt;&lt;br&gt;รับสำนวนคดี บันทึกข้อมูลเบื้องต้น (ผู้กล่าวหา/ผู้ถูกกล่าวหา, เลขคดีดำ-แดง, สนง.อัยการที่มีคำสั่ง)" vertex="1">
          <mxGeometry height="90" width="340" x="470" y="350" as="geometry" />
        </mxCell>
        <mxCell id="p4_n2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#d4edda;strokeColor=#28a745;fontSize=11;" value="&lt;b&gt;ผู้บังคับบัญชา&lt;/b&gt;&lt;br&gt;มอบหมายนิติกรผู้รับผิดชอบสำนวนคดี" vertex="1">
