        <mxCell id="p8_trackB_lbl" parent="1" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=2;fontColor=#666666;" value="หนังสือทั่วไป — งานธุรการ ไม่ผ่านมติบอร์ด" vertex="1">
