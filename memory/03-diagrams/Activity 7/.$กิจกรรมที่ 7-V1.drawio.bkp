        <mxCell id="p8_n3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffe0b2;strokeColor=#e65100;fontSize=11;" value="&lt;b&gt;คณะกรรมการ ป.ป.ท.&lt;/b&gt;&lt;br&gt;พิจารณาและมีมติ" vertex="1">
          <mxGeometry height="80" width="340" x="480" y="960" as="geometry" />
        </mxCell>
        <mxCell id="p8_n4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffe0b2;strokeColor=#e65100;fontSize=11;" value="&lt;b&gt;กองบริหารคดี (กบค.)&lt;/b&gt;&lt;br&gt;จัดทำมติ และเวียนหนังสือแจ้งหน่วยงานที่เกี่ยวข้อง / ออกคำสั่งที่เกี่ยวข้อง" vertex="1">
          <mxGeometry height="80" width="340" x="480" y="1080" as="geometry" />
