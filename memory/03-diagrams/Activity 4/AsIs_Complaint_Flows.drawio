        <mxCell id="T3_sys041" parent="t3_lane_citizen" value="&lt;b&gt;SYS041&lt;/b&gt;&lt;br&gt;ฝากข้อความเสียง (Voice Mail)&lt;br&gt;ไว้ในระบบสายด่วน 1206" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;" vertex="1">
