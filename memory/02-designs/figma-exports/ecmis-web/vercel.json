{
  "buildCommand": "bash vercel-build.sh",
  "outputDirectory": "release/wwwroot",
  "framework": null,
  "rewrites": [
    {
      "source": "/ecmis-admin/:path*",
      "destination": "https://ecmis-admin.onrender.com/:path*"
    },
    {
      "source": "/((?!_framework|css|js|[^/]+\\.[^/]+$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.wasm",
      "headers": [
        { "key": "Content-Type", "value": "application/wasm" }
      ]
    }
  ]
}
