<div class="reg-step @CssClass">
    <div class="reg-step-circle">
        <span class="reg-step-num">@Num</span>
    </div>
    <div class="reg-step-label">@Label</div>
</div>

@code {
    [Parameter] public int Num { get; set; }
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public int Current { get; set; }

    private string CssClass => Current > Num ? "done" : Current == Num ? "active" : "";
}
