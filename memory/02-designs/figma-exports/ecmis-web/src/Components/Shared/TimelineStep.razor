<div class="tracker-tl-item @State">
    <div class="tracker-tl-dot">
        @if (State == "done")
        {
            <i class="bi bi-check-lg"></i>
        }
        else if (State == "current")
        {
            <i class="bi bi-arrow-right"></i>
        }
        else if (State == "rejected")
        {
            <i class="bi bi-x-lg"></i>
        }
        else
        {
            <i class="bi bi-circle"></i>
        }
    </div>
    <div>
        <div class="tracker-tl-label">@Label</div>
        <div class="tracker-tl-sub">@Sub</div>
    </div>
</div>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Sub   { get; set; } = "";
    [Parameter] public string State { get; set; } = "pending";
}
