@page "/admin/api-keys"
@inject ApiKeyApiService ApiKeyService
@inject NavigationManager Nav
@using EcmisWeb.Services

<div style="background:linear-gradient(135deg,var(--navy-deep) 0%,var(--navy) 55%,#1e3575 100%);border-radius:18px;padding:24px 28px;margin-bottom:20px;position:relative;overflow:hidden" class="fade-in">
    <div style="position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,transparent,var(--gold),var(--gold-light),var(--gold),transparent)"></div>
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div style="display:flex;align-items:center;gap:14px">
            <a href="/admin/dashboard" style="color:rgba(255,255,255,.55);font-size:18px;text-decoration:none"><i class="bi bi-arrow-left"></i></a>
            <div style="width:48px;height:48px;border-radius:14px;background:linear-gradient(135deg,var(--gold),var(--gold-light));display:flex;align-items:center;justify-content:center">
                <i class="bi bi-key-fill" style="font-size:20px;color:var(--navy-deep)"></i>
            </div>
            <div>
                <div style="font-size:19px;font-weight:800;color:#fff">เผยแพร่ข้อมูลผ่าน API</div>
                <div style="font-size:12px;color:rgba(255,255,255,.55);margin-top:2px">จัดการ API Key สำหรับเผยแพร่ข้อมูล · TOBE 14.4.5</div>
            </div>
        </div>
        <a href="/admin/api-keys/create"
           style="background:linear-gradient(135deg,var(--gold),var(--gold-light));color:var(--navy-deep);border:none;border-radius:10px;padding:10px 20px;font-weight:700;font-size:13px;display:flex;align-items:center;gap:7px;text-decoration:none">
            <i class="bi bi-plus-circle-fill"></i>ออก API Key
        </a>
    </div>
</div>

@if (Stats is not null)
{
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:12px;margin-bottom:20px" class="fade-in">
        <div style="@StatCard("#0B1940","#fff")"><div style="font-size:22px;font-weight:800">@Stats.Total</div><div style="font-size:11px;opacity:.7;margin-top:2px">ทั้งหมด</div></div>
        <div style="@StatCard("#16a34a","#fff")"><div style="font-size:22px;font-weight:800">@Stats.Active</div><div style="font-size:11px;opacity:.7;margin-top:2px">ใช้งานอยู่</div></div>
        <div style="@StatCard("#d97706","#fff")"><div style="font-size:22px;font-weight:800">@Stats.Suspended</div><div style="font-size:11px;opacity:.7;margin-top:2px">ถูกระงับ</div></div>
        <div style="@StatCard("#dc2626","#fff")"><div style="font-size:22px;font-weight:800">@Stats.Expired</div><div style="font-size:11px;opacity:.7;margin-top:2px">หมดอายุ</div></div>
        <div style="@StatCard("#6b7280","#fff")"><div style="font-size:22px;font-weight:800">@Stats.UniqueAgencies</div><div style="font-size:11px;opacity:.7;margin-top:2px">หน่วยงาน</div></div>
    </div>
}

<div style="background:#fff;border-radius:16px;border:1px solid #eaecf2;margin-bottom:20px;overflow:hidden;box-shadow:0 2px 12px rgba(13,27,62,.05)" class="fade-in">
    <div style="display:flex;border-bottom:1px solid #eaecf2;background:linear-gradient(180deg,#fafbff,#fff);padding:0 8px">
        @foreach (var (label, val) in new[] { ("ทั้งหมด",""), ("ใช้งานอยู่","active"), ("ถูกระงับ","suspended"), ("หมดอายุ","expired") })
        {
            <button @onclick="@(() => SetStatusFilter(val))"
                    style="padding:14px 18px;border:none;background:none;font-size:13px;font-weight:700;cursor:pointer;font-family:'Sarabun',sans-serif;
                           color:@(StatusFilter==val ? "var(--navy-deep)" : "#8A96A8");
                           border-bottom:@(StatusFilter==val ? "2.5px solid var(--navy-deep)" : "2.5px solid transparent");
                           margin-bottom:-1px">
                @label
            </button>
        }
    </div>

    <div style="padding:16px;display:flex;gap:10px;align-items:center;flex-wrap:wrap">
        <select @bind="EndpointFilter" @bind:after="ReloadAsync"
                style="border:1.5px solid #e2e8f0;border-radius:8px;padding:7px 12px;font-size:13px;font-family:'Sarabun',sans-serif;background:#fafbff;color:#2d3748">
            <option value="">ทุก Endpoint</option>
            @foreach (var ep in Endpoints)
            {
                <option value="@ep.code">@ep.label</option>
            }
        </select>
    </div>

    @if (Loading)
    {
        <div style="padding:40px;text-align:center;color:#8A96A8"><i class="bi bi-hourglass-split me-2"></i>กำลังโหลด...</div>
    }
    else if (Keys.Count == 0)
    {
        <div style="padding:40px;text-align:center;color:#8A96A8"><i class="bi bi-key me-2"></i>ยังไม่มี API Key</div>
    }
    else
    {
        <div style="overflow-x:auto">
            <table style="width:100%;border-collapse:collapse;font-size:13px">
                <thead>
                    <tr style="background:#f8fafc;border-bottom:1.5px solid #eaecf2">
                        <th style="@Th">หน่วยงาน</th>
                        <th style="@Th">Endpoint</th>
                        <th style="@Th">Key ID</th>
                        <th style="@Th">วันออก</th>
                        <th style="@Th">หมดอายุ</th>
                        <th style="@Th">ใช้งานล่าสุด</th>
                        <th style="@Th">สถานะ</th>
                        <th style="@Th">จัดการ</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var k in Keys)
                    {
                        <tr style="border-bottom:1px solid #f1f5f9;transition:background .15s;background:@(HoverId == k.Id ? "#f8fafc" : "#fff")"
                            @onmouseenter="@(() => HoverId = k.Id)" @onmouseleave="@(() => HoverId = null)">
                            <td style="@Td">
                                <div style="font-weight:700;color:#1a202c">@k.AgencyName</div>
                                <div style="font-size:11px;color:#8A96A8">@k.ContactName · @k.ContactEmail</div>
                            </td>
                            <td style="@Td"><code style="font-size:11px;background:#f1f5f9;border-radius:4px;padding:2px 6px">/api/v1/@EndpointPath(k.EndpointCode)</code></td>
                            <td style="@Td"><code style="font-size:11px;color:#6366f1">@k.KeyPrefix…</code></td>
                            <td style="@Td;color:#64748b">@k.CreatedAt.LocalDateTime.ToString("dd/MM/yyyy")</td>
                            <td style="@Td">
                                <div style="color:@ExpiryColor(k)">@k.ExpiresAt.LocalDateTime.ToString("dd/MM/yyyy")</div>
                                <div style="font-size:10px;color:#8A96A8">@DaysLabel(k.ExpiresAt)</div>
                            </td>
                            <td style="@Td;color:#64748b;font-size:12px">
                                @(k.LastUsedAt.HasValue ? k.LastUsedAt.Value.LocalDateTime.ToString("dd/MM HH:mm") : "ยังไม่ใช้")
                            </td>
                            <td style="@Td">@StatusBadge(k.Status)</td>
                            <td style="@Td">
                                <div style="display:flex;gap:6px">
                                    <button @onclick="@(() => OpenDetail(k))" style="@ActionBtn("#6366f1")" title="รายละเอียด"><i class="bi bi-eye-fill"></i></button>
                                    @if (k.Status == "active")
                                    {
                                        <button @onclick="@(() => OpenSuspend(k))" style="@ActionBtn("#d97706")" title="ระงับ"><i class="bi bi-pause-fill"></i></button>
                                    }
                                    @if (k.Status is "active" or "suspended" or "expired")
                                    {
                                        <button @onclick="@(() => OpenRenew(k))" style="@ActionBtn("#16a34a")" title="ต่ออายุ"><i class="bi bi-arrow-clockwise"></i></button>
                                    }
                                    @if (k.Status != "revoked")
                                    {
                                        <button @onclick="@(() => OpenRevoke(k))" style="@ActionBtn("#dc2626")" title="ยกเลิก"><i class="bi bi-trash3-fill"></i></button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (TotalPages > 1)
        {
            <div style="padding:12px 16px;display:flex;justify-content:flex-end;gap:6px;border-top:1px solid #f1f5f9">
                @for (var p = 1; p <= TotalPages; p++)
                {
                    var cp = p;
                    <button @onclick="@(() => GoToPage(cp))"
                            style="border:1.5px solid @(CurrentPage==cp?"var(--navy-deep)":"#e2e8f0");background:@(CurrentPage==cp?"var(--navy-deep)":"#fff");color:@(CurrentPage==cp?"#fff":"#374151");border-radius:6px;padding:5px 11px;font-size:12px;cursor:pointer">
                        @p
                    </button>
                }
            </div>
        }
    }
</div>

@* ── Detail Panel ──────────────────────────────────────────────────────────── *@
@if (DetailKey is not null)
{
    <div style="position:fixed;top:0;right:0;width:420px;height:100vh;background:#fff;box-shadow:-4px 0 24px rgba(0,0,0,.12);z-index:1000;overflow-y:auto;padding:24px" class="fade-in">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px">
            <div style="font-size:16px;font-weight:800;color:#0B1940">รายละเอียด API Key</div>
            <button @onclick="@(() => DetailKey = null)" style="border:none;background:none;font-size:20px;cursor:pointer;color:#8A96A8">×</button>
        </div>
        <div style="display:flex;flex-direction:column;gap:10px;font-size:13px">
            <div style="background:#f8fafc;border-radius:10px;padding:12px">
                <div style="color:#8A96A8;font-size:11px">หน่วยงาน</div>
                <div style="font-weight:700">@DetailKey.AgencyName (@DetailKey.AgencyCode)</div>
                <div style="color:#64748b">@DetailKey.ContactName · @DetailKey.ContactEmail</div>
            </div>
            <div style="background:#f8fafc;border-radius:10px;padding:12px">
                <div style="color:#8A96A8;font-size:11px">Endpoint</div>
                <code style="color:#6366f1">/api/v1/@EndpointPath(DetailKey.EndpointCode)</code>
            </div>
            <div style="background:#f8fafc;border-radius:10px;padding:12px;display:grid;grid-template-columns:1fr 1fr;gap:8px">
                <div><div style="color:#8A96A8;font-size:11px">เรียกทั้งหมด</div><div style="font-weight:700;font-size:20px">@DetailKey.CallCount.ToString("N0")</div></div>
                <div><div style="color:#8A96A8;font-size:11px">สถานะ</div><div>@StatusBadge(DetailKey.Status)</div></div>
            </div>
        </div>

        @if (DetailLogs.Count > 0)
        {
            <div style="margin-top:16px;font-size:13px;font-weight:700;color:#0B1940;margin-bottom:8px">Activity Log (ล่าสุด 50 รายการ)</div>
            <div style="display:flex;flex-direction:column;gap:4px">
                @foreach (var log in DetailLogs)
                {
                    <div style="background:#f8fafc;border-radius:8px;padding:8px 10px;display:flex;justify-content:space-between;align-items:center">
                        <div>
                            <code style="font-size:11px;color:#6366f1">GET /api/v1/@EndpointPath(log.EndpointCode)</code>
                            <div style="font-size:10px;color:#8A96A8">@(log.IpAddress ?? "–")</div>
                        </div>
                        <div style="text-align:right">
                            <span style="font-size:11px;font-weight:700;color:@(log.HttpStatus < 300 ? "#16a34a" : "#dc2626")">HTTP @log.HttpStatus</span>
                            <div style="font-size:10px;color:#8A96A8">@log.CalledAt.LocalDateTime.ToString("dd/MM HH:mm")</div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
    <div @onclick="@(() => DetailKey = null)" style="position:fixed;inset:0;background:rgba(0,0,0,.3);z-index:999"></div>
}

@* ── Suspend Modal ─────────────────────────────────────────────────────────── *@
@if (SuspendTarget is not null)
{
    <div style="position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:1100;display:flex;align-items:center;justify-content:center">
        <div style="background:#fff;border-radius:16px;padding:28px;width:440px;box-shadow:0 20px 60px rgba(0,0,0,.2)">
            <div style="font-size:16px;font-weight:800;color:#0B1940;margin-bottom:12px"><i class="bi bi-pause-circle-fill me-2" style="color:#d97706"></i>ระงับ API Key</div>
            <div style="font-size:13px;color:#64748b;margin-bottom:16px">หน่วยงาน: <strong>@SuspendTarget.AgencyName</strong></div>
            <textarea @bind="SuspendReason" placeholder="เหตุผลที่ระงับ (ไม่บังคับ)"
                      style="width:100%;border:1.5px solid #e2e8f0;border-radius:8px;padding:10px;font-size:13px;font-family:'Sarabun',sans-serif;resize:vertical;min-height:80px"></textarea>
            @if (!string.IsNullOrEmpty(ModalError)) { <div style="color:#dc2626;font-size:12px;margin-top:6px">@ModalError</div> }
            <div style="display:flex;gap:10px;margin-top:16px;justify-content:flex-end">
                <button @onclick="@(() => { SuspendTarget = null; SuspendReason = ""; ModalError = ""; })"
                        style="border:1.5px solid #e2e8f0;background:#fff;border-radius:8px;padding:8px 18px;font-size:13px;cursor:pointer">ยกเลิก</button>
                <button @onclick="ConfirmSuspendAsync"
                        style="background:#d97706;color:#fff;border:none;border-radius:8px;padding:8px 20px;font-size:13px;font-weight:700;cursor:pointer">ระงับ</button>
            </div>
        </div>
    </div>
}

@* ── Renew Modal ───────────────────────────────────────────────────────────── *@
@if (RenewTarget is not null)
{
    <div style="position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:1100;display:flex;align-items:center;justify-content:center">
        <div style="background:#fff;border-radius:16px;padding:28px;width:400px;box-shadow:0 20px 60px rgba(0,0,0,.2)">
            <div style="font-size:16px;font-weight:800;color:#0B1940;margin-bottom:12px"><i class="bi bi-arrow-clockwise me-2" style="color:#16a34a"></i>ต่ออายุ API Key</div>
            <div style="font-size:13px;color:#64748b;margin-bottom:16px">หน่วยงาน: <strong>@RenewTarget.AgencyName</strong></div>
            <label style="font-size:12px;color:#64748b;display:block;margin-bottom:4px">วันหมดอายุใหม่</label>
            <input type="date" @bind="RenewDate" min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")"
                   style="width:100%;border:1.5px solid #e2e8f0;border-radius:8px;padding:8px 12px;font-size:13px" />
            @if (!string.IsNullOrEmpty(ModalError)) { <div style="color:#dc2626;font-size:12px;margin-top:6px">@ModalError</div> }
            <div style="display:flex;gap:10px;margin-top:16px;justify-content:flex-end">
                <button @onclick="@(() => { RenewTarget = null; ModalError = ""; })"
                        style="border:1.5px solid #e2e8f0;background:#fff;border-radius:8px;padding:8px 18px;font-size:13px;cursor:pointer">ยกเลิก</button>
                <button @onclick="ConfirmRenewAsync"
                        style="background:#16a34a;color:#fff;border:none;border-radius:8px;padding:8px 20px;font-size:13px;font-weight:700;cursor:pointer">ต่ออายุ</button>
            </div>
        </div>
    </div>
}

@* ── Revoke Modal ──────────────────────────────────────────────────────────── *@
@if (RevokeTarget is not null)
{
    <div style="position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:1100;display:flex;align-items:center;justify-content:center">
        <div style="background:#fff;border-radius:16px;padding:28px;width:420px;box-shadow:0 20px 60px rgba(0,0,0,.2)">
            <div style="font-size:16px;font-weight:800;color:#dc2626;margin-bottom:12px"><i class="bi bi-trash3-fill me-2"></i>ยกเลิก API Key</div>
            <div style="font-size:13px;color:#64748b;margin-bottom:16px">
                กรณีนี้ไม่สามารถกู้คืนได้ พิมพ์ <strong>REVOKE</strong> เพื่อยืนยัน
            </div>
            <input @bind="RevokeConfirmText" placeholder="พิมพ์ REVOKE"
                   style="width:100%;border:1.5px solid #e2e8f0;border-radius:8px;padding:8px 12px;font-size:13px" />
            @if (!string.IsNullOrEmpty(ModalError)) { <div style="color:#dc2626;font-size:12px;margin-top:6px">@ModalError</div> }
            <div style="display:flex;gap:10px;margin-top:16px;justify-content:flex-end">
                <button @onclick="@(() => { RevokeTarget = null; RevokeConfirmText = ""; ModalError = ""; })"
                        style="border:1.5px solid #e2e8f0;background:#fff;border-radius:8px;padding:8px 18px;font-size:13px;cursor:pointer">ยกเลิก</button>
                <button @onclick="ConfirmRevokeAsync" disabled="@(RevokeConfirmText != "REVOKE")"
                        style="background:#dc2626;color:#fff;border:none;border-radius:8px;padding:8px 20px;font-size:13px;font-weight:700;cursor:pointer;opacity:@(RevokeConfirmText=="REVOKE"?"1":".4")">ยืนยันยกเลิก</button>
            </div>
        </div>
    </div>
}

@code {
    private ApiKeyStatsDto? Stats;
    private List<ApiKeyDto> Keys = new();
    private bool Loading = true;
    private string StatusFilter = "";
    private string EndpointFilter = "";
    private int CurrentPage = 1;
    private int TotalPages = 1;
    private const int PageSize = 20;

    private int? HoverId;
    private ApiKeyDto? DetailKey;
    private List<ApiKeyAccessLogDto> DetailLogs = new();

    private ApiKeyDto? SuspendTarget;
    private string SuspendReason = "";
    private ApiKeyDto? RenewTarget;
    private DateTime RenewDate = DateTime.Today.AddYears(1);
    private ApiKeyDto? RevokeTarget;
    private string RevokeConfirmText = "";
    private string ModalError = "";

    private static readonly (string code, string label)[] Endpoints =
    [
        ("ds-001", "DS-001 — case_statistics"),
        ("ds-002", "DS-002 — case_types"),
        ("ds-003", "DS-003 — agencies"),
        ("ds-004", "DS-004 — cases_masked"),
        ("ds-005", "DS-005 — performance"),
    ];

    protected override async Task OnInitializedAsync()
    {
        Stats = await ApiKeyService.GetStatsAsync();
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        Loading = true;
        StateHasChanged();
        var result = await ApiKeyService.ListAsync(
            status: string.IsNullOrEmpty(StatusFilter) ? null : StatusFilter,
            endpoint: string.IsNullOrEmpty(EndpointFilter) ? null : EndpointFilter,
            page: CurrentPage, pageSize: PageSize);
        Keys = result?.Data?.ToList() ?? new();
        TotalPages = result is not null ? (int)Math.Ceiling(result.Total / (double)PageSize) : 1;
        Loading = false;
    }

    private async Task SetStatusFilter(string val)
    {
        StatusFilter = val;
        CurrentPage = 1;
        await ReloadAsync();
    }

    private async Task GoToPage(int p)
    {
        CurrentPage = p;
        await ReloadAsync();
    }

    private async Task OpenDetail(ApiKeyDto k)
    {
        DetailKey = k;
        DetailLogs = new();
        var detail = await ApiKeyService.GetDetailAsync(k.Id);
        if (detail is not null)
        {
            DetailKey = detail.Key;
            DetailLogs = detail.Logs?.ToList() ?? new();
        }
    }

    private void OpenSuspend(ApiKeyDto k) { SuspendTarget = k; SuspendReason = ""; ModalError = ""; }
    private void OpenRenew(ApiKeyDto k) { RenewTarget = k; RenewDate = DateTime.Today.AddYears(1); ModalError = ""; }
    private void OpenRevoke(ApiKeyDto k) { RevokeTarget = k; RevokeConfirmText = ""; ModalError = ""; }

    private async Task ConfirmSuspendAsync()
    {
        if (SuspendTarget is null) return;
        var ok = await ApiKeyService.SuspendAsync(SuspendTarget.Id, SuspendReason);
        if (ok) { SuspendTarget = null; SuspendReason = ""; Stats = await ApiKeyService.GetStatsAsync(); await ReloadAsync(); }
        else ModalError = "เกิดข้อผิดพลาด กรุณาลองใหม่";
    }

    private async Task ConfirmRenewAsync()
    {
        if (RenewTarget is null) return;
        if (RenewDate <= DateTime.Today) { ModalError = "วันหมดอายุต้องอยู่ในอนาคต"; return; }
        var ok = await ApiKeyService.RenewAsync(RenewTarget.Id, new DateTimeOffset(RenewDate));
        if (ok) { RenewTarget = null; Stats = await ApiKeyService.GetStatsAsync(); await ReloadAsync(); }
        else ModalError = "เกิดข้อผิดพลาด กรุณาลองใหม่";
    }

    private async Task ConfirmRevokeAsync()
    {
        if (RevokeTarget is null || RevokeConfirmText != "REVOKE") return;
        var ok = await ApiKeyService.RevokeAsync(RevokeTarget.Id);
        if (ok) { RevokeTarget = null; RevokeConfirmText = ""; Stats = await ApiKeyService.GetStatsAsync(); await ReloadAsync(); }
        else ModalError = "เกิดข้อผิดพลาด กรุณาลองใหม่";
    }

    private static string EndpointPath(string code) => code switch
    {
        "ds-001" => "case_statistics",
        "ds-002" => "case_types",
        "ds-003" => "agencies",
        "ds-004" => "cases_masked",
        "ds-005" => "performance",
        _ => code
    };

    private static string ExpiryColor(ApiKeyDto k)
    {
        var days = (k.ExpiresAt - DateTimeOffset.Now).TotalDays;
        return days < 0 ? "#dc2626" : days < 30 ? "#d97706" : "#16a34a";
    }

    private static string DaysLabel(DateTimeOffset expiresAt)
    {
        var days = (int)(expiresAt - DateTimeOffset.Now).TotalDays;
        return days < 0 ? $"หมดอายุ {-days} วันที่แล้ว" : $"เหลือ {days} วัน";
    }

    private static MarkupString StatusBadge(string status) => (MarkupString)(status switch
    {
        "active" => "<span style='background:#dcfce7;color:#16a34a;border-radius:20px;padding:2px 10px;font-size:11px;font-weight:700'>ใช้งานอยู่</span>",
        "suspended" => "<span style='background:#fef3c7;color:#d97706;border-radius:20px;padding:2px 10px;font-size:11px;font-weight:700'>ถูกระงับ</span>",
        "expired" => "<span style='background:#fee2e2;color:#dc2626;border-radius:20px;padding:2px 10px;font-size:11px;font-weight:700'>หมดอายุ</span>",
        "revoked" => "<span style='background:#f1f5f9;color:#64748b;border-radius:20px;padding:2px 10px;font-size:11px;font-weight:700'>ยกเลิกแล้ว</span>",
        _ => status
    });

    private static string StatCard(string bg, string color) =>
        $"background:{bg};color:{color};border-radius:12px;padding:16px 18px;";
