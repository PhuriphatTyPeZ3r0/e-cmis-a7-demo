@page "/admin/approvals"
@inject EcmisWeb.Services.AdminApiService AdminApi
@inject EcmisWeb.Services.SystemAccessApiService SystemApi
@inject NavigationManager Nav
@using EcmisWeb.Services

@* ── HERO ── *@
<div style="background:linear-gradient(135deg,var(--navy-deep) 0%,var(--navy) 55%,#1e3575 100%);border-radius:18px;padding:24px 28px;margin-bottom:20px;position:relative;overflow:hidden" class="fade-in">
    <div style="position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,transparent,var(--gold),var(--gold-light),var(--gold),transparent)"></div>
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div style="display:flex;align-items:center;gap:14px">
            <a href="/admin/dashboard" style="color:rgba(255,255,255,.55);font-size:18px;text-decoration:none"><i class="bi bi-arrow-left"></i></a>
            <div style="width:48px;height:48px;border-radius:14px;background:linear-gradient(135deg,var(--gold),var(--gold-light));display:flex;align-items:center;justify-content:center;flex-shrink:0">
                <i class="bi bi-clipboard-check-fill" style="font-size:20px;color:var(--navy-deep)"></i>
            </div>
            <div>
                <div style="font-size:19px;font-weight:800;color:#fff">อนุมัติคำขอ</div>
                <div style="font-size:12px;color:rgba(255,255,255,.55);margin-top:2px">ลงทะเบียน · ระบบงาน · หน่วยงาน · ตำแหน่ง · สิทธิ์การเข้าถึง</div>
            </div>
        </div>
        <div class="d-flex gap-2 flex-wrap align-items-center">
            <a href="/admin/transfers" class="btn btn-sm" style="background:rgba(255,255,255,.12);color:#fff;border:1px solid rgba(255,255,255,.2);font-size:12px;border-radius:8px;padding:8px 14px;font-weight:700;text-decoration:none">
                <i class="bi bi-arrow-left-right me-1"></i>คำขอย้ายหน่วยงาน
            </a>
            <button @onclick="LoadAllAsync" class="btn btn-sm" disabled="@Loading" style="background:rgba(255,255,255,.12);color:#fff;border:1px solid rgba(255,255,255,.2);font-size:12px;border-radius:8px;padding:8px 14px;font-weight:700">
                <i class="bi bi-arrow-clockwise me-1"></i>@(Loading ? "กำลังโหลด..." : "รีเฟรช")
            </button>
        </div>
    </div>
</div>

@* ── TAB BAR ── *@
<div style="background:#fff;border-radius:16px;border:1px solid #eaecf2;margin-bottom:20px;overflow:hidden;box-shadow:0 2px 12px rgba(13,27,62,.05)" class="fade-in">
    <div style="display:flex;border-bottom:1px solid #eaecf2;background:linear-gradient(180deg,#fafbff,#fff);padding:0 8px;overflow-x:auto">
        @foreach (var t in Tabs)
        {
            <button @onclick="() => SetTab(t.Key)"
                    style="padding:14px 20px;border:none;background:none;font-size:13px;font-weight:700;cursor:pointer;
                           color:@(ActiveTab == t.Key ? "var(--navy-deep)" : "#8A96A8");
                           border-bottom:@(ActiveTab == t.Key ? "2.5px solid var(--navy-deep)" : "2.5px solid transparent");
                           display:flex;align-items:center;gap:7px;white-space:nowrap;margin-bottom:-1px;font-family:'Sarabun',sans-serif">
                <i class="bi @t.Icon" style="font-size:14px"></i>@t.Label
                @{ var c = Count(t.Key); }
                @if (c > 0)
                {
                    <span style="background:@t.Color;color:#fff;border-radius:20px;padding:1px 8px;font-size:10.5px;font-weight:700">@c</span>
                }
            </button>
        }
    </div>
</div>

@if (!string.IsNullOrEmpty(ActionMessage))
{
    <div style="background:#f0fdf4;border:1.5px solid #bbf7d0;border-radius:10px;padding:12px 16px;margin-bottom:16px;font-size:13px;color:#15803d">
        <i class="bi bi-check-circle-fill me-2"></i>@ActionMessage
    </div>
}
@if (!string.IsNullOrEmpty(ActionError))
{
    <div style="background:#fef2f2;border:1.5px solid #fecaca;border-radius:10px;padding:12px 16px;margin-bottom:16px;font-size:13px;color:#991b1b">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@ActionError
    </div>
}

@* ══════════════════════════════
   TAB: Registration
══════════════════════════════ *@
@if (ActiveTab == "registration")
{
    <div class="ecmis-card fade-in">
        <div class="ecmis-card-header">
            <div class="ecmis-card-title"><span class="badge-dot"></span>คำขอลงทะเบียนใหม่</div>
            <div style="font-size:12px;color:var(--text-muted)">@PendingRegs.Count รายการ</div>
        </div>
        @if (PendingRegs.Count == 0)
        {
            <div style="padding:40px;text-align:center;color:var(--text-muted)">
                <i class="bi bi-inbox" style="font-size:32px"></i>
                <div style="margin-top:8px">ไม่มีคำขอรอดำเนินการ</div>
            </div>
        }
        else
        {
            <div style="overflow-x:auto">
                <table class="ecmis-table">
                    <thead><tr>
                        <th>ผู้สมัคร</th>
                        <th>สถานะ</th>
                        <th>ส่งเมื่อ</th>
                        <th>เลขติดตาม</th>
                        <th style="text-align:center">จัดการ</th>
                    </tr></thead>
                    <tbody>
                        @foreach (var r in PendingRegs)
                        {
                            <tr>
                                <td>
                                    <div style="font-weight:700;font-size:13px">@($"{r.FirstName} {r.LastName}".Trim())</div>
                                    <div style="font-size:11px;color:var(--text-muted)">@r.Email · @r.Username</div>
                                </td>
                                <td>
                                    <span style="background:#fef9c3;color:#854d0e;border:1px solid #fde047;border-radius:5px;padding:2px 8px;font-size:11px;font-weight:700;white-space:nowrap">
                                        <i class="bi bi-clock me-1"></i>รออนุมัติ
                                    </span>
                                </td>
                                <td style="font-size:11.5px;color:var(--text-muted)">@r.CreatedAt.ToLocalTime().ToString("dd/MM/yy HH:mm")</td>
                                <td style="font-family:monospace;font-size:11.5px">@r.TrackingId</td>
                                <td style="text-align:center">
                                    <div class="d-flex gap-1 justify-content-center">
                                        <a href="@($"/admin/registrations/{r.Id}")" class="btn btn-sm" style="background:#16a34a;color:#fff;border:none;font-size:11px;border-radius:6px;padding:3px 10px;font-weight:700;text-decoration:none"><i class="bi bi-check-lg me-1"></i>พิจารณา</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

@* ══════════════════════════════
   TAB: System Access
══════════════════════════════ *@
@if (ActiveTab == "system-access")
{
    <div class="ecmis-card fade-in">
        <div class="ecmis-card-header">
            <div class="ecmis-card-title"><span class="badge-dot"></span>คำขอเข้าใช้งานระบบงาน</div>
            <div style="font-size:12px;color:var(--text-muted)">@PendingSysAccess.Count รายการ</div>
        </div>
        @if (PendingSysAccess.Count == 0)
        {
            <div style="padding:40px;text-align:center;color:var(--text-muted)">
                <i class="bi bi-inbox" style="font-size:32px"></i>
                <div style="margin-top:8px">ไม่มีคำขอรอดำเนินการ</div>
            </div>
        }
        else
        {
            <div style="overflow-x:auto">
                <table class="ecmis-table">
                    <thead><tr>
                        <th>ผู้ขอ</th>
                        <th>ระบบงาน</th>
                        <th>เหตุผล</th>
                        <th>ส่งเมื่อ</th>
                        <th style="text-align:center">จัดการ</th>
                    </tr></thead>
                    <tbody>
                        @foreach (var s in PendingSysAccess)
                        {
                            <tr>
                                <td>
                                    <div style="font-weight:700;font-size:13px">@($"{s.FirstName} {s.LastName}".Trim())</div>
                                    <div style="font-size:11px;color:var(--text-muted)">@s.Email · @s.Username</div>
                                </td>
                                <td>
                                    <span style="border-radius:5px;padding:3px 8px;font-size:11px;font-weight:700;background:#e0f2fe;color:#0369a1">@s.SystemCode</span>
                                    <div style="font-size:11px;color:var(--text-muted);margin-top:2px">@s.SystemName</div>
                                </td>
                                <td style="font-size:12px;max-width:280px">@(string.IsNullOrEmpty(s.RequestedReason) ? "—" : s.RequestedReason)</td>
                                <td style="font-size:11.5px;color:var(--text-muted)">@s.RequestedAt.ToLocalTime().ToString("dd/MM/yy HH:mm")</td>
                                <td style="text-align:center">
                                    <div class="d-flex gap-1 justify-content-center">
                                        <button @onclick="() => ApproveSysAccessAsync(s.Id)" disabled="@Busy" class="btn btn-sm" style="background:#16a34a;color:#fff;border:none;font-size:11px;border-radius:6px;padding:3px 10px;font-weight:700"><i class="bi bi-check-lg me-1"></i>อนุมัติ</button>
                                        <button @onclick="@(() => OpenRejectModal(s.Id, "system-access"))" disabled="@Busy" class="btn btn-sm" style="background:#fff;border:1px solid #fca5a5;color:#dc2626;font-size:11px;border-radius:6px;padding:3px 8px;font-weight:700"><i class="bi bi-x-lg"></i></button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

@* ══════════════════════════════
   TAB: Org / Role Change
══════════════════════════════ *@
@if (ActiveTab is "org-change" or "role-change" or "position-change")
{
    var list = ActiveTab switch
    {
        "org-change" => PendingOrgChange,
        "role-change" => PendingRoleChange,
        _ => PendingPositionChange
    };
    var label = ChangeRequestDisplay.ApprovalTargetColumnHeader(ActiveTab);
    var cardTitle = ChangeRequestDisplay.ApprovalCardTitle(ActiveTab);

    <div class="ecmis-card fade-in">
        <div class="ecmis-card-header">
            <div class="ecmis-card-title"><span class="badge-dot"></span>@cardTitle</div>
            <div style="font-size:12px;color:var(--text-muted)">@list.Count รายการ</div>
        </div>
        @if (list.Count == 0)
        {
            <div style="padding:40px;text-align:center;color:var(--text-muted)">
                <i class="bi bi-inbox" style="font-size:32px"></i>
                <div style="margin-top:8px">ไม่มีคำขอรอดำเนินการ</div>
            </div>
        }
        else
        {
            <div style="overflow-x:auto">
                <table class="ecmis-table">
                    <thead><tr>
                        <th>ผู้ขอ</th>
                        <th>@label ใหม่</th>
                        <th>เหตุผล</th>
                        <th>ส่งเมื่อ</th>
                        <th>ไฟล์แนบ</th>
                        <th style="text-align:center">จัดการ</th>
                    </tr></thead>
                    <tbody>
                        @foreach (var c in list)
                        {
                            <tr>
                                <td>
                                    <div style="font-weight:700;font-size:13px">@(string.IsNullOrEmpty(c.FullName) ? c.Username : c.FullName)</div>
                                    <div style="font-size:11px;color:var(--text-muted)">@c.Email</div>
                                </td>
                                <td style="font-size:12.5px">@ChangeTargetLabel(c)</td>
                                <td style="font-size:12px;max-width:280px">@(string.IsNullOrEmpty(c.Reason) ? "—" : c.Reason)</td>
                                <td style="font-size:11.5px;color:var(--text-muted)">@c.RequestedAt.ToLocalTime().ToString("dd/MM/yy HH:mm")</td>
                                <td>
                                    @if (c.AttachmentId.HasValue)
                                    {
                                        <a href="@($"/api/uploads/{c.AttachmentId.Value}/download")" target="_blank" class="btn btn-sm btn-outline-secondary" style="font-size:11px;border-radius:6px;padding:3px 8px"><i class="bi bi-file-earmark me-1"></i>เปิด</a>
                                    }
                                    else
                                    {
                                        <span style="font-size:11px;color:var(--text-muted)">—</span>
                                    }
                                </td>
                                <td style="text-align:center">
                                    <div class="d-flex gap-1 justify-content-center">
                                        <button @onclick="() => ApproveChangeAsync(c.Id)" disabled="@Busy" class="btn btn-sm" style="background:#16a34a;color:#fff;border:none;font-size:11px;border-radius:6px;padding:3px 10px;font-weight:700"><i class="bi bi-check-lg me-1"></i>อนุมัติ</button>
                                        <button @onclick="() => OpenRejectModal(c.Id, ActiveTab)" disabled="@Busy" class="btn btn-sm" style="background:#fff;border:1px solid #fca5a5;color:#dc2626;font-size:11px;border-radius:6px;padding:3px 8px;font-weight:700"><i class="bi bi-x-lg"></i></button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

@* ══════════════════════════════
   TAB: Individual Access Request
══════════════════════════════ *@
@if (ActiveTab == "individual")
{
    <div class="ecmis-card fade-in">
        <div class="ecmis-card-header">
            <div class="ecmis-card-title"><span class="badge-dot"></span>คำขอสิทธิ์การเข้าถึงรายบุคคล</div>
            <div style="font-size:12px;color:var(--text-muted);margin-top:2px">@PendingIndividual.Count รายการที่รอพิจารณา — tscr_type='07'</div>
        </div>
        @if (!PendingIndividual.Any())
        {
            <div style="padding:40px;text-align:center;color:var(--text-muted)">
                <i class="bi bi-person-check" style="font-size:32px;display:block;margin-bottom:8px"></i>
                <div style="margin-top:8px">ไม่มีคำขอรอดำเนินการ</div>
            </div>
        }
        else
        {
            <div style="overflow-x:auto">
                <table class="ecmis-table">
                    <thead><tr>
                        <th>ผู้ขอ</th>
                        <th>สิทธิ์ที่ขอ</th>
                        <th>เหตุผล</th>
                        <th>ส่งเมื่อ</th>
                        <th style="text-align:center">จัดการ</th>
                    </tr></thead>
                    <tbody>
                        @foreach (var r in PendingIndividual)
                        {
                            <tr>
                                <td>
                                    <div style="font-weight:700;font-size:13px">@(string.IsNullOrEmpty(r.FullName) ? r.Username : r.FullName)</div>
                                    <div style="font-size:11px;color:var(--text-muted)">@r.Email</div>
                                </td>
                                <td style="font-size:12.5px">
                                    @ChangeTargetLabel(r)
                                    <div style="font-size:10px;color:var(--text-muted)">@r.RequestType</div>
                                </td>
                                <td style="font-size:12px;max-width:280px">@(string.IsNullOrEmpty(r.Reason) ? "—" : r.Reason)</td>
                                <td style="font-size:11.5px;color:var(--text-muted)">@r.RequestedAt.ToLocalTime().ToString("dd/MM/yy HH:mm")</td>
                                <td style="text-align:center">
                                    <div class="d-flex gap-1 justify-content-center">
                                        <button @onclick="() => ApproveChangeAsync(r.Id)" disabled="@Busy" class="btn btn-sm" style="background:#16a34a;color:#fff;border:none;font-size:11px;border-radius:6px;padding:3px 10px;font-weight:700"><i class="bi bi-check-lg me-1"></i>อนุมัติ</button>
                                        <button @onclick="() => OpenRejectModal(r.Id, ActiveTab)" disabled="@Busy" class="btn btn-sm" style="background:#fff;border:1px solid #fca5a5;color:#dc2626;font-size:11px;border-radius:6px;padding:3px 8px;font-weight:700"><i class="bi bi-x-lg"></i></button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

@* ── REJECT MODAL ── *@
@if (RejectModalOpen)
{
    <div style="position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(11,25,64,.5);z-index:1050;display:flex;align-items:center;justify-content:center;backdrop-filter:blur(4px)" class="fade-in">
        <div style="background:#fff;border-radius:16px;width:100%;max-width:480px;overflow:hidden;box-shadow:0 12px 40px rgba(13,27,62,.15)">
            <div style="background:linear-gradient(135deg,#991b1b,#dc2626);padding:18px 22px;display:flex;align-items:center;justify-content:space-between">
                <div style="font-size:15px;font-weight:800;color:#fff"><i class="bi bi-x-circle-fill me-2"></i>ปฏิเสธคำขอ</div>
                <button @onclick="CloseRejectModal" style="background:none;border:none;color:rgba(255,255,255,.85);font-size:18px;cursor:pointer"><i class="bi bi-x-lg"></i></button>
            </div>
            <div style="padding:18px 22px">
                <label style="font-size:12px;font-weight:700;color:var(--text-muted);margin-bottom:6px;display:block">เหตุผลการปฏิเสธ <span style="color:#dc2626">*</span></label>
                <textarea @bind="RejectReason" rows="4" style="width:100%;border:1.5px solid #e2e6f0;border-radius:9px;padding:10px;font-size:13px;font-family:'Sarabun',sans-serif" placeholder="ระบุเหตุผลที่ปฏิเสธ..."></textarea>
            </div>
            <div style="padding:14px 22px;border-top:1px solid #eaecf2;background:#fafbff;display:flex;justify-content:flex-end;gap:8px">
                <button @onclick="CloseRejectModal" class="btn btn-outline-secondary" style="font-size:12px;font-weight:700;border-radius:8px;padding:7px 18px">ยกเลิก</button>
                <button @onclick="ConfirmRejectAsync" disabled="@(Busy || string.IsNullOrWhiteSpace(RejectReason))" class="btn" style="background:#dc2626;color:#fff;border:none;font-size:12px;font-weight:700;border-radius:8px;padding:7px 18px">ยืนยันปฏิเสธ</button>
            </div>
        </div>
    </div>
}

@code {
    private string ActiveTab = "registration";
    private bool Loading;
    private bool Busy;
    private string? ActionMessage;
    private string? ActionError;

    private List<RegistrationDto> PendingRegs = new();
    private List<PendingSystemAccessDto> PendingSysAccess = new();
    private List<PendingChangeRequestDto> PendingOrgChange = new();
    private List<PendingChangeRequestDto> PendingRoleChange = new();
    private List<PendingChangeRequestDto> PendingPositionChange = new();
    private List<PendingChangeRequestDto> PendingIndividual = new();

    private record TabItem(string Key, string Label, string Icon, string Color);
    private List<TabItem> Tabs = new()
    {
        new("registration",   "ลงทะเบียน",        "bi-person-plus-fill",      "#d97706"),
        new("system-access",  "ระบบงาน",          "bi-box-arrow-in-right",    "#2563eb"),
        new("org-change",     "แก้ไขหน่วยงาน",     "bi-building",              "#0e7c7b"),
        new("role-change",    "สิทธิ์การเข้าถึง",   "bi-shield-shaded",         "#9333ea"),
        new("position-change","แก้ไขตำแหน่ง",      "bi-person-badge",          "#b45309"),
        new("individual",     "สิทธิ์รายบุคคล",    "bi-person-lines-fill",     "#0891b2")
    };

    private bool RejectModalOpen;
    private int RejectTargetId;
    private string RejectTargetType = "";
    private string RejectReason = "";

    protected override async Task OnInitializedAsync()
    {
        // tab from ?tab=... query string
        var query = Nav.ToAbsoluteUri(Nav.Uri).Query.TrimStart('?');
        foreach (var pair in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var kv = pair.Split('=', 2);
            if (kv.Length == 2 && kv[0] == "tab")
            {
                var t = Uri.UnescapeDataString(kv[1]);
                if (Tabs.Any(x => x.Key == t)) { ActiveTab = t; }
                break;
            }
        }
        await LoadAllAsync();
    }

    private void SetTab(string key)
    {
        ActiveTab = key;
        ActionMessage = null;
        ActionError = null;
    }

    private int Count(string key) => key switch
    {
        "registration" => PendingRegs.Count,
        "system-access" => PendingSysAccess.Count,
        "org-change" => PendingOrgChange.Count,
        "role-change" => PendingRoleChange.Count,
        "position-change" => PendingPositionChange.Count,
        "individual" => PendingIndividual.Count,
        _ => 0
    };

    private async Task LoadAllAsync()
    {
        Loading = true;
        try
        {
            var t1 = SafeList(() => AdminApi.GetRegistrationsAsync("pending"));
            var t2 = SafeList(() => SystemApi.PendingSystemAccessAsync());
            var t3 = SafeList(() => SystemApi.PendingChangeRequestsAsync("org"));
            var t4 = SafeList(() => SystemApi.PendingChangeRequestsAsync("role"));
            var t5 = SafeList(() => SystemApi.PendingChangeRequestsAsync("position"));
            var t6 = SafeList(() => SystemApi.PendingChangeRequestsAsync("individual"));
            await Task.WhenAll(t1, t2, t3, t4, t5, t6);
            PendingRegs = await t1 ?? new();
            PendingSysAccess = await t2 ?? new();
            PendingOrgChange = await t3 ?? new();
            PendingRoleChange = await t4 ?? new();
            PendingPositionChange = await t5 ?? new();
            PendingIndividual = await t6 ?? new();
        }
        finally
        {
            Loading = false;
            StateHasChanged();
        }
    }

    private static async Task<List<T>?> SafeList<T>(Func<Task<List<T>>> fn)
    {
        try { return await fn(); } catch { return null; }
    }

    // ── System access actions
    private async Task ApproveSysAccessAsync(int id)
    {
        Busy = true; ActionMessage = null; ActionError = null;
        try
        {
            await SystemApi.ApproveSystemAccessAsync(id);
            ActionMessage = "อนุมัติสิทธิ์เข้าใช้งานระบบแล้ว";
            await LoadAllAsync();
        }
        catch (Exception ex) { ActionError = ex.Message; }
        finally { Busy = false; StateHasChanged(); }
    }

    // ── Change request actions
    private async Task ApproveChangeAsync(int id)
    {
        Busy = true; ActionMessage = null; ActionError = null;
        try
        {
            await SystemApi.ApproveChangeRequestAsync(id);
            ActionMessage = "อนุมัติคำขอแล้ว";
            await LoadAllAsync();
        }
        catch (Exception ex) { ActionError = ex.Message; }
        finally { Busy = false; StateHasChanged(); }
    }

    // ── Unified reject flow
    private void OpenRejectModal(int id, string type)
    {
        RejectTargetId = id;
        RejectTargetType = type;
        RejectReason = "";
        RejectModalOpen = true;
    }

    private void CloseRejectModal()
    {
        RejectModalOpen = false;
        RejectReason = "";
    }

    private async Task ConfirmRejectAsync()
    {
        if (string.IsNullOrWhiteSpace(RejectReason)) return;
        Busy = true; ActionMessage = null; ActionError = null;
        try
        {
            switch (RejectTargetType)
            {
                case "registration":
                    await AdminApi.RejectRegistrationAsync(RejectTargetId, RejectReason, null);
                    break;
                case "system-access":
                    await SystemApi.RejectSystemAccessAsync(RejectTargetId, RejectReason);
                    break;
                case "org-change":
                case "role-change":
                case "position-change":
                case "individual":
                    await SystemApi.RejectChangeRequestAsync(RejectTargetId, RejectReason);
                    break;
            }
            ActionMessage = "ปฏิเสธคำขอแล้ว";
            CloseRejectModal();
            await LoadAllAsync();
        }
        catch (Exception ex) { ActionError = ex.Message; }
        finally { Busy = false; StateHasChanged(); }
    }

    private static string ChangeTargetLabel(PendingChangeRequestDto c) =>
        ChangeRequestDisplay.TargetLabel(c.RequestType, c.TargetOrgName, c.TargetPositionName, c.TargetRoleName);
}
