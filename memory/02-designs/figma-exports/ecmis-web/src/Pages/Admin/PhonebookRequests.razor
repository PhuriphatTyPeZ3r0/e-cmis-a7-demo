@page "/admin/phonebook-requests"
@using EcmisWeb.Services
@inject CentralSupportApiService CentralSupportApi

<PageTitle>คำขออัปเดตสมุดโทรศัพท์ — E-CMIS Admin</PageTitle>

<div style="background:linear-gradient(135deg,var(--navy-deep) 0%,var(--navy) 60%,#1e3575 100%);border-radius:18px;padding:28px 32px;margin-bottom:24px;position:relative;overflow:hidden">
    <div style="position:absolute;top:-40px;right:-40px;width:220px;height:220px;border-radius:50%;background:rgba(201,168,76,.08);pointer-events:none"></div>
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
        <div>
            <div style="display:flex;align-items:center;gap:10px;margin-bottom:6px">
                <div style="width:40px;height:40px;border-radius:12px;background:linear-gradient(135deg,var(--gold),var(--gold-light));display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0">
                    <i class="bi bi-telephone-fill" style="color:var(--navy-deep)"></i>
                </div>
                <div>
                    <div style="font-size:20px;font-weight:800;color:#fff;line-height:1.2">คำขออัปเดตสมุดโทรศัพท์</div>
                    <div style="font-size:12px;color:rgba(255,255,255,.5)">Phonebook Update Requests — Central Support</div>
                </div>
            </div>
        </div>
        <div class="d-flex gap-2 align-items-center flex-wrap">
            <a href="/admin/support-tickets" class="btn btn-sm" style="background:rgba(255,255,255,.15);color:#fff;border:1px solid rgba(255,255,255,.25)">
                <i class="bi bi-headset me-1"></i>IT Support Tickets
            </a>
            <div style="background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.15);border-radius:12px;padding:10px 16px;min-width:80px;text-align:center">
                <div style="font-size:10px;font-weight:700;color:rgba(255,255,255,.5);text-transform:uppercase;letter-spacing:.08em">รอดำเนินการ</div>
                <div style="font-size:22px;font-weight:900;color:#fbbf24;line-height:1">@requests.Count(r => r.Status == "pending_review")</div>
            </div>
            <button class="btn-navy" style="background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.25)" @onclick="Load" disabled="@loading">
                <i class="bi bi-arrow-clockwise"></i>
            </button>
        </div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(error))
{
    <div style="background:#fef2f2;color:#991b1b;border:1px solid #fecaca;border-radius:8px;padding:12px 16px;margin-bottom:14px;display:flex;gap:10px;align-items:center">
        <i class="bi bi-exclamation-triangle-fill"></i>@error
    </div>
}
@if (!string.IsNullOrWhiteSpace(successMsg))
{
    <div style="background:#ecfdf5;color:#065f46;border:1px solid #bbf7d0;border-radius:8px;padding:12px 16px;margin-bottom:14px;display:flex;gap:10px;align-items:center">
        <i class="bi bi-check-circle-fill"></i>@successMsg
    </div>
}

<div style="display:grid;grid-template-columns:minmax(0,1fr) 360px;gap:16px;align-items:start">
    @* — Request list — *@
    <div style="background:#fff;border:1px solid #e5e7eb;border-radius:12px;overflow:hidden;box-shadow:0 4px 16px rgba(15,23,42,.05)">
        <div style="padding:14px 16px;border-bottom:1px solid #f1f5f9;display:flex;gap:8px;align-items:center;flex-wrap:wrap">
            @foreach (var (label, val) in new[] { ("ทั้งหมด",""), ("รอดำเนินการ","pending_review"), ("อนุมัติแล้ว","approved"), ("ปฏิเสธ","rejected") })
            {
                <button class="@(statusFilter == val ? "btn-navy" : "btn-outline-navy")"
                        style="font-size:12px;padding:5px 12px"
                        @onclick="() => SetFilter(val)">
                    @label
                </button>
            }
        </div>

        @if (loading)
        {
            <div style="padding:32px;text-align:center;color:#94a3b8">กำลังโหลด...</div>
        }
        else if (FilteredRequests.Count == 0)
        {
            <div style="padding:32px;text-align:center;color:#94a3b8">ไม่มีคำขอในขณะนี้</div>
        }
        else
        {
            @foreach (var r in FilteredRequests)
            {
                var isSelected = selected?.Id == r.Id;
                <div style="padding:14px 16px;border-bottom:1px solid #f1f5f9;cursor:pointer;background:@(isSelected?"#f0f4ff":"#fff")"
                     @onclick="() => Select(r)">
                    <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:8px">
                        <div>
                            <div style="font-weight:700;color:var(--navy-deep);font-size:14px">@r.ContactName</div>
                            <div style="font-size:12px;color:#64748b">@r.OrgName</div>
                        </div>
                        <span class="@StatusBadgeClass(r.Status)" style="font-size:11px;flex-shrink:0">@StatusLabel(r.Status)</span>
                    </div>
                    <div style="font-size:11px;color:#94a3b8;margin-top:4px">@r.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                </div>
            }
        }
    </div>

    @* — Detail + review panel — *@
    <div style="background:#fff;border:1px solid #e5e7eb;border-radius:12px;padding:18px;box-shadow:0 4px 16px rgba(15,23,42,.05)">
        @if (selected is null)
        {
            <div style="text-align:center;color:#94a3b8;padding:32px 0">
                <i class="bi bi-cursor-fill" style="font-size:28px;margin-bottom:8px;display:block"></i>
                เลือกคำขอเพื่อดูรายละเอียด
            </div>
        }
        else
        {
            <div style="margin-bottom:14px">
                <h3 style="margin:0 0 6px;color:var(--navy-deep);font-size:16px;font-weight:800">@selected.ContactName</h3>
                <span class="@StatusBadgeClass(selected.Status)">@StatusLabel(selected.Status)</span>
            </div>

            <div style="font-size:13px;color:#475569;margin-bottom:14px;display:grid;gap:6px">
                @if (!string.IsNullOrWhiteSpace(selected.OrgName))
                    { <div><strong>หน่วยงาน:</strong> @selected.OrgName</div> }
                @if (!string.IsNullOrWhiteSpace(selected.Phone))
                    { <div><strong>โทรศัพท์:</strong> @selected.Phone</div> }
                @if (!string.IsNullOrWhiteSpace(selected.Email))
                    { <div><strong>อีเมล:</strong> @selected.Email</div> }
                <div><strong>ข้อมูลที่ต้องการแก้ไข:</strong></div>
                <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:6px;padding:8px 10px;line-height:1.55">@selected.RequestedChanges</div>
                @if (!string.IsNullOrWhiteSpace(selected.AdminNote))
                {
                    <div><strong>หมายเหตุ Admin:</strong></div>
                    <div style="background:#fefce8;border:1px solid #fde68a;border-radius:6px;padding:8px 10px">@selected.AdminNote</div>
                }
                <div style="font-size:11px;color:#94a3b8">สร้างเมื่อ @selected.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
            </div>

            @if (selected.Status == "pending_review")
            {
                <div style="border-top:1px solid #f1f5f9;padding-top:14px">
                    <div style="font-size:13px;font-weight:800;color:var(--navy-deep);margin-bottom:10px">พิจารณาคำขอ</div>
                    <label style="font-size:12px;font-weight:700;color:var(--navy-deep)">หมายเหตุ (ถ้ามี)</label>
                    <textarea @bind="adminNote" rows="3"
                              placeholder="บันทึกหมายเหตุหรือเหตุผล..."
                              style="width:100%;border:1px solid #d7dde8;border-radius:8px;padding:8px 10px;resize:vertical;margin-bottom:10px;outline:none"></textarea>
                    <div style="display:flex;gap:8px">
                        <button class="btn-navy" style="flex:1" @onclick='() => Review("approved")' disabled="@reviewing">
                            <i class="bi bi-check-lg"></i> อนุมัติ
                        </button>
                        <button class="btn-outline-navy" style="flex:1;color:#dc2626;border-color:#dc2626" @onclick='() => Review("rejected")' disabled="@reviewing">
                            <i class="bi bi-x-lg"></i> ปฏิเสธ
                        </button>
                    </div>
                </div>
            }
        }
    </div>
</div>

@code {
    private List<PhonebookRequestDto> requests = new();
    private PhonebookRequestDto? selected;
    private string statusFilter = "";
    private string adminNote = "";
    private bool loading = true;
    private bool reviewing;
    private string error = "";
    private string successMsg = "";

    private List<PhonebookRequestDto> FilteredRequests =>
        string.IsNullOrEmpty(statusFilter)
            ? requests
            : requests.Where(r => r.Status == statusFilter).ToList();

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        loading = true;
        error = "";
        try
        {
            requests = await CentralSupportApi.GetPhonebookRequestsAsync();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private void SetFilter(string val)
    {
        statusFilter = val;
        selected = null;
    }

    private void Select(PhonebookRequestDto r)
    {
        selected = r;
        adminNote = r.AdminNote;
        successMsg = "";
        error = "";
    }

    private async Task Review(string status)
    {
        if (selected is null) return;
        reviewing = true;
        error = "";
        successMsg = "";
        try
        {
            await CentralSupportApi.ReviewPhonebookRequestAsync(selected.Id, status, adminNote);
            successMsg = status == "approved" ? "อนุมัติคำขอเรียบร้อย" : "ปฏิเสธคำขอเรียบร้อย";
            await Load();
            selected = requests.FirstOrDefault(r => r.Id == selected.Id);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            reviewing = false;
        }
    }

    private static string StatusLabel(string status) => status switch
    {
        "pending_review" => "รอดำเนินการ",
        "approved" => "อนุมัติแล้ว",
        "rejected" => "ปฏิเสธ",
        _ => status
    };

    private static string StatusBadgeClass(string status) => status switch
    {
        "pending_review" => "badge bg-warning text-dark",
        "approved" => "badge bg-success",
        "rejected" => "badge bg-danger",
        _ => "badge bg-secondary"
    };
}
