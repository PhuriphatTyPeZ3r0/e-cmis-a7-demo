@page "/admin/transfers"
@inject EcmisWeb.Services.AdminApiService AdminApi
@inject EcmisWeb.Services.SystemAccessApiService SystemApi

<PageTitle>คำขอย้ายสังกัดหน่วยงาน — E-CMIS</PageTitle>

<div style="background:linear-gradient(135deg,var(--navy-deep) 0%,var(--navy) 60%,#1e3575 100%);border-radius:18px;padding:24px 28px;margin-bottom:16px">
    <div style="font-size:20px;font-weight:800;color:#fff;line-height:1.2">คำขอย้ายสังกัดหน่วยงาน</div>
    <div style="font-size:12px;color:rgba(255,255,255,.55)">บันทึกคำขอ อนุมัติ/ปฏิเสธ และติดตามสถานะการย้ายสังกัด (14.1.3 / 14.1.4)</div>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
@if (!string.IsNullOrEmpty(infoMessage))
{
    <div class="alert alert-success">@infoMessage</div>
}

<div class="ecmis-card mb-3">
    <div class="ecmis-card-header">
        <div class="ecmis-card-title"><span class="badge-dot"></span>สร้างคำขอย้ายสังกัด (ผู้ดูแล)</div>
    </div>
    <div style="padding:16px 22px">
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label" style="font-size:12px;font-weight:700;margin-bottom:5px">เจ้าหน้าที่</label>
                <select class="form-select form-select-sm" @bind="createUserId">
                    <option value="">— เลือกเจ้าหน้าที่ —</option>
                    @foreach (var u in users)
                    {
                        <option value="@u.Id">@UserLabel(u)</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label" style="font-size:12px;font-weight:700;margin-bottom:5px">หน่วยงานปลายทาง</label>
                <select class="form-select form-select-sm" @bind="createToOrgId">
                    <option value="">— เลือกหน่วยงาน —</option>
                    @foreach (var o in orgs)
                    {
                        <option value="@o.Id">@o.NameTh</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label" style="font-size:12px;font-weight:700;margin-bottom:5px">วันที่มีผล (ไม่บังคับ)</label>
                <InputDate class="form-control form-control-sm" @bind-Value="createEffectiveDate" />
            </div>
            <div class="col-12">
                <label class="form-label" style="font-size:12px;font-weight:700;margin-bottom:5px">เหตุผล</label>
                <input class="form-control form-control-sm" @bind="createReason" placeholder="ระบุเหตุผลการย้ายสังกัด" />
            </div>
            <div class="col-12">
                <button class="btn btn-ecmis-primary btn-sm" disabled="@saving" @onclick="CreateTransferAsync">
                    @if (saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    <i class="bi bi-floppy me-1"></i>บันทึกคำขอ
                </button>
            </div>
        </div>
    </div>
</div>

<div class="ecmis-card mb-3">
    <div class="ecmis-card-header">
        <div class="ecmis-card-title"><span class="badge-dot"></span>ค้นหาและกรองรายการ</div>
    </div>
    <div style="padding:16px 22px">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label" style="font-size:12px;font-weight:700;margin-bottom:5px">สถานะ</label>
                <select class="form-select form-select-sm" @bind="filterStatus">
                    <option value="">ทุกสถานะ</option>
                    <option value="pending">รอพิจารณา</option>
                    <option value="approved">อนุมัติแล้ว</option>
                    <option value="rejected">ปฏิเสธ</option>
                    <option value="cancelled">ยกเลิก</option>
                </select>
            </div>
            <div class="col-md-5">
                <label class="form-label" style="font-size:12px;font-weight:700;margin-bottom:5px">เจ้าหน้าที่</label>
                <select class="form-select form-select-sm" @bind="filterUserId">
                    <option value="">ทุกคน</option>
                    @foreach (var u in users)
                    {
                        <option value="@u.Id">@UserLabel(u)</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button class="btn btn-outline-primary btn-sm w-100" @onclick="LoadAsync">
                    <i class="bi bi-search me-1"></i>ค้นหา
                </button>
            </div>
        </div>
    </div>
</div>

<div class="ecmis-card">
    <div class="ecmis-card-header">
        <div class="ecmis-card-title"><span class="badge-dot"></span>รายการคำขอ (@rows.Count)</div>
    </div>
    <div style="overflow-x:auto">
        <table class="ecmis-table">
            <thead>
                <tr>
                    <th></th>
                    <th>วันที่ยื่น</th>
                    <th>เจ้าหน้าที่</th>
                    <th>จากหน่วยงาน</th>
                    <th>ไปหน่วยงาน</th>
                    <th>สถานะ</th>
                    <th style="text-align:center">ดำเนินการ</th>
                </tr>
            </thead>
            <tbody>
                @if (!rows.Any())
                {
                    <tr><td colspan="7" style="text-align:center;color:var(--text-muted)">ไม่พบข้อมูล</td></tr>
                }
                else
                {
                    @foreach (var row in rows)
                    {
                        <tr>
                            <td>
                                <button class="btn btn-sm btn-link p-0" @onclick="() => ToggleDetail(row.Id)">
                                    <i class="bi @(expandedId == row.Id ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                </button>
                            </td>
                            <td>@row.RequestedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <strong>@row.Username</strong>
                                @if (!string.IsNullOrEmpty(row.Reason))
                                {
                                    <div style="font-size:11px;color:var(--text-muted);margin-top:2px">@row.Reason</div>
                                }
                            </td>
                            <td>@row.FromOrgName</td>
                            <td>@row.ToOrgName</td>
                            <td><span class="status-badge @(StatusClass(row.Status))">@StatusLabel(row.Status)</span></td>
                            <td style="text-align:center">
                                @if (row.Status == "pending")
                                {
                                    <div class="d-flex gap-2 justify-content-center">
                                        <button class="btn btn-sm btn-success" style="min-width:70px" @onclick="() => OpenReview(row.Id, true)">
                                            <i class="bi bi-check-lg me-1"></i>อนุมัติ
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" style="min-width:80px" @onclick="() => OpenReview(row.Id, false)">
                                            <i class="bi bi-x-lg me-1"></i>ปฏิเสธ
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <span style="font-size:12px;color:var(--text-muted)">—</span>
                                }
                            </td>
                        </tr>
                        @if (expandedId == row.Id)
                        {
                            <tr>
                                <td colspan="7" style="background:#f8fafc;padding:12px 16px">
                                    <div style="font-size:12.5px;line-height:1.8">
                                        <div><strong>ผู้ยื่นคำขอ:</strong> @row.RequestedByUsername · @row.RequestedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                                        @if (row.EffectiveDate.HasValue)
                                        {
                                            <div><strong>วันที่มีผล:</strong> @row.EffectiveDate.Value.ToString("dd/MM/yyyy")</div>
                                        }
                                        @if (row.ReviewedAt.HasValue)
                                        {
                                            <div><strong>พิจารณาเมื่อ:</strong> @row.ReviewedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm") โดย @(string.IsNullOrWhiteSpace(row.ReviewedByUsername) ? "—" : row.ReviewedByUsername)</div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(row.ReviewNote))
                                        {
                                            <div><strong>หมายเหตุการพิจารณา:</strong> @row.ReviewNote</div>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@if (reviewTransferId.HasValue)
{
    <div style="position:fixed;inset:0;background:rgba(11,25,64,.45);z-index:1050;display:flex;align-items:center;justify-content:center;padding:16px" @onclick="CloseReview">
        <div class="ecmis-card" style="width:100%;max-width:480px" @onclick:stopPropagation="true">
            <div class="ecmis-card-header">
                <div class="ecmis-card-title">@(reviewApprove ? "อนุมัติคำขอย้ายสังกัด" : "ปฏิเสธคำขอย้ายสังกัด")</div>
            </div>
            <div style="padding:16px 20px">
                <label class="form-label" style="font-size:12px;font-weight:700">
                    หมายเหตุ @(reviewApprove ? "(ไม่บังคับ)" : "(จำเป็น)")
                </label>
                <textarea class="form-control" rows="3" @bind="reviewNote" placeholder="@(reviewApprove ? "ระบุหมายเหตุเพิ่มเติม (ถ้ามี)" : "ระบุเหตุผลการปฏิเสธ")"></textarea>
                <div class="d-flex gap-2 justify-content-end mt-3">
                    <button class="btn btn-outline-secondary" @onclick="CloseReview">ยกเลิก</button>
                    <button class="btn @(reviewApprove ? "btn-success" : "btn-danger")" disabled="@saving" @onclick="SubmitReviewAsync">
                        @if (saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        @(reviewApprove ? "ยืนยันอนุมัติ" : "ยืนยันปฏิเสธ")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<TransferRequestDto> rows = new();
    private List<UserDto> users = new();
    private List<LookupOrgDto> orgs = new();

    private string? errorMessage;
    private string? infoMessage;
    private bool saving;

    private string createUserId = "";
    private string createToOrgId = "";
    private string createReason = "";
    private DateTime? createEffectiveDate;

    private string filterStatus = "";
    private string filterUserId = "";

    private int? expandedId;
    private int? reviewTransferId;
    private bool reviewApprove;
    private string reviewNote = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var t1 = AdminApi.GetUsersAsync(status: "active");
            var t2 = SystemApi.LookupOrganizationsAsync();
            await Task.WhenAll(t1, t2);
            users = await t1;
            orgs = await t2;
        }
        catch (Exception ex)
        {
            errorMessage = $"โหลดข้อมูลอ้างอิงไม่สำเร็จ: {ex.Message}";
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            errorMessage = null;
            rows = await AdminApi.GetTransferRequestsAsync(
                string.IsNullOrWhiteSpace(filterStatus) ? null : filterStatus,
                string.IsNullOrWhiteSpace(filterUserId) ? null : filterUserId);
        }
        catch (Exception ex)
        {
            errorMessage = $"โหลดรายการคำขอไม่สำเร็จ: {ex.Message}";
            rows = new();
        }
    }

    private async Task CreateTransferAsync()
    {
        if (!int.TryParse(createUserId, out var userId))
        {
            errorMessage = "กรุณาเลือกเจ้าหน้าที่";
            return;
        }
        if (!int.TryParse(createToOrgId, out var toOrgId))
        {
            errorMessage = "กรุณาเลือกหน่วยงานปลายทาง";
            return;
        }

        DateOnly? effectiveDate = createEffectiveDate.HasValue
            ? DateOnly.FromDateTime(createEffectiveDate.Value)
            : null;

        saving = true;
        errorMessage = null;
        infoMessage = null;
        try
        {
            await AdminApi.CreateTransferRequestAsync(userId, toOrgId, createReason, effectiveDate);
            infoMessage = "บันทึกคำขอย้ายสังกัดเรียบร้อยแล้ว";
            createReason = "";
            createEffectiveDate = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"บันทึกคำขอไม่สำเร็จ: {ex.Message}";
        }
        finally
        {
            saving = false;
        }
    }

    private void OpenReview(int id, bool approve)
    {
        reviewTransferId = id;
        reviewApprove = approve;
        reviewNote = "";
        errorMessage = null;
    }

    private void CloseReview() => reviewTransferId = null;

    private async Task SubmitReviewAsync()
    {
        if (!reviewTransferId.HasValue) return;
        if (!reviewApprove && string.IsNullOrWhiteSpace(reviewNote))
        {
            errorMessage = "กรุณาระบุเหตุผลการปฏิเสธ";
            return;
        }

        saving = true;
        errorMessage = null;
        infoMessage = null;
        try
        {
            var note = string.IsNullOrWhiteSpace(reviewNote) ? null : reviewNote.Trim();
            if (reviewApprove)
                await AdminApi.ApproveTransferRequestAsync(reviewTransferId.Value, note);
            else
                await AdminApi.RejectTransferRequestAsync(reviewTransferId.Value, note!);

            infoMessage = reviewApprove
                ? "อนุมัติคำขอย้ายสังกัดเรียบร้อยแล้ว"
                : "บันทึกผลการปฏิเสธเรียบร้อยแล้ว";
            CloseReview();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"ดำเนินการไม่สำเร็จ: {ex.Message}";
        }
        finally
        {
            saving = false;
        }
    }

    private void ToggleDetail(int id) =>
        expandedId = expandedId == id ? null : id;

    private static string UserLabel(UserDto u)
    {
        var name = $"{u.FirstName} {u.LastName}".Trim();
        return string.IsNullOrEmpty(name) ? u.Username : $"{name} ({u.Username})";
    }

    private static string StatusLabel(string status) => status switch
    {
        "pending" => "รอพิจารณา",
        "approved" => "อนุมัติแล้ว",
        "rejected" => "ปฏิเสธ",
        "cancelled" => "ยกเลิก",
        _ => status
    };

    private static string StatusClass(string status) => status switch
    {
        "approved" => "status-active",
        "pending" => "status-pending",
        "rejected" => "status-inactive",
        _ => ""
    };
}
