@page "/super-admin/systems/{SystemId:int}/menus"
@inject SystemAccessApiService SystemApi
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>จัดการเมนู — E-CMIS</PageTitle>

<div class="page-header">
    <div>
        <div class="page-title"><i class="bi bi-list-nested me-2"></i>เมนูย่อย</div>
        <div class="page-subtitle">@(_system?.NameTh ?? "—")</div>
    </div>
    <div class="d-flex gap-2">
        <button class="btn-outline-navy" @onclick='() => Nav.NavigateTo("/super-admin/systems?tab=modules")'><i class="bi bi-arrow-left me-1"></i>กลับ</button>
        <button class="btn btn-sm" style="background:var(--navy-deep);color:#fff" @onclick="OpenCreateModal"><i class="bi bi-plus-lg me-1"></i>เพิ่มเมนู</button>
    </div>
</div>

@if (!string.IsNullOrEmpty(ActionMessage))
{
    <div class="reg-alert reg-alert-success mb-3"><i class="bi bi-check-circle-fill me-2"></i>@ActionMessage</div>
}
@if (!string.IsNullOrEmpty(ActionError))
{
    <div class="reg-alert reg-alert-error mb-3"><i class="bi bi-exclamation-triangle-fill me-2"></i>@ActionError</div>
}

@if (Loading)
{
    <div style="padding:40px;text-align:center"><span class="spinner-border" style="color:var(--navy)"></span></div>
}
else
{
    <div class="ecmis-card">
        <div class="ecmis-card-header">
            <div class="ecmis-card-title">รายการเมนู (@Menus.Count)</div>
        </div>
        @if (Menus.Count == 0)
        {
            <div style="padding:32px;text-align:center;color:var(--text-muted)">ยังไม่มีเมนูย่อย</div>
        }
        else
        {
            <div style="overflow-x:auto">
                <table class="ecmis-table" style="table-layout:fixed;width:100%">
                    <colgroup>
                        <col style="width:35%" />
                        <col style="width:40%" />
                        <col style="width:10%" />
                        <col style="width:15%" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th>ชื่อฟังก์ชัน</th>
                            <th>หน้า (Route)</th>
                            <th style="text-align:center">สถานะ</th>
                            <th style="text-align:center">จัดการ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Menus.OrderBy(x => x.DisplayOrder).ThenBy(x => x.NameTh))
                        {
                            <tr>
                                <td style="font-weight:600;font-size:13px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@m.NameTh</td>
                                <td style="font-size:12px;color:#475569;font-family:monospace;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@(string.IsNullOrEmpty(m.Route) ? "—" : m.Route)</td>
                                <td style="text-align:center">@(m.IsActive ? @<span class="status-badge status-active">เปิด</span> : @<span class="status-badge status-inactive">ปิด</span>)</td>
                                <td style="text-align:center;white-space:nowrap">
                                    <div class="d-flex gap-1 justify-content-center">
                                        <button class="btn btn-sm btn-outline-secondary" style="font-size:11px;border-radius:6px;padding:3px 8px" @onclick="() => OpenEditModal(m)"><i class="bi bi-pencil"></i></button>
                                        <button class="btn btn-sm" style="background:#fff;border:1px solid #fca5a5;color:#dc2626;font-size:11px;border-radius:6px;padding:3px 8px" disabled="@Busy" @onclick="() => DeleteMenuAsync(m.Id)"><i class="bi bi-trash"></i></button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

@if (ModalOpen)
{
    <div style="position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:2000;display:flex;align-items:center;justify-content:center;padding:16px" @onclick="CloseModal">
        <div style="background:#fff;border-radius:14px;width:100%;max-width:440px;padding:20px" @onclick:stopPropagation="true">
            <div style="font-weight:800;font-size:16px;margin-bottom:14px">@(EditingId.HasValue ? "แก้ไขเมนู" : "เพิ่มเมนูย่อย")</div>
            <div class="mb-3">
                <label class="form-label-custom">ชื่อฟังก์ชัน *</label>
                <input class="form-control" @bind="Form.NameTh" placeholder="เช่น รายการทั้งหมด" />
            </div>
            <div class="mb-3">
                <label class="form-label-custom">หน้า (Route) *</label>
                <input class="form-control" @bind="Form.Route" placeholder="/complaints" style="font-family:monospace;font-size:13px" />
                <div style="font-size:11px;color:var(--text-muted);margin-top:4px">ลิงก์ที่เปิดเมื่อคลิกเมนู</div>
            </div>
            <div class="mb-3">
                <label><input type="checkbox" @bind="Form.IsActive" /> เปิดใช้งาน</label>
            </div>
            @if (!EditingId.HasValue)
            {
                <div style="font-size:11.5px;color:var(--text-muted);margin-bottom:12px">ระบบสร้างรหัสภายในและลำดับให้อัตโนมัติ</div>
            }
            <div class="d-flex justify-content-end gap-2">
                <button class="btn-outline-navy" @onclick="CloseModal">ยกเลิก</button>
                <button class="btn btn-sm" style="background:var(--navy-deep);color:#fff"
                        disabled="@(Busy || string.IsNullOrWhiteSpace(Form.NameTh) || string.IsNullOrWhiteSpace(Form.Route))"
                        @onclick="SaveMenuAsync">บันทึก</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int SystemId { get; set; }

    private SystemDto? _system;
    private List<SystemMenuAdminDto> Menus = new();
    private bool Loading = true;
    private bool Busy;
    private bool ModalOpen;
    private int? EditingId;
    private SystemMenuUpsertRequest Form = new();
    private string? ActionMessage;
    private string? ActionError;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        Loading = true;
        ActionError = null;
        try
        {
            _system = await SystemApi.GetSystemAsync(SystemId);
            Menus = await SystemApi.ListSystemMenusAsync(SystemId);
        }
        catch (Exception ex) { ActionError = ex.Message; }
        finally { Loading = false; }
    }

    private void OpenCreateModal()
    {
        EditingId = null;
        Form = new SystemMenuUpsertRequest { IsActive = true };
        ModalOpen = true;
    }

    private void OpenEditModal(SystemMenuAdminDto m)
    {
        EditingId = m.Id;
        Form = new SystemMenuUpsertRequest
        {
            Code = m.Code,
            NameTh = m.NameTh,
            Route = m.Route,
            IsActive = m.IsActive
        };
        ModalOpen = true;
    }

    private void CloseModal() => ModalOpen = false;

    private async Task SaveMenuAsync()
    {
        Busy = true;
        ActionError = null;
        ActionMessage = null;
        try
        {
            if (EditingId.HasValue)
                await SystemApi.UpdateSystemMenuAsync(SystemId, EditingId.Value, Form);
            else
                await SystemApi.CreateSystemMenuAsync(SystemId, Form);
            ActionMessage = "บันทึกเมนูแล้ว";
            CloseModal();
            Menus = await SystemApi.ListSystemMenusAsync(SystemId);
            SystemApi.InvalidateMenuCache();
        }
        catch (Exception ex) { ActionError = ex.Message; }
        finally { Busy = false; }
    }

    private async Task DeleteMenuAsync(int menuId)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "ยืนยันการลบเมนูนี้?")) return;
        Busy = true;
        ActionError = null;
        try
        {
            await SystemApi.DeleteSystemMenuAsync(SystemId, menuId);
            ActionMessage = "ลบเมนูแล้ว";
            Menus = await SystemApi.ListSystemMenusAsync(SystemId);
            SystemApi.InvalidateMenuCache();
        }
        catch (Exception ex) { ActionError = ex.Message; }
        finally { Busy = false; }
    }
}
