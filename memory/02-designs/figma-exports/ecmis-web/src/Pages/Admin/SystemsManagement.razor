                OrgGroupForm.DepartmentId = deptId;
                var newId = await SystemApi.CreateOrgGroupAsync(OrgGroupForm);
                ActionMessage = "เพิ่มสิทธิ์ตามหน่วยงานแล้ว — ติ๊กเมนูทางขวาได้เลย";
                SelectedGroupId = newId;
