@code {
    private string ActiveTab = "assign-users";
    private CurrentUserDto? _currentUser;
    private bool CanEditStructure;
    private bool CanManageOrgGroups;
    private AdminContextDto? _adminContext;
    private List<LookupOrgDto> AllDepartments = new();
    private bool Busy;
    private string? ActionMessage;
    private string? ActionError;

    private List<SystemDto> Systems = new();
    private bool ShowAdvancedFunctions;

    private int ModuleRootCount => Systems
        .Count(s => s.IsMainModule || (s.ParentId is null && s.Code.StartsWith("mod.", StringComparison.OrdinalIgnoreCase)));

    private List<SystemDto> ModuleRootsList => Systems
        .Where(s => s.IsMainModule || (s.ParentId is null && s.Code.StartsWith("mod.", StringComparison.OrdinalIgnoreCase)))
        .OrderBy(s => s.DisplayOrder)
        .ThenBy(s => s.Code)
        .ToList();

    private List<SystemDto> VisibleFunctions => ShowAdvancedFunctions
        ? Systems.OrderBy(s => s.DisplayOrder).ThenBy(s => s.Code).ToList()
        : ModuleRootsList;
    private List<SystemGroupDto> Groups = new();
    private List<SystemGroupDto> SpecialGroups = new();
    private List<PositionDto> Positions = new();
    private List<PositionRoleDto> PositionRoles = new();
    private int? SelectedPositionId;
    private bool PositionRoleModalOpen;
    private int? EditingPositionRoleId;
    private PositionRoleUpsertRequest PositionRoleForm = new() { IsActive = true };
    private List<OrgAdminDto> DeptOrgAdmins = new();
    private List<OrgGroupDto> OrgGroups = new();
    private string OrgGroupFilterDeptText = "";
    private bool OrgGroupModalOpen;
    private int? EditingOrgGroupId;
    private OrgGroupUpsertRequest OrgGroupForm = new() { IsActive = true };
    private string OrgGroupFormDeptText = "";

    private bool DeptOrgAdminsLoading;
    private bool CanRevokeMembers;

    private bool SystemModalOpen;
    private int? EditingId;
    private SystemUpsertRequest Form = new() { IsActive = true };

    private bool GroupModalOpen;
    private int? EditingGroupId;
    private SystemGroupUpsertRequest GroupForm = new() { IsActive = true };
    private int? SelectedGroupId;
    private GroupDetailPanel? _groupDetailRoles;
    private GroupDetailPanel? _groupDetailSpecial;
    private GroupDetailPanel? _groupDetailOrg;

    private int? EffectiveOrgGroupDeptId =>
        int.TryParse(OrgGroupFilterDeptText, out var did) ? did
        : ScopedDepartments.Count == 1 ? ScopedDepartments[0].Id : null;

    // Individual access request
    private List<SystemGroupDto> AvailableGroupsToRequest = new();
    private bool ShowRequestModal;
    private SystemGroupDto? RequestingGroup;
    private string RequestReason = "";
    private int MyPendingRequests;
    private bool RequestSubmitting;
    private string RequestActionMessage = "";

    private string PageSubtitle => CanEditStructure
        ? "เมนู · สิทธิ์ตามตำแหน่ง · สิทธิ์พิเศษ · สิทธิ์ตามหน่วยงาน · มอบให้ผู้ใช้"
        : CanManageOrgGroups
            ? "สิทธิ์ตามหน่วยงาน · มอบสิทธิ์การเข้าถึงในสังกัด"
            : "มอบสิทธิ์การเข้าถึง";

    private List<LookupOrgDto> ScopedDepartments
    {
        get
        {
            if (_adminContext is { IsSuperAdmin: true } || _adminContext?.OrgScopeIds.Count == 0)
                return AllDepartments;
            var ids = _adminContext?.OrgScopeIds ?? new List<int>();
            return AllDepartments.Where(d => ids.Contains(d.Id)).ToList();
        }
    }

    [SupplyParameterFromQuery(Name = "tab")]
    public string? TabQuery { get; set; }

    [SupplyParameterFromQuery(Name = "positionId")]
    public int? PositionIdQuery { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _currentUser = await CurrentUserSvc.GetCurrentUserAsync();
        CanEditStructure = HasGroup("super_admin");

        try
        {
            _adminContext = await SystemApi.GetAdminContextAsync();
            CanManageOrgGroups = _adminContext?.CanManageOrgGroups == true;
        }
        catch
        {
            CanManageOrgGroups = _currentUser?.Roles.Any(r =>
                string.Equals(r, "org_admin", StringComparison.OrdinalIgnoreCase)) == true
                && !CanEditStructure;
        }

        ApplyTabFromQuery();
        await LoadAllAsync();
        CanRevokeMembers = HasGroup("super_admin");
        if (ActiveTab == "org-groups")
            await LoadDeptOrgAdminsAsync();
    }

    protected override void OnParametersSet()
    {
        ApplyTabFromQuery();
    }

    private bool HasGroup(string groupCode) =>
        _currentUser?.Roles?.Any(r => string.Equals(r, groupCode, StringComparison.OrdinalIgnoreCase)) == true;

    private void ApplyTabFromQuery()
    {
        var t = string.IsNullOrWhiteSpace(TabQuery) ? null : TabQuery.Trim().ToLowerInvariant();
        var requested = t switch
        {
            "systems" or "modules" => "modules",
            "roles" or "position-roles" => "roles",
            "groups" or "special" or "permissions" => "special",
            "org-groups" or "org" => "org-groups",
            "assign-users" or "assign" or "users" => "assign-users",
            "org-admins" => "org-groups",
            _ => CanEditStructure ? "modules" : CanManageOrgGroups ? "org-groups" : "assign-users"
        };

        if (!CanManageOrgGroups && requested == "org-groups")
            ActiveTab = CanEditStructure ? "modules" : "assign-users";
        else if (!CanEditStructure && requested is "modules" or "roles" or "special" or "groups")
            ActiveTab = CanManageOrgGroups ? "org-groups" : "assign-users";
        else
            ActiveTab = requested;

        if (PositionIdQuery is > 0)
            SelectedPositionId = PositionIdQuery;
    }

    private void SetTab(string tab)
    {
        ActiveTab = tab;
        Nav.NavigateTo($"/super-admin/systems?tab={Uri.EscapeDataString(tab)}", replace: true);
        if (tab == "org-groups")
            _ = LoadDeptOrgAdminsAsync();
    }

    private void SelectGroup(int id) => SelectedGroupId = id;

    private Task OnMatrixSavedAsync() => Task.CompletedTask;

    private async Task LoadAllAsync()
    {
        try
        {
            if (CanEditStructure)
            {
                var t1 = SystemApi.ListSystemsAsync(includeInactive: true);
                var t4 = SystemApi.ListSystemGroupsAsync("special");
                var t5 = SystemApi.ListPositionsAsync();
                await Task.WhenAll(t1, t4, t5);
                Systems = await t1;
                SpecialGroups = Groups = await t4;
                Positions = await t5;
                if (SelectedPositionId is null && Positions.Count > 0)
                    SelectedPositionId = Positions[0].Id;
                if (SelectedPositionId is > 0)
                    await LoadPositionRolesAsync(SelectedPositionId.Value);
            }

            if (CanManageOrgGroups)
            {
                try { AllDepartments = await SystemApi.LookupOrganizationsAsync(); }
                catch { AllDepartments = new(); }
                await LoadOrgGroupsAsync();
                await LoadDeptOrgAdminsAsync();
            }
        }
        catch (Exception ex)
        {
            ActionError = ex.Message;
        }
        finally { await InvokeAsync(StateHasChanged); }
    }

    private async Task LoadOrgGroupsAsync()
    {
        try
        {
            int? deptFilter = int.TryParse(OrgGroupFilterDeptText, out var did) ? did : null;
            OrgGroups = await SystemApi.ListOrgGroupsAsync(deptFilter);
        }
        catch (Exception ex) { ActionError = ex.Message; }
        await InvokeAsync(StateHasChanged);
    }

    private async Task SelectPositionAsync(int positionId)
    {
        SelectedPositionId = positionId;
        SelectedGroupId = null;
        Nav.NavigateTo($"/super-admin/systems?tab=roles&positionId={positionId}", replace: true);
        await LoadPositionRolesAsync(positionId);
    }

    private async Task LoadPositionRolesAsync(int positionId)
    {
        try
        {
            PositionRoles = await SystemApi.ListPositionRolesAsync(positionId);
            var pos = Positions.FirstOrDefault(p => p.Id == positionId);
            if (pos is not null)
                pos.RoleCount = PositionRoles.Count;
        }
        catch (Exception ex) { ActionError = ex.Message; }
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnOrgGroupDeptFilterChangedAsync()
    {
        await LoadOrgGroupsAsync();
        await LoadDeptOrgAdminsAsync();
    }

    private async Task LoadDeptOrgAdminsAsync()
    {
        if (EffectiveOrgGroupDeptId is not int deptId)
        {
            DeptOrgAdmins = new();
            return;
        }
        DeptOrgAdminsLoading = true;
        try { DeptOrgAdmins = await AdminApi.GetOrgAdminsAsync(deptId); }
        catch (Exception ex) { ActionError = ex.Message; DeptOrgAdmins = new(); }
        finally { DeptOrgAdminsLoading = false; await InvokeAsync(StateHasChanged); }
    }

    // ── System CRUD
    private void OpenCreateSystemModal()
    {
        EditingId = null;
        Form = new SystemUpsertRequest { IsActive = true, IsMenu = true };
        SystemModalOpen = true;
    }
    private void OpenEditSystemModal(SystemDto s)
    {
        EditingId = s.Id;
        Form = new SystemUpsertRequest
        {
            Code = s.Code,
            NameTh = s.NameTh,
            Path = string.IsNullOrWhiteSpace(s.Path) ? null : s.Path,
            ParentId = s.ParentId,
            Remark = string.IsNullOrWhiteSpace(s.Remark) ? s.Description : s.Remark,
            DisplayOrder = s.DisplayOrder,
            IsActive = s.IsActive,
            IsMenu = true
        };
        SystemModalOpen = true;
    }
    private void CloseSystemModal() { SystemModalOpen = false; }

    private async Task SaveSystemAsync()
    {
        Busy = true; ActionError = null; ActionMessage = null;
        try
        {
            if (EditingId.HasValue)
            {
                await SystemApi.UpdateSystemAsync(EditingId.Value, Form);
                ActionMessage = "อัปเดตระบบงานแล้ว";
            }
            else
            {
                await SystemApi.CreateSystemAsync(Form);
                ActionMessage = "เพิ่มระบบงานใหม่แล้ว";
            }
            CloseSystemModal();
            await LoadAllAsync();
        }
        catch (Exception ex) { ActionError = ex.Message; }
        finally { Busy = false; await InvokeAsync(StateHasChanged); }
    }

    private async Task DeleteSystemAsync(int id)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "ยืนยันการลบระบบงานนี้?")) return;
        var backup = Systems.FirstOrDefault(x => x.Id == id);
        if (backup is null) return;
        Systems.Remove(backup);
        Busy = true; ActionError = null; ActionMessage = null;
        try { await SystemApi.DeleteSystemAsync(id); ActionMessage = "ลบระบบงานแล้ว"; }
        catch (Exception ex) { Systems.Add(backup); ActionError = ex.Message; }
        finally { Busy = false; await InvokeAsync(StateHasChanged); }
    }

