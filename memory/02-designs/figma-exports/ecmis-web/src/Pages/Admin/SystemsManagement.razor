    private void OpenRequestModal(SystemGroupDto g)
    {
        RequestingGroup = g;
        RequestReason = "";
        RequestActionMessage = "";
        ShowRequestModal = true;
    }

    private void CloseRequestModal()
    {
        ShowRequestModal = false;
        RequestingGroup = null;
    }

    private async Task SubmitAccessRequestAsync()
    {
        if (RequestingGroup is null || string.IsNullOrWhiteSpace(RequestReason)) return;
        RequestSubmitting = true;
        try
        {
            await SystemApi.RequestIndividualAccessAsync(RequestingGroup.Id, RequestReason);
            CloseRequestModal();
            RequestActionMessage = $"ส่งคำขอสิทธิ์ '{RequestingGroup.NameTh}' เรียบร้อย รอ Admin พิจารณา";
            MyPendingRequests++;
        }
        catch (Exception ex)
        {
            RequestActionMessage = $"เกิดข้อผิดพลาด: {ex.Message}";
        }
        finally { RequestSubmitting = false; }
    }
