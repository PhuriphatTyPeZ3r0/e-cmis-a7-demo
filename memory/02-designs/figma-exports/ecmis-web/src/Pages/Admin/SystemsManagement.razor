@page "/super-admin/systems"
@inject EcmisWeb.Services.SystemAccessApiService SystemApi
@inject EcmisWeb.Services.AdminApiService AdminApi
@inject EcmisWeb.Services.CurrentUserService CurrentUserSvc
@inject NavigationManager Nav
@inject IJSRuntime JS
@using EcmisWeb.Services

@* ── HERO ── *@
<div style="background:linear-gradient(135deg,var(--navy-deep) 0%,var(--navy) 55%,#1e3575 100%);border-radius:18px;padding:24px 28px;margin-bottom:20px;position:relative;overflow:hidden" class="fade-in">
    <div style="position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,transparent,var(--gold),var(--gold-light),var(--gold),transparent)"></div>
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div style="display:flex;align-items:center;gap:14px">
            <a href="/admin/dashboard" style="color:rgba(255,255,255,.55);font-size:18px;text-decoration:none"><i class="bi bi-arrow-left"></i></a>
            <div style="width:48px;height:48px;border-radius:14px;background:linear-gradient(135deg,var(--gold),var(--gold-light));display:flex;align-items:center;justify-content:center">
                <i class="bi bi-grid-3x3-gap-fill" style="font-size:20px;color:var(--navy-deep)"></i>
            </div>
            <div>
                <div style="font-size:19px;font-weight:800;color:#fff">ตั้งค่าเมนูและสิทธิ์</div>
                <div style="font-size:12px;color:rgba(255,255,255,.55);margin-top:2px">@PageSubtitle</div>
            </div>
        </div>
    </div>
</div>

@* ── TAB BAR ── *@
<div style="background:#fff;border-radius:16px;border:1px solid #eaecf2;margin-bottom:20px;overflow:hidden;box-shadow:0 2px 12px rgba(13,27,62,.05)" class="fade-in">
    <div style="display:flex;border-bottom:1px solid #eaecf2;background:linear-gradient(180deg,#fafbff,#fff);padding:0 8px">
        @if (CanEditStructure)
        {
        <button @onclick="@(() => SetTab("modules"))"
                style="padding:14px 20px;border:none;background:none;font-size:13px;font-weight:700;cursor:pointer;
                       color:@(ActiveTab=="modules" ? "var(--navy-deep)" : "#8A96A8");
                       border-bottom:@(ActiveTab=="modules" ? "2.5px solid var(--navy-deep)" : "2.5px solid transparent");
                       display:flex;align-items:center;gap:7px;margin-bottom:-1px;font-family:'Sarabun',sans-serif">
            <i class="bi bi-grid-3x3-gap-fill" style="font-size:14px"></i>โมดูล / เมนู
            <span style="background:#0B1940;color:#fff;border-radius:20px;padding:1px 8px;font-size:10.5px;font-weight:700">@ModuleRootCount</span>
        </button>
        <button @onclick="@(() => SetTab("roles"))"
                style="padding:14px 20px;border:none;background:none;font-size:13px;font-weight:700;cursor:pointer;
                       color:@(ActiveTab=="roles" ? "var(--navy-deep)" : "#8A96A8");
                       border-bottom:@(ActiveTab=="roles" ? "2.5px solid var(--navy-deep)" : "2.5px solid transparent");
                       display:flex;align-items:center;gap:7px;margin-bottom:-1px;font-family:'Sarabun',sans-serif">
            <i class="bi bi-person-badge-fill" style="font-size:14px"></i>สิทธิ์ตามตำแหน่ง
            <span style="background:#d97706;color:#fff;border-radius:20px;padding:1px 8px;font-size:10.5px;font-weight:700">@PositionRoles.Count</span>
        </button>
        <button @onclick="@(() => SetTab("special"))"
                style="padding:14px 20px;border:none;background:none;font-size:13px;font-weight:700;cursor:pointer;
                       color:@(ActiveTab=="special" ? "var(--navy-deep)" : "#8A96A8");
                       border-bottom:@(ActiveTab=="special" ? "2.5px solid var(--navy-deep)" : "2.5px solid transparent");
                       display:flex;align-items:center;gap:7px;margin-bottom:-1px;font-family:'Sarabun',sans-serif">
            <i class="bi bi-stars" style="font-size:14px"></i>สิทธิ์การเข้าถึงพิเศษ
            <span style="background:#6366f1;color:#fff;border-radius:20px;padding:1px 8px;font-size:10.5px;font-weight:700">@SpecialGroups.Count</span>
        </button>
        }
        @if (CanManageOrgGroups)
        {
        <button @onclick="@(() => SetTab("org-groups"))"
                style="padding:14px 20px;border:none;background:none;font-size:13px;font-weight:700;cursor:pointer;
                       color:@(ActiveTab=="org-groups" ? "var(--navy-deep)" : "#8A96A8");
                       border-bottom:@(ActiveTab=="org-groups" ? "2.5px solid var(--navy-deep)" : "2.5px solid transparent");
                       display:flex;align-items:center;gap:7px;margin-bottom:-1px;font-family:'Sarabun',sans-serif">
            <i class="bi bi-building-gear" style="font-size:14px"></i>สิทธิ์ตามหน่วยงาน
            <span style="background:#0B1940;color:#fff;border-radius:20px;padding:1px 8px;font-size:10.5px;font-weight:700">@OrgGroups.Count</span>
        </button>
        }
        <button @onclick="@(() => SetTab("assign-users"))"
                style="padding:14px 20px;border:none;background:none;font-size:13px;font-weight:700;cursor:pointer;
                       color:@(ActiveTab=="assign-users" ? "var(--navy-deep)" : "#8A96A8");
                       border-bottom:@(ActiveTab=="assign-users" ? "2.5px solid var(--navy-deep)" : "2.5px solid transparent");
                       display:flex;align-items:center;gap:7px;margin-bottom:-1px;font-family:'Sarabun',sans-serif">
            <i class="bi bi-person-check-fill" style="font-size:14px"></i>มอบสิทธิ์การเข้าถึง
        </button>
        @if (!CanEditStructure && !CanManageOrgGroups)
        {
            <button @onclick='async () => { SetTab("request-access"); await LoadAvailableGroupsAsync(); }'
                    class="systems-tab @(ActiveTab == "request-access" ? "active" : "")"
                    style="padding:14px 20px;border:none;background:none;font-size:13px;font-weight:700;cursor:pointer;
                           color:@(ActiveTab=="request-access" ? "var(--navy-deep)" : "#8A96A8");
                           border-bottom:@(ActiveTab=="request-access" ? "2.5px solid var(--navy-deep)" : "2.5px solid transparent");
                           display:flex;align-items:center;gap:7px;margin-bottom:-1px;font-family:'Sarabun',sans-serif">
                <i class="bi bi-send-plus" style="font-size:14px"></i>ขอสิทธิ์เพิ่มเติม
                @if (MyPendingRequests > 0)
                {
                    <span style="background:#f59e0b;color:#fff;border-radius:20px;padding:1px 8px;font-size:10.5px;font-weight:700">@MyPendingRequests</span>
                }
            </button>
        }
    </div>
</div>

@if (!string.IsNullOrEmpty(ActionMessage))
{
    <div style="background:#f0fdf4;border:1.5px solid #bbf7d0;border-radius:10px;padding:12px 16px;margin-bottom:16px;font-size:13px;color:#15803d">
        <i class="bi bi-check-circle-fill me-2"></i>@ActionMessage
    </div>
}
@if (!string.IsNullOrEmpty(ActionError))
{
    <div style="background:#fef2f2;border:1.5px solid #fecaca;border-radius:10px;padding:12px 16px;margin-bottom:16px;font-size:13px;color:#991b1b">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@ActionError
    </div>
}

@* ═══════════════════════════════
   TAB: Systems
═══════════════════════════════ *@
@if (ActiveTab == "modules" || ActiveTab == "systems")
{
    <div class="ecmis-card fade-in">
        <div class="ecmis-card-header flex-wrap gap-2">
            <div>
                <div class="ecmis-card-title"><span class="badge-dot"></span>รายการฟังก์ชัน / เมนู</div>
                <div style="font-size:11.5px;color:var(--text-muted);margin-top:4px">โมดูลหลัก ~@ModuleRootCount รายการ (ตรง sidebar) · เมนูย่อยตาม parent อัตโนมัติ</div>
            </div>
            <div class="d-flex gap-2 align-items-center flex-wrap">
                <label style="font-size:12px;display:flex;align-items:center;gap:6px;cursor:pointer;margin:0">
                    <input type="checkbox" @bind="ShowAdvancedFunctions" style="accent-color:var(--navy-deep)" />
                    แสดงเมนูย่อย/สิทธิ์ภายใน (@Systems.Count)
                </label>
                <button @onclick="OpenCreateSystemModal" class="btn btn-sm" style="background:var(--navy-deep);color:#fff;border:none;font-size:12px;border-radius:8px;padding:6px 14px;font-weight:700">
                    <i class="bi bi-plus-lg me-1"></i>เพิ่มโมดูล
                </button>
            </div>
        </div>
        @if (!VisibleFunctions.Any())
        {
            <div style="padding:40px;text-align:center;color:var(--text-muted)">
                <i class="bi bi-inbox" style="font-size:32px"></i>
                <div style="margin-top:8px">ยังไม่มีฟังก์ชัน/เมนู</div>
            </div>
        }
        else
        {
            <div style="overflow-x:auto">
                <table class="ecmis-table">
                    <thead><tr>
                        <th>ชื่อฟังก์ชัน</th>
                        <th>สถานะ</th>
                        <th style="text-align:center">จัดการ</th>
                    </tr></thead>
                    <tbody>
                        @foreach (var s in VisibleFunctions)
                        {
                            <tr>
                                <td>
                                    <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
                                        @if (s.IsMainModule)
                                        {
                                            <span style="font-size:10px;font-weight:700;background:#e0e7ff;color:#3730a3;border-radius:4px;padding:2px 6px">โมดูล</span>
                                        }
                                        else if (ShowAdvancedFunctions)
                                        {
                                            <span style="font-size:10px;color:var(--text-muted)">ย่อย</span>
                                        }
                                        <div style="font-weight:700;font-size:13px">@s.NameTh</div>
                                        @if (ShowAdvancedFunctions)
                                        {
                                            <span style="font-family:monospace;font-size:10.5px;color:var(--text-muted)">@s.Code</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    @if (s.IsActive)
                                    { <span class="status-badge status-active">เปิดใช้</span> }
                                    else
                                    { <span class="status-badge status-inactive">ปิด</span> }
                                </td>
                                <td style="text-align:center">
                                    <div class="d-flex gap-1 justify-content-center">
                                        <button @onclick="@(() => Nav.NavigateTo($"/super-admin/systems/{s.Id}/menus"))" class="btn btn-sm btn-outline-primary" style="font-size:11px;border-radius:6px;padding:3px 8px" title="จัดการเมนู"><i class="bi bi-list-nested"></i></button>
                                        <button @onclick="@(() => OpenEditSystemModal(s))" class="btn btn-sm btn-outline-secondary" style="font-size:11px;border-radius:6px;padding:3px 8px"><i class="bi bi-pencil"></i></button>
                                        <button @onclick="@(() => DeleteSystemAsync(s.Id))" disabled="@Busy" class="btn btn-sm" style="background:#fff;border:1px solid #fca5a5;color:#dc2626;font-size:11px;border-radius:6px;padding:3px 8px"><i class="bi bi-trash"></i></button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

@if (ActiveTab == "assign-users")
{
    <div class="ecmis-card fade-in">
        <div class="ecmis-card-header">
            <div>
                <div class="ecmis-card-title"><span class="badge-dot"></span>มอบสิทธิ์ให้ผู้ใช้งาน</div>
                <div style="font-size:11.5px;color:var(--text-muted);margin-top:4px">เลือกผู้ใช้ + หน่วยงาน + สิทธิ์ (ตามตำแหน่ง) หรือสิทธิ์พิเศษ</div>
            </div>
        </div>
        <div style="padding:16px 22px">
            <UserGroupAssignment />
        </div>
    </div>
}

@if (ActiveTab == "roles")
{
    <div class="ecmis-card fade-in">
        <div class="ecmis-card-header flex-wrap gap-2">
            <div>
                <div class="ecmis-card-title"><span class="badge-dot"></span>สิทธิ์ตามตำแหน่ง + เมนู</div>
                <div style="font-size:11.5px;color:var(--text-muted);margin-top:4px">① เลือกตำแหน่ง → ② เลือกสิทธิ์ → ③ ติ๊กเมนู → บันทึก</div>
            </div>
            <button @onclick="OpenCreatePositionRole" disabled="@(!SelectedPositionId.HasValue)" class="btn btn-sm" style="background:var(--navy-deep);color:#fff;border:none;font-size:12px;border-radius:8px;padding:6px 14px;font-weight:700"><i class="bi bi-plus-lg me-1"></i>เพิ่มสิทธิ์</button>
        </div>
        <div class="row g-0" style="min-height:420px">
            <div class="col-lg-3" style="border-right:1px solid #eaecf2;padding:12px 14px;max-height:56vh;overflow-y:auto">
                <div style="font-size:11px;font-weight:700;color:var(--text-muted);margin-bottom:8px">ตำแหน่ง</div>
                @foreach (var p in Positions.OrderBy(x => x.NameTh))
                {
                    var sel = SelectedPositionId == p.Id;
                    <button type="button" @onclick="() => SelectPositionAsync(p.Id)"
                            style="display:block;width:100%;text-align:left;border:1px solid @(sel ? "#c7d2fe" : "#eaecf2");background:@(sel ? "#eef2ff" : "#fff");border-radius:10px;padding:10px 12px;margin-bottom:8px;cursor:pointer">
                        <div style="font-size:13px;font-weight:700;color:var(--navy-deep)">@p.NameTh</div>
                        <div style="font-size:10.5px;color:var(--text-muted)">@p.RoleCount สิทธิ์</div>
                    </button>
                }
            </div>
            <div class="col-lg-4" style="border-right:1px solid #eaecf2">
                @if (!SelectedPositionId.HasValue)
                {
                    <div style="padding:40px;text-align:center;color:var(--text-muted)">เลือกตำแหน่งทางซ้าย</div>
                }
                else if (PositionRoles.Count == 0)
                {
                    <div style="padding:40px;text-align:center;color:var(--text-muted)"><i class="bi bi-person-badge" style="font-size:32px"></i><div style="margin-top:8px">ยังไม่มีสิทธิ์ — กดเพิ่มสิทธิ์</div></div>
                }
                else
                {
                    <div style="overflow-x:auto;max-height:56vh;overflow-y:auto">
                        <table class="ecmis-table" style="margin:0">
                            <thead><tr><th>สิทธิ์</th><th>เมนู</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var r in PositionRoles)
                                {
                                    var selected = SelectedGroupId == r.Id;
                                    <tr style="cursor:pointer;background:@(selected ? "#eef2ff" : "transparent")" @onclick="() => SelectGroup(r.Id)">
                                        <td>
                                            <div style="font-size:13px;font-weight:700;color:var(--navy-deep)">@r.NameTh</div>
                                            @if (r.IsDefault) { <span style="font-size:10px;font-weight:700;color:#b45309">★ ค่าเริ่มต้น</span> }
                                        </td>
                                        <td style="font-size:11.5px">@r.MenuCount</td>
                                        <td style="text-align:right" @onclick:stopPropagation="true">
                                            @if (!r.IsDefault)
                                            {
                                                <button title="ตั้งเป็นค่าเริ่มต้น" @onclick="@(() => SetDefaultRoleAsync(r.Id))" class="btn btn-sm btn-outline-warning" style="font-size:10px;padding:2px 6px"><i class="bi bi-star"></i></button>
                                            }
                                            <button @onclick="@(() => OpenEditPositionRole(r))" class="btn btn-sm btn-outline-secondary" style="font-size:10px;padding:2px 6px"><i class="bi bi-pencil"></i></button>
                                            <button @onclick="@(() => DeletePositionRoleAsync(r.Id))" disabled="@Busy" class="btn btn-sm" style="font-size:10px;padding:2px 6px;background:#fff;border:1px solid #fca5a5;color:#dc2626"><i class="bi bi-trash"></i></button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
            <div class="col-lg-5" style="padding:16px 18px">
                <GroupDetailPanel @ref="_groupDetailRoles" SelectedGroupId="SelectedGroupId" CanRevokeMembers="@CanRevokeMembers" OnMatrixSaved="OnMatrixSavedAsync" />
            </div>
        </div>
    </div>
}

@if (ActiveTab == "org-groups")
{
    <div class="ecmis-card fade-in">
        <div class="ecmis-card-header flex-wrap gap-2">
            <div>
                <div class="ecmis-card-title"><span class="badge-dot"></span>สิทธิ์ตามหน่วยงาน + เมนู</div>
                <div style="font-size:11.5px;color:var(--text-muted);margin-top:4px">สร้างชุดสิทธิ์เฉพาะสำนัก · คลิกชุดสิทธิ์ → ติ๊กเมนู → บันทึก · มอบที่แท็บมอบสิทธิ์</div>
            </div>
            @if (CanEditStructure || ScopedDepartments.Count == 1)
            {
                <button @onclick="OpenCreateOrgGroup" disabled="@(ScopedDepartments.Count == 0)" class="btn btn-sm" style="background:var(--navy-deep);color:#fff;border:none;font-size:12px;border-radius:8px;padding:6px 14px;font-weight:700"><i class="bi bi-plus-lg me-1"></i>เพิ่มสิทธิ์ตามหน่วยงาน</button>
            }
        </div>
        @if (CanEditStructure && ScopedDepartments.Count > 1)
        {
            <div style="padding:12px 22px 0;border-bottom:1px solid #eaecf2">
                <label style="font-size:11px;font-weight:700;color:var(--text-muted)">กรองตามหน่วยงาน</label>
                <select class="form-select form-select-sm" style="max-width:320px;margin-top:4px" @bind="OrgGroupFilterDeptText" @bind:after="OnOrgGroupDeptFilterChangedAsync">
                    <option value="">ทุกหน่วยงาน</option>
                    @foreach (var d in ScopedDepartments.OrderBy(x => x.NameTh))
                    {
                        <option value="@d.Id">@d.NameTh</option>
                    }
                </select>
            </div>
        }
        @if (EffectiveOrgGroupDeptId is int deptId)
        {
            <div style="margin:12px 22px 0;padding:14px 16px;background:linear-gradient(135deg,#f8fafc,#eef2ff);border:1px solid #c7d2fe;border-radius:12px">
                <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px">
                    <i class="bi bi-shield-check" style="color:var(--navy-deep);font-size:16px"></i>
                    <span style="font-size:13px;font-weight:800;color:var(--navy-deep)">ผู้ดูแลสำนัก (@DeptOrgAdmins.Count)</span>
                    <span style="font-size:11px;color:var(--text-muted)">— มอบ/ถอนที่แท็บ มอบสิทธิ์การเข้าถึง (กลุ่ม org_admin)</span>
                </div>
                @if (DeptOrgAdminsLoading)
                {
                    <div style="font-size:12px;color:var(--text-muted)"><i class="bi bi-arrow-clockwise" style="animation:spin 1s linear infinite"></i> กำลังโหลด...</div>
                }
                else if (DeptOrgAdmins.Count == 0)
                {
                    <div style="font-size:12.5px;color:var(--text-muted)">ยังไม่มีผู้ดูแลสำนักในหน่วยงานนี้</div>
                }
                else
                {
                    <div class="d-flex flex-wrap gap-8px" style="gap:8px">
                        @foreach (var a in DeptOrgAdmins)
                        {
                            <a href="/admin/users/@a.UserId" style="display:inline-flex;align-items:center;gap:8px;padding:8px 12px;background:#fff;border:1px solid #eaecf2;border-radius:10px;text-decoration:none;min-width:200px">
                                @{
                                    var adminLabel = string.IsNullOrWhiteSpace(a.FullName) ? a.Username : a.FullName.Trim();
                                    var adminInitial = adminLabel.Length > 0 ? adminLabel[..1] : "?";
                                }
                                <span style="width:32px;height:32px;border-radius:8px;background:var(--navy-deep);color:#fff;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:800">@adminInitial</span>
                                <span>
                                    <span style="display:block;font-size:12.5px;font-weight:700;color:var(--navy-deep)">@(string.IsNullOrWhiteSpace(a.FullName) ? a.Username : a.FullName)</span>
                                    <span style="display:block;font-size:10.5px;color:var(--text-muted)">@a.Username</span>
                                </span>
                            </a>
                        }
                    </div>
                }
            </div>
        }
        else if (CanEditStructure && ScopedDepartments.Count > 1)
        {
            <div style="margin:12px 22px 0;padding:12px 16px;background:#fffbeb;border:1px solid #fde68a;border-radius:10px;font-size:12.5px;color:#92400e">
                <i class="bi bi-info-circle me-1"></i>เลือกหน่วยงานด้านบนเพื่อดูผู้ดูแลสำนัก
            </div>
        }
        <div class="row g-0" style="min-height:420px">
            <div class="col-lg-5" style="border-right:1px solid #eaecf2">
                @if (OrgGroups.Count == 0)
                {
                    <div style="padding:40px;text-align:center;color:var(--text-muted)"><i class="bi bi-building-gear" style="font-size:32px"></i><div style="margin-top:8px">ยังไม่มีสิทธิ์ตามหน่วยงาน</div></div>
                }
                else
                {
                    <div style="overflow-x:auto;max-height:56vh;overflow-y:auto">
                        <table class="ecmis-table" style="margin:0">
                            <thead><tr><th>กลุ่ม</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var g in OrgGroups.OrderBy(x => x.DepartmentName).ThenBy(x => x.NameTh))
                                {
                                    var selected = SelectedGroupId == g.Id;
                                    <tr style="cursor:pointer;background:@(selected ? "#ecfdf5" : "transparent")"
                                        @onclick="() => SelectGroup(g.Id)">
                                        <td>
                                            <div style="font-size:13px;font-weight:700;color:var(--navy-deep)">@g.NameTh</div>
                                            <div style="font-size:10.5px;color:var(--text-muted)">@g.DepartmentName · @g.Code · เมนู @g.MenuCount</div>
                                        </td>
                                        <td style="text-align:right" @onclick:stopPropagation="true">
