@code {
    // ── Hero carousel ──────────────────────────────────────
    private int activeSlide;
    private System.Threading.Timer? _slideTimer;

    private static readonly IReadOnlyList<HeroSlide> HeroSlides = [
        new("/img/hero-bg.jpg",  null,             "ภาพเมืองและสังคม"),
        new(null, "slide-office",   "สำนักงาน ป.ป.ท."),
        new(null, "slide-activity", "ภาพกิจกรรม"),
    ];

    protected override async Task OnInitializedAsync()
    {
        _slideTimer = new System.Threading.Timer(
            _ => InvokeAsync(() => { activeSlide = (activeSlide + 1) % HeroSlides.Count; StateHasChanged(); }),
            null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
        await LoadLandingSupportDataAsync();
        await LoadLandingNewsAsync();
    }

    private void SetSlide(int idx)
    {
        activeSlide = idx;
        _slideTimer?.Change(TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    public void Dispose() => _slideTimer?.Dispose();

    private sealed record HeroSlide(string? ImageUrl, string? GradientClass, string Caption);

    // ── Other state ────────────────────────────────────────
    private string directorySearch = "";
    private List<DirectoryItem> landingDirectory = [];
    private List<PublicNewsItem> landingNews = [];
    private PublicNewsItem? selectedNews;
    private bool ShowCitizenEntryPoints => false;

    private IEnumerable<PublicNewsItem> NewsBy(string type) =>
        landingNews.Where(n => string.Equals(n.Type, type, StringComparison.OrdinalIgnoreCase));

    // ── PACC Video pagination ──
    private int videoPage = 0;
    private const int VideosPerPage = 4;
    private IReadOnlyList<PublicNewsItem> AllVideos =>
        landingNews.Where(n => n.Type.Contains("วิดีโอ", StringComparison.OrdinalIgnoreCase)).ToList();
    private IEnumerable<PublicNewsItem> CurrentVideoPage =>
        AllVideos.Skip(videoPage * VideosPerPage).Take(VideosPerPage);
    private int VideoPageMax => Math.Max(0, (AllVideos.Count - 1) / VideosPerPage);
    private void PrevVideoPage() { if (videoPage > 0) videoPage--; }
    private void NextVideoPage() { if (videoPage < VideoPageMax) videoPage++; }

    private static readonly string[] OtherNewsTypes = ["ข่าวประชาสัมพันธ์", "ข่าวป้องกัน", "ข่าวปราบปราม"];

    private IEnumerable<PublicNewsItem> NewsOther =>
        landingNews.Where(n => OtherNewsTypes.Contains(n.Type, StringComparer.OrdinalIgnoreCase));

    private void OpenNews(PublicNewsItem item) => selectedNews = item;
    private void CloseNews() => selectedNews = null;
    private static bool HasNewsImage(PublicNewsItem item) => !string.IsNullOrWhiteSpace(item.ImageDataUrl);
    private string NewsImageStyle(PublicNewsItem item) =>
        !HasNewsImage(item)
            ? ""
            : $"background-image:url('{item.ImageDataUrl}');background-size:contain;background-repeat:no-repeat;background-position:center;background-color:#f3f0e8";

    private static readonly IReadOnlyList<ServiceItem> Services = [
        // new("แจ้งเบาะแส/ร้องเรียน", "ช่องทางรับเรื่องร้องเรียนและแจ้งเบาะแสทุจริต", "bi-shield-exclamation", "/citizen/login"),
        new("ศูนย์ข้อมูลข่าวสาร", "ประกาศ เอกสารเผยแพร่ และข่าวประชาสัมพันธ์", "bi-newspaper", "#announcements"),
        new("PACC Videos", "วิดีโอองค์ความรู้และผลการดำเนินงาน", "bi-play-btn", "#manuals")
    ];

    private static readonly IReadOnlyList<ResourceItem> Resources = [
        new("เอกสารเผยแพร่", "PACC Keymessage", "สารหลักและสื่อประชาสัมพันธ์สำหรับรณรงค์ต่อต้านการทุจริต", "bi-chat-square-quote"),
        new("คู่มือ PDF", "คู่มือการใช้งาน E-CMIS", "ขั้นตอนเข้าสู่ระบบ ค้นหาข่าวสาร ถาม-ตอบ และแจ้งปัญหาการใช้งาน", "bi-file-earmark-pdf"),
        new("นโยบาย", "No Gift Policy", "เอกสารและสื่อรณรงค์แนวทางขับเคลื่อนนโยบาย No Gift Policy", "bi-gift"),
        new("วิดีโอ", "PACC Videos", "วีดิทัศน์ผลการดำเนินงาน บทบาทภารกิจ และสื่อความรู้ด้านการป้องกันการทุจริต", "bi-play-circle")
    ];

    private IEnumerable<DirectoryItem> FilteredDirectory =>
        landingDirectory.Where(d => string.IsNullOrWhiteSpace(directorySearch)
            || d.Name.Contains(directorySearch, StringComparison.OrdinalIgnoreCase)
            || d.Role.Contains(directorySearch, StringComparison.OrdinalIgnoreCase)
            || d.Unit.Contains(directorySearch, StringComparison.OrdinalIgnoreCase)
            || d.Phone.Contains(directorySearch, StringComparison.OrdinalIgnoreCase)
            || d.Email.Contains(directorySearch, StringComparison.OrdinalIgnoreCase));

    private async Task LoadLandingNewsAsync()
    {
        try
        {
            var items = await CentralSupportApi.GetPublicNewsAsync();
            landingNews = items
                .Where(n => string.Equals(n.Status, "published", StringComparison.OrdinalIgnoreCase))
                .Select(MapToNewsItem)
                .OrderByDescending(n => n.PublishedAt ?? n.UpdatedAt)
                .ToList();
        }
        catch
        {
            landingNews = [];
        }
    }

    private static PublicNewsItem MapToNewsItem(PublicNewsDto dto)
    {
        var when = dto.PublishedAt ?? dto.CreatedAt;
        var th = CultureInfo.GetCultureInfo("th-TH");
        var dateText = when.ToLocalTime().ToString("dd MMM yyyy", th);
        var visual = PickVisual(dto.Category);
        return new PublicNewsItem(
            dto.Id,
            dto.Category,
            dto.Title,
            dto.Summary,
            dto.Body,
            dateText,
            "สำนักงาน ป.ป.ท.",
            false,
            visual.Class,
            visual.Label,
            dto.Status,
            "",
            dto.CoverImageUrl ?? "",
            when,
            dto.PublishedAt);
    }

    private static (string Class, string Label) PickVisual(string category)
    {
        var classes = new[] { "photo-teal", "photo-gold", "photo-navy", "photo-rose" };
        var idx = Math.Abs(category.GetHashCode(StringComparison.Ordinal)) % classes.Length;
        var label = string.IsNullOrWhiteSpace(category) ? "PR" : category[..Math.Min(2, category.Length)];
        return (classes[idx], label);
    }

    private async Task LoadLandingSupportDataAsync()
    {
        try
        {
            var people = await CentralSupportApi.SearchPhonebookAsync("");
            landingDirectory = people
                .Select(p => new DirectoryItem(
                    p.DisplayName,
                    p.JobTitle,
                    p.OrgName,
                    p.Phone,
                    p.Email,
                    BuildInitials(p.DisplayName)))
                .ToList();
        }
        catch { /* ไม่แสดง error บน landing page */ }
    }

    private static string BuildInitials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
        return parts.Length == 1 && parts[0].Length > 0 ? parts[0][0].ToString().ToUpperInvariant() : "?";
    }

    private sealed record ServiceItem(string Title, string Description, string Icon, string Url);
    private sealed record ResourceItem(string Type, string Title, string Description, string Icon);
    private sealed record DirectoryItem(string Name, string Role, string Unit, string Phone, string Email, string Initials);
}
