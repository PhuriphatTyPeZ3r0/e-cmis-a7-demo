        GenerateTrackNo();
        RunAiSuggestion();
        editContext.NotifyValidationStateChanged();
    }

    private void OnAnonymousChanged()
    {
        if (!form.Anonymous)
        {
            return;
        }

        form.CitizenId = string.Empty;
        form.Prefix = string.Empty;
        form.FirstName = string.Empty;
        form.LastName = string.Empty;
        form.Email = string.Empty;
        form.Phone = string.Empty;
        form.Network = "ไม่ได้เป็นเครือข่าย";
        editContext.NotifyValidationStateChanged();
    }

    private void GenerateTrackNo()
    {
        var suffix = Random.Shared.Next(1000, 9999);
        form.TrackNo = $"PCMS-{DateTime.Now:yyMMdd}-{suffix}";
        editContext.NotifyFieldChanged(FieldIdentifier.Create(() => form.TrackNo));
    }

    private void OnChannelChanged()
    {
        form.SourceDetail = GetDefaultSourceDetail(form.Channel);
        editContext.NotifyFieldChanged(FieldIdentifier.Create(() => form.SourceDetail));
    }

    private static string GetDefaultSourceDetail(string channel) => string.Empty;

    private void OnDescriptionChanged()
    {
        if (form.Description.Length >= 20)
        {
            RunAiSuggestion();
        }
        else
        {
            aiSuggestionVisible = false;
        }
    }

    private void RunAiSuggestion()
    {
        var desc = form.Description.ToLowerInvariant();
        var misconduct = new[] { "ทุจริต", "รับสินบน", "เรียกรับ", "ยักยอก", "ฉ้อโกง", "ประพฤติมิชอบ", "ร่ำรวยผิดปกติ", "ใช้ตำแหน่ง", "ปฏิบัติหน้าที่โดยมิชอบ" };
        var distress = new[] { "เดือดร้อน", "ไม่ได้รับความเป็นธรรม", "ออกใบอนุญาต", "ประวิงเวลา", "ล่าช้า", "ไม่ดำเนินการ", "เสียหาย", "ที่ดิน", "สิทธิ์" };

        var misconductScore = misconduct.Count(kw => desc.Contains(kw));
        var distressScore = distress.Count(kw => desc.Contains(kw));

        if (misconductScore == 0 && distressScore == 0)
        {
            aiSuggestionVisible = false;
            return;
        }

        if (misconductScore >= distressScore)
        {
            aiSuggestedCategory = "ม.18/4";
            form.AiCategory = "ม.18/4";
            aiConfidence = Math.Min(95, 60 + misconductScore * 8);
            aiReason = "พบคำที่บ่งชี้การประพฤติมิชอบของเจ้าหน้าที่รัฐ เข้าข่ายอำนาจหน้าที่ ป.ป.ท. ตาม ม.18/4";
        }
        else
        {
            aiSuggestedCategory = "ม.58/2";
            form.AiCategory = "ม.58/2";
            aiConfidence = Math.Min(95, 60 + distressScore * 8);
            aiReason = "พบคำที่บ่งชี้ความเดือดร้อนของประชาชนจากการปฏิบัติหน้าที่ เข้าข่าย ม.58/2";
        }

        aiSuggestionVisible = true;
    }

    private async Task LookupThaiId()
    {
        if (form.CitizenId.Length < 13)
        {
            return;
        }

        thaiIdLoading = true;
        thaiIdMessage = string.Empty;
        thaiIdSuccess = false;

        // Simulate API delay (mockup — real integration would call ThaiID API)
        await Task.Delay(800);

        // Mock response based on test citizen ID
        if (form.CitizenId == "1234567890123")
        {
            form.Prefix = "นาย";
            form.FirstName = "สมชาย";
            form.LastName = "มุ่งมั่นไทย";
            thaiIdMessage = "ดึงข้อมูลสำเร็จ (ThaiID API Mockup)";
            thaiIdSuccess = true;
        }
        else
        {
            thaiIdMessage = "ไม่พบข้อมูลจาก ThaiID API (ทดสอบใช้: 1234567890123)";
            thaiIdSuccess = false;
        }

        thaiIdLoading = false;
    }

    private async Task OnFilesSelected(InputFileChangeEventArgs e)
    {
        fileError = string.Empty;

        if (uploadedFiles.Count + e.FileCount > MaxFiles)
        {
            fileError = $"แนบไฟล์ได้สูงสุด {MaxFiles} ไฟล์";
            return;
        }

        foreach (var file in e.GetMultipleFiles(MaxFiles))
        {
            if (file.Size > MaxFileSize)
            {
                fileError = $"ไฟล์ {file.Name} มีขนาดเกิน 50MB";
                continue;
            }

            uploadedFiles.Add(new UploadedFile(file));
        }

        await InvokeAsync(StateHasChanged);
    }

    private void RemoveFile(int index)
    {
        if (index < 0 || index >= uploadedFiles.Count)
        {
            return;
        }

        uploadedFiles.RemoveAt(index);
    }

    private void OpenConfirmModal()
    {
        fileError = string.Empty;
        confirmOpen = true;
    }

    private async Task SaveConfirmed()
    {
        saving = true;
        saveError = string.Empty;

        try
        {
            var created = await ComplaintApi.CreateComplaintAsync(new CreateComplaintRequest
            {
                Channel = form.Channel,
                SourceDetail = form.SourceDetail,
                Anonymous = form.Anonymous,
                CitizenId = form.CitizenId,
                ComplainantPrefix = form.Prefix,
                ComplainantFirstName = form.FirstName,
                ComplainantLastName = form.LastName,
                ComplainantEmail = form.Email,
                ComplainantPhone = form.Phone,
                ComplainantNetwork = form.Network,
                AccusedPrefix = form.AccusedPrefix,
                AccusedFirstName = form.AccusedFirst,
                AccusedLastName = form.AccusedLast,
                AccusedAgency = form.AccusedAgency,
                AccusedPosition = form.AccusedPosition,
                Description = form.Description,
                IncidentDate = form.IncidentDate,
                IncidentTime = form.IncidentTime,
                Province = form.Province,
                District = form.District,
                SubDistrict = form.SubDistrict,
                Location = form.Location,
                FirstReceivedDate = form.FirstReceivedDate
            });

            if (uploadedFiles.Count > 0)
            {
                await ComplaintApi.UploadComplaintDocumentsAsync(created.Id, uploadedFiles.Select(file => file.File));
            }

            createdComplaintId = created.Id;
            confirmOpen = false;
            successOpen = true;
        }
        catch (Exception ex)
        {
            confirmOpen = false;
            saveError = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private void ResetForm()
    {
        form = new FormData();
        uploadedFiles.Clear();
        fileError = string.Empty;
        confirmOpen = false;
        successOpen = false;
        saveError = string.Empty;
        createdComplaintId = null;
        thaiIdMessage = string.Empty;
        thaiIdLoading = false;
        aiSuggestionVisible = false;
        largeScanPages = 0;
        editContext = new EditContext(form);
    }

    private static string FormatSize(long bytes)
    {
        const double kb = 1024.0;
        const double mb = kb * 1024.0;
        return bytes >= mb ? $"{bytes / mb:0.##} MB" : $"{bytes / kb:0.##} KB";
    }

    private void GoToCreatedComplaint()
    {
        if (createdComplaintId.HasValue)
        {
            Nav.NavigateTo($"/complaints/{createdComplaintId.Value}");
            return;
        }

        Nav.NavigateTo("/complaints");
    }

    private sealed class UploadedFile(IBrowserFile file)
    {
        public IBrowserFile File { get; } = file;
        public string Name => File.Name;
        public long Size => File.Size;
    }

    private sealed class FormData : IValidatableObject
    {
        [Required(ErrorMessage = "กรุณาเลือกช่องทางการร้องเรียน")]
        public string Channel { get; set; } = "เว็บไซต์";

        public string SourceDetail { get; set; } = "";

        public bool Anonymous { get; set; }

        [RegularExpression(@"^\d{0,13}$", ErrorMessage = "เลขบัตรประชาชนต้องเป็นตัวเลขเท่านั้น")]
        public string CitizenId
        {
            get => citizenId;
            set => citizenId = NormalizeDigits(value, 13);
        }

        [Required(ErrorMessage = "กรุณาระบุเลขที่ติดตามเรื่อง")]
        [RegularExpression(@"^[A-Za-z0-9\-_/|]{4,30}$", ErrorMessage = "รูปแบบเลขติดตามไม่ถูกต้อง")]
        public string TrackNo { get; set; } = "";

        public string Prefix { get; set; } = string.Empty;

        public string FirstName { get; set; } = string.Empty;

        public string LastName { get; set; } = string.Empty;

        [Required(ErrorMessage = "กรุณาระบุสถานะเครือข่าย")]
        public string Network { get; set; } = "ไม่ได้เป็นเครือข่าย";

        public string Email { get; set; } = string.Empty;

        [RegularExpression(@"^\d{0,10}$", ErrorMessage = "เบอร์โทรศัพท์ต้องเป็นตัวเลขไม่เกิน 10 หลัก")]
        public string Phone
        {
            get => phone;
            set => phone = NormalizeDigits(value, 10);
        }

        public string AccusedPrefix { get; set; } = string.Empty;
        public string AccusedFirst { get; set; } = string.Empty;
        public string AccusedLast { get; set; } = string.Empty;
        public string AccusedAgency { get; set; } = string.Empty;
        public string AccusedPosition { get; set; } = string.Empty;

        [Required(ErrorMessage = "กรุณากรอกรายละเอียดการร้องเรียน")]
        [MinLength(20, ErrorMessage = "รายละเอียดการร้องเรียนต้องมีอย่างน้อย 20 ตัวอักษร")]
        [MaxLength(4000, ErrorMessage = "รายละเอียดการร้องเรียนยาวเกินกำหนด")]
        public string Description { get; set; } = string.Empty;

        public DateTime IncidentDate { get; set; } = DateTime.Today;
        public string IncidentTime { get; set; } = string.Empty;

        [Required(ErrorMessage = "กรุณาเลือกจังหวัด")]
        public string Province { get; set; } = "";

        public string District { get; set; } = string.Empty;
        public string SubDistrict { get; set; } = string.Empty;
        public string Location { get; set; } = string.Empty;

        // SLA Start Date — date case was FIRST received by ป.ป.ท. (not the data-entry date)
        public DateTime FirstReceivedDate { get; set; } = DateTime.Today;

        // AI recommended case category
        public string AiCategory { get; set; } = string.Empty;

        private string citizenId = string.Empty;
        private string phone = string.Empty;

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if ((Channel is "เว็บไซต์" or "สายด่วน 1206" or "อีเมล") && string.IsNullOrWhiteSpace(SourceDetail))
            {
                yield return new ValidationResult(
                    "กรุณาระบุข้อมูลแหล่งที่มาของเรื่องร้องเรียน",
                    [nameof(SourceDetail)]);
            }

            if (!string.IsNullOrWhiteSpace(SourceDetail))
            {
                if (Channel == "เว็บไซต์" && !Uri.TryCreate(SourceDetail, UriKind.Absolute, out _))
                {
                    yield return new ValidationResult(
                        "กรุณาระบุเว็บไซต์ให้เป็น URL ที่ถูกต้อง",
                        [nameof(SourceDetail)]);
                }

                if (Channel == "อีเมล" && !new EmailAddressAttribute().IsValid(SourceDetail))
                {
                    yield return new ValidationResult(
                        "กรุณาระบุอีเมลต้นทางให้ถูกต้อง",
                        [nameof(SourceDetail)]);
                }

                if (Channel == "สายด่วน 1206")
                {
                    var hasInvalidChar = SourceDetail.Any(ch => !char.IsLetterOrDigit(ch) && ch is not '-' and not '_' and not '/' and not ' ');
                    if (hasInvalidChar)
                    {
                        yield return new ValidationResult(
                            "หมายเลขอ้างอิงสายด่วนสามารถใช้เฉพาะตัวอักษร ตัวเลข และ - _ /",
                            [nameof(SourceDetail)]);
                    }
                }
            }

            if (!Anonymous)
            {
                if (string.IsNullOrWhiteSpace(FirstName) || string.IsNullOrWhiteSpace(LastName))
                {
                    yield return new ValidationResult(
                        "กรุณากรอกชื่อ-นามสกุลผู้ร้องเรียน หรือเลือกปกปิดตัวตน",
                        [nameof(FirstName), nameof(LastName)]);
                }

                if (string.IsNullOrWhiteSpace(Email) && string.IsNullOrWhiteSpace(Phone))
                {
                    yield return new ValidationResult(
                        "กรุณาระบุอีเมลหรือหมายเลขโทรศัพท์อย่างน้อย 1 รายการ",
                        [nameof(Email), nameof(Phone)]);
                }

                if (!string.IsNullOrWhiteSpace(Email) && !new EmailAddressAttribute().IsValid(Email))
                {
                    yield return new ValidationResult(
                        "รูปแบบอีเมลไม่ถูกต้อง",
                        [nameof(Email)]);
                }

                if (!string.IsNullOrWhiteSpace(CitizenId) && CitizenId.Length != 13)
                {
                    yield return new ValidationResult(
                        "เลขบัตรประชาชนต้องมี 13 หลัก",
                        [nameof(CitizenId)]);
                }
            }

            if (IncidentDate.Date > DateTime.Today)
            {
                yield return new ValidationResult(
                    "วันที่เกิดเหตุไม่สามารถเป็นวันในอนาคตได้",
                    [nameof(IncidentDate)]);
            }
        }

        private static string NormalizeDigits(string value, int maxLength)
        {
            var digits = new string((value ?? string.Empty).Where(char.IsDigit).ToArray());
            return digits.Length > maxLength ? digits[..maxLength] : digits;
        }
    }
}
