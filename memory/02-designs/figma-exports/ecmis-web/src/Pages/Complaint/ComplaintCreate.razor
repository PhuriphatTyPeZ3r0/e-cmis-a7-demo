    };

    private bool IsSourceRequired => form.Channel is "เว็บไซต์" or "สายด่วน 1206" or "อีเมล" or "แอปทางรัฐ";

    private string SourceInputType => form.Channel switch
    {
        "เว็บไซต์" => "url",
        "Facebook" => "url",
        "อีเมล" => "email",
        _ => "text"
    };

    private string SourcePlaceholder => form.Channel switch
    {
        "เว็บไซต์" => "เช่น https://www.example.go.th/complaint",
        "อีเมล" => "เช่น complaint@agency.go.th",
        "สายด่วน 1206" => "เช่น CALL-1206-000123",
        "สปน. 1111" => "เช่น SPN-1111-000123",
        "แอปทางรัฐ" => "เช่น TANG-RAT-000123",
        "จดหมาย" => "เช่น เลขหนังสือรับ 123/2569",
        "ยื่นด้วยตนเอง" => "เช่น ศูนย์บริการประชาชน ป.ป.ท.",
        "Facebook" => "เช่น https://www.facebook.com/...",
        "Telegram" => "เช่น TG-000123",
        "WhatsApp" => "เช่น WA-000123",
