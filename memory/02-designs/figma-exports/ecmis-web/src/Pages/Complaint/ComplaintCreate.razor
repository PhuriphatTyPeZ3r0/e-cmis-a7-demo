    // AI suggestion state
    private bool aiSuggestionVisible;
    private string aiSuggestedCategory = string.Empty;
    private int aiConfidence;
    private string aiReason = string.Empty;

    // Split file state
    private int splitChunkSize = 100;
    private int largeScanPages;

    private readonly List<UploadedFile> uploadedFiles = [];

    private const int MaxFiles = 10;
    private const long MaxFileSize = 50L * 1024 * 1024;

    protected override void OnInitialized()
    {
        form.SourceDetail = GetDefaultSourceDetail(form.Channel);
        form.Network = "ไม่ได้เป็นเครือข่าย";
        editContext = new EditContext(form);
    }

    private string SourceLabel => form.Channel switch
    {
        "เว็บไซต์" => "เว็บไซต์/URL ต้นทาง",
        "สายด่วน 1206" => "หมายเลขอ้างอิงจากสายด่วน",
        "สปน. 1111" => "หมายเลขอ้างอิงจาก สปน.",
        "อีเมล" => "อีเมลต้นทาง",
        "จดหมาย" => "เลขรับหนังสือ/ข้อมูลต้นทาง",
        "ยื่นด้วยตนเอง" => "จุดรับคำร้อง",
        "แอปทางรัฐ" => "รหัสอ้างอิงจากแอปทางรัฐ",
        "Line Official" => "Line Message ID",
        "Facebook" => "Facebook Post/Message URL",
        "Telegram" => "Telegram Message ID",
        "WhatsApp" => "WhatsApp Message ID",
