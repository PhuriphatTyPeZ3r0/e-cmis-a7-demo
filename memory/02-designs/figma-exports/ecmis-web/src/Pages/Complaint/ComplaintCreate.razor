    };

    private string ComplainantDisplay =>
        form.Anonymous
            ? "ไม่เปิดเผยตัวตน"
            : string.IsNullOrWhiteSpace(string.Join(' ', new[] { form.Prefix, form.FirstName, form.LastName }.Where(x => !string.IsNullOrWhiteSpace(x))))
                ? "-"
                : string.Join(' ', new[] { form.Prefix, form.FirstName, form.LastName }.Where(x => !string.IsNullOrWhiteSpace(x)));

    private void FillSampleData()
    {
        form.Channel = "แอปทางรัฐ";
        form.SourceDetail = "TANG-RAT-002567";
        form.Anonymous = false;
        form.CitizenId = "1234567890123";
        form.Prefix = "นาย";
