                </div>
            </div>
        </div>
    </div>
}

@code {
    private FormData form = new();
    private EditContext editContext = default!;
    private bool confirmOpen;
    private bool successOpen;
    private bool saving;
    private string fileError = string.Empty;
    private string saveError = string.Empty;
    private int? createdComplaintId;

    // ThaiID API state
    private bool thaiIdLoading;
    private bool thaiIdSuccess;
