        form.AccusedPrefix = "นาย";
        form.AccusedFirst = "วิชิต";
        form.AccusedLast = "มาตรา";
        form.AccusedAgency = "องค์การบริหารส่วนตำบลดอนเมือง";
        form.AccusedPosition = "นายช่างโยธา";

        form.Description = "เจ้าหน้าที่เรียกรับเงินในการอนุมัติใบอนุญาตก่อสร้างอาคาร โดยมีการเรียกเก็บค่าธรรมเนียมแฝงนอกระบบคนละ 5,000 บาท และหากไม่จ่ายจะทำการประวิงเวลาการเซ็นเอกสารออกไปอย่างไม่มีกำหนด";
        form.IncidentDate = DateTime.Today.AddDays(-2);
        form.IncidentTime = "10:30 น.";
        form.Province = "นนทบุรี";
        form.District = "ปากเกร็ด";
        form.SubDistrict = "คลองเกลือ";
