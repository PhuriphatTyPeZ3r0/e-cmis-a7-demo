@* StatusBadge — แสดง badge สถานะสำนวน *@
<span class="status-badge status-@StatusClass">@Label</span>

@code {
    [Parameter] public string Status { get; set; } = "";

    private string StatusClass => Status switch {
        "pending"  => "pending",
        "active"   => "active",
        "review"   => "review",
        "transfer" => "transfer",
        "urgent"   => "urgent",
        "closed"   => "closed",
        _ => "pending"
    };

    private string Label => Status switch {
        "pending"  => "⏳ รอดำเนินการ",
        "active"   => "🔍 กำลังไต่สวน",
        "review"   => "✅ รอพิจารณา",
        "transfer" => "→ ส่งต่อ ป.ป.ช.",
        "urgent"   => "⚡ เร่งด่วน",
        "closed"   => "✅ ดำเนินการแล้ว",
        _ => Status
    };
}
