@* ComplaintCard — card แสดงสรุปสำนวน 1 รายการ *@
@inject NavigationManager Nav

<div class="ecmis-card h-100" style="cursor:pointer" @onclick='() => Nav.NavigateTo($"/complaints/{Id}")'>
    <div class="ecmis-card-body">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <span style="font-size:13px;font-weight:800;color:var(--navy)">@CaseNo</span>
            <StatusBadge Status="@Status" />
        </div>
        <div style="font-size:14px;font-weight:600;margin-bottom:4px">@Accused</div>
        <div style="font-size:12px;color:var(--text-muted);margin-bottom:8px">@Agency</div>
        <div class="d-flex justify-content-between align-items-center">
            <span class="mini-badge" style="background:#e8f0ff;color:var(--navy)">@CaseType</span>
            <span style="font-size:11px;color:var(--text-muted)">@ReceivedDate</span>
        </div>
    </div>
</div>

@code {
    [Parameter] public int Id { get; set; }
    [Parameter] public string CaseNo { get; set; } = "";
    [Parameter] public string Accused { get; set; } = "";
    [Parameter] public string Agency { get; set; } = "";
    [Parameter] public string CaseType { get; set; } = "";
    [Parameter] public string Status { get; set; } = "";
    [Parameter] public string ReceivedDate { get; set; } = "";
}
