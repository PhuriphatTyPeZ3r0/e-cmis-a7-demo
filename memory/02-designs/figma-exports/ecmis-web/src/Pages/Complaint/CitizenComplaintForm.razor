        "พระนคร" => new[]{ "พระบรมมหาราชวัง","วังบูรพาภิรมย์","วัดราชบพิธ","สำราญราษฎร์","ศาลเจ้าพ่อเสือ","เสาชิงช้า","บวรนิเวศ","ตลาดยอด","ชนะสงคราม","บ้านพานถม","บางขุนพรหม","วัดสามพระยา" },
        _ => Enumerable.Empty<string>()
