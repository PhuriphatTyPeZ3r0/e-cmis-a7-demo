                            ไปหน้าเข้าสู่ระบบ
                        </button>
                        <button class="pub-btn pub-btn-gold" @onclick='() => Nav.NavigateTo($"/register/status?id={Uri.EscapeDataString(trackId)}")'>
                            <i class="bi bi-search"></i>
                            ตรวจสอบสถานะ
