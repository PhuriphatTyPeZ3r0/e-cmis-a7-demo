<style>
    .tos-overlay {
        position: fixed; inset: 0; z-index: 1000;
        background: rgba(0,0,0,.45);
        backdrop-filter: blur(6px);
        display: flex; align-items: center; justify-content: center;
        padding: 16px;
        animation: tos-fade-in .18s ease both;
    }
    @@keyframes tos-fade-in  { from { opacity:0; } to { opacity:1; } }
    @@keyframes tos-slide-up { from { opacity:0; transform:translateY(20px); } to { opacity:1; transform:translateY(0); } }
    @@keyframes spin { to { transform:rotate(360deg); } }

    .tos-dialog {
        background: #fff;
        border-radius: 20px;
        width: 100%; max-width: 580px;
        max-height: 88vh;
        display: flex; flex-direction: column;
        box-shadow: 0 24px 60px rgba(0,0,0,.3);
        animation: tos-slide-up .28s cubic-bezier(.16,1,.3,1) both;
        overflow: hidden;
    }

    .tos-header {
        display: flex; align-items: center; gap: 14px;
        padding: 22px 24px 18px;
        border-bottom: 1px solid #f0f0f0;
        flex-shrink: 0;
    }
    .tos-title { font-size: 15px; font-weight: 700; color: #1a1a2e; letter-spacing: -.1px; }
    .tos-sub   { font-size: 12px; color: #888; margin-top: 2px; }

    .tos-body {
        padding: 20px 24px 16px;
        overflow-y: auto; flex: 1;
        font-size: 13.5px; line-height: 1.8;
        color: #444;
        scrollbar-width: thin;
        scrollbar-color: #ddd transparent;
    }
    .tos-body::-webkit-scrollbar       { width: 4px; }
    .tos-body::-webkit-scrollbar-thumb { background: #ddd; border-radius: 4px; }

    .tos-body h4 {
        font-size: 12px; font-weight: 700; text-transform: uppercase;
        letter-spacing: .4px; color: #b8891e;
        margin: 18px 0 6px;
        display: flex; align-items: center; gap: 6px;
    }
    .tos-body h4::before {
        content: ''; width: 3px; height: 12px; border-radius: 2px;
        background: #c8a96e; flex-shrink: 0;
    }
    .tos-body h4:first-child { margin-top: 0; }
    .tos-body p  { margin: 0 0 10px; }
    .tos-body ul { margin: 0 0 12px; padding-left: 0; list-style: none; }
    .tos-body li { margin-bottom: 5px; padding-left: 16px; position: relative; }
    .tos-body li::before {
        content: ''; position: absolute; left: 4px; top: 8px;
        width: 4px; height: 4px; border-radius: 50%; background: #c8a96e;
    }
    .tos-body strong { color: #1a1a2e; font-weight: 600; }

    .tos-footer {
        display: flex; justify-content: flex-end; align-items: center; gap: 10px;
        padding: 14px 24px 18px;
        border-top: 1px solid #ebebeb;
        background: #f7f7f7;
        flex-shrink: 0;
    }
    .tos-cancel-btn {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 10px 20px; border-radius: 10px; cursor: pointer;
        font-size: 14px; font-weight: 600; font-family: var(--pub-font, sans-serif);
        background: #fff; color: #444;
        border: 1.5px solid #d0d0d0;
        transition: all .2s ease;
    }
    .tos-cancel-btn:hover { background: #f0f0f0; border-color: #aaa; color: #222; }
    @@media (max-width: 480px) {
        .tos-footer { flex-direction: column-reverse; }
        .tos-footer .pub-btn, .tos-cancel-btn { width: 100%; justify-content: center; }
    }

    .pub-birth-grid {
        display: grid;
        grid-template-columns: minmax(84px, .8fr) minmax(160px, 1.4fr) minmax(120px, 1fr);
        gap: 12px;
        align-items: start;
    }

    @@media (max-width: 640px) {
        .pub-birth-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

@code {
    private int step = 1;
    private RegistrationRequest req = new();
    private string confirmPw = "";
    // private bool showPw;
    private bool isDark = false;
    private bool showTermsModal = false;
    private bool tosLoading = false;
    private TosDto? tosData;
    private bool isCheckingUsername;
    private bool usernameWasAdjusted;
    private string usernameCheckMessage = "";
    private string trackId = "";
    private bool isSubmitting;
    private string submitError = "";
    private Dictionary<string, string> errs = new();
    private bool IsThaiDLocked => req.ThaiDVerified;
    private string? pidError;

    private void OnNationalIdInput(ChangeEventArgs e)
    {
        var raw = new string((e.Value?.ToString() ?? "").Where(char.IsDigit).ToArray());
        if (raw.Length > 13) raw = raw[..13];
        req.NationalId = raw;
        pidError = raw.Length == 13 ? null : "เลขบัตรประชาชนต้องมี 13 หลัก";
    }
    private string birthDateError = "";
    private string birthDayText = "";
    private string birthMonthText = "";
    private string birthYearText = "";
    private List<OrgItem> organizations = [];
    private string organizationLoadError = "";

    private List<SystemDto>? availableSystems;
    private HashSet<int> selectedSystemIds = new();

    private void ToggleSystem(int id, bool isChecked)
    {
        if (isChecked) selectedSystemIds.Add(id);
        else selectedSystemIds.Remove(id);
        req.RequestedSystemIds = selectedSystemIds.ToArray();
    }

    private async Task LoadAvailableSystemsAsync()
    {
        try { availableSystems = await SystemApi.ListPublicSystemsAsync(); }
        catch { availableSystems = new(); }
    }

    private static readonly (string Value, string Label)[] ThaiMonths =
    [
        ("1", "มกราคม"),
        ("2", "กุมภาพันธ์"),
        ("3", "มีนาคม"),
        ("4", "เมษายน"),
        ("5", "พฤษภาคม"),
        ("6", "มิถุนายน"),
        ("7", "กรกฎาคม"),
        ("8", "สิงหาคม"),
        ("9", "กันยายน"),
        ("10", "ตุลาคม"),
        ("11", "พฤศจิกายน"),
        ("12", "ธันวาคม")
    ];

    private void ToggleTheme() => isDark = !isDark;

    private void OnBirthDateInput(ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? "";
        // Keep only digits
        birthDayText = new string(value.Where(char.IsDigit).ToArray());
        if (birthDayText.Length > 2)
            birthDayText = birthDayText.Substring(0, 2);
        birthDateError = "";
        UpdateBirthDateFromParts(showError: false);
    }

    private void OnBirthMonthChanged(ChangeEventArgs e)
    {
        birthMonthText = e.Value?.ToString() ?? "";
        birthDateError = "";
        UpdateBirthDateFromParts(showError: false);
    }

    private void OnBirthYearInput(ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? "";
        // Keep only digits
        birthYearText = new string(value.Where(char.IsDigit).ToArray());
        if (birthYearText.Length > 4)
            birthYearText = birthYearText.Substring(0, 4);
        birthDateError = "";
        UpdateBirthDateFromParts(showError: false);
    }

    private bool UpdateBirthDateFromParts(bool showError = false)
    {
        birthDateError = "";

        var hasAny = !string.IsNullOrWhiteSpace(birthDayText)
            || !string.IsNullOrWhiteSpace(birthMonthText)
            || !string.IsNullOrWhiteSpace(birthYearText);

        if (!hasAny)
        {
            req.BirthDate = null;
            return true;
        }

        if (!int.TryParse(birthDayText, out var day) ||
            !int.TryParse(birthMonthText, out var month) ||
            !int.TryParse(birthYearText, out var buddhistYear))
        {
            if (showError) birthDateError = "กรุณากรอกวัน เดือนและปี พ.ศ. ให้ครบ";
            req.BirthDate = null;
            return false;
        }

        var gregorianYear = buddhistYear - 543;

        if (!DateOnly.TryParseExact(
            $"{gregorianYear:D4}-{month:D2}-{day:D2}",
            "yyyy-MM-dd",
            CultureInfo.InvariantCulture,
            DateTimeStyles.None,
            out var date))
        {
            if (showError) birthDateError = "วันเดือนปีเกิดไม่ถูกต้อง";
            req.BirthDate = null;
            return false;
        }

        var today = DateOnly.FromDateTime(DateTime.Today);
        if (date > today)
        {
            if (showError) birthDateError = "วันเดือนปีเกิดต้องไม่เป็นวันที่ในอนาคต";
            req.BirthDate = null;
            return false;
        }

        var maxBirthDate = today.AddYears(-120);
        if (date < maxBirthDate)
        {
            if (showError) birthDateError = "อายุต้องไม่เกิน 120 ปี";
            req.BirthDate = null;
            return false;
        }

        req.BirthDate = date;
        return true;
    }

    private void SetBirthDateParts(DateOnly? date)
    {
        if (!date.HasValue)
        {
            birthDayText = "";
            birthMonthText = "";
            birthYearText = "";
            return;
        }

        birthDayText = date.Value.Day.ToString("00", CultureInfo.InvariantCulture);
        birthMonthText = date.Value.Month.ToString(CultureInfo.InvariantCulture);
        birthYearText = (date.Value.Year + 543).ToString(CultureInfo.InvariantCulture);
    }

    private bool HasErr(string k) => errs.ContainsKey(k);
    private string E(string k)    => errs.TryGetValue(k, out var v) ? v : "";

    private string MaskId(string id) =>
        string.IsNullOrEmpty(id) || id.Length < 4
            ? id : id[..1] + new string('*', id.Length - 4) + id[^3..];

    protected override async Task OnInitializedAsync()
    {
        await LoadOrganizationsAsync();
        await LoadAvailableSystemsAsync();

        // รับ identity ที่ ThaiDCallback.razor เก็บไว้ใน sessionStorage
        var identity = await ThaiDSvc.ReadIdentityAsync();
        if (identity is null) return;

        req.TitleTh        = identity.TitleTh;
        req.FirstName      = identity.FirstNameTh;
        req.LastName       = identity.LastNameTh;
        req.FirstNameEn    = identity.FirstNameEn;
        req.LastNameEn     = identity.LastNameEn;
        req.NationalId     = identity.Pid;
        req.ThaiDVerified  = true;
        req.ThaiDCitizenId = identity.Pid;
        req.ThaiDReference = identity.Reference;
        req.BirthDate      = ParseThaiDBirthdate(identity.Birthdate);
        SetBirthDateParts(req.BirthDate);

        await ThaiDSvc.ClearIdentityAsync();
        await CheckUsernameFromApiAsync();
    }

    private async Task LoadOrganizationsAsync()
    {
        organizationLoadError = "";
        try
        {
            organizations = await UserApi.GetOrganizationsAsync();
        }
        catch (Exception ex)
        {
            organizationLoadError = $"โหลดหน่วยงานไม่สำเร็จ: {ex.Message}";
            organizations = [];
        }
    }

    private void OnOrganizationChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        if (!int.TryParse(value, out var orgId))
        {
            req.TargetOrgId = null;
            req.Bureau = "";
            return;
        }

        var org = organizations.FirstOrDefault(x => x.Id == orgId);
        req.TargetOrgId = orgId;
        req.Bureau = org?.NameTh ?? "";
        errs.Remove("bureau");
    }

    private static string OrgLabel(OrgItem org) =>
        org.NameTh;

    private static readonly TosDto TosFallback = new()
    {
        Version = "1.0",
        Title = "นโยบายความเป็นส่วนตัวและเงื่อนไขการใช้งาน",
        Content =
            "<h4>1. วัตถุประสงค์การเก็บและใช้ข้อมูลส่วนบุคคล</h4>" +
