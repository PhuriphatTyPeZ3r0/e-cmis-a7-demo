@page "/register"
@layout Components.Layout.BlankLayout
@inject NavigationManager Nav
@inject EcmisWeb.Services.UserApiService UserApi
@inject EcmisWeb.Services.ThaiDService ThaiDSvc
@inject EcmisWeb.Services.SessionService SessionSvc
@inject EcmisWeb.Services.SystemAccessApiService SystemApi
@using EcmisWeb.Models
@using EcmisWeb.Services
@using System.Globalization
@using Microsoft.AspNetCore.Components.Forms

<div class="pub-root pub-col @(isDark ? "" : "pub-light")">
    <div class="pub-bg-glow"></div>
    <div class="pub-grid"></div>

    @* ── TOP ── *@
    <div class="pub-top">
        <div class="pub-brand">
            <div class="pub-emblem">ป.ป.ท.</div>
            <div>
                <div class="pub-brand-name">E‑CMIS</div>
                <div class="pub-brand-sub">สำนักงาน ป.ป.ท.</div>
            </div>
        </div>
        <div class="pub-top-right">
            <button type="button" class="pub-theme-btn" @onclick="ToggleTheme"
                    title="@(isDark ? "เปลี่ยนเป็นธีมสว่าง" : "เปลี่ยนเป็นธีมมืด")">
                <i class="bi @(isDark ? "bi-sun-fill" : "bi-moon-stars-fill")"></i>
            </button>
            <a href="/login" class="pub-back-btn">
                <i class="bi bi-arrow-left"></i> เข้าสู่ระบบ
            </a>
        </div>
    </div>

    @* ── STEPPER ── *@
    @if (step < 4)
    {
        <div class="pub-stepper">
            <div class="pub-step-item">
                <div class="pub-dot @(step > 1 ? "done" : step == 1 ? "active" : "")">
                    @if (step > 1) { <i class="bi bi-check-lg"></i> } else { <span>1</span> }
                </div>
                <div class="pub-step-lbl @(step == 1 ? "active" : step > 1 ? "done" : "")">ข้อมูลผู้ใช้</div>
            </div>
            <div class="pub-step-line @(step > 1 ? "done" : "")"></div>
            <div class="pub-step-item">
                <div class="pub-dot @(step > 2 ? "done" : step == 2 ? "active" : "")">
                    @if (step > 2) { <i class="bi bi-check-lg"></i> } else { <span>2</span> }
                </div>
                <div class="pub-step-lbl @(step == 2 ? "active" : step > 2 ? "done" : "")">สังกัดที่ปฏิบัติงาน</div>
            </div>
            <div class="pub-step-line @(step > 2 ? "done" : "")"></div>
            <div class="pub-step-item">
                <div class="pub-dot @(step == 3 ? "active" : "")"><span>3</span></div>
                <div class="pub-step-lbl @(step == 3 ? "active" : "")">ยืนยันข้อมูล</div>
            </div>
        </div>
    }

    <div class="pub-col-card pub-card">

        @* ══ STEP 1 — ข้อมูลผู้ใช้ ══ *@
        @if (step == 1)
        {
            <div class="pub-card-head">
                <div class="pub-card-title">ข้อมูลผู้ใช้</div>
                <div class="pub-card-sub">ข้อมูลส่วนบุคคลและช่องทางติดต่อ</div>
            </div>
            <div class="pub-card-body">

                @* ThaiD *@
                <div class="pub-sec">ยืนยันตัวตน ThaiD</div>
                <div class="pub-thaid @(req.ThaiDVerified ? "verified" : "")">
                    <div class="pub-thaid-logo">
                        <i class="bi @(req.ThaiDVerified ? "bi-check-lg" : "bi-credit-card-2-front-fill")"></i>
                    </div>
                    @if (req.ThaiDVerified)
                    {
                        <div class="pub-thaid-info">
                            <div class="pub-thaid-ok-name">@req.FirstName @req.LastName</div>
                            <div class="pub-thaid-ok-id">
                                <i class="bi bi-check-circle-fill me-1" style="color:#4ade80"></i>
                                ยืนยันแล้ว · เลขบัตร @MaskId(req.NationalId)
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="pub-thaid-info">
                            <div class="pub-thaid-name">ยืนยันตัวตนด้วยบัตรประชาชนดิจิทัล</div>
                            <div class="pub-thaid-sub">ตัวเลือกเสริม: ใช้ ThaiD เพื่อช่วยเติมชื่อ-นามสกุลอัตโนมัติ หรือกรอกข้อมูลเองด้านล่างได้</div>
                        </div>
                        <button class="pub-btn pub-btn-blue" @onclick="() => OpenTerms()">
                            <i class="bi bi-credit-card-fill"></i> ยืนยัน ThaiD
                        </button>
                    }
                </div>
                @if (!req.ThaiDVerified)
                {
                    @* ช่องกรอกเลขบัตรประชาชน (แสดงเฉพาะเมื่อไม่ได้ยืนยัน ThaiD) *@
                    <div class="pub-sec" style="margin-top:22px">เลขบัตรประชาชน</div>
                    <div class="pub-field">
                        <label class="pub-lbl-f">เลขบัตรประชาชน 13 หลัก <span class="pub-req">*</span></label>
                        <div class="pub-iw">
                            <i class="bi bi-credit-card-2-front pub-ico"></i>
                            <input class="pub-inp @(pidError != null ? "pub-inp-err" : "")"
                                   type="text"
                                   inputmode="numeric"
                                   maxlength="13"
                                   placeholder="กรอกเลข 13 หลัก"
                                   value="@req.NationalId"
                                   @oninput="OnNationalIdInput" />
                        </div>
                        @if (pidError != null)
                        {
                            <div class="pub-err"><i class="bi bi-exclamation-circle me-1"></i>@pidError</div>
                        }
                    </div>
                }

                @* บัญชีผู้ใช้งาน *@
                <div class="pub-sec" style="margin-top:22px">บัญชีผู้ใช้งาน</div>
                <div class="pub-username-grid">
                    <div class="pub-field">
                        <label class="pub-lbl-f">ชื่อ (สำหรับ Username) <span class="pub-req">*</span></label>
                        <div class="pub-iw">
                            <i class="bi bi-person pub-ico"></i>
                            <input class="pub-inp"
                                   value="@req.FirstNameEn"
                                   @oninput="OnFirstNameEnInput"
                                   @onblur="CheckUsernameFromApiAsync"
                                   readonly="@IsThaiDLocked"
                                   placeholder="เช่น Somchai" />
                        </div>
                    </div>
                    <div class="pub-field">
                        <label class="pub-lbl-f">นามสกุล (สำหรับ Username) <span class="pub-req">*</span></label>
                        <div class="pub-iw">
                            <i class="bi bi-person pub-ico"></i>
                            <input class="pub-inp"
                                   value="@req.LastNameEn"
                                   @oninput="OnLastNameEnInput"
                                   @onblur="CheckUsernameFromApiAsync"
                                   readonly="@IsThaiDLocked"
                                   placeholder="เช่น Jaidee" />
                        </div>
                    </div>
                    <div class="pub-field">
                        <label class="pub-lbl-f">ชื่อผู้ใช้งาน (ระบบสร้าง)</label>
                        <div class="pub-iw">
                            <i class="bi bi-at pub-ico"></i>
                            <input class="pub-inp" value="@(isCheckingUsername ? "กำลังตรวจสอบ..." : req.Username)" readonly placeholder="auto-generate" />
                        </div>
                    </div>
                </div>
                <div class="pub-username-status @(usernameWasAdjusted ? "warn" : !string.IsNullOrEmpty(req.Username) ? "ok" : "")">
                    <i class="bi @(isCheckingUsername ? "bi-arrow-repeat" : usernameWasAdjusted ? "bi-exclamation-triangle-fill" : !string.IsNullOrEmpty(req.Username) ? "bi-check-circle-fill" : "bi-info-circle")"></i>
                    @(string.IsNullOrWhiteSpace(usernameCheckMessage)
                        ? "กรอกชื่อและนามสกุล (ด้านล่าง) เพื่อสร้าง Username"
                        : usernameCheckMessage)
                </div>
                @if (HasErr("uname")) { <span class="pub-err-msg" style="margin-top:8px"><i class="bi bi-exclamation-circle-fill"></i>@E("uname")</span> }
                @if (HasErr("fnen"))  { <span class="pub-err-msg" style="margin-top:4px"><i class="bi bi-exclamation-circle-fill"></i>@E("fnen")</span> }
                @if (HasErr("lnen"))  { <span class="pub-err-msg" style="margin-top:4px"><i class="bi bi-exclamation-circle-fill"></i>@E("lnen")</span> }

                @* ข้อมูลส่วนบุคคล *@
                <div class="pub-sec" style="margin-top:22px">ข้อมูลส่วนบุคคล</div>
                <div class="pub-g3">
                    <div class="pub-field">
                        <label class="pub-lbl-f">คำนำหน้า <span class="pub-req">*</span></label>
                        <div class="pub-iw">
                            <i class="bi bi-person-badge pub-ico"></i>
                            <select class="pub-sel @(HasErr("title") ? "err" : "")" @bind="req.TitleTh" disabled="@IsThaiDLocked">
                                <option value="">— เลือก —</option>
                                <option>นาย</option>
                                <option>นาง</option>
                                <option>นางสาว</option>
                                <option>ว่าที่ร้อยตรี</option>
                                <option>ว่าที่ร้อยโท</option>
                                <option>ว่าที่ร้อยเอก</option>
                            </select>
                        </div>
                        @if (HasErr("title")) { <span class="pub-err-msg"><i class="bi bi-exclamation-circle-fill"></i>@E("title")</span> }
                    </div>
                    <div class="pub-field">
                        <label class="pub-lbl-f">ชื่อ <span class="pub-req">*</span></label>
                        <div class="pub-iw">
                            <i class="bi bi-person-fill pub-ico"></i>
                            <input class="pub-inp @(HasErr("fn") ? "err" : "")"
                                   @bind="req.FirstName" readonly="@IsThaiDLocked" placeholder="ชื่อ" />
                        </div>
                        @if (HasErr("fn")) { <span class="pub-err-msg"><i class="bi bi-exclamation-circle-fill"></i>@E("fn")</span> }
                    </div>
                    <div class="pub-field">
                        <label class="pub-lbl-f">นามสกุล <span class="pub-req">*</span></label>
                        <div class="pub-iw">
                            <i class="bi bi-person-fill pub-ico"></i>
                            <input class="pub-inp @(HasErr("ln") ? "err" : "")"
                                   @bind="req.LastName" readonly="@IsThaiDLocked" placeholder="นามสกุล" />
                        </div>
                        @if (HasErr("ln")) { <span class="pub-err-msg"><i class="bi bi-exclamation-circle-fill"></i>@E("ln")</span> }
                    </div>
                </div>
                <div class="pub-g3" style="margin-top:14px">
                    <div class="pub-field">
                        <label class="pub-lbl-f">ชื่อเล่น</label>
                        <div class="pub-iw">
                            <i class="bi bi-chat-heart pub-ico"></i>
                            <input class="pub-inp" @bind="req.Nickname" placeholder="ชื่อเล่น" />
                        </div>
                    </div>
                </div>
                <div class="pub-field" style="margin-top:14px">
                    <label class="pub-lbl-f">วันเดือนปีเกิด</label>
                    <div class="pub-birth-grid">
                        <div class="pub-field">
                            <label class="pub-lbl-f">วัน</label>
                            <div class="pub-iw">
                                <input class="pub-inp" type="text" inputmode="numeric" maxlength="2"
                                    value="@birthDayText" placeholder="วว"
                                    disabled="@IsThaiDLocked"
                                    @oninput="OnBirthDateInput"
                                    autocomplete="bday-day" />
                            </div>
                        </div>

                        <div class="pub-field">
                            <label class="pub-lbl-f">เดือน</label>
                            <div class="pub-iw">
                                <select class="pub-inp"
                                        value="@birthMonthText"
                                        disabled="@IsThaiDLocked"
                                        @onchange="OnBirthMonthChanged"
                                        autocomplete="bday-month">
                                    <option value="">เลือกเดือน</option>
                                    @foreach (var month in ThaiMonths)
                                    {
                                        <option value="@month.Value">@month.Label</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="pub-field">
                            <label class="pub-lbl-f">ปี พ.ศ.</label>
                            <div class="pub-iw">
                                <input class="pub-inp" type="text" inputmode="numeric" maxlength="4"
                                    value="@birthYearText" placeholder="ปปปป"
                                    disabled="@IsThaiDLocked"
                                    @oninput="OnBirthYearInput"
                                    autocomplete="bday-year" />
                            </div>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(birthDateError))
                    {
                        <div class="pub-username-status warn" style="margin-top:8px">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            @birthDateError
                        </div>
                    }
                </div>

                @* ช่องทางติดต่อ *@
                <div class="pub-sec" style="margin-top:22px">ช่องทางติดต่อ</div>
                <div class="pub-g3">
                    <div class="pub-field" style="grid-column:1/3">
                        <label class="pub-lbl-f">โทรศัพท์ภายใน</label>
                        <div class="pub-iw">
                            <i class="bi bi-telephone pub-ico"></i>
                            <input class="pub-inp" @bind="req.PhoneInternal" placeholder="02-xxx-xxxx" />
                        </div>
                    </div>
                    <div class="pub-field">
                        <label class="pub-lbl-f">หมายเลขต่อ</label>
                        <div class="pub-iw">
                            <i class="bi bi-hash pub-ico"></i>
                            <input class="pub-inp" @bind="req.PhoneExtension" placeholder="xxxx" />
                        </div>
                    </div>
                </div>
                <div class="pub-g3" style="margin-top:14px">
                    <div class="pub-field" style="grid-column:1/3">
                        <label class="pub-lbl-f">โทรศัพท์มือถือ <span class="pub-req">*</span></label>
                        <div class="pub-iw">
                            <i class="bi bi-phone-fill pub-ico"></i>
                            <input class="pub-inp @(HasErr("mob") ? "err" : "")"
                                   @bind="req.Mobile" placeholder="08x-xxx-xxxx" maxlength="12" />
                        </div>
                        @if (HasErr("mob")) { <span class="pub-err-msg"><i class="bi bi-exclamation-circle-fill"></i>@E("mob")</span> }
                    </div>
                    <div class="pub-field">
                        <label class="pub-lbl-f">มือถือสำรอง</label>
                        <div class="pub-iw">
                            <i class="bi bi-phone pub-ico"></i>
                            <input class="pub-inp" @bind="req.MobileBackup" placeholder="08x-xxx-xxxx" maxlength="12" />
                        </div>
                    </div>
                </div>
                <div class="pub-field" style="margin-top:14px">
                    <label class="pub-lbl-f">อีเมลราชการ <span class="pub-req">*</span></label>
                    <div class="pub-iw">
                        <i class="bi bi-envelope-fill pub-ico"></i>
                        <input class="pub-inp @(HasErr("em") ? "err" : "")"
                               type="email" @bind="req.Email" placeholder="name@pacc.go.th" />
                    </div>
                    @if (HasErr("em")) { <span class="pub-err-msg"><i class="bi bi-exclamation-circle-fill"></i>@E("em")</span> }
                </div>
                <div class="pub-field" style="margin-top:10px">
                    <label class="pub-lbl-f">อีเมลสำรอง</label>
                    <div class="pub-iw">
                        <i class="bi bi-envelope pub-ico"></i>
                        <input class="pub-inp" type="email" @bind="req.EmailBackup" placeholder="personal@example.com (ถ้ามี)" />
                    </div>
                </div>

                @*
                รหัสผ่าน
                <div class="pub-sec" style="margin-top:22px">รหัสผ่าน</div>
                <div class="pub-g2">
                    <div class="pub-field">
                        <label class="pub-lbl-f">รหัสผ่าน <span class="pub-req">*</span></label>
                        <div class="pub-iw">
                            <i class="bi bi-lock-fill pub-ico"></i>
                            <input class="pub-inp pub-inp-pr @(HasErr("pw") ? "err" : "")"
                                   type="@(showPw ? "text" : "password")"
                                   value="@req.Password"
                                   @oninput="OnPasswordInput"
                                   placeholder="อย่างน้อย 8 ตัวอักษร" />
                            <button type="button" class="pub-eye" @onclick="() => showPw = !showPw">
                                <i class="bi @(showPw ? "bi-eye-slash" : "bi-eye")"></i>
                            </button>
                        </div>
                        <div class="pub-str"><div class="pub-str-fill" style="width:@(PwdPct())%;background:@PwdColor()"></div></div>
                        @if (!string.IsNullOrEmpty(PwdLabel()))
                        {
                            <div class="pub-str-lbl" style="color:@PwdColor()">@PwdLabel()</div>
                        }
                        @if (HasErr("pw")) { <span class="pub-err-msg"><i class="bi bi-exclamation-circle-fill"></i>@E("pw")</span> }
                    </div>
                    <div class="pub-field">
                        <label class="pub-lbl-f">ยืนยันรหัสผ่าน <span class="pub-req">*</span></label>
                        <div class="pub-iw">
                            <i class="bi bi-lock-fill pub-ico"></i>
                            <input class="pub-inp pub-inp-pr @(HasErr("cpw") ? "err" : "")"
                                   type="@(showPw ? "text" : "password")"
                                   value="@confirmPw"
                                   @oninput="OnConfirmPwInput"
                                   placeholder="กรอกรหัสผ่านอีกครั้ง" />
                        </div>
                        @if (HasErr("cpw")) { <span class="pub-err-msg"><i class="bi bi-exclamation-circle-fill"></i>@E("cpw")</span> }
                    </div>
                </div>
                <div style="font-size:12px;color:var(--pub-muted);margin-top:8px;line-height:1.6">
                    <i class="bi bi-shield-check me-1" style="color:rgba(200,169,110,.6)"></i>
                    ต้องมี: ตัวพิมพ์ใหญ่ · ตัวพิมพ์เล็ก · ตัวเลข · อักขระพิเศษ · ห้ามมีตัวเลขเรียงต่อกัน (เช่น 123, 789)
                </div>
                *@

                <div class="pub-actions">
                    <button class="pub-btn pub-btn-flex pub-btn-gold" @onclick="Step1Next">
                        ถัดไป — สังกัดที่ปฏิบัติงาน <i class="bi bi-arrow-right"></i>
                    </button>
                </div>
            </div>
        }

        @* ══ STEP 2 — สังกัดที่ปฏิบัติงาน ══ *@
        else if (step == 2)
        {
            <div class="pub-card-head">
                <div class="pub-card-title">สังกัดที่ปฏิบัติงาน</div>
                <div class="pub-card-sub">ตำแหน่ง สายงาน และหน่วยงานที่สังกัด</div>
            </div>
            <div class="pub-card-body">

                <div class="pub-field" style="margin-top:14px">
                    <label class="pub-lbl-f">ตำแหน่งงาน</label>
                    <div class="pub-iw">
                        <i class="bi bi-briefcase-fill pub-ico"></i>
                        <input class="pub-inp" @bind="req.JobTitle" placeholder="ตำแหน่งงานในสังกัด" />
                    </div>
                </div>

                @* หน่วยงานที่สังกัด *@
                <div class="pub-sec" style="margin-top:22px">หน่วยงานที่สังกัด</div>
                <div class="pub-g2">
                    <div class="pub-field">
                        <label class="pub-lbl-f">สำนัก / กอง / ศูนย์ <span class="pub-req">*</span></label>
                        <div class="pub-iw">
                            <select class="pub-sel no-ico @(HasErr("bureau") ? "err" : "")"
                                    value="@req.TargetOrgId?.ToString()"
                                    @onchange="OnOrganizationChanged">
                                <option value="">— เลือกสำนัก/กอง/ศูนย์ —</option>
                                @foreach (var org in organizations)
                                {
                                    <option value="@org.Id">@OrgLabel(org)</option>
                                }
                            </select>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(organizationLoadError))
                        {
                            <span class="pub-err-msg"><i class="bi bi-exclamation-circle-fill"></i>@organizationLoadError</span>
                        }
                        @if (HasErr("bureau")) { <span class="pub-err-msg"><i class="bi bi-exclamation-circle-fill"></i>@E("bureau")</span> }
                    </div>
                    <div class="pub-field">
                        <label class="pub-lbl-f">ประเภทเจ้าหน้าที่ <span class="pub-req">*</span></label>
                        <div class="pub-iw">
                            <select class="pub-sel no-ico @(HasErr("offtype") ? "err" : "")" @bind="req.OfficerType">
                                <option value="">— เลือกประเภท —</option>
                                <option>ข้าราชการ</option>
                                <option>พนักงานราชการ</option>
                                <option>ลูกจ้างประจำ</option>
                                <option>ลูกจ้างชั่วคราว</option>
                                <option>เจ้าหน้าที่โครงการ</option>
                            </select>
                        </div>
                        @if (HasErr("offtype")) { <span class="pub-err-msg"><i class="bi bi-exclamation-circle-fill"></i>@E("offtype")</span> }
                    </div>
                </div>
                <div class="pub-g2" style="margin-top:14px">
                    <div class="pub-field">
                        <label class="pub-lbl-f">ส่วน / กลุ่ม / ฝ่าย</label>
                        <div class="pub-iw">
                            <select class="pub-sel no-ico" @bind="req.Division">
                                <option value="">— ไม่ระบุ —</option>
                                <option>กลุ่มงานคอมพิวเตอร์และการสื่อสาร</option>
                                <option>กลุ่มงานบริหารเทคโนโลยีและพัฒนาระบบ</option>
                                <option>ฝ่ายบริหารทั่วไป</option>
                            </select>
                        </div>
                    </div>
                    <div class="pub-field">
                        <label class="pub-lbl-f">ส่วน / กลุ่ม / ย่อย</label>
                        <div class="pub-iw">
                            <i class="bi bi-diagram-3 pub-ico"></i>
                            <input class="pub-inp" @bind="req.SubDivision" placeholder="ระบุกลุ่มย่อย (ถ้ามี)" />
                        </div>
                    </div>
                </div>

<div class="pub-actions">
