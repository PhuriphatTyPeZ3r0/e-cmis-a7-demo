    private async Task Submit()
    {
        submitError = "";
        isSubmitting = true;

        try
        {
            if (!UpdateBirthDateFromParts(showError: true))
            {
                submitError = birthDateError;
                return;
            }

            var saved = await UserApi.RegisterAsync(req);
            trackId = saved.TrackingId;
            req.Username = saved.Username;
            req.Email = saved.Email;
            step = 4;
        }
        catch (Exception ex)
        {
            submitError = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private int PwdPct()
    {
        if (string.IsNullOrEmpty(req.Password)) return 0;
        int s = 0;
        if (req.Password.Length >= 8)  s += 25;
        if (req.Password.Length >= 12) s += 15;
        if (req.Password.Any(char.IsUpper)) s += 20;
        if (req.Password.Any(char.IsDigit)) s += 20;
        if (req.Password.Any(c => !char.IsLetterOrDigit(c))) s += 20;
        return Math.Min(s, 100);
    }
    private string PwdColor() { var p = PwdPct(); return p < 40 ? "#ef4444" : p < 70 ? "#f59e0b" : "#22c55e"; }
    private string PwdLabel() { var p = PwdPct(); return p == 0 ? "" : p < 40 ? "รหัสผ่านอ่อนแอ" : p < 70 ? "รหัสผ่านปานกลาง" : "รหัสผ่านแข็งแกร่ง"; }

