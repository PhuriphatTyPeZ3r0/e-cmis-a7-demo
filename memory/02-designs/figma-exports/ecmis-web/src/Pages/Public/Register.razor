    private async Task CheckUsernameFromApiAsync()
    {
        errs.Remove("uname");
        var fn = NormalizeEnglishName(req.FirstNameEn);
        var ln = NormalizeEnglishName(req.LastNameEn);

        if (fn.Length == 0 || ln.Length == 0)
        {
            req.Username = "";
            usernameWasAdjusted = false;
            usernameCheckMessage = "กรอกชื่อและนามสกุล (ด้านล่าง) เพื่อสร้าง Username";
            return;
        }

        isCheckingUsername = true;
        usernameCheckMessage = "กำลังตรวจสอบ Username...";
        StateHasChanged();

        UsernameCheckResult result;
        try
        {
            result = await UserApi.CheckUsernameAsync(req.FirstNameEn, req.LastNameEn);
        }
        catch (Exception ex)
        {
            usernameCheckMessage = $"ไม่สามารถตรวจสอบ Username ได้: {ex.Message}";
            isCheckingUsername = false;
            return;
        }

        req.Username = result.Username;
        usernameWasAdjusted = result.WasAdjusted;
        usernameCheckMessage = result.WasAdjusted
            ? $"Username {result.OriginalUsername} ถูกใช้งานแล้ว ระบบปรับเป็น {result.Username}"
            : $"Username {result.Username} สามารถใช้งานได้";
        isCheckingUsername = false;
    }

    private void UpdateUsername()
    {
        var fn = NormalizeEnglishName(req.FirstNameEn);
        var ln = NormalizeEnglishName(req.LastNameEn);
        if (fn.Length == 0 || ln.Length == 0) { req.Username = ""; return; }

        var candidate = "";
        for (var len = 1; len <= ln.Length; len++)
        {
            candidate = $"{fn}.{ln[..len]}";
            if (!UsernameConflict(candidate))
                break;
        }

        var suffix = 2;
        while (UsernameConflict(candidate))
        {
            candidate = $"{fn}.{ln}{suffix}";
            suffix++;
        }

        req.Username = candidate;
    }

    private static string NormalizeEnglishName(string value) =>
        new((value ?? "")
            .Trim()
            .ToLowerInvariant()
            .Where(c => c is >= 'a' and <= 'z')
            .ToArray());

    private static DateOnly? ParseThaiDBirthdate(string value)
    {
        if (string.IsNullOrWhiteSpace(value)) return null;
        if (DateOnly.TryParse(value, out var parsed)) return parsed;

        var digits = new string(value.Where(char.IsDigit).ToArray());
        if (digits.Length == 8 &&
            int.TryParse(digits[..4], out var year) &&
            int.TryParse(digits[4..6], out var month) &&
            int.TryParse(digits[6..], out var day))
        {
            if (year > 2400) year -= 543;
            if (DateOnly.TryParse($"{year:D4}-{month:D2}-{day:D2}", out parsed))
                return parsed;
        }

        return null;
    }

    private bool UsernameConflict(string name) =>
        // Backend จะ validate ให้เอง ไม่ต้อง check duplicate username ที่ frontend
        false;

    private static bool HasSequentialNums(string pw)
    {
        for (int i = 0; i < pw.Length - 2; i++) {
            if (!char.IsDigit(pw[i]) || !char.IsDigit(pw[i+1]) || !char.IsDigit(pw[i+2])) continue;
            int a = pw[i]-'0', b = pw[i+1]-'0', c = pw[i+2]-'0';
            if ((b==a+1&&c==b+1)||(b==a-1&&c==b-1)) return true;
        }
        return false;
    }
