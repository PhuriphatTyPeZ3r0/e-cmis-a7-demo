                    }
                    <div class="pub-sum-row"><span class="pub-sum-k">เลขบัตรประชาชน</span><span class="pub-sum-v">@MaskId(req.NationalId)</span></div>
                    <div class="pub-sum-row"><span class="pub-sum-k">โทรศัพท์มือถือ</span><span class="pub-sum-v">@req.Mobile</span></div>
                    @if (!string.IsNullOrEmpty(req.PhoneInternal))
                    {
