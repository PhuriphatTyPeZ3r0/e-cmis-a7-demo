@page "/forgot-password"
@layout Components.Layout.BlankLayout
@inject EcmisWeb.Services.AdminApiService AdminApi
@inject NavigationManager Nav
@using EcmisWeb.Services
@using EcmisWeb.Models
@using Microsoft.AspNetCore.Components.Web

<PageTitle>ลืมรหัสผ่าน — E-CMIS</PageTitle>

<div class="tracker-shell">
    <div class="tracker-card">

        <div class="d-flex align-items-center gap-3 mb-4">
            <div style="width:42px;height:42px;border-radius:50%;border:2px solid var(--gold);background:var(--navy-deep);display:flex;align-items:center;justify-content:center;color:var(--gold);font-weight:800;font-size:12px;flex-shrink:0">
                ป.ป.ท.
            </div>
            <div>
                <div style="font-size:18px;font-weight:800;color:var(--navy-deep)">ลืมรหัสผ่าน</div>
                <div style="font-size:12px;color:var(--text-muted)">E-CMIS — สำนักงาน ป.ป.ท.</div>
            </div>
        </div>

        @if (!linkSent)
        {
            <div style="margin-bottom:20px">
                <label style="display:block;font-size:13px;font-weight:700;color:var(--navy-deep);margin-bottom:8px">อีเมลที่ลงทะเบียน</label>
                <input class="tracker-input" @bind="email" placeholder="example@pacc.go.th" style="width:100%;margin-bottom:12px" />
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="reg-alert reg-alert-error">
                        <i class="bi bi-exclamation-circle-fill"></i>
                        @errorMessage
                    </div>
                }
            </div>

            <button class="btn-login" style="width:100%" @onclick="SendResetLink" disabled="@isSending">
                @if (isSending)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span><text>กำลังส่ง</text>
                }
                else
                {
                    <i class="bi bi-send me-1"></i><text>ส่งลิงก์รีเซ็ต</text>
                }
            </button>
        }
        else
        {
            <div style="background:#f0f9ff;border:1px solid #bae6fd;border-radius:12px;padding:16px;margin-bottom:20px">
                <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">
                    <i class="bi bi-info-circle-fill" style="color:#0284c7;font-size:16px"></i>
                    <div style="font-size:13px;font-weight:700;color:#0c4a6e">ส่งลิงก์รีเซ็ตแล้ว</div>
                </div>
                <div style="font-size:12px;color:#0369a1">
                    หากอีเมลนี้มีในระบบ ระบบจะส่งลิงก์รีเซ็ตไปยัง @email กรุณาตรวจสอบอีเมลของท่าน
                </div>
            </div>

            <button class="btn-login" style="width:100%;background:var(--navy-mid)" @onclick="ResendLink" disabled="@isSending">
                @if (isSending)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span><text>กำลังส่ง</text>
                }
                else
                {
                    <i class="bi bi-arrow-counterclockwise me-1"></i><text>ส่งลิงก์ใหม่</text>
                }
            </button>
        }

        <div style="margin-top:24px;padding-top:20px;border-top:1px solid #eaecf2;display:flex;justify-content:space-between;align-items:center">
            <a href="/login" style="font-size:13px;color:var(--navy);text-decoration:none;display:flex;align-items:center;gap:5px">
                <i class="bi bi-arrow-left"></i> กลับสู่หน้าเข้าสู่ระบบ
            </a>
            <a href="mailto:itsupport@pacc.go.th" style="font-size:12px;color:var(--text-muted)">
                <i class="bi bi-envelope me-1"></i>itsupport@pacc.go.th
            </a>
        </div>
    </div>
</div>

@code {
    private string email = "";
    private string errorMessage = "";
    private bool linkSent = false;
    private bool isSending = false;

    private async Task SendResetLink()
    {
        if (string.IsNullOrWhiteSpace(email))
        {
            errorMessage = "กรุณากรอกอีเมล";
            return;
        }

        isSending = true;
        errorMessage = "";
        StateHasChanged();

        try
        {
            await AdminApi.RequestPasswordResetAsync(new PasswordResetRequest { Email = email });
            linkSent = true;
            errorMessage = "";
        }
        catch (Exception ex)
        {
            errorMessage = "ไม่สามารถส่งลิงก์รีเซ็ตได้: " + ex.Message;
        }
        finally
        {
            isSending = false;
            StateHasChanged();
        }
    }

    private async Task ResendLink()
    {
        linkSent = false;
        await SendResetLink();
    }
}
