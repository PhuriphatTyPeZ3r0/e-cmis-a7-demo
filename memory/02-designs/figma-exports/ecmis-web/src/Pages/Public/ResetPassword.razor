@page "/reset-password"
@layout Components.Layout.BlankLayout
@inject NavigationManager Nav
@inject EcmisWeb.Services.AuthApiService AuthApi
@using Microsoft.AspNetCore.Components

<PageTitle>รีเซ็ตรหัสผ่าน — E-CMIS</PageTitle>

<div class="rp-root">
    <div class="rp-card">
        <div class="rp-brand">ป.ป.ท.</div>
        <h1>รีเซ็ตรหัสผ่าน</h1>
        <p>ตั้งรหัสผ่านใหม่จากลิงก์ที่ได้รับทาง Email</p>

        @if (string.IsNullOrWhiteSpace(Token))
        {
            <div class="rp-alert err">กรุณาเปิดหน้านี้จากลิงก์รีเซ็ตรหัสผ่านใน Email</div>
        }
        else if (verifying)
        {
            <div class="rp-alert">กำลังตรวจสอบลิงก์...</div>
        }
        else if (!validToken)
        {
            <div class="rp-alert err">@error</div>
        }
        else if (success)
        {
            <div class="rp-alert ok">ตั้งรหัสผ่านใหม่สำเร็จ กรุณาเข้าสู่ระบบด้วยรหัสผ่านใหม่</div>
            <button class="rp-btn" @onclick='() => Nav.NavigateTo("/login")'>ไปหน้าเข้าสู่ระบบ</button>
        }
        else
        {
            <div class="rp-alert">
                บัญชี <strong>@username</strong><br />
                ส่งลิงก์ไปที่ @maskedEmail
            </div>

            <label>รหัสผ่านใหม่</label>
            <input type="password" @bind="newPassword" placeholder="อย่างน้อย 8 ตัวอักษร" />

            <label>ยืนยันรหัสผ่านใหม่</label>
            <input type="password" @bind="confirmPassword" placeholder="กรอกซ้ำอีกครั้ง" />

            @if (!string.IsNullOrWhiteSpace(error))
            {
                <div class="rp-alert err">@error</div>
            }

            <button class="rp-btn" @onclick="Submit" disabled="@busy">
                @(busy ? "กำลังบันทึก..." : "ตั้งรหัสผ่านใหม่")
            </button>
        }
    </div>
</div>

<style>
    .rp-root {
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 24px;
        background: #050b18;
        font-family: 'Sarabun', 'IBM Plex Sans Thai', sans-serif;
    }
    .rp-card {
        width: min(440px, 100%);
        background: #0b1730;
        border: 1px solid rgba(200, 169, 110, .22);
        border-radius: 8px;
        padding: 28px;
        color: #fff;
    }
    .rp-brand {
        width: 46px;
        height: 46px;
        border: 2px solid #c8a96e;
        border-radius: 50%;
        display: grid;
        place-items: center;
        color: #c8a96e;
        font-weight: 800;
        margin-bottom: 18px;
    }
    h1 { font-size: 26px; margin: 0 0 8px; }
    p { margin: 0 0 22px; color: rgba(255,255,255,.62); }
    label { display: block; margin: 14px 0 7px; font-size: 13px; color: rgba(255,255,255,.72); }
    input {
        width: 100%;
        height: 46px;
        border: 1px solid rgba(255,255,255,.14);
        border-radius: 6px;
        padding: 0 12px;
        background: rgba(255,255,255,.06);
        color: #fff;
        outline: none;
    }
    .rp-btn {
        width: 100%;
        height: 46px;
        margin-top: 18px;
        border: 0;
        border-radius: 6px;
        background: #c8a96e;
        color: #071020;
        font-weight: 800;
        cursor: pointer;
    }
    .rp-btn:disabled { opacity: .65; cursor: wait; }
    .rp-alert {
        margin-top: 16px;
        padding: 12px;
        border-radius: 6px;
        font-size: 14px;
        line-height: 1.5;
    }
    .rp-alert.err { background: rgba(239, 68, 68, .12); color: #fecaca; }
    .rp-alert.ok { background: rgba(34, 197, 94, .12); color: #bbf7d0; }
</style>

@code {
    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private string newPassword = "";
    private string confirmPassword = "";
    private string error = "";
    private bool busy;
    private bool success;
    private bool verifying;
    private bool validToken;
    private string verifiedToken = "";
    private string username = "";
    private string maskedEmail = "";

    protected override async Task OnParametersSetAsync()
    {
        var token = Token?.Trim() ?? "";
        if (string.IsNullOrWhiteSpace(token) || token == verifiedToken)
            return;

        verifying = true;
        validToken = false;
        error = "";

        try
        {
            var result = await AuthApi.VerifyResetPasswordAsync(token);
            validToken = result.Valid;
            username = result.Username;
            maskedEmail = result.MaskedEmail;
            verifiedToken = token;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            verifying = false;
        }
    }

    private async Task Submit()
    {
        error = "";

        if (string.IsNullOrWhiteSpace(Token) || !validToken)
        {
            error = "ลิงก์รีเซ็ตไม่ถูกต้องหรือถูกใช้ไปแล้ว";
            return;
        }

        if (string.IsNullOrWhiteSpace(newPassword))
        {
            error = "กรุณากรอกรหัสผ่านใหม่";
            return;
        }

        if (newPassword != confirmPassword)
        {
            error = "รหัสผ่านไม่ตรงกัน";
            return;
        }

        busy = true;
        try
        {
            await AuthApi.ResetPasswordAsync(Token, newPassword, confirmPassword);
            success = true;
            Nav.NavigateTo("/login?reset=success");
        }
        catch (Exception ex)
        {
            error = $"เชื่อมต่อระบบไม่สำเร็จ: {ex.Message}";
        }
        finally
        {
            busy = false;
        }
    }
}
