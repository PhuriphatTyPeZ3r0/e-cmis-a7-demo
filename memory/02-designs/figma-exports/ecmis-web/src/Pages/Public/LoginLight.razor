@page "/login-light"
@layout Components.Layout.BlankLayout
@inject NavigationManager Nav
@implements IDisposable

<style>
/* ═══════════════════════════════════════════════════
   E-CMIS LOGIN — Light Edition
   ═══════════════════════════════════════════════════ */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
    --gold:    #c8a96e;
    --gold-hi: #e2c484;
    --navy:    #1a3575;
    --navy-dk: #0d2258;
    --navy-md: #2d52a0;
    --muted-l: rgba(255,255,255,.40);
}

html, body { height: 100%; background: #eaf0fb; }

.lx-root {
    display: flex; min-height: 100vh;
    font-family: 'Sarabun','IBM Plex Sans Thai',sans-serif;
    background: #eaf0fb;
    opacity: 0; animation: lx-fade .6s ease .05s forwards;
}
@@keyframes lx-fade { to { opacity: 1; } }

/* ─── LEFT (navy brand — เหมือน dark) ──────────────── */
.lx-left {
    flex: 1; position: relative;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    overflow: hidden; padding: 60px 48px 48px;
    background: linear-gradient(150deg, #0c1d50 0%, #1a3575 55%, #0d1e4a 100%);
}
.lx-left::before {
    content: ''; position: absolute; inset: 0;
    background:
        radial-gradient(ellipse 70% 60% at 50% 44%, rgba(200,169,110,.08) 0%, transparent 65%),
        radial-gradient(ellipse 100% 100% at 50% 50%, rgba(13,30,74,0) 0%, rgba(5,10,30,.35) 100%);
    pointer-events: none;
}
.lx-left::after {
    content: ''; position: absolute; inset: 0;
    background: repeating-linear-gradient(0deg, transparent, transparent 3px, rgba(0,0,0,.04) 3px, rgba(0,0,0,.04) 4px);
    pointer-events: none; opacity: .3;
}

.lx-grid {
    position: absolute; inset: -10%;
    background-image:
        linear-gradient(rgba(200,169,110,.028) 1px, transparent 1px),
        linear-gradient(90deg, rgba(200,169,110,.028) 1px, transparent 1px);
    background-size: 80px 80px;
    animation: lx-drift 60s linear infinite; pointer-events: none;
}
@@keyframes lx-drift { from { transform: translate(0,0); } to { transform: translate(80px,80px); } }

.lx-ptcl { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
.lx-p {
    position: absolute; width: 2px; height: 2px; border-radius: 50%;
    background: var(--gold); opacity: 0;
    animation: lx-rise var(--d) ease-in-out var(--delay) infinite;
}
@@keyframes lx-rise {
    0%   { opacity: 0; transform: translate(0,0) scale(0); }
    15%  { opacity: .6; }
    85%  { opacity: .2; }
    100% { opacity: 0; transform: translate(var(--tx),-100px) scale(.4); }
}

/* ── EMBLEM ─── */
.lx-em-wrap {
    position: relative; width: 260px; height: 260px;
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 52px;
    animation: lx-em-in 1.4s cubic-bezier(.16,1,.3,1) .2s both;
}
@@keyframes lx-em-in { from { opacity:0; transform:scale(.55) translateY(24px); } to { opacity:1; transform:scale(1) translateY(0); } }
.lx-halo {
    position: absolute; width: 290px; height: 290px; border-radius: 50%;
    background: radial-gradient(circle, rgba(200,169,110,.12) 0%, rgba(200,169,110,.04) 40%, transparent 68%);
    animation: lx-halo-beat 4s ease-in-out infinite; pointer-events: none;
}
@@keyframes lx-halo-beat { 0%,100% { transform:scale(1); opacity:.7; } 50% { transform:scale(1.15); opacity:1; } }
.lx-ring { position: absolute; border-radius: 50%; border: 1px solid transparent; }
.lx-r1 { width:260px; height:260px; border-top-color:rgba(200,169,110,.75); border-right-color:rgba(200,169,110,.18); border-bottom-color:rgba(200,169,110,.08); animation:lx-cw 10s linear infinite; }
.lx-r2 { width:214px; height:214px; border-bottom-color:rgba(200,169,110,.55); border-left-color:rgba(200,169,110,.14); animation:lx-ccw 14s linear infinite; }
.lx-r3 { width:168px; height:168px; border-top-color:rgba(200,169,110,.85); border-right-color:rgba(200,169,110,.22); animation:lx-cw 6s linear infinite; }
.lx-r4 { width:130px; height:130px; border-bottom-color:rgba(255,255,255,.1); border-left-color:rgba(255,255,255,.05); animation:lx-ccw 11s linear infinite; }
@@keyframes lx-cw  { to { transform:rotate( 360deg); } }
@@keyframes lx-ccw { to { transform:rotate(-360deg); } }
.lx-r1::before, .lx-r3::before {
    content:''; position:absolute; width:7px; height:7px; border-radius:50%;
    background:var(--gold-hi); box-shadow:0 0 10px 4px rgba(200,169,110,.65);
    top:-3.5px; left:50%; transform:translateX(-50%);
}
.lx-r3::before { width:5px; height:5px; top:-2.5px; box-shadow:0 0 8px 3px rgba(200,169,110,.5); }
.lx-ticks { position:absolute; width:260px; height:260px; animation:lx-ccw 40s linear infinite; }
.lx-disk {
    position:relative; z-index:3; width:108px; height:108px; border-radius:50%;
    background:linear-gradient(150deg,#122050 0%,#060c1a 100%);
    border:2px solid rgba(200,169,110,.5);
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    box-shadow:0 0 0 8px rgba(200,169,110,.06),0 0 50px rgba(200,169,110,.15),inset 0 1px 0 rgba(255,255,255,.06);
    overflow:hidden;
}
.lx-disk::before {
    content:''; position:absolute; inset:0; border-radius:50%;
    background:conic-gradient(from 0deg,transparent 0%,rgba(200,169,110,.15) 8%,transparent 16%);
    animation:lx-cw 3.5s linear infinite;
}
.lx-disk-name { position:relative; font-size:16px; font-weight:900; color:var(--gold-hi); letter-spacing:1.5px; text-shadow:0 0 14px rgba(200,169,110,.7); }
.lx-disk-sub  { position:relative; font-size:8px; font-weight:700; color:rgba(200,169,110,.5); letter-spacing:3px; margin-top:3px; }

/* ── HERO ─── */
.lx-hero { position:relative; z-index:2; text-align:center; animation:lx-up .9s cubic-bezier(.16,1,.3,1) .65s both; }
@@keyframes lx-up { from { opacity:0; transform:translateY(18px); } to { opacity:1; transform:translateY(0); } }
.lx-hero-name { font-size:72px; font-weight:900; color:#fff; letter-spacing:-4px; line-height:1; margin-bottom:10px; }
.lx-hero-name span { color:var(--gold-hi); }
.lx-hero-bar { display:flex; align-items:center; justify-content:center; gap:16px; margin:0 auto 14px; }
.lx-bar-line { flex:1; max-width:90px; height:1px; background:linear-gradient(90deg,transparent,rgba(200,169,110,.55)); }
.lx-bar-line:last-child { transform:scaleX(-1); }
.lx-bar-gem { width:8px; height:8px; border-radius:1px; background:var(--gold); transform:rotate(45deg); box-shadow:0 0 12px rgba(200,169,110,.8); animation:lx-gem 2.5s ease-in-out infinite; }
@@keyframes lx-gem { 0%,100% { box-shadow:0 0 12px rgba(200,169,110,.7); } 50% { box-shadow:0 0 22px rgba(200,169,110,1),0 0 44px rgba(200,169,110,.35); } }
.lx-hero-sub { font-size:13px; color:var(--muted-l); line-height:1.75; letter-spacing:.3px; margin-bottom:48px; }
.lx-stats { display:flex; align-items:center; background:rgba(255,255,255,.06); border:1px solid rgba(200,169,110,.13); border-radius:14px; padding:18px 32px; gap:0; animation:lx-up .9s cubic-bezier(.16,1,.3,1) .85s both; }
.lx-stat { flex:1; text-align:center; }
.lx-stat-n { font-size:24px; font-weight:800; color:#fff; letter-spacing:-.5px; }
.lx-stat-l { font-size:11px; color:var(--muted-l); margin-top:3px; letter-spacing:.3px; }
.lx-sep { width:1px; height:32px; background:rgba(200,169,110,.13); flex-shrink:0; }
.lx-certs { position:absolute; bottom:32px; left:0; right:0; display:flex; justify-content:center; gap:10px; animation:lx-up .7s ease 1.1s both; }
.lx-cert { display:inline-flex; align-items:center; gap:5px; padding:5px 13px; border-radius:20px; font-size:10.5px; font-weight:600; color:rgba(200,169,110,.6); border:1px solid rgba(200,169,110,.15); background:rgba(200,169,110,.05); letter-spacing:.3px; }

/* ─── RIGHT PANEL (white) ────────────────────────── */
.lx-right {
    width: 460px; flex-shrink: 0;
    background: #ffffff;
    box-shadow: -6px 0 56px rgba(13,27,62,.12);
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    padding: 52px 44px; position: relative;
    animation: lx-slide .75s cubic-bezier(.16,1,.3,1) .12s both;
}
@@keyframes lx-slide { from { opacity:0; transform:translateX(36px); } to { opacity:1; transform:translateX(0); } }
.lx-right::before {
    content:''; position:absolute; top:0; left:0; right:0; height:4px;
    background: linear-gradient(90deg, var(--navy-dk), var(--navy), var(--navy-md));
}
.lx-right::after { display:none; }

.lx-card { width:100%; max-width:360px; }

/* Icon */
.lx-icon {
    width:58px; height:58px; border-radius:16px;
    background:linear-gradient(150deg, var(--navy) 0%, var(--navy-dk) 100%);
    border:1px solid rgba(26,53,117,.25);
    display:flex; align-items:center; justify-content:center;
    font-size:22px; color:#ffffff; margin-bottom:22px;
    box-shadow:0 8px 24px rgba(13,34,88,.22), 0 0 0 6px rgba(26,53,117,.08);
    animation:lx-icon-glow 3.5s ease-in-out infinite;
}
@@keyframes lx-icon-glow {
    0%,100% { box-shadow:0 8px 24px rgba(13,34,88,.22), 0 0 0 6px rgba(26,53,117,.08); }
    50%     { box-shadow:0 8px 30px rgba(13,34,88,.32), 0 0 0 9px rgba(26,53,117,.16), 0 0 28px rgba(26,53,117,.1); }
}
.lx-icon-amber { background:linear-gradient(150deg,#92590e,#5c3200); border-color:rgba(180,100,10,.3); color:#fff; }
.lx-icon-red   { background:linear-gradient(150deg,#b91c1c,#7f1d1d); border-color:rgba(185,28,28,.3); color:#fff; }

.lx-title { font-size:23px; font-weight:800; color:#0d1b42; letter-spacing:-.3px; margin-bottom:5px; }
.lx-sub   { font-size:13px; color:rgba(13,27,62,.48); line-height:1.55; margin-bottom:28px; }

/* Tabs */
.lx-tabs { display:flex; gap:3px; background:#f0f5ff; border:1px solid rgba(13,27,62,.09); border-radius:12px; padding:4px; margin-bottom:24px; }
.lx-tab { flex:1; padding:10px 8px; border:none; border-radius:9px; font-family:inherit; font-size:13px; font-weight:600; cursor:pointer; transition:all .2s; color:rgba(13,27,62,.48); background:transparent; }
.lx-tab-on { color:var(--navy); background:#ffffff; border:1px solid rgba(26,53,117,.16) !important; box-shadow:0 2px 10px rgba(13,27,62,.1); }

/* Fields */
.lx-field { margin-bottom:16px; }
.lx-lbl { display:block; font-size:10.5px; font-weight:700; color:rgba(13,27,62,.45); letter-spacing:.9px; text-transform:uppercase; margin-bottom:8px; }
.lx-iw { position:relative; }
.lx-ico { position:absolute; left:14px; top:50%; transform:translateY(-50%); font-size:15px; color:rgba(13,27,62,.28); pointer-events:none; transition:color .2s; }
.lx-inp {
    width:100%; padding:13px 14px 13px 42px;
    background:#f6f9ff; border:1.5px solid rgba(13,27,62,.11);
    border-radius:11px; color:#0d1b42;
    font-family:inherit; font-size:14px; outline:none; transition:all .22s;
}
.lx-inp::placeholder { color:rgba(13,27,62,.28); }
.lx-inp:focus { border-color:rgba(26,53,117,.5); background:#ffffff; box-shadow:0 0 0 3.5px rgba(26,53,117,.1); }
.lx-iw:focus-within .lx-ico { color:var(--navy); }
.lx-inp-pr { padding-right:46px; }
.lx-eye { position:absolute; right:12px; top:50%; transform:translateY(-50%); background:none; border:none; cursor:pointer; color:rgba(13,27,62,.28); font-size:14px; padding:4px; transition:color .2s; }
.lx-eye:hover { color:var(--navy); }

/* Between */
.lx-between { display:flex; align-items:center; justify-content:space-between; margin-bottom:20px; }
.lx-check { display:flex; align-items:center; gap:8px; font-size:13px; color:rgba(13,27,62,.5); cursor:pointer; }
.lx-check input { width:14px; height:14px; accent-color:var(--navy); cursor:pointer; }
.lx-session-note { margin:-12px 0 16px; font-size:12px; color:rgba(13,27,62,.45); line-height:1.4; }
.lx-link { background:none; border:none; padding:0; color:var(--navy); font-family:inherit; font-size:13px; font-weight:600; cursor:pointer; text-decoration:none; transition:opacity .2s; }
.lx-link:hover { opacity:.72; }
.lx-back { width:100%; background:none; border:none; color:rgba(13,27,62,.48); font-family:inherit; font-size:13px; cursor:pointer; margin-top:12px; text-align:center; transition:color .2s; }
.lx-back:hover { color:var(--navy); }

/* Button */
.lx-btn { width:100%; padding:14px; display:flex; align-items:center; justify-content:center; gap:9px; border:none; border-radius:12px; font-family:inherit; font-size:15px; font-weight:700; cursor:pointer; transition:all .25s; letter-spacing:.1px; }
.lx-gold {
    background:linear-gradient(135deg, var(--navy-md) 0%, var(--navy) 50%, var(--navy-dk) 100%);
    color:#ffffff; box-shadow:0 4px 22px rgba(13,34,88,.28);
}
.lx-gold:hover:not(:disabled) { transform:translateY(-2px); box-shadow:0 10px 32px rgba(13,34,88,.4); filter:brightness(1.12); }
.lx-gold:active:not(:disabled) { transform:translateY(0); }
.lx-gold:disabled { opacity:.5; cursor:not-allowed; }
.lx-blue { background:linear-gradient(135deg,#1e4db4 0%,#0d2d7a 100%); color:#fff; margin-top:20px; box-shadow:0 4px 20px rgba(30,77,180,.32); }
.lx-blue:hover { transform:translateY(-2px); box-shadow:0 10px 28px rgba(30,77,180,.46); }

/* Spinner */
.lx-spin { display:inline-block; width:17px; height:17px; border:2.5px solid rgba(255,255,255,.3); border-top-color:#fff; border-radius:50%; animation:lx-do-spin .6s linear infinite; }
@@keyframes lx-do-spin { to { transform:rotate(360deg); } }

/* Alerts */
.lx-alert { display:flex; align-items:flex-start; gap:10px; padding:11px 13px; border-radius:10px; font-size:13px; line-height:1.5; margin-bottom:16px; }
.a-err  { background:rgba(220,38,38,.07);  border:1px solid rgba(220,38,38,.2);  color:#dc2626; }
.a-ok   { background:rgba(22,163,74,.07);  border:1px solid rgba(22,163,74,.2);  color:#15803d; }
.a-warn { background:rgba(217,119,6,.07);  border:1px solid rgba(217,119,6,.2);  color:#b45309; }

/* ThaiD */
.lx-thaid { text-align:center; padding:4px 0; }
.lx-thaid-ico { width:76px; height:76px; border-radius:50%; background:linear-gradient(145deg,#1c3ea4,#091a60); border:2px solid rgba(26,53,117,.25); display:flex; align-items:center; justify-content:center; font-size:28px; color:#fff; margin:0 auto 16px; box-shadow:0 8px 28px rgba(28,62,164,.32); }
.lx-thaid-t { font-size:16px; font-weight:700; color:#0d1b42; margin-bottom:8px; }
.lx-thaid-d { font-size:13px; color:rgba(13,27,62,.48); line-height:1.6; }
.lx-thaid-n { font-size:11px; color:rgba(13,27,62,.35); margin-top:16px; }

/* Strength bar */
.lx-bar { height:4px; background:rgba(13,27,62,.08); border-radius:2px; overflow:hidden; margin-top:8px; }
.lx-bar-fill { height:100%; border-radius:2px; transition:width .35s,background .35s; }
.lx-bar-lbl  { font-size:11px; font-weight:600; margin-top:4px; }

/* Register link */
.lx-reg { text-align:center; font-size:13px; color:rgba(13,27,62,.45); margin-top:22px; padding-top:20px; border-top:1px solid rgba(13,27,62,.1); }
.lx-reg a { color:var(--navy); font-weight:600; text-decoration:none; margin-left:4px; }
.lx-reg a:hover { opacity:.75; }

/* Panel footer */
.lx-foot { position:absolute; bottom:22px; left:0; right:0; display:flex; align-items:center; justify-content:center; gap:10px; font-size:11px; color:rgba(13,27,62,.32); }
.lx-foot a { color:rgba(26,53,117,.5); text-decoration:none; }
.lx-foot a:hover { color:var(--navy); }
.lx-dot { opacity:.4; }

@@media (max-width: 860px) {
    .lx-root { flex-direction: column; }
    .lx-left { min-height: 52vh; padding: 40px 24px 44px; }
    .lx-hero-name { font-size: 52px; }
    .lx-em-wrap { width: 190px; height: 190px; }
    .lx-r1 { width: 190px; height: 190px; }
    .lx-r2 { width: 155px; height: 155px; }
    .lx-r3 { width: 122px; height: 122px; }
    .lx-r4 { width:  94px; height:  94px; }
    .lx-ticks { width: 190px; height: 190px; }
    .lx-disk  { width:  80px; height:  80px; }
    .lx-halo  { width: 210px; height: 210px; }
    .lx-right { width: 100%; padding: 40px 24px 68px; border-top: 4px solid var(--navy); box-shadow: none; }
}
</style>

<div class="lx-root">

    @* ══ LEFT ══════════════════════════════════════ *@
    <div class="lx-left">
        <div class="lx-grid"></div>

        <div class="lx-ptcl">
            @for (int i = 0; i < 20; i++)
            {
                var l   = (i * 41 + 7) % 100;
                var bot = (i * 17 % 55) + 5;
                var tx  = ((i % 7) - 3) * 22;
                var d   = (4.5 + i % 5).ToString("F1", System.Globalization.CultureInfo.InvariantCulture) + "s";
                var dl  = (i * 0.38).ToString("F2", System.Globalization.CultureInfo.InvariantCulture) + "s";
                <div class="lx-p"
                     style="left:@(l)%;bottom:@(bot)px;--d:@d;--delay:@dl;--tx:@(tx)px"></div>
            }
        </div>

        <div class="lx-em-wrap">
            <div class="lx-halo"></div>
            <div class="lx-ticks">
                @for (int t = 0; t < 36; t++)
                {
                    var deg = t * 10;
                    var h   = t % 3 == 0 ? 9 : 5;
                    var op  = t % 3 == 0 ? ".38" : ".18";
                    <div style="position:absolute;width:1px;height:@(h)px;
                                background:rgba(200,169,110,@op);
                                left:50%;top:0;
                                transform:rotate(@(deg)deg) translateX(-50%);
                                transform-origin:bottom center;margin-top:-1px"></div>
                }
            </div>
            <div class="lx-ring lx-r1"></div>
            <div class="lx-ring lx-r2"></div>
            <div class="lx-ring lx-r3"></div>
            <div class="lx-ring lx-r4"></div>
            <div class="lx-disk">
                <div class="lx-disk-name">ป.ป.ท.</div>
                <div class="lx-disk-sub">PACC</div>
            </div>
        </div>

        <div class="lx-hero">
            <div class="lx-hero-name">E<span>‑</span>CMIS</div>
            <div class="lx-hero-bar">
                <div class="lx-bar-line"></div>
                <div class="lx-bar-gem"></div>
                <div class="lx-bar-line"></div>
            </div>
            <div class="lx-hero-sub">
                ระบบบริหารจัดการคดีและการตรวจสอบ<br />
                สำนักงานคณะกรรมการป้องกันและปราบปรามการทุจริตในภาครัฐ
            </div>
            <div class="lx-stats">
                <div class="lx-stat">
                    <div class="lx-stat-n">12,847</div>
                    <div class="lx-stat-l">คดีในระบบ</div>
                </div>
                <div class="lx-sep"></div>
                <div class="lx-stat">
                    <div class="lx-stat-n">1,230</div>
                    <div class="lx-stat-l">ผู้ใช้งาน</div>
                </div>
                <div class="lx-sep"></div>
                <div class="lx-stat">
                    <div class="lx-stat-n">77</div>
                    <div class="lx-stat-l">จังหวัด</div>
                </div>
            </div>
        </div>

        <div class="lx-certs">
            <div class="lx-cert"><i class="bi bi-shield-lock-fill"></i> ISO 27001</div>
            <div class="lx-cert"><i class="bi bi-patch-check-fill"></i> PDPA Compliant</div>
            <div class="lx-cert"><i class="bi bi-lock-fill"></i> TLS 1.3</div>
        </div>
    </div>

    @* ══ RIGHT ══════════════════════════════════════ *@
    <div class="lx-right">
        <div class="lx-card">

            @if (viewMode == LoginView.ForgotPassword)
            {
                <div class="lx-icon lx-icon-amber"><i class="bi bi-envelope-at-fill"></i></div>
                <div class="lx-title">ลืมรหัสผ่าน</div>
                <div class="lx-sub">กรอกชื่อผู้ใช้และอีเมล — ระบบส่งลิงก์รีเซ็ตให้ทันที</div>

                @if (forgotSuccess)
                {
                    <div class="lx-alert a-ok"><i class="bi bi-check-circle-fill"></i> ส่งลิงก์รีเซ็ตไปยังอีเมลของท่านแล้ว</div>
                    <button class="lx-btn lx-gold" @onclick='() => { viewMode = LoginView.Main; forgotSuccess = false; }'>
                        <i class="bi bi-arrow-left"></i>กลับหน้าเข้าสู่ระบบ
                    </button>
                }
                else
                {
                    <div class="lx-field">
                        <label class="lx-lbl">ชื่อผู้ใช้งาน</label>
                        <div class="lx-iw">
                            <input class="lx-inp" @bind="forgotUsername" placeholder="กรอกชื่อผู้ใช้งาน" />
                            <i class="bi bi-person lx-ico"></i>
                        </div>
                    </div>
                    <div class="lx-field">
                        <label class="lx-lbl">อีเมล</label>
                        <div class="lx-iw">
                            <input class="lx-inp" type="email" @bind="forgotEmail" placeholder="อีเมลที่ลงทะเบียนไว้" />
                            <i class="bi bi-envelope lx-ico"></i>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(forgotErr))
                    {
                        <div class="lx-alert a-err"><i class="bi bi-exclamation-circle-fill"></i> @forgotErr</div>
                    }
                    <button class="lx-btn lx-gold" @onclick="SubmitForgotPassword">
                        <i class="bi bi-send"></i>ส่งลิงก์รีเซ็ตรหัสผ่าน
                    </button>
                    <button class="lx-back" @onclick='() => viewMode = LoginView.Main'>
                        <i class="bi bi-arrow-left me-1"></i>กลับ
                    </button>
                }
            }
            else if (viewMode == LoginView.ForceChangePassword)
            {
                <div class="lx-icon lx-icon-red"><i class="bi bi-key-fill"></i></div>
                <div class="lx-title">ตั้งรหัสผ่านใหม่</div>
                <div class="lx-sub">กรุณาตั้งรหัสผ่านใหม่ก่อนเข้าใช้งานระบบ</div>
                <div class="lx-alert a-warn"><i class="bi bi-exclamation-triangle-fill"></i> ผู้ดูแลระบบกำหนดให้เปลี่ยนรหัสผ่าน</div>

                <div class="lx-field">
                    <label class="lx-lbl">รหัสผ่านใหม่</label>
                    <div class="lx-iw">
                        <input class="lx-inp lx-inp-pr" type="@(showNewPwd ? "text" : "password")"
                               @bind="newPwd" placeholder="อย่างน้อย 8 ตัวอักษร" />
                        <i class="bi bi-lock lx-ico"></i>
                        <button type="button" class="lx-eye" @onclick='() => showNewPwd = !showNewPwd'>
                            <i class="bi @(showNewPwd ? "bi-eye-slash" : "bi-eye")"></i>
                        </button>
                    </div>
                    <div class="lx-bar"><div class="lx-bar-fill" style="width:@GetPwdPct()%;background:@GetPwdColor()"></div></div>
                    @if (!string.IsNullOrEmpty(GetPwdLabel()))
                    {
                        <div class="lx-bar-lbl" style="color:@GetPwdColor()">@GetPwdLabel()</div>
                    }
                </div>
                <div class="lx-field">
                    <label class="lx-lbl">ยืนยันรหัสผ่านใหม่</label>
                    <div class="lx-iw">
                        <input class="lx-inp lx-inp-pr" type="@(showConfirmPwd ? "text" : "password")"
                               @bind="confirmPwd" placeholder="กรอกซ้ำอีกครั้ง" />
                        <i class="bi bi-lock lx-ico"></i>
                        <button type="button" class="lx-eye" @onclick='() => showConfirmPwd = !showConfirmPwd'>
                            <i class="bi @(showConfirmPwd ? "bi-eye-slash" : "bi-eye")"></i>
                        </button>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(changePwdErr))
                {
                    <div class="lx-alert a-err"><i class="bi bi-exclamation-circle-fill"></i> @changePwdErr</div>
                }
                <button class="lx-btn lx-gold" @onclick="SubmitChangePwd">
                    <i class="bi bi-check2"></i>บันทึกรหัสผ่านใหม่
                </button>
            }
            else
            {
                <div class="lx-icon"><i class="bi bi-shield-lock-fill"></i></div>
                <div class="lx-title">เข้าสู่ระบบ</div>
                <div class="lx-sub">ยินดีต้อนรับสู่ E-CMIS สำนักงาน ป.ป.ท.</div>

                <div class="lx-tabs">
                    <button class="lx-tab @(tab == "pw" ? "lx-tab-on" : "")"
                            @onclick='() => { tab = "pw"; loginErr = ""; }'>
                        <i class="bi bi-person-badge me-1"></i>Username
                    </button>
                    <button class="lx-tab @(tab == "td" ? "lx-tab-on" : "")"
                            @onclick='() => { tab = "td"; loginErr = ""; }'>
                        <i class="bi bi-credit-card-2-front me-1"></i>ThaiD
                    </button>
                </div>

                @if (tab == "pw")
                {
                    @if (!string.IsNullOrEmpty(loginErr))
                    {
                        <div class="lx-alert a-err"><i class="bi bi-shield-exclamation me-1"></i>@loginErr</div>
                    }
                    <form autocomplete="@FormAutocomplete" @onsubmit="SubmitLogin" @onsubmit:preventDefault>
                    <div class="lx-field">
                        <label class="lx-lbl" for="lx-light-username">ชื่อผู้ใช้งาน</label>
                        <div class="lx-iw">
                            <input id="lx-light-username" name="username" class="lx-inp" @bind="username" @bind:event="oninput"
                                   placeholder="กรอกชื่อผู้ใช้งาน"
                                   autocomplete="@UsernameAutocomplete" />
                            <i class="bi bi-person lx-ico"></i>
                        </div>
                    </div>
                    <div class="lx-field">
                        <label class="lx-lbl" for="lx-light-password">รหัสผ่าน</label>
                        <div class="lx-iw">
                            <input id="lx-light-password" name="password" class="lx-inp lx-inp-pr" type="@(showPw ? "text" : "password")"
                                   @bind="password" @bind:event="oninput"
                                   placeholder="กรอกรหัสผ่าน" autocomplete="@PasswordAutocomplete" />
                            <i class="bi bi-lock lx-ico"></i>
                            <button type="button" class="lx-eye" @onclick='() => showPw = !showPw'>
                                <i class="bi @(showPw ? "bi-eye-slash" : "bi-eye")"></i>
                            </button>
                        </div>
                    </div>
                    <div class="lx-between">
                        <label class="lx-check">
                            <input type="checkbox" @bind="remember" />
                            <span title="จดจำชื่อผู้ใช้บนเครื่องนี้ และให้เบราว์เซอร์จัดเก็บรหัสผ่าน">จดจำการเข้าสู่ระบบ</span>
                        </label>
                        <button type="button" class="lx-link"
                                @onclick='() => { viewMode = LoginView.ForgotPassword; loginErr = ""; }'>
                            ลืมรหัสผ่าน?
                        </button>
                    </div>
                    <p class="lx-session-note">หลังเข้าสู่ระบบ การใช้งานจะหมดอายุภายใน 8 ชั่วโมง</p>
                    <button type="submit" class="lx-btn lx-gold" disabled="@busy">
                        @if (busy)
                        {
                            <span class="lx-spin"></span><span>กำลังตรวจสอบ...</span>
                        }
                        else
                        {
                            <i class="bi bi-box-arrow-in-right"></i><span>เข้าสู่ระบบ</span>
                        }
                    </button>
                    </form>
                }
                else
                {
                    <div class="lx-thaid">
                        <div class="lx-thaid-ico"><i class="bi bi-credit-card-2-front-fill"></i></div>
                        <div class="lx-thaid-t">ยืนยันตัวตนด้วย ThaiD</div>
                        <div class="lx-thaid-d">
                            รองรับบัตรประชาชนอิเล็กทรอนิกส์<br />และแอปพลิเคชัน ThaID
                        </div>
                        <button class="lx-btn lx-blue" @onclick="LoginThaiD">
                            <i class="bi bi-credit-card-fill"></i>เชื่อมต่อ ThaiD
                        </button>
                        <div class="lx-thaid-n">
                            <i class="bi bi-info-circle me-1"></i>
                            ต้องติดตั้งแอป ThaID และผูกบัตรประชาชนก่อนใช้งาน
                        </div>
                    </div>
                }

                <div class="lx-reg">
                    ยังไม่มีบัญชี?
                    <a href="/register">ลงทะเบียนผู้ใช้งานใหม่</a>
                </div>
            }

        </div>

        <div class="lx-foot">
            <span>E-CMIS v1.0</span>
            <span class="lx-dot">·</span>
            <span>สำนักงาน ป.ป.ท.</span>
            <span class="lx-dot">·</span>
            <a href="mailto:itsupport@pacc.go.th">itsupport@pacc.go.th</a>
        </div>
    </div>

</div>

@code {
    private enum LoginView { Main, ForgotPassword, ForceChangePassword }
    private LoginView viewMode = LoginView.Main;
    private string tab = "pw";
    private string username = "";
    private string password = "";
    private bool showPw, remember, busy;

    private string FormAutocomplete => remember ? "on" : "off";
    private string UsernameAutocomplete => remember ? "username" : "off";
    private string PasswordAutocomplete => remember ? "current-password" : "off";
    private string loginErr = "";
    private string forgotUsername = "", forgotEmail = "", forgotErr = "";
    private bool forgotSuccess;
    private string newPwd = "", confirmPwd = "";
    private bool showNewPwd, showConfirmPwd;
    private string changePwdErr = "";
    public void Dispose() { }

    private async Task SubmitLogin()
    {
        busy = true;
        await Task.Delay(700);
        Nav.NavigateTo("/dashboard");
    }

    private void SubmitForgotPassword()
    {
        forgotErr = "";
        if (string.IsNullOrWhiteSpace(forgotUsername) || string.IsNullOrWhiteSpace(forgotEmail))
        { forgotErr = "กรุณากรอกชื่อผู้ใช้งานและอีเมล"; return; }
        forgotSuccess = true;
    }

    private void SubmitChangePwd()
    {
        changePwdErr = "";
        if (string.IsNullOrWhiteSpace(newPwd) || newPwd.Length < 8)
        { changePwdErr = "รหัสผ่านต้องมีความยาวอย่างน้อย 8 ตัวอักษร"; return; }
        if (newPwd != confirmPwd)
        { changePwdErr = "รหัสผ่านใหม่และการยืนยันไม่ตรงกัน"; return; }
        Nav.NavigateTo("/dashboard");
    }

    private void LoginThaiD() => Nav.NavigateTo("/dashboard");

    private int GetPwdPct()
    {
        if (string.IsNullOrEmpty(newPwd)) return 0;
        int s = 0;
        if (newPwd.Length >= 8)  s += 25;
        if (newPwd.Length >= 12) s += 15;
        if (newPwd.Any(char.IsUpper)) s += 20;
        if (newPwd.Any(char.IsDigit)) s += 20;
        if (newPwd.Any(c => !char.IsLetterOrDigit(c))) s += 20;
        return Math.Min(s, 100);
    }
    private string GetPwdColor() { var p = GetPwdPct(); return p < 40 ? "#ef4444" : p < 70 ? "#f59e0b" : "#22c55e"; }
    private string GetPwdLabel() { var p = GetPwdPct(); return p == 0 ? "" : p < 40 ? "รหัสผ่านอ่อนแอ" : p < 70 ? "รหัสผ่านปานกลาง" : "รหัสผ่านแข็งแกร่ง"; }
}
