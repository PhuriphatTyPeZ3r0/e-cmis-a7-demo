@page "/public"

<div class="ar-shell">

    @* ══ HEADER ══ *@
    <div class="ar-header">
        <div class="ar-header-inner">
            <div class="ar-bc">
                <i class="bi bi-house-fill"></i>
                <i class="bi bi-chevron-right"></i>
                <a href="/complaints">เรื่องร้องทุกข์</a>
                <i class="bi bi-chevron-right"></i>
                <span>รับอัตโนมัติ</span>
            </div>
            <div class="ar-title-row">
                <div>
                    <div class="ar-title">
                        <i class="bi bi-cloud-arrow-down-fill ar-title-ico"></i>
                        รับเรื่องใหม่จากระบบอัตโนมัติ
                        <span class="ar-count-badge">2</span>
                    </div>
                    <div class="ar-title-sub">เรื่องที่ส่งเข้าจากช่องทางอัตโนมัติ รอการพิจารณารับดำเนินการ</div>
                </div>
            </div>
        </div>
    </div>

    @* ══ BODY ══ *@
    <div class="ar-body">
        <div class="ar-card">
            <div class="ar-card-head">
                <div class="ar-ico ar-ico-teal"><i class="bi bi-inbox-fill"></i></div>
                คิวรอพิจารณา
                <span class="ar-card-sub">เรียงตามเวลาเข้า</span>
            </div>
            <div style="overflow-x:auto">
                <table class="ar-tbl">
                    <thead>
                        <tr>
                            <th>เลขคิว</th>
                            <th>แหล่งที่มา</th>
                            <th>หัวข้อร้องเรียน</th>
                            <th>เวลาเข้า</th>
                            <th>พิจารณา</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><span class="ar-queue-no">AUTO-2026-001</span></td>
                            <td><span class="ar-chip-source"><i class="bi bi-globe2"></i>&nbsp;เว็บไซต์สำนักงาน</span></td>
                            <td><div class="ar-subject">ร้องเรียนโครงการจัดซื้อครุภัณฑ์เกินราคา</div></td>
                            <td><span class="ar-time"><i class="bi bi-clock"></i> 08:05</span></td>
                            <td>
                                <button class="ar-review-btn" @onclick="() => showReview = true">
                                    <i class="bi bi-eye"></i> พิจารณา
                                </button>
                            </td>
                        </tr>
                        <tr>
                            <td><span class="ar-queue-no">AUTO-2026-002</span></td>
                            <td><span class="ar-chip-source"><i class="bi bi-phone"></i>&nbsp;ภาษีไปไหน</span></td>
                            <td><div class="ar-subject">ร้องเรียนการเรียกรับผลประโยชน์</div></td>
                            <td><span class="ar-time"><i class="bi bi-clock"></i> 08:21</span></td>
                            <td>
                                <button class="ar-review-btn" @onclick="() => showReview = true">
                                    <i class="bi bi-eye"></i> พิจารณา
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>@* /ar-shell *@

@if (showReview)
{
    <div class="modal-backdrop-custom open" @onclick="() => showReview = false">
        <div class="modal-box" style="width:440px" @onclick:stopPropagation="true">
            <div style="font-size:17px;font-weight:800;color:#fff;margin-bottom:4px">
                <i class="bi bi-eye me-2" style="color:#818cf8"></i>พิจารณารับเรื่อง
            </div>
            <div style="font-size:12px;color:rgba(255,255,255,.45);margin-bottom:18px">เลือกผลการพิจารณาและกรอกหมายเหตุ</div>
            <div class="mb-3" style="display:flex;gap:18px">
                <label style="display:flex;align-items:center;gap:7px;font-size:13px;color:rgba(255,255,255,.82);cursor:pointer">
                    <input type="radio" name="ar-decision" checked style="accent-color:#6366f1" /> รับดำเนินการ
                </label>
                <label style="display:flex;align-items:center;gap:7px;font-size:13px;color:rgba(255,255,255,.82);cursor:pointer">
                    <input type="radio" name="ar-decision" style="accent-color:#6366f1" /> ไม่รับดำเนินการ
                </label>
            </div>
            <div class="mb-3">
                <label class="form-label-custom">หมายเหตุ <span style="color:#f87171">*</span></label>
                <input class="form-control-custom" placeholder="ระบุเหตุผลหรือหมายเหตุประกอบ" />
            </div>
            <div class="text-end mt-3">
                <button class="btn-outline-navy me-2" @onclick="() => showReview = false">ยกเลิก</button>
                <button class="btn-navy">ยืนยัน</button>
            </div>
        </div>
    </div>
}

@code {
    private bool showReview;
}
