    private static bool IsReasonValid(string? reason) =>
        !string.IsNullOrWhiteSpace(reason) && reason.Trim().Length >= 3;

    private static string ChangeTypeLabel(string type) => ChangeRequestDisplay.TypeLabel(type);

    private static string ChangeTargetName(MyChangeRequestDto c) =>
        ChangeRequestDisplay.TargetLabel(c.RequestType, c.TargetOrgName, c.TargetPositionName, c.TargetRoleName);

}
