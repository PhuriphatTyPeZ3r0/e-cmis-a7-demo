<div class="table-card an-flex-card panel-glow wr-map-hero-card @CardClass">
    <div class="tc-head @HeadClass">
        <div class="tc-row1">
            <div class="tc-title"><i class="bi @MapIcon" style="color:@AccentColor"></i> @Title</div>
            @if (HeadMeta is not null)
            {
                <div class="tc-meta">@HeadMeta</div>
            }
        </div>
    </div>
    <div class="an-scroll an-map-scroll">
        <div class="wr-map-layout">
            <div class="wr-thai-map wr-thai-map-3d" role="img" aria-label="แผนที่ความเสี่ยงประเทศไทย">
                <canvas id="@CanvasId" class="wr-thailand-canvas"></canvas>
                <div class="wr-map-legend">
                    <span><i class="risk-low"></i>ความเสี่ยงต่ำ</span>
                    <span><i class="risk-mid"></i>ความเสี่ยงปานกลาง</span>
                    <span><i class="risk-high"></i>ความเสี่ยงสูง</span>
                    <span><i class="risk-critical"></i>ความเสี่ยงสูงมาก</span>
                </div>
                @if (MapOverlay is not null)
                {
                    @MapOverlay
                }
            </div>
            <div class="wr-map-side">
                @SideContent
            </div>
        </div>
    </div>
    @if (Footer is not null)
    {
        @Footer
    }
</div>

@code {
    [Parameter] public string CanvasId { get; set; } = "thailandRiskMap";
    [Parameter] public string Title { get; set; } = "แผนที่ความเสี่ยงทั่วประเทศ";
    [Parameter] public string MapIcon { get; set; } = "bi-map-fill";
    [Parameter] public string AccentColor { get; set; } = "#10b981";
    [Parameter] public string? CardClass { get; set; }
    [Parameter] public string? HeadClass { get; set; }
    [Parameter] public RenderFragment? HeadMeta { get; set; }
    [Parameter] public RenderFragment? MapOverlay { get; set; }
    [Parameter] public RenderFragment SideContent { get; set; } = _ => { };
    [Parameter] public RenderFragment? Footer { get; set; }
}
