@page "/analytics/complaint-register"
@layout MainLayout
@implements IDisposable
@using EcmisWeb.Data
@inject IJSRuntime JS

<div class="cs-shell">

    <div class="cs-header">
        <div class="cs-header-inner">
            <div class="cs-bc">
                <i class="bi bi-house-fill"></i>
                <a href="/">หน้าหลัก</a>
                <i class="bi bi-chevron-right"></i>
                <span>วิเคราะห์และรายงานผล</span>
                <i class="bi bi-chevron-right"></i>
                <span>ทะเบียนควบคุม</span>
            </div>
            <div class="cs-ph-row">
                <div>
                    <div class="cs-title">ทะเบียนควบคุมเรื่องร้องเรียน</div>
                    <div class="cs-sub">TOR 12.5 · ทะเบียนควบคุมและติดตามสถานะ SLA เรื่องร้องเรียนของสำนักงาน ป.ป.ท.</div>
                </div>
                <div class="cs-actions">
                    <button type="button" class="btn-ghost-d" @onclick="PrintReportAsync">
                        <i class="bi bi-printer"></i>
                        พิมพ์ PDF
                    </button>
                    <button type="button" class="btn-accent" @onclick="ExportCsvAsync">
                        <i class="bi bi-file-earmark-spreadsheet"></i>
                        Export Excel
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="cs-body">

        @* ── KPI Stats ── *@
        <div class="cs-stats-row">
            <div class="sc sc-blue">
                <div class="sc-head">ยอดรวมทะเบียน</div>
                <div class="sc-body-area">
                    <div class="sc-num">@_filtered.Count.ToString("N0")</div>
                    <div class="sc-bottom">
                        <span class="sc-hint">ช่วงที่เลือก</span>
                    </div>
                </div>
            </div>
            <div class="sc sc-green">
                <div class="sc-head">เสร็จสิ้นในกำหนด%</div>
                <div class="sc-body-area">
                    <div class="sc-num">@SlaCompliancePct()</div>
                    <div class="sc-bottom">
                        <span class="sc-badge sc-badge-up">@SlaCompliantCount() เรื่อง</span>
                        <span class="sc-hint">ของที่ปิดแล้ว</span>
                    </div>
                </div>
            </div>
            <div class="sc sc-red">
                <div class="sc-head">เรื่องค้างเกิน 30 วัน</div>
                <div class="sc-body-area">
                    <div class="sc-num">@OverdueCount().ToString("N0")</div>
                    <div class="sc-bottom">
                        <span class="sc-badge sc-badge-down">เกิน SLA</span>
                        <span class="sc-hint">ยังไม่ปิด</span>
                    </div>
                </div>
            </div>
            <div class="sc sc-orange">
                <div class="sc-head">รับใหม่เดือนนี้</div>
                <div class="sc-body-area">
                    <div class="sc-num">@NewThisMonthCount().ToString("N0")</div>
                    <div class="sc-bottom">
                        <span class="sc-badge sc-badge-flat">เดือน @DateTime.Now.ToString("MMM", new System.Globalization.CultureInfo("th-TH"))</span>
                        <span class="sc-hint">เรื่องใหม่</span>
                    </div>
                </div>
            </div>
        </div>

        @* ── Filter + Charts card ── *@
        <section class="table-card">
            <div class="tc-head">
                <div class="tc-row1">
                    <div>
                        <div class="tc-title">กรองข้อมูลทะเบียน</div>
                        <div class="tc-sub">กรองช่วงวันที่ ประเภทเรื่อง ช่องทางรับ หรือสถานะ แล้วกด แสดงผล</div>
                    </div>
                    <div class="tc-meta">
                        <span class="bdg-nv">ทั้งหมด @_all.Count</span>
                        <span class="bdg-gd">แสดง @_filtered.Count</span>
                    </div>
                </div>
            </div>

            @* ── FR-039: Filter ── *@
            <div class="filter-row">
                <div class="fgrp">
                    <label class="flbl" for="crFiscalYear">ปีงบประมาณ</label>
                    <select id="crFiscalYear" class="fsel" @bind="_fiscalYear">
                        <option value="">ทั้งหมด</option>
                        @foreach (var fy in _fiscalYears)
                        {
                            <option value="@fy">@fy</option>
                        }
                    </select>
                </div>
                <div class="fgrp">
                    <label class="flbl" for="crZone">หน่วยงาน</label>
                    <select id="crZone" class="fsel" @bind="_zone">
                        <option value="">ทั้งหมด</option>
                        @foreach (var z in _zones)
                        {
                            <option value="@z">@z</option>
                        }
                    </select>
                </div>
                <div class="fgrp">
                    <label class="flbl" for="crStatus">สถานะ</label>
                    <select id="crStatus" class="fsel" @bind="_status">
                        <option value="">สถานะทั้งหมด</option>
                        <option value="pending">รอดำเนินการ</option>
                        <option value="active">กำลังดำเนินการ</option>
                        <option value="closed">แล้วเสร็จ</option>
                        <option value="transfer">ยุติ/ส่งคืน</option>
                    </select>
                </div>
                <div class="fgrp">
                    <label class="flbl" for="crCategory">ประเภทเรื่อง</label>
                    <select id="crCategory" class="fsel" @bind="_category">
                        <option value="">ทั้งหมด</option>
                        @foreach (var cat in _categories)
                        {
                            <option value="@cat">@ComplaintData.CategoryLabel(cat)</option>
                        }
                    </select>
                </div>
                <div class="fgrp">
                    <label class="flbl" for="crFrom">จาก</label>
                    <input id="crFrom" type="date" class="finp"
                           value="@_fromDate" @onchange="@(e => _fromDate = e.Value?.ToString() ?? "")" />
                </div>
                <div class="fgrp">
                    <label class="flbl" for="crTo">ถึง</label>
                    <input id="crTo" type="date" class="finp"
                           value="@_toDate" @onchange="@(e => _toDate = e.Value?.ToString() ?? "")" />
                </div>
                <button type="button" class="btn-accent btn-sm-f" @onclick="OnApplyFilter">
                    <i class="bi bi-search"></i> แสดงผล
                </button>
                <button type="button" class="fbtn" @onclick="OnResetFilter">
                    <i class="bi bi-x-lg"></i> ล้างค่า
                </button>
            </div>

            @if (_noData)
            {
                <div class="empty-state">
                    <i class="bi bi-inbox"></i>
                    <span>ไม่พบข้อมูลตามเงื่อนไขที่เลือก กรุณาเปลี่ยนตัวกรอง</span>
                </div>
            }
            else
            {
                <div class="cs-charts-wrap layout-fill">
                    <div class="cs-charts-top">
                        <div class="cs-chart-card">
                            <div class="cs-chart-title"><i class="bi bi-graph-up"></i> แนวโน้มรับ/ปิด ต่อเดือน (12 เดือน)</div>
                            <div class="cs-chart-canvas"><canvas id="crChartTrend"></canvas></div>
                        </div>
                        <div class="cs-chart-card">
                            <div class="cs-chart-title"><i class="bi bi-bar-chart-fill"></i> จำนวนตามประเภทเรื่อง</div>
                            <div class="cs-chart-canvas"><canvas id="crChartCategory"></canvas></div>
                        </div>
                        <div class="cs-chart-card">
                            <div class="cs-chart-title"><i class="bi bi-broadcast"></i> ช่องทางรับเรื่อง</div>
                            <div class="cs-chart-canvas"><canvas id="crChartChannel"></canvas></div>
                        </div>
                    </div>

                    <div class="cs-charts-bot">
                        @* FR-036: quarterly chart *@
                        <div class="cs-chart-card">
                            <div class="cs-chart-title"><i class="bi bi-calendar3-range"></i> รับเรื่องรายไตรมาส</div>
                            <div class="cs-chart-canvas"><canvas id="crChartQuarterly"></canvas></div>
                        </div>
                        @* FR-037: multi-year comparison *@
                        <div class="cs-chart-card">
                            <div class="cs-chart-title"><i class="bi bi-graph-up-arrow"></i> เปรียบเทียบข้ามปีงบประมาณ</div>
                            <div class="cs-chart-canvas"><canvas id="crChartYearCompare"></canvas></div>
                        </div>
                        <div class="cs-chart-card has-table">
                            <div class="cs-chart-title"><i class="bi bi-circle-half"></i> สัดส่วนสถานะเรื่อง</div>
                            <div class="cs-chart-canvas cs-chart-canvas-sm"><canvas id="crChartStatus"></canvas></div>
                            <table class="cs-status-table">
                                <thead>
                                    <tr><th>สถานะ</th><th>จำนวน</th><th>สัดส่วน</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var (label, count, color) in StatusSummaryRows())
                                    {
                                        <tr>
                                            <td><span style="color:@color;font-weight:700">@label</span></td>
                                            <td>@count.ToString("N0")</td>
                                            <td>@StatusPct(count)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                @* ── FR-035: เรื่องค้างแยกตามหน่วยงาน ── *@
                <div class="tc-head" style="margin-top:1.5rem">
                    <div class="tc-row1">
                        <div>
                            <div class="tc-title"><i class="bi bi-exclamation-triangle-fill" style="color:#f59e0b"></i> เรื่องค้างดำเนินการเกิน 30 วัน แยกตามหน่วยงาน</div>
                            <div class="tc-sub" style="font-size:11px;color:#94a3b8">เฉพาะสถานะที่ยังไม่ปิด และรับมาเกิน 30 วันแล้ว</div>
                        </div>
                    </div>
                </div>
                @if (!OverdueByZoneRows().Any())
                {
                    <div class="empty-state" style="margin-bottom:1rem">
                        <i class="bi bi-check-circle-fill" style="color:#06d6a0"></i>
                        <span>ไม่มีเรื่องค้างเกิน 30 วัน</span>
                    </div>
                }
                else
                {
                    <table class="cs-status-table" style="margin-bottom:1.5rem">
                        <thead>
                            <tr><th>หน่วยงาน</th><th>ค้างทั้งหมด</th><th>รอดำเนินการ</th><th>กำลังดำเนินการ</th><th>เกินนานสุด (วัน)</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var row in OverdueByZoneRows())
                            {
                                <tr>
                                    <td style="font-weight:700">@row.Zone</td>
                                    <td><span class="sla-chip sla-danger">@row.Total เรื่อง</span></td>
                                    <td>@row.Pending</td>
                                    <td>@row.Active</td>
                                    <td style="color:#f87171;font-weight:700">@row.MaxDays วัน</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

                @* ── FR-038: Completion Rate แยก Zone ── *@
                <div class="tc-head" style="margin-top:0.5rem">
                    <div class="tc-row1">
                        <div class="tc-title"><i class="bi bi-bar-chart-steps"></i> อัตราดำเนินการแล้วเสร็จ (Completion Rate) แยกหน่วยงาน</div>
                    </div>
                </div>
                <table class="cs-status-table" style="margin-bottom:1.5rem">
                    <thead>
                        <tr><th>หน่วยงาน</th><th>รับทั้งหมด</th><th>แล้วเสร็จ</th><th>Completion Rate</th><th>SLA ในกำหนด</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var row in CompletionRateByZone())
                        {
                            var pct = row.Total == 0 ? 0 : (int)Math.Round((double)row.Closed * 100 / row.Total);
                            var slaRate = row.Closed == 0 ? "N/A" : $"{(int)Math.Round((double)row.SlaCompliant * 100 / row.Closed)}%";
                            <tr>
                                <td style="font-weight:700">@row.Zone</td>
                                <td>@row.Total</td>
                                <td>@row.Closed</td>
                                <td>
                                    <div style="display:flex;align-items:center;gap:8px">
                                        <div style="flex:1;background:#e2e8f0;border-radius:4px;height:8px;overflow:hidden">
                                            <div style="width:@pct%;background:@(pct>=70?"#06d6a0":pct>=40?"#fbbf24":"#f87171");height:100%;border-radius:4px"></div>
                                        </div>
                                        <span style="font-weight:700;min-width:36px">@pct%</span>
                                    </div>
                                </td>
                                <td>@slaRate</td>
                            </tr>
                        }
                    </tbody>
                </table>

                @* ── Data Table ── *@
                <table class="cs-status-table" id="exportTable">
                    <thead>
                        <tr>
                            <th>เลขทะเบียน</th>
                            <th>วันรับ</th>
                            <th>ประเภท</th>
                            <th>ช่องทาง</th>
                            <th>สถานะ</th>
                            <th>SLA</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in _filtered.Take(100))
                        {
                            var sla = GetSlaStatus(r);
                            <tr>
                                <td>@r.CaseNo</td>
                                <td>@r.ReceivedAt</td>
                                <td>@ComplaintData.CategoryLabel(r.Category)</td>
                                <td>@r.Channel</td>
                                <td>@ComplaintData.StatusLabel(r.Status)</td>
                                <td>
                                    @if (sla == "ในกำหนด")
                                    {
                                        <span style="color:#06d6a0;font-weight:700">ในกำหนด</span>
                                    }
                                    else
                                    {
                                        <span style="color:#f87171;font-weight:700">เกินกำหนด</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @* ── Export footer ── *@
                <div class="cs-footer">
                    <span class="cs-footer-info">
                        แสดงผล <strong>@Math.Min(_filtered.Count, 100).ToString("N0") เรื่อง</strong>
                        @if (!string.IsNullOrEmpty(_fromDate) || !string.IsNullOrEmpty(_toDate))
                        {
                            <span> · @_fromDate – @_toDate</span>
                        }
                        @if (!string.IsNullOrEmpty(_category)) { <span> · @ComplaintData.CategoryLabel(_category)</span> }
                        @if (!string.IsNullOrEmpty(_channel)) { <span> · @_channel</span> }
                        @if (!string.IsNullOrEmpty(_status)) { <span> · @ComplaintData.StatusLabel(_status)</span> }
                    </span>
                    <div class="cs-footer-btns">
                        <button type="button" class="btn-ghost-d" @onclick="PrintReportAsync">
                            <i class="bi bi-printer"></i> พิมพ์ PDF
                        </button>
                        <button type="button" class="btn-accent" @onclick="ExportCsvAsync">
                            <i class="bi bi-file-earmark-spreadsheet"></i> Export Excel
                        </button>
                    </div>
                </div>
            }
        </section>
    </div>
</div>

