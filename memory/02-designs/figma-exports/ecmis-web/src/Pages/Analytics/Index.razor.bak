    private void OnMapTypeChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? "ภาพรวม";
        _ = SwitchTab(val);
    }

    public void Dispose()
    {
        _dotNetRef?.Dispose();
        try
        {
            _ = JS.InvokeVoidAsync("stopWarRoomClock");
        }
        catch { }
    }

    private async Task RenderChartsAsync()
    {
        if (SelectedVersion == 1)
        {
            if (ActiveTab == "ร้องเรียน")
            {
                // 2. ร้องเรียน ทำข้อมูลรายชั่วโมง (Hourly Complaint Chart)
                // แสดง 24 แท่งชั่วโมง โดยเน้นช่วงพีค 09:00 - 11:00 น.
                await JS.InvokeVoidAsync("initTrendChart", "chartMonthly", 
                    new[] { "00:00", "02:00", "04:00", "06:00", "08:00", "09:00", "10:00", "11:00", "12:00", "14:00", "16:00", "18:00", "20:00", "22:00" }, 
                    new object[] { 2, 1, 3, 8, 22, 35, 58, 42, 18, 29, 31, 15, 9, 4 },
                    new object[] { 1, 1, 2, 5, 14, 21, 38, 28, 12, 18, 20, 10, 6, 2 }, _isDark);
            }
            else
            {
                // 1. กราฟจำนวนเรื่องร้องเรียนปกติ (Line Chart)
                await JS.InvokeVoidAsync("initTrendChart", "chartMonthly", 
                    new[] { "17 พ.ค.", "18 พ.ค.", "19 พ.ค.", "20 พ.ค.", "21 พ.ค.", "22 พ.ค.", "23 พ.ค." }, 
                    new object[] { 220, 480, 180, 690, 310, 890, 620 },
                    new object[] { 180, 320, 150, 450, 240, 600, 520 }, _isDark);
            }

            // 2. กราฟความเสียหาย (Bar Chart)
            await JS.InvokeVoidAsync("initAnalyticsChart", "chartInvestigation", "bar",
                new[] { "17 พ.ค.", "18 พ.ค.", "19 พ.ค.", "20 พ.ค.", "21 พ.ค.", "22 พ.ค.", "23 พ.ค." },
                new object[] { 1100, 1800, 800, 2200, 1500, 2900, KpiDamageCount },
                new[] { "#3b82f6" }, _isDark);

            // 3. กราฟวงกลมประเภทความเสี่ยง (Doughnut Chart)
            await JS.InvokeVoidAsync("initAnalyticsChart", "chartRisk", "doughnut",
                new[] { "จัดซื้อจัดจ้าง", "ใบอนุญาต", "งบประมาณ", "บุคลากร", "อื่นๆ" },
                new object[] { 48, 25, 15, 7, 5 },
                new[] { "#dc2626", "#ea580c", "#d97706", "#65a30d", "#2563eb" }, _isDark);

            await JS.InvokeVoidAsync("initThailandRiskMap3D", "thailandRiskMap");
        }
        else if (SelectedVersion == 2)
        {
            // V2: Dual-Axis Trend + Budget Gauge
            await JS.InvokeVoidAsync("initTrendChart", "chartTrendV2",
                new[] { "ม.ค.", "ก.พ.", "มี.ค.", "เม.ย.", "พ.ค.", "มิ.ย.", "ก.ค." },
                new object[] { 4500, 5200, 6100, 5800, 6900, 7800, 8745 },
                new object[] { 3800, 4200, 4800, 5100, 5500, 6200, 6900 }, _isDark);

            await JS.InvokeVoidAsync("initGaugeChart", "chartBudgetGaugeV2",
                BudgetAtRisk, BudgetSaved, _isDark);
        }
        else if (SelectedVersion == 3)
        {
            // V3: Giant 3D Thailand Map, Regional Doughnut Chart
            await JS.InvokeVoidAsync("initThailandRiskMap3D", "thailandRiskMapV3");

            await JS.InvokeVoidAsync("initAnalyticsChart", "chartRiskV3", "doughnut",
                new[] { "จัดซื้อจัดจ้าง", "ใบอนุญาต", "งบประมาณ", "บุคลากร", "อื่นๆ" },
                new object[] { 48, 25, 15, 7, 5 },
                new[] { "#dc2626", "#ea580c", "#d97706", "#65a30d", "#2563eb" }, _isDark);
        }
        else if (SelectedVersion == 4)
        {
            // V4: Full-width Time series line chart, SLA compass gauge
            await JS.InvokeVoidAsync("initTrendChart", "chartTrendV4", 
                new[] { "00:00", "02:00", "04:00", "06:00", "08:00", "10:00", "12:00", "14:00", "16:00", "18:00", "20:00", "22:00" }, 
                new object[] { 12, 8, 5, 20, 110, 245, 150, 185, 210, 95, 60, 30 },
                new object[] { 8, 4, 3, 15, 80, 195, 130, 160, 175, 70, 45, 20 }, _isDark);

            await JS.InvokeVoidAsync("initAnalyticsChart", "chartComparisonV4", "doughnut",
                new[] { "สำเร็จ", "เป้าหมายที่เหลือ" },
                new object[] { 88, 12 },
                new[] { "#10b981", "rgba(128,128,128,0.15)" }, _isDark);
        }
        else if (SelectedVersion == 5)
        {
            // V5: SLA response time doughnut chart
            await JS.InvokeVoidAsync("initAnalyticsChart", "chartSlaV5", "doughnut",
                new[] { "ในเกณฑ์ SLA", "เกินกำหนด" },
                new object[] { 88, 12 },
                new[] { "#10b981", "#ef4444" }, _isDark);
        }
    }

    private async Task RenderSparklineAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("eval", @"
                (function() {
                    const canvas = document.getElementById('userSparkline');
                    if (!canvas) return;
                    const ctx = canvas.getContext('2d');
                    const data = [20, 25, 30, 28, 35, 45, 40, 52, 48, 62, 58, 70, 65, 80, 75, 88, 82, 95, 90, 110, 105, 128];
                    ctx.clearRect(0, 0, canvas.width, canvas.height);
                    ctx.beginPath();
                    ctx.strokeStyle = '#38bdf8';
                    ctx.lineWidth = 1.5;
                    const step = canvas.width / (data.length - 1);
                    const max = Math.max(...data);
                    const min = Math.min(...data);
                    const range = max - min;
                    for (let i = 0; i < data.length; i++) {
                        const x = i * step;
                        const y = canvas.height - 2 - ((data[i] - min) / range) * (canvas.height - 4);
                        if (i === 0) ctx.moveTo(x, y);
                        else ctx.lineTo(x, y);
                    }
                    ctx.stroke();
                })()
            ");
        }
        catch { }
    }

    private static string ScoreClass(int score) => score >= 85 ? "risk-red" : score >= 75 ? "risk-orange" : "risk-yellow";
    private static string ScoreTextClass(int score) => score >= 85 ? "c-red" : score >= 75 ? "c-orange" : score >= 65 ? "c-amber" : "c-green";
    
    private static string RiskLabel(int score) =>
        score >= 85 ? "สูงมาก" :
        score >= 75 ? "สูง" :
        score >= 60 ? "ปานกลาง" : "ต่ำ";

    private string TranslateCategory(string catCode)
    {
        if (catCode.Contains("18/4")) return "จัดซื้อจัดจ้าง";
        if (catCode.Contains("58/2")) return "ใบอนุญาต";
        return "ร้องเรียน";
    }

    private sealed record RiskRow(int Rank, string Title, string Owner, string Budget, int Score, string Category);
    private sealed record RegionScore(string Name, int Score);
    private sealed record ProvinceScore(int Index, string Name, int Score);
    private sealed record AlertRow(string Time, string Level, string Type, string Title, string Detail, int Score);
    private sealed record ActionRow(int Rank, string Title, string Owner, string Status, string Level, string Due, string Deadline, string Category);
}
