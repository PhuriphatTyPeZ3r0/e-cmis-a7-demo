    private static string SparklineSvg(int[] data, string color, int width = 80, int height = 24)
    {
        if (data.Length < 2) return "";
        var max = data.Max();
        var min = data.Min();
        var range = max - min;
        if (range == 0) range = 1;
        var points = new System.Text.StringBuilder();
        for (int i = 0; i < data.Length; i++)
        {
            var x = (i * width) / (data.Length - 1);
            var y = height - ((data[i] - min) * height / range);
            if (i > 0) points.Append(' ');
            points.Append($"{x},{y}");
        }
        return $"<svg width='{width}' height='{height}' style='overflow:visible'><polyline points='{points}' fill='none' stroke='{color}' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/></svg>";
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var theme = await JS.InvokeAsync<string?>("localStorage.getItem", "dashTheme");
            _isDark = theme != "light";
        }
        catch { }

        _rows = await ComplaintApi.GetComplaintsAsync();
        _total = _rows.Count;
        _loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("registerAnalyticsComponent", _dotNetRef);
            await JS.InvokeVoidAsync("startWarRoomClock");
            await RenderSparklineAsync();
        }

        if (!_loading && !_chartsInitialized)
        {
            _chartsInitialized = true;
            await RenderChartsAsync();
        }

        // Render hourly chart when province modal is open
        if (_showProvinceModal)
        {
            var hourLabels = Enumerable.Range(0, 24).Select(h => $"{h:00}.00").ToArray();
            var hourData = _provinceHourlyData.Cast<object>().ToArray();
            await JS.InvokeVoidAsync("initAnalyticsChart", "chartProvinceHourly", "bar",
                hourLabels, hourData,
                new[] { "#60a5fa", "#38bdf8", "#0ea5e9", "#0284c7" }, _isDark);
        }
    }

    [JSInvokable]
    public async Task OnThemeChangedAsync(bool isDark)
    {
        _isDark = isDark;
        await RenderChartsAsync();
        await InvokeAsync(StateHasChanged);
    }

    // Switch active tabs (ภาพรวม, จัดซื้อจัดจ้าง, etc.)
    private async Task SwitchTab(string tabName)
    {
        ActiveTab = tabName;
        // Re-render charts with appropriate data
        await RenderChartsAsync();
        await InvokeAsync(StateHasChanged);
    }

    // Switch version between V1 - V5
    private async Task SwitchVersion(int verNo)
    {
        SelectedVersion = verNo;
        _chartsInitialized = false;
        
        await Task.Delay(150); // Give time for canvas elements of the new version to mount in Blazor DOM
        await RenderChartsAsync();
        await InvokeAsync(StateHasChanged);
    }

    // Interactive Province Click — callable from both Blazor @onclick and JS canvas click
    [JSInvokable]
    public async Task ClickProvince(string provinceName)
    {
        _selectedProvinceName = provinceName;
        var stats = _byProvince.FirstOrDefault(p => p.Name == provinceName)
                    ?? new ProvinceScore(99, provinceName, 74);

        _selectedProvinceScore = stats.Score;
        _selectedProvinceCount = stats.Name switch
        {
            "ชลบุรี"        => 34,
            "นครราชสีมา"   => 28,
            "กรุงเทพมหานคร" => 54,
            "ขอนแก่น"       => 22,
            "สงขลา"         => 19,
            _               => 18
        };

        _selectedProvinceCases = stats.Name switch
        {
            "ชลบุรี"        => ["ทุจริตประมูลจัดซื้อระบบไฟฟ้าแสงสว่าง", "เรียกรับสินบนอนุมัติการประเมินสิทธิ์ที่ดิน", "เจ้าหน้าที่ทุจริตเงินเยียวยาเกษตรกร"],
            "กรุงเทพมหานคร" => ["ทุจริต TOR โครงการจัดซื้อครุภัณฑ์แพทย์", "การเรียกรับผลประโยชน์อนุมัติสิ่งก่อสร้าง", "การละเว้นการปฏิบัติหน้าที่ราชการเขต"],
            "นครราชสีมา"   => ["ผู้รับเหมาชนะประมูลซ้ำ 6 ครั้ง", "เจ้าหน้าที่เรียกค่าธรรมเนียมเกินกำหนด", "ทุจริตโครงการก่อสร้างถนนสายรอง"],
            "ขอนแก่น"       => ["ทุจริตจัดซื้อครุภัณฑ์คอมพิวเตอร์", "เจ้าหน้าที่เบิกค่าใช้จ่ายเท็จ", "อนุมัติสิทธิ์ที่ดินทับซ้อน"],
            _               => ["เจ้าหน้าที่ทุจริตโครงการก่อสร้างประปา", "เรียกเงินใต้โต๊ะออกสิทธิ์ที่ทำกิน", "พบผู้รับเหมารายเดียวชนะงานซ้ำซ้อน"]
        };

        _provinceHourlyData = provinceName switch
        {
            "กรุงเทพมหานคร" => [1,0,0,0,0,2,5,12,28,45,38,22,8,6,10,14,11,7,3,2,1,1,0,0],
            "ชลบุรี"        => [0,0,0,0,0,1,3,8,18,26,22,14,5,4,7,9,6,4,2,1,0,0,0,0],
            "นครราชสีมา"   => [0,0,0,0,0,1,2,6,15,22,19,11,4,3,5,8,5,3,1,1,0,0,0,0],
            "ขอนแก่น"       => [0,0,0,0,0,0,2,5,12,18,15,9,3,2,4,6,4,2,1,0,0,0,0,0],
            "สงขลา"         => [0,0,0,0,0,0,1,4,10,16,14,8,3,2,4,5,3,2,1,0,0,0,0,0],
            _               => [0,0,0,0,0,1,2,5,10,15,12,8,3,2,4,6,4,2,1,1,0,0,0,0]
        };

        _showProvinceModal = true;
        await InvokeAsync(StateHasChanged);

        // ให้ Blazor render modal DOM ก่อน แล้วค่อย render chart บน canvas ที่เพิ่งสร้าง
