            {
                // 2. ร้องเรียน ทำข้อมูลรายชั่วโมง (Hourly Complaint Chart)
                // แสดง 24 แท่งชั่วโมง โดยเน้นช่วงพีค 09:00 - 11:00 น.
                await JS.InvokeVoidAsync("initTrendChart", "chartMonthly", 
                    new[] { "00:00", "02:00", "04:00", "06:00", "08:00", "09:00", "10:00", "11:00", "12:00", "14:00", "16:00", "18:00", "20:00", "22:00" }, 
