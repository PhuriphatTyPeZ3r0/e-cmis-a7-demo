    private int V6TotalCases => V6Sec18_1gVal + V6Sec18_4Val + V6Sec62Val + V6Sec58_2Val;
    
    // คำนวณเปอร์เซ็นต์ความก้าวหน้า
    private double V6Sec18_1gPct => V6TotalCases > 0 ? (double)V6Sec18_1gVal / V6TotalCases * 100 : 0;
    private double V6Sec18_4Pct => V6TotalCases > 0 ? (double)V6Sec18_4Val / V6TotalCases * 100 : 0;
    private double V6Sec62Pct => V6TotalCases > 0 ? (double)V6Sec62Val / V6TotalCases * 100 : 0;
    private double V6Sec58_2Pct => V6TotalCases > 0 ? (double)V6Sec58_2Val / V6TotalCases * 100 : 0;

    // Dynamic SLA V6
    private int V6SlaYellowVal => SelectedYearMode == "fiscal" ? 175 : 158;
    private int V6SlaRedVal => SelectedYearMode == "fiscal" ? 82 : 74;

    // Dynamic Intake V6
    private int IntakeM62Val => SelectedYearMode == "fiscal" ? 163 : 151;
    private int IntakeWebVal => SelectedYearMode == "fiscal" ? 99 : 92;
    private int IntakePostVal => SelectedYearMode == "fiscal" ? 94 : 85;
    private int IntakeCallVal => SelectedYearMode == "fiscal" ? 68 : 61;
    private int IntakeAppVal => SelectedYearMode == "fiscal" ? 33 : 30;

    // Dynamic SLA Logs
    private sealed record M62DrilldownRow(string Region, int Received, int Accum);
    private List<M62DrilldownRow> GetM62DrilldownRows()
    {
