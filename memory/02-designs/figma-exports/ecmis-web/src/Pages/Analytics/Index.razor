                                    <span class="wr-terminal-time">[SYS_DONE]</span>
                                    <span class="wr-terminal-text" style="color: #00ff66; text-shadow: 0 0 4px #00ff66;">LISTENING ON SOCKET e-GP / GFMIS...</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    @* คอลัมน์ 3: เกจวัดดัชนี SLA ประจำปี *@
                    <div class="table-card an-flex-card panel-glow wr-hud-card" style="min-height: 180px;">
                        <div class="tc-head">
                            <div class="tc-row1">
                                <div class="tc-title"><i class="bi bi-compass" style="color:var(--wr-gold)"></i> อัตราบรรลุเป้าหมายมาตรการ (SLA Matrix)</div>
                                <span class="bdg-nv" style="background: rgba(200, 169, 110, 0.15); color: var(--wr-gold);">TARGET</span>
                            </div>
                        </div>
                        <div class="an-scroll p-3" style="display:flex; flex-direction:column; align-items:center; justify-content:center; gap: 8px;">
                            <div style="position:relative; width: 80px; height: 80px;">
                                <canvas id="chartComparisonV4" style="max-height:80px; max-width:80px;"></canvas>
                            </div>
                            <div style="text-align:center;">
                                <strong style="font-size: 1.15rem; color:var(--wr-green); font-family: monospace; font-weight: 900;">88.2% SLA</strong>
                                <small class="an-muted" style="display:block; font-size:0.65rem; font-weight: 700; color: var(--wr-text-muted);">บรรลุเป้าหมายการป้องกันภาครัฐ</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        else if (SelectedVersion == 5)
        {
            @* ── VERSION 5: NOC Crisis Command Center ── *@
            <div style="display: grid; grid-template-columns: 1.15fr 1fr; gap: 12px; min-height: 0; flex: 1;">
                
                @* 1. ฝั่งซ้าย: Live Alert Feed ไหลสด -> Flashing Red corner hud-card! *@
                <div class="table-card an-flex-card panel-glow wr-hud-card wr-hud-card-red" style="display:flex; flex-direction:column; min-height:300px;">
                    <div class="tc-head" style="border-bottom-color: rgba(239, 68, 68, 0.3); background: rgba(239, 68, 68, 0.05);">
                        <div class="tc-row1">
                            <div class="tc-title" style="color: #f87171;"><span class="wr-live-dot" style="margin-right:6px;"></span> แหล่งข้อมูลเตือนภัยและล็อคเป้าทุจริตด่วน (Live NOC Stream)</div>
                            <span class="bdg-nv" style="background:#ef4444; color:#fff; font-weight:900; animation: wr-pulse 1.2s infinite; box-shadow: 0 0 10px rgba(239, 68, 68, 0.45);">CRITICAL RISK DETECTED</span>
                        </div>
                    </div>
                    <div class="an-scroll" style="padding: 12px; display:flex; flex-direction:column; gap: 8px; background: rgba(0, 0, 0, 0.15);">
                        @foreach (var alert in _allAlerts)
                        {
                            <div style="display:flex; gap:12px; padding:10px; background: rgba(239, 68, 68, 0.04); border:1px solid @(alert.Level == "red" ? "rgba(239, 68, 68, 0.3)" : alert.Level == "amber" ? "rgba(245, 158, 11, 0.25)" : "rgba(59, 130, 246, 0.2)"); border-radius:6px; position:relative; align-items:center; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                                <div style="width:8px; height:8px; background:@(alert.Level == "red" ? "#ef4444" : alert.Level == "amber" ? "#f59e0b" : "#3b82f6"); border-radius:50%; flex-shrink:0; @(alert.Level == "red" ? "animation: wr-pulse 1.2s infinite;" : "")"></div>
                                <div style="flex:1;">
                                    <div style="display:flex; justify-content:space-between; align-items:center;">
                                        <strong style="font-size:0.75rem; color:#fff; font-weight: 800;">@alert.Title</strong>
                                        <span style="font-size:0.6rem; color:var(--wr-text-muted); font-family: monospace; font-weight: bold;">@alert.Time น.</span>
                                    </div>
                                    <div style="font-size:0.65rem; color:var(--wr-text-muted); margin-top:2px;">@alert.Detail</div>
                                </div>
                                <span class="wr-risk-score @ScoreClass(alert.Score)" style="font-size: 0.65rem; padding: 2px 4px; flex-shrink:0;">@alert.Score%</span>
                            </div>
                        }
                    </div>
                </div>

                @* 2. ฝั่งขวา: Joint Command Board & SLA *@
                <div style="display:flex; flex-direction:column; gap:12px; min-height:0;">
                    @* บอร์ดติดตามงานเผชิญเหตุและประสานงานด่วน *@
                    <div class="table-card an-flex-card panel-glow wr-hud-card" style="flex:1.4; min-height:180px;">
                        <div class="tc-head">
                            <div class="tc-row1">
                                <div class="tc-title"><i class="bi bi-shield-fill-check" style="color:var(--wr-blue)"></i> บอร์ดประสานงานปราบปรามทุจริตด่วน (Joint Command Board)</div>
                                <span class="bdg-nv" style="background: rgba(59, 130, 246, 0.15); color: var(--wr-blue);">SECURITY DEPT</span>
                            </div>
                        </div>
                        <div class="an-scroll">
                            <table class="an-tbl">
                                <thead>
                                    <tr><th>เรื่องสืบสวนเร่งด่วน</th><th>ผู้รับผิดชอบหลัก</th><th>คำสั่งด่วนหน้างาน</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in _allActions.Take(3))
                                    {
                                        <tr>
                                            <td>
                                                <div style="font-size:0.75rem; font-weight:800; color:#fff;">@item.Title</div>
                                                <small class="an-muted" style="font-size:0.6rem;">สแกนดัชนีวิกฤตเมื่อ @item.Due</small>
                                            </td>
                                            <td class="an-muted" style="font-size:0.7rem; font-weight:bold;">@item.Owner</td>
                                            <td style="display:flex; gap:6px; border:none; padding: 8px 4px; align-items: center;">
                                                <button class="wr-tactical-btn" style="font-size: 0.58rem; padding: 3px 6px; border-radius: 4px; margin: 0;" @onclick='() => ClickProvince("ส่งทีมร่วมปราบปรามทันที: " + item.Title)'>ส่งทีม</button>
                                                <button class="wr-tactical-btn wr-tactical-btn-blue" style="font-size: 0.58rem; padding: 3px 6px; border-radius: 4px; margin: 0;" @onclick='() => ClickProvince("ระงับงบประมาณชั่วคราว: " + item.Title)'>ระงับงบ</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        
                        @* Tactical interactive operations panel *@
                        <div style="padding: 10px; border-top: 1px solid var(--wr-card-border); background: rgba(0, 0, 0, 0.2);">
                            <div class="an-mini-head" style="margin-bottom: 6px; font-weight: 800; color: #ef4444; font-size: 0.6rem; letter-spacing: 0.05em;"><i class="bi bi-radioactive"></i> CRISIS CONTROLLER DIRECT ACCESS</div>
                            <div class="wr-tactical-grid">
                                <button class="wr-tactical-btn" @onclick='() => ClickProvince("ส่งกองบังคับการร่วม (ป.ป.ท./ป.ป.ช.) ลุยหน้างานตรวจสอบทันควัน")'>
                                    <i class="bi bi-shield-fill-exclamation"></i> สั่งการ ป.ป.ท. ด่วน
                                </button>
                                <button class="wr-tactical-btn wr-tactical-btn-blue" @onclick='() => ClickProvince("ประสาน ป.ป.ช. ยื่นคัดค้าน TOR")'>
                                    <i class="bi bi-shield-fill-check"></i> ประสาน ป.ป.ช.
                                </button>
                                <button class="wr-tactical-btn wr-tactical-btn-blue" @onclick='() => ClickProvince("ประสาน DSI สืบสวนเชิงลึกทางการเงิน")'>
                                    <i class="bi bi-cash-coin"></i> ประสาน DSI
                                </button>
                                <button class="wr-tactical-btn" @onclick='() => ClickProvince("สั่งระงับธุรกรรมและการเบิกจ่ายเงินแผ่นดินโครงการเป้าหมายทั้งหมด")' style="border-color: #ef4444; color: #ef4444; font-weight: bold;">
                                    <i class="bi bi-slash-circle-fill"></i> ระงับธุรกรรมด่วน
                                </button>
                            </div>
                        </div>
                    </div>

                    @* SLA KPI chart *@
                    <div class="table-card an-flex-card panel-glow wr-hud-card" style="flex:1; min-height:120px;">
                        <div class="tc-head">
                            <div class="tc-row1">
                                <div class="tc-title"><i class="bi bi-clock-fill" style="color:var(--wr-green)"></i> ดัชนีความเร็วตอบสนองภัยคุกคามสะสม (Response Time SLA)</div>
                                <span class="bdg-nv" style="background: rgba(16, 185, 129, 0.15); color: var(--wr-green);">RESPONSE RATE</span>
                            </div>
                        </div>
                        <div class="an-scroll p-3" style="display:grid; grid-template-columns:1fr 1.2fr; align-items:center; justify-content:center; gap: 10px;">
                            <div style="position:relative; max-height:80px; display: flex; align-items: center; justify-content: center;">
                                <canvas id="chartSlaV5" style="max-height:80px; max-width:100%;"></canvas>
                            </div>
                            <div style="display:flex; flex-direction:column; justify-content:center;">
                                <div style="font-size: 1.25rem; font-weight:900; color:var(--wr-green); font-family: monospace;">88% SLA ACCELERATION</div>
                                <div style="font-size:0.6rem; color:var(--wr-text-muted); font-weight: 700; margin-top: 2px;">ตรวจเข้าหน้างานได้ภายใน 24 ชม. ของสัญญาณเตือน Red Flag เพื่อให้สามารถระงับยับยั้งความเสียหายได้อย่างทันเวลาก่อนที่จะมีการอนุมัติเสร็จสมบูรณ์</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        else if (SelectedVersion == 6)
        {
            @* ── VERSION 6: Next-Gen War Room (กิจกรรม 12 & 4 Feedback) ── *@
            <div class="v6-layout font-sarabun">
                
                @* แถวหลักกลาง: แบ่งสัดส่วน 3 คอลัมน์ (29% | 42% | 29%) *@
                @* โครงสร้างแบบ Asymmetric Cyber HUD Grid Layout เพื่อความแปลกใหม่ของ ป.ป.ท. *@
                @* โครงสร้างใหม่: แผนที่ประเทศไทยฝั่งซ้ายยาวเต็มแกน (Left Sidebar Map) และ Dashboard ฝั่งขวา *@
                <div class="v6-main-layout">
                    
                    @* คอลัมน์ซ้าย (32%): แผนที่ความเสี่ยงประเทศไทยแนวตั้งยาวเต็มหน้าจอ *@
                    <div class="v6-main-left">
                        @* แผงหลัก: แผนที่ประเทศไทย *@
                        <div class="table-card an-flex-card panel-glow map-hud-card" style="position:relative; flex: 1; min-height: 0; display: flex; flex-direction: column;">
                            <div class="tc-head">
                                <div class="tc-row1">
                                    <div class="tc-title"><i class="bi bi-map-fill text-emerald"></i> แผนที่เรื่องร้องเรียนรายเขต ปปท. (ปีงบ 2569)</div>
                                    <span class="bdg-nv border-emerald text-emerald font-monospace uppercase">รวม @_heatTotal เรื่อง</span>
                                </div>
                            </div>
                            <div class="v6-map-area" style="flex: 1; display: flex; flex-direction: column; min-height: 0; position: relative;">
                                <ThailandHeatmap Zones="_heatZones" MaxValue="_heatMax" ValueLabel="เรื่องร้องเรียน" SelectedZone="SelectedHeatZone" OnZoneClick="OnHeatZoneClick" />
                                <div style="text-align:center; font-size:12px; color:#94a3b8; padding:4px 0; flex-shrink:0;">
                                    ส่วนกลาง (กปท.1–5 + กอท.): <b style="color:#e2e8f0">@_centralCount</b> เรื่อง — ไม่มีอาณาเขตบนแผนที่
                                </div>
                            </div>

                        </div>
                    </div>
                    
                    @* คอลัมน์ขวา (68%): Dashboard ข้อมูลอื่นๆ ทั้งหมด *@
                    <div class="v6-main-right">
                        @* 1. แผง KPI 6 ใบ: ยอดรวม 2 + มาตรา 4 (Horizontal Law HUD Panels) *@
                        <div class="v6-law-hud-row">
                            <div class="v6-sec-card border-yellow v6-sec-card-click" title="กดเพื่อดูแยกรายปี" @onclick='() => OpenMetricDrillAsync("accum")'>
                                <div class="v6-sec-header" style="flex-direction: column; align-items: flex-start;">
                                    <span class="v6-sec-title">สะสมทั้งหมด</span>
                                    <span class="v6-sec-subtitle">พ.ศ. 2551–2569</span>
                                </div>
                                <div class="v6-sec-value">
                                    @_accumTotal.ToString("N0") <small>เรื่อง</small>
                                </div>
                            </div>

                            <div class="v6-sec-card border-cyan v6-sec-card-click" title="กดเพื่อดูแยกรายเขต" @onclick='() => OpenMetricDrillAsync("all")'>
                                <div class="v6-sec-header" style="flex-direction: column; align-items: flex-start;">
                                    <span class="v6-sec-title">รับปีงบ 2569</span>
                                    <span class="v6-sec-subtitle">ณ 30 พ.ย. 2568</span>
                                </div>
                                <div class="v6-sec-value text-emerald">
                                    @_heatTotal <small>เรื่อง</small>
                                </div>
                            </div>

                            <div class="v6-sec-card border-cyan v6-sec-card-click" title="กดเพื่อดูรายละเอียด" @onclick='() => OpenMetricDrillAsync("M181k")'>
                                <div class="v6-sec-header" style="flex-direction: column; align-items: flex-start;">
                                    <span class="v6-sec-title">ม.18/1ก</span>
                                    <span class="v6-sec-subtitle">ไต่สวนเอง</span>
                                </div>
                                <div class="v6-sec-value text-cyan">
                                    @V6Sec18_1gVal <small>เรื่อง</small>
                                </div>
                            </div>

                            <div class="v6-sec-card border-blue v6-sec-card-click" title="กดเพื่อดูแยกรายเขต" @onclick='() => OpenMetricDrillAsync("M184")'>
                                <div class="v6-sec-header" style="flex-direction: column; align-items: flex-start;">
                                    <span class="v6-sec-title">ม.18/4</span>
                                    <span class="v6-sec-subtitle">พงส. ส่งสำนวน</span>
                                </div>
                                <div class="v6-sec-value text-blue">
                                    @V6Sec18_4Val <small>เรื่อง</small>
                                </div>
                            </div>

                            <div class="v6-sec-card border-purple v6-sec-card-click" title="กดเพื่อดูแยกรายเขต" @onclick='() => OpenMetricDrillAsync("M62")'>
                                <div class="v6-sec-header" style="flex-direction: column; align-items: flex-start;">
                                    <span class="v6-sec-title">ม.62 / 18/1(ข)</span>
                                    <span class="v6-sec-subtitle">ทำเองรับเอง</span>
                                </div>
                                <div class="v6-sec-value text-purple">
                                    @V6Sec62Val <small>เรื่อง</small>
                                </div>
                            </div>

                            <div class="v6-sec-card border-yellow v6-sec-card-click" title="กดเพื่อดูรายละเอียด" @onclick='() => OpenMetricDrillAsync("M582")'>
                                <div class="v6-sec-header" style="flex-direction: column; align-items: flex-start;">
                                    <span class="v6-sec-title">ม.58/2</span>
                                    <span class="v6-sec-subtitle">ไต่สวนเร่งด่วน</span>
                                </div>
                                <div class="v6-sec-value text-yellow">
                                    @V6Sec58_2Val <small>เรื่อง</small>
                                </div>
                            </div>
                        </div>

                        @* 2. จัดกล่องข้อมูลแถวกลาง: กราฟเปรียบเทียบคดีย้อนหลัง (60%) และ SLA Alerts (40%) เคียงข้างกันเพื่อแก้ปัญหาความกว้างเกินไป *@
                        <div class="v6-alerts-container">
                            
                            @* กราฟเปรียบเทียบ ย้อนหลัง (อดีต vs ปัจจุบัน) ย้ายขึ้นมาอยู่แถวกลางเพื่อให้ได้หน้ากว้างสมส่วน *@
                            <div class="table-card an-flex-card panel-glow" style="flex: 1.6; display: flex; flex-direction: column; min-height: 0;">
                                <div class="tc-head">
                                    <div class="tc-row1">
                                        <div class="tc-title">
                                            <i class="bi bi-graph-up text-cyan"></i> 
                                            เปรียบเทียบคดีสะสมย้อนหลังรายปี — มิติ: @(SelectedYearMode == "fiscal" ? "ปีงบประมาณ" : "ปีปฏิทิน")
                                        </div>
                                    </div>
                                </div>
                                <div class="v6-chart-box" style="flex: 1; padding: 10px; min-height: 0;">
                                    <canvas id="chartCompareV6" style="width: 100%; height: 100%; min-height: 160px;"></canvas>
                                </div>
                            </div>

                            @* SLA & Ageing Alerts บีบให้แคบลงเหลือ 40% เพื่อให้อยู่ในรูปทรงแนวตั้งที่อ่านง่ายและกระชับ *@
                            <div class="table-card an-flex-card panel-glow" style="flex: 1; display: flex; flex-direction: column; min-height: 0;">
                                <div class="tc-head">
                                    <div class="tc-row1">
                                        <div class="tc-title"><i class="bi bi-alarm-fill text-rose"></i> แจ้งเตือนกรอบเวลาคดีค้าง SLA & AGEING</div>
                                    </div>
                                </div>
                                <div class="v6-sla-alerts" style="flex: 1; display: flex; flex-direction: column; min-height: 0; padding: 10px; gap: 10px;">
                                    <div class="v6-sla-kpis" style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
                                        <div class="v6-sla-kpi-card bg-yellow-dark v6-sla-kpi-click" title="กดเพื่อดูรายการ" @onclick='() => OpenSlaPopup("yellow")'>
                                            <div class="v6-kpi-val text-yellow">@V6SlaYellowVal <small>คดี</small></div>
                                            <div class="v6-kpi-lbl">เกิน 45 วัน (เตือนเหลือง)</div>
                                        </div>
                                        <div class="v6-sla-kpi-card bg-red-dark v6-sla-kpi-click" title="กดเพื่อดูรายการ" @onclick='() => OpenSlaPopup("red")'>
                                            <div class="v6-kpi-val text-red">@V6SlaRedVal <small>คดี</small></div>
                                            <div class="v6-kpi-lbl">เกิน 60 วัน (เลยกำหนดแดง)</div>
                                        </div>
                                    </div>
                                    
                                    <div class="v6-sla-list an-scroll" style="flex: 1; min-height: 0;">
                                        @foreach (var c in SlaCases.Take(3))
                                        {
                                            <div class="v6-sla-item @(c.Bucket == "red" ? "border-l-red" : "border-l-yellow") v6-sla-item-click" style="margin-bottom: 6px; padding: 6px 8px;" title="กดเพื่อดูรายละเอียด" @onclick="() => OpenSlaCase(c)">
                                                <div class="v6-sla-header">
                                                    <span class="v6-sla-time @(c.Bucket == "red" ? "bg-danger" : "bg-warning text-dark")">@(c.Bucket == "red" ? "เลยกำหนด" : "แจ้งเตือน") @c.DaysOver วัน</span>
                                                    <strong class="v6-sla-title">@c.Title</strong>
                                                </div>
                                                <small class="v6-sla-desc">@c.CaseNo · รับเรื่อง @ThaiShortDate(c.ReceivedAt) · @ComplaintStatsData.ZoneLabel(c.Zone) · @c.Stage</small>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>

                        </div>

                        @* 3. แถวล่าง: เหลือ 2 กล่อง คือ Top 5 ช่องทางรับเรื่อง (span 4) และ รายการคดีรับใหม่ (span 8) *@
                        <div class="v6-bottom-grid">
                            @* Top 5 ช่องทางรับเรื่อง (span 4) *@
                            <div class="table-card an-flex-card panel-glow" style="grid-column: span 4; display: flex; flex-direction: column;">
                                <div class="tc-head">
                                    <div class="tc-row1">
                                        <div class="tc-title"><i class="bi bi-pie-chart-fill text-purple"></i> Top 5 ช่องทางรับเรื่อง</div>
                                    </div>
                                </div>
                                <div class="v6-chart-box d-flex flex-column align-items-center justify-content-center p-3" style="flex: 1; min-height: 0;">
                                    <div style="width:160px; height:160px; position:relative; flex-shrink:0; margin-bottom: 12px;">
                                        <canvas id="chartIntakeV6"></canvas>
