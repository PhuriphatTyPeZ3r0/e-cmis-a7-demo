            new("กปท. เขต 1 (กรุงเทพฯ)", 7 + 1 * multiplier, 24 + 3 * multiplier),
            new("ปปท. เขต 9 (ภาคใต้ตอนล่าง)", 2, 25 + 2 * multiplier),
            new("กปท. เขต 2 (กรุงเทพฯ)", 8 + 1 * multiplier, 34 + 3 * multiplier),
            new("ปปท. เขต 2 (ภาคกลางตอนล่าง)", 6, 38 + 3 * multiplier),
            new("ปปท. เขต 6 (ภาคเหนือตอนบน)", 9 + 1 * multiplier, 39 + 4 * multiplier),
            new("ปปท. เขต 7 (ภาคเหนือตอนล่าง)", 5 + 1 * multiplier, 38 + 3 * multiplier),
            new("ปปท. เขต 8 (ภาคใต้ตอนบน)", 8 + 1 * multiplier, 25 + 2 * multiplier),
            new("กปท. เขต 5 (กรุงเทพฯ)", 7 + 1 * multiplier, 44 + 4 * multiplier),
            new("กอท. (กองอำนวยการข่าวพิเศษ)", 12 + 1 * multiplier, 25 + 2 * multiplier),
            new("กปท. เขต 3 (กรุงเทพฯ)", 5 + 1 * multiplier, 14 + 2 * multiplier)
        };
    }

    private async Task ChangeV6YearMode(string mode)
    {
        SelectedYearMode = mode;
        _slaCases = []; // ตัวเลข SLA ต่างตามมุมมองปี → ให้ generator สร้างชุดใหม่
        await Task.Delay(10); // UI yield
        await RenderChartsAsync();
    }

    private void OnV6WarningTypeChanged(ChangeEventArgs e)
        => SelectedWarningType = e.Value?.ToString() ?? "all";

    private void GoToZoneStats(int zone) => Nav.NavigateTo($"/analytics/complaint-stats?zone=Pt{zone}");

    private async Task ToggleFullscreenAsync() => await JS.InvokeVoidAsync("toggleWarRoomFullscreen");

    // ── แชร์มุมมองอ่านอย่างเดียว (ลิงก์ + QR, อายุลิงก์เลือกได้) ──
    [Parameter] public bool ShareMode { get; set; }

    private bool _showSharePanel;
    private bool _shareCopied;
    private int _shareHours = 168; // ค่าเริ่มต้น 7 วัน
    private string? _shareUrl;
    private bool _shareIsLocalhost;

    private async Task ToggleSharePanelAsync()
    {
        _showSharePanel = !_showSharePanel;
        if (_showSharePanel) await RegenerateShareLinkAsync();
    }

    private async Task OnShareExpiryChangedAsync(ChangeEventArgs e)
    {
        _shareHours = int.TryParse(e.Value?.ToString(), out var h) ? h : 168;
        await RegenerateShareLinkAsync();
    }

    private async Task RegenerateShareLinkAsync()
    {
        _shareCopied = false;
        var token = ShareToken.Create(DateTime.UtcNow.AddHours(_shareHours));
        _shareUrl = $"{Nav.BaseUri}share/warroom/{token}";
        _shareIsLocalhost = new Uri(Nav.BaseUri).IsLoopback;
        StateHasChanged();
        await Task.Delay(60); // รอ DOM มี #shareQrBox ก่อนวาด QR
        await JS.InvokeVoidAsync("renderShareQr", "shareQrBox", _shareUrl);
    }

    private async Task CopyShareLinkAsync()
    {
        if (_shareUrl is null) return;
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", _shareUrl);
        _shareCopied = true;
    }

    // ── Drill-down ในหน้าเดียว: ประเทศ → (เมตริก) → เขต → จังหวัด ──
    private Zone? _drillZone;
    private string? _drillProvince;
    private string? _drillMetric;   // null | accum | all | M62 | M184 | M181k | M582
    private LegalType? _drillType;  // filter มาตราที่พ่วงมากับเมตริก
    private (string Label, Func<StatRecord, bool> Pred)? _drillDim; // เจาะจากแท่งมิติใดๆ → รายการคดี
    private StatRecord? _drillCase;   // คดีรายตัว
    private StatsSnapshot? _drillSnap;

    private void SelectDrillDim(string label, Func<StatRecord, bool> pred) { _drillDim = (label, pred); _drillCase = null; }
    private void DrillBackToCaseList() => _drillCase = null;
    private void SelectDrillCase(StatRecord r) => _drillCase = r;
    private void DrillBackFromDim() { _drillDim = null; _drillCase = null; }
    private void ResetDrillCaseLevel() { _drillDim = null; _drillCase = null; }

    private IEnumerable<StatRecord> DrillDimCases()
        => _drillSnap is null || _drillDim is null ? [] : _drillSnap.Rows.Where(_drillDim.Value.Pred);

    private static string MonthLabel(DateTime d)
    {
        string[] m = { "ม.ค.", "ก.พ.", "มี.ค.", "เม.ย.", "พ.ค.", "มิ.ย.", "ก.ค.", "ส.ค.", "ก.ย.", "ต.ค.", "พ.ย.", "ธ.ค." };
        return $"{m[d.Month - 1]} {d.Year}";
    }

    private IEnumerable<(int Index, string Label, int Count)> DrillChannelRows()
        => _drillSnap is null ? [] : _drillSnap.Channels.All
            .Select((c, i) => (i, c.Label, c.Count))
            .Where(x => x.Count > 0)
            .OrderByDescending(x => x.Count);

    private static string StatusChip(CaseStatus s) => s switch
    {
        CaseStatus.Pending => "bg-warning text-dark",
        CaseStatus.Review => "bg-info text-dark",
        CaseStatus.Active => "bg-primary",
        CaseStatus.Transfer => "bg-purple",
