@page "/analytics"
@layout MainLayout
@implements IDisposable
@using EcmisWeb.Data
@using System.Globalization
@using EcmisWeb.Pages.Analytics.Components
@inject ComplaintApiService ComplaintApi
@inject IComplaintStatsService Stats
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="cs-shell an-fullscreen @(_isDark ? "" : "app-light") @(SelectedVersion == 6 ? "v6-active" : "") @(ShareMode ? "v6-share" : "")">

    @* ══ WAR ROOM HEADER ══ *@
    <div class="wr-topbar">
        <div class="wr-logo-area">
            <div class="wr-logo-seal">
                <i class="bi bi-shield-shaded" style="font-size: 20px; color: #0b0f1e;"></i>
            </div>
            <div class="wr-logo-text-block">
                <div class="wr-logo-title">ศอ.สท. WAR ROOM</div>
                <div class="wr-logo-sub">ศูนย์อำนวยการต่อต้านการทุจริตแห่งชาติ</div>
                <div class="wr-logo-en">NATIONAL ANTI-CORRUPTION COMMAND CENTER</div>
            </div>
        </div>

        @* Content Switcher Tab Navigation *@
        <div class="wr-topbar-tabs">
            @if (SelectedVersion != 6)
            {
                @* แท็บเหล่านี้ขับเคลื่อนเฉพาะ layout เก่า (ActiveTab ใช้ใน V1) — V6 ซ่อนเพื่อลดความซ้ำซ้อน *@
                <div class="wr-tab-item @(ActiveTab == "ภาพรวม" ? "active" : "")" @onclick='() => SwitchTab("ภาพรวม")'><i class="bi bi-speedometer2"></i> ภาพรวม</div>
                <div class="wr-tab-item @(ActiveTab == "จัดซื้อจัดจ้าง" ? "active" : "")" @onclick='() => SwitchTab("จัดซื้อจัดจ้าง")'><i class="bi bi-bank"></i> จัดซื้อจัดจ้าง</div>
                <div class="wr-tab-item @(ActiveTab == "ใบอนุญาต" ? "active" : "")" @onclick='() => SwitchTab("ใบอนุญาต")'><i class="bi bi-file-earmark-text"></i> ใบอนุญาต</div>
                <div class="wr-tab-item @(ActiveTab == "ร้องเรียน" ? "active" : "")" @onclick='() => SwitchTab("ร้องเรียน")'><i class="bi bi-envelope"></i> ร้องเรียน</div>
                <div class="wr-tab-item @(ActiveTab == "คดีเผชิญเหตุฯ" ? "active" : "")" @onclick='() => SwitchTab("คดีเผชิญเหตุฯ")'><i class="bi bi-folder-check"></i> คดีเผชิญเหตุฯ</div>
                <div class="wr-tab-item @(ActiveTab == "รายงาน" ? "active" : "")" @onclick='() => SwitchTab("รายงาน")'><i class="bi bi-file-earmark-bar-graph"></i> รายงาน</div>
                <a href="/analytics/director-report" class="wr-tab-item" style="text-decoration:none;"><i class="bi bi-person-badge-fill"></i> รายงานผู้บริหาร</a>
            }
            @if (SelectedVersion == 6)
            {
                @* V6: ใช้พื้นที่แท็บเดิมวางตัวกรอง/ค้นหา — ตัดแถบ controls แยกทิ้ง ข้อมูลกลางได้พื้นที่คืน *@
                <div class="v6-inline-controls">
                    <div class="v6-toggle-buttons">
                        <button class="v6-toggle-btn @(SelectedYearMode == "fiscal" ? "active" : "")" @onclick='() => ChangeV6YearMode("fiscal")'>ปีงบประมาณ</button>
                        <button class="v6-toggle-btn @(SelectedYearMode == "calendar" ? "active" : "")" @onclick='() => ChangeV6YearMode("calendar")'>ปีปฏิทิน</button>
                    </div>
                    <select class="v6-select" @onchange="OnV6WarningTypeChanged">
                        <option value="all">ความเสี่ยงรวมทุกประเภท</option>
                        <option value="road">โครงการก่อสร้างถนน</option>
                        <option value="procure">จัดซื้อจัดจ้างทั่วไป</option>
                        <option value="duty">ปฏิบัติหน้าที่มิชอบ</option>
                        <option value="license">ทุจริตใบอนุญาต</option>
                    </select>
                </div>
            }
            @if (ShareMode)
            {
                <span class="wr-readonly-badge"><i class="bi bi-eye-fill"></i> มุมมองอ่านอย่างเดียว</span>
            }
        </div>

        <div class="wr-topbar-right">
            @if (_showDevMode)
            {
                @* Layout Version Controls (V1 - V6) *@
                <div class="wr-version-selector">
                    <span class="wr-ver-label">DEV VERSION:</span>
                    <button class="wr-ver-btn @(SelectedVersion == 1 ? "active" : "")" @onclick="() => SwitchVersion(1)">V1</button>
                    <button class="wr-ver-btn @(SelectedVersion == 2 ? "active" : "")" @onclick="() => SwitchVersion(2)">V2</button>
                    <button class="wr-ver-btn @(SelectedVersion == 3 ? "active" : "")" @onclick="() => SwitchVersion(3)">V3</button>
                    <button class="wr-ver-btn @(SelectedVersion == 4 ? "active" : "")" @onclick="() => SwitchVersion(4)">V4</button>
                    <button class="wr-ver-btn @(SelectedVersion == 5 ? "active" : "")" @onclick="() => SwitchVersion(5)">V5</button>
                    <button class="wr-ver-btn @(SelectedVersion == 6 ? "active" : "")" @onclick="() => SwitchVersion(6)">V6</button>
                </div>
            }
            
            <div class="wr-export-wrapper" style="position:relative;">
                <button class="wr-export-btn" @onclick="ToggleFullscreenAsync" title="ดูเต็มจอ (กด ESC เพื่อออก)">
                    <i class="bi bi-arrows-fullscreen"></i>
                </button>
                @if (!ShareMode)
                {
                    <button class="wr-export-btn" @onclick="ToggleSharePanelAsync" title="แชร์ให้ผู้บริหาร (อ่านอย่างเดียว)">
                        <i class="bi bi-share-fill"></i>
                    </button>
                    <button class="wr-export-btn wr-btn-gold" @onclick="OpenReportModal" title="Export">
                        <i class="bi bi-download"></i>
                        <span>Export</span>
                    </button>
                }
                @if (_showSharePanel)
                {
                    <div class="wr-share-panel font-sarabun">
                        <div class="wr-share-head">
                            <strong><i class="bi bi-share-fill"></i> แชร์มุมมองอ่านอย่างเดียว</strong>
                            <button class="v6-close-btn" @onclick="() => _showSharePanel = false">&times;</button>
                        </div>
                        <label class="wr-share-lbl">อายุลิงก์</label>
                        <select class="wr-share-select" @onchange="OnShareExpiryChangedAsync">
                            <option value="1">1 ชั่วโมง</option>
                            <option value="24">24 ชั่วโมง</option>
                            <option value="168" selected>7 วัน</option>
                            <option value="720">30 วัน</option>
                        </select>
                        <label class="wr-share-lbl">ลิงก์</label>
                        <div class="wr-share-linkrow">
                            <input class="wr-share-input" readonly value="@_shareUrl" />
                            <button class="wr-share-copy" @onclick="CopyShareLinkAsync">@(_shareCopied ? "คัดลอกแล้ว ✓" : "คัดลอก")</button>
                        </div>
                        <div class="wr-share-qrwrap">
                            <div id="shareQrBox"></div>
                            <small>สแกนเพื่อเปิดดูบนมือถือ/แท็บเล็ต</small>
                        </div>
                        @if (_shareIsLocalhost)
                        {
                            <small class="wr-share-warn"><i class="bi bi-exclamation-triangle-fill"></i> ระบบเปิดอยู่ที่ localhost — ลิงก์/QR นี้เปิดได้เฉพาะบนเครื่องนี้เท่านั้น
                                ถ้าจะให้เครื่องอื่นดู ให้เปิดระบบผ่าน IP เครือข่าย (เช่น http://192.168.x.x:5050) แล้วกดแชร์ใหม่ หรือใช้เวอร์ชันที่ deploy แล้ว</small>
                        }
                        <small class="wr-share-note">ผู้รับลิงก์ดูข้อมูลได้อย่างเดียว ไม่ต้องเข้าสู่ระบบ · ลิงก์หมดอายุอัตโนมัติ</small>
                    </div>
                }
            </div>
            <div class="wr-clock">
                <span id="wrClock">10:24:36</span>
                <small>23 พฤษภาคม 2567</small>
            </div>
            <div class="wr-live-badge"><span class="wr-live-dot"></span> LIVE</div>
            @if (!ShareMode)
            {
                <div class="wr-tab-item-settings" @onclick="ToggleDevMode" style="cursor:pointer;" title="โหมดนักพัฒนา"><i class="bi bi-gear-fill"></i></div>
            }
        </div>
    </div>

    @* ══ WAR ROOM BODY ══ *@
    <div class="an-body">

        @if (SelectedVersion == 1)
        {
            @* ── VERSION 1: Operational Command Center ── *@
            @* ── ROW 1: TOP 10 / HEATMAP / KPI + ALERTS ── *@
            <div class="wr-grid-top">

                @* 1. TOP 10 โครงการเสี่ยงสูงสุด (ฟิลเตอร์ตามแท็บ) *@
                <div class="table-card an-flex-card panel-glow">
                    <div class="tc-head">
                        <div class="tc-row1">
                            <div class="tc-title"><i class="bi bi-exclamation-octagon-fill" style="color:#ef4444"></i> TOP 10 โครงการเสี่ยงสูงสุด [@ActiveTab]</div>
                            <div class="tc-meta"><span class="bdg-nv">RISK SCORE</span></div>
                        </div>
                    </div>
                    <div class="an-scroll">
                        <table class="an-tbl">
                            <thead>
                                <tr>
                                    <th>ลำดับ</th>
                                    <th>ชื่อโครงการ</th>
                                    <th>หน่วยงาน</th>
                                    <th>มูลค่าโครงการ</th>
                                    <th>RISK SCORE</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (FilteredRiskRows.Count == 0)
                                {
                                    <tr>
                                        <td colspan="5" class="text-center an-muted py-4">ไม่พบโครงการเสี่ยงในหมวดหมู่นี้</td>
                                    </tr>
                                }
                                else
                                {
                                    int index = 1;
                                    @foreach (var item in FilteredRiskRows)
                                    {
                                        <tr>
                                            <td><span class="an-rank @(index <= 3 ? "top3" : "")">@index</span></td>
                                            <td>
                                                <div class="an-strong">@item.Title</div>
                                            </td>
                                            <td class="an-muted">@item.Owner</td>
                                            <td class="an-muted" style="color: #60a5fa; font-weight: 600;">@item.Budget</td>
                                            <td><span class="wr-risk-score @ScoreClass(item.Score)">@item.Score%</span></td>
                                        </tr>
                                        index++;
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="panel-foot-action">
                        <button class="btn-panel-action" @onclick='() => ClickProvince("ท็อปโครงการเสี่ยงทั้งหมด")'>ดูทั้งหมด <i class="bi bi-arrow-right-short"></i></button>
                    </div>
                </div>

                @* 2. RISK HEATMAP แผนที่ความเสี่ยง (คลิกแสดง Modal) *@
                <div class="table-card an-flex-card panel-glow">
                    <div class="tc-head">
                        <div class="tc-row1">
                            <div class="tc-title"><i class="bi bi-map-fill" style="color:#10b981"></i> แผนที่ความเสี่ยงทั่วประเทศ (RISK HEATMAP)</div>
                            <div class="tc-meta">
                                <select class="wr-select-map" @onchange="OnMapTypeChanged">
                                    <option value="ภาพรวม">ดูตามประเภท</option>
                                    <option value="จัดซื้อจัดจ้าง">จัดซื้อจัดจ้าง</option>
                                    <option value="ใบอนุญาต">ใบอนุญาต</option>
                                    <option value="ร้องเรียน">เรื่องร้องเรียน</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="an-scroll an-map-scroll">
                        <div class="wr-map-layout">
                            <div class="wr-thai-map wr-thai-map-3d" role="img" aria-label="โมเดล 3D แผนที่ประเทศไทย">
                                <canvas id="thailandRiskMap" class="wr-thailand-canvas"></canvas>
                                <div class="wr-map-legend">
                                    <span><i class="risk-low"></i>ความเสี่ยงต่ำ</span>
                                    <span><i class="risk-mid"></i>ความเสี่ยงปานกลาง</span>
                                    <span><i class="risk-high"></i>ความเสี่ยงสูง</span>
                                    <span><i class="risk-critical"></i>ความเสี่ยงสูงมาก</span>
                                </div>
                            </div>
                            <div class="wr-map-side">
                                <div class="an-map-metric">
                                    <div class="an-muted">ความเสี่ยงรายภูมิภาค</div>
                                </div>
                                @foreach (var region in _regions)
                                {
                                    <div class="an-row">
                                        <span>@region.Name</span>
                                        <strong class="@ScoreTextClass(region.Score)">@region.Score% · @RiskLabel(region.Score)</strong>
                                    </div>
                                }
                                
                                <div class="an-mini-head" style="margin-top: 10px;">จังหวัดที่มีความเสี่ยงสูงสุด (คลิกเพื่อดูข้อมูล)</div>
                                @foreach (var province in _byProvince.Take(5))
                                {
                                    <div class="an-row wr-clickable-row" @onclick="() => ClickProvince(province.Name)">
                                        <span>@(province.Index + 1). @province.Name <i class="bi bi-info-circle ms-1" style="font-size: 10px; opacity:0.6;"></i></span>
                                        <strong class="wr-badge-score">@province.Score%</strong>
                                    </div>
                                }
                                
                                <button class="btn-panel-action" style="width: 100%; margin-top: 12px; text-align: center; display: block;" @onclick='() => ClickProvince("กรุงเทพมหานคร")'>ดูแผนที่เชิงลึก <i class="bi bi-arrow-right-short"></i></button>
                            </div>
                        </div>
                    </div>
                </div>

                @* 3. KPI REAL-TIME + ALERTS *@
                <div class="wr-right-column">
                    
                    @* KPI Matrix (4 cards) *@
                    <div class="wr-kpi-matrix">
                        <div class="wr-kpi-card blue-glow">
                            <div class="kpi-icon"><i class="bi bi-folder-check"></i></div>
                            <div class="kpi-body">
                                <div class="kpi-title">คดีอยู่ระหว่างดำเนินการ</div>
                                <div class="kpi-value text-blue">@KpiActiveCount <small>คดี</small></div>
                                <div class="kpi-sub"><span class="kpi-up"><i class="bi bi-arrow-up-short"></i> เพิ่มขึ้น 12%</span></div>
                            </div>
                        </div>
                        <div class="wr-kpi-card green-glow">
                            <div class="kpi-icon"><i class="bi bi-currency-dollar"></i></div>
                            <div class="kpi-body">
                                <div class="kpi-title">มูลค่าความเสียหาย</div>
                                <div class="kpi-value text-green">@KpiDamageCount <small>ล้านบาท</small></div>
                                <div class="kpi-sub">ป้องกันได้ <strong style="color:#10b981">@KpiSavedCount ลบ.</strong></div>
                            </div>
                        </div>
                        <div class="wr-kpi-card purple-glow">
                            <div class="kpi-icon"><i class="bi bi-flag-fill"></i></div>
                            <div class="kpi-body">
                                <div class="kpi-title">Red Flag วันนี้</div>
                                <div class="kpi-value text-purple">@KpiRedFlagCount <small>รายการ</small></div>
                                <div class="kpi-sub"><span class="kpi-up"><i class="bi bi-arrow-up-short"></i> เพิ่มขึ้น 23%</span></div>
                            </div>
                        </div>
                        <div class="wr-kpi-card gold-glow">
                            <div class="kpi-icon"><i class="bi bi-chat-left-dots-fill"></i></div>
                            <div class="kpi-body">
                                <div class="kpi-title">ร้องเรียนทั้งหมด</div>
                                <div class="kpi-value text-gold">@KpiTotalComplaints <small>เรื่อง</small></div>
                                <div class="kpi-sub"><span class="kpi-up"><i class="bi bi-arrow-up-short"></i> เพิ่มขึ้น 15%</span></div>
                            </div>
                        </div>
                    </div>

                    @* ALERT & RED FLAG *@
                    <div class="table-card an-flex-card panel-glow flex-grow-1" style="min-height: 0; display: flex; flex-direction: column;">
                        <div class="tc-head">
                            <div class="tc-row1">
                                <div class="tc-title"><i class="bi bi-bell-fill" style="color:#f87171"></i> ALERT & RED FLAG (แจ้งเตือนความเสี่ยง)</div>
                                <div class="tc-meta"><a href="#" class="wr-link-action" @onclick='() => ClickProvince("ประวัติการแจ้งเตือนภัยทั้งหมด")'>ดูทั้งหมด</a></div>
                            </div>
                        </div>
                        <div class="an-scroll flex-grow-1">
                            @if (FilteredAlerts.Count == 0)
                            {
                                <div class="p-4 text-center an-muted">ไม่มีรายการแจ้งเตือนในหมวดหมู่นี้</div>
                            }
                            else
                            {
                                @foreach (var alert in FilteredAlerts)
                                {
                                    <div class="an-alert-row">
                                        <span class="an-alert-time">@alert.Time</span>
                                        <span class="an-alert-tag @alert.Level">@alert.Type</span>
                                        <div class="an-alert-body">
                                            <div class="an-strong">@alert.Title</div>
                                            <div class="an-muted">@alert.Detail</div>
                                        </div>
                                        <span class="wr-risk-score @ScoreClass(alert.Score)">@alert.Score%</span>
                                    </div>
                                }
                            }
                        </div>
                    </div>

                </div>

            </div>

            @* ── ROW 2: TRIPLE CHART / ACTION TRACKING ── *@
            <div class="wr-grid-bottom">

                @* 1. สถิติข้อมูลภาพรวม (สลับกราฟรายชั่วโมงเมื่อกดแท็บ ร้องเรียน) *@
                <div class="table-card an-flex-card panel-glow">
                    <div class="tc-head">
                        <div class="tc-row1">
                            <div class="tc-title">
                                <i class="bi bi-bar-chart-line-fill" style="color: #6366f1;"></i> 
                                @(ActiveTab == "ร้องเรียน" ? "สถิติเรื่องร้องเรียนรายชั่วโมง (ในรอบ 24 ชม.)" : "สถิติข้อมูลภาพรวม")
                            </div>
                            <div class="tc-meta">
                                <select class="wr-select-map">
                                    <option>7 วันล่าสุด</option>
                                    <option>30 วันล่าสุด</option>
                                    <option>ปีงบประมาณนี้</option>
                                </select>
                            </div>
                        </div>
                        <div class="tc-sub">
                            @(ActiveTab == "ร้องเรียน" 
                                ? "ข้อมูลวิเคราะห์รายชั่วโมง ตรวจพบการร้องเรียนสูงสุดช่วงเวลา 09:00 - 11:00 น." 
                                : $"จำนวนเรื่องร้องเรียน {KpiTotalComplaints} เรื่อง (+15% จาก 7 วันที่แล้ว)")
                        </div>
                    </div>
                    <div class="an-scroll p-3">
                        <div class="wr-triple-charts">
                            <div class="wr-sub-chart">
                                <div class="wr-sub-chart-title">@(ActiveTab == "ร้องเรียน" ? "เรื่องร้องเรียนสะสมรายชั่วโมง (09:00-11:00 Peak)" : "จำนวนเรื่องร้องเรียน")</div>
                                <div class="wr-sub-chart-canvas"><canvas id="chartMonthly"></canvas></div>
                            </div>
                            <div class="wr-sub-chart">
                                <div class="wr-sub-chart-title">ประเภทความเสี่ยง</div>
                                <div class="wr-sub-chart-canvas"><canvas id="chartRisk"></canvas></div>
                                <div class="wr-donut-legend">
                                    <div><i style="background:#dc2626"></i>จัดซื้อจัดจ้าง 48%</div>
                                    <div><i style="background:#ea580c"></i>ใบอนุญาต 25%</div>
                                    <div><i style="background:#d97706"></i>งบประมาณ 15%</div>
                                    <div><i style="background:#65a30d"></i>บุคลากร 7%</div>
                                    <div><i style="background:#2563eb"></i>อื่นๆ 5%</div>
                                </div>
                            </div>
                            <div class="wr-sub-chart">
                                <div class="wr-sub-chart-title">มูลค่าความเสียหาย (ล้านบาท)</div>
                                <div class="wr-sub-chart-canvas"><canvas id="chartInvestigation"></canvas></div>
                            </div>
                        </div>
                    </div>
                </div>

                @* 2. ACTION TRACKING (ติดตามการสั่งการ) *@
                <div class="table-card an-flex-card panel-glow">
                    <div class="tc-head">
                        <div class="tc-row1">
                            <div class="tc-title"><i class="bi bi-list-check" style="color:#14b8a6"></i> ACTION TRACKING (ติดตามการสั่งการ) [@ActiveTab]</div>
                            <div class="tc-meta"><a href="#" class="wr-link-action" @onclick='() => ClickProvince("ติดตามการสั่งการทั้งหมด")'>ดูทั้งหมด</a></div>
                        </div>
                    </div>
                    <div class="an-scroll">
                        <table class="an-tbl">
                            <thead>
                                <tr>
                                    <th>ลำดับ</th>
