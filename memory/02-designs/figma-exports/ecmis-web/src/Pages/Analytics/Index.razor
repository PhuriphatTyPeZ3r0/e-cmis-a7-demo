    protected override async Task OnInitializedAsync()
    {
        try
        {
            var theme = await JS.InvokeAsync<string?>("localStorage.getItem", "dashTheme");
            _isDark = !ShareMode && theme == "dark";
        }
        catch { }

        try
        {
            _rows = await ComplaintApi.GetComplaintsAsync();
            _total = _rows.Count;
        }
        catch
        {
            _rows = []; // backend ภายนอกล่ม/ออฟไลน์ — แดชบอร์ดส่วนที่เหลือต้องยังทำงาน (สำคัญกับหน้าแชร์)
            _total = 0;
        }
        _loading = false;

        var snap = await Stats.GetSnapshotAsync(StatsFilter.Default);
        foreach (var r in snap.Zones.ByRegion)
        {
            if (HeatmapLogic.ZoneFromRegionLabel(r.Label) is int zi)
                _heatZones[zi] = new ZoneHeatValue(r.Count, r.Count);
            else
                _centralCount += r.Count;
        }
        _heatMax = _heatZones.Count > 0 ? _heatZones.Values.Max(v => v.Value) : 0;
        _heatTotal = snap.Kpi.ReceivedThisYear;
        _accumTotal = snap.Kpi.Accumulated;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (ShareMode) await JS.InvokeVoidAsync("initShareRotate");
            try
            {
                var theme = await JS.InvokeAsync<string?>("localStorage.getItem", "dashTheme");
                _isDark = !ShareMode && theme == "dark";
            }
            catch { }

            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("registerAnalyticsComponent", _dotNetRef);
            await JS.InvokeVoidAsync("startWarRoomClock");
        }

        if (!_loading && !_chartsInitialized)
        {
            _chartsInitialized = true;
            await RenderChartsAsync();
        }
    }

