    private IEnumerable<(Zone Zone, string Label, int Count)> DrillZoneUnits()
        => _drillSnap is null ? [] : _drillSnap.Rows
            .GroupBy(r => r.Zone)
            .OrderByDescending(g => g.Count())
            .Select(g => (g.Key, ComplaintStatsData.ZoneLabel(g.Key), g.Count()));

    private async Task DrillZoneFromListAsync(Zone z)
    {
        _drillZone = z;
        ResetDrillCaseLevel();
        _drillProvince = null;
        _drillSnap = await Stats.GetSnapshotAsync(StatsFilter.Default with { Type = _drillType, Zone = z });
    }

    private async Task DrillBackToMetricAsync()
    {
        if (_drillMetric is null) { CloseDrill(); return; }
        ResetDrillCaseLevel();
        _drillZone = null;
        _drillProvince = null;
        _drillSnap = await Stats.GetSnapshotAsync(StatsFilter.Default with { Type = _drillType });
    }

    private int? SelectedHeatZone
        => _drillZone is Zone z && z.ToString().StartsWith("Pt") ? int.Parse(z.ToString()[2..]) : null;

    private async Task OnHeatZoneClick(int zone)
    {
        if (!Enum.TryParse<Zone>($"Pt{zone}", out var z)) return;
        if (_drillZone == z && _drillProvince is null && _drillMetric is null) { CloseDrill(); return; }
        _drillMetric = null;
        _drillType = null;
        _drillZone = z;
        ResetDrillCaseLevel();
        _drillProvince = null;
        _drillSnap = await Stats.GetSnapshotAsync(StatsFilter.Default with { Zone = z });
    }

    private async Task DrillProvince(string province)
    {
        if (_drillZone is not Zone z) return;
        ResetDrillCaseLevel();
        _drillProvince = province;
        _drillSnap = await Stats.GetSnapshotAsync(StatsFilter.Default with { Type = _drillType, Zone = z, Province = province });
    }

    private async Task DrillBackToZone()
    {
        if (_drillZone is not Zone z) return;
        ResetDrillCaseLevel();
        _drillProvince = null;
        _drillSnap = await Stats.GetSnapshotAsync(StatsFilter.Default with { Type = _drillType, Zone = z });
    }

    private void CloseDrill()
    {
        ResetDrillCaseLevel();
        _drillZone = null;
        _drillProvince = null;
        _drillMetric = null;
        _drillType = null;
        _drillSnap = null;
    }

    // ── SLA popup: ตัวเลข → รายเขต → รายการคดี → รายละเอียด (ข้อมูลสังเคราะห์ deterministic) ──
    private string? _slaPopup;     // null | yellow | red
