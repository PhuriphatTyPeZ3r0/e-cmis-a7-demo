    private bool MetricHasZoneData => _drillMetric is "all" or "M62" or "M184";

    private async Task OpenMetricDrillAsync(string metric)
    {
        _drillMetric = metric;
        _drillZone = null;
        _drillProvince = null;
        _drillType = metric switch
        {
            "M62" => LegalType.M62,
            "M184" => LegalType.M18_4_2,
            _ => null,
        };
        _drillSnap = await Stats.GetSnapshotAsync(StatsFilter.Default with { Type = _drillType });
