@page "/migration"
@using EcmisWeb.Data
@inject NavigationManager Nav

<div class="routing-page-wrap">
    <div class="complaints-page-header">
        <div>
            <div class="complaints-title">
                <i class="bi bi-speedometer2" style="color:var(--navy)"></i>
                <span>ศูนย์กลางโอนย้ายข้อมูล (Data Migration Dashboard)</span>
            </div>
            <div class="complaints-subtitle">
                กิจกรรมที่ 11: ควบคุมสถานะการดึงข้อมูลจากระบบเดิม 40,000+ เรคคอร์ด เข้าสู่ E-CMIS แบบ Real-time
            </div>
        </div>
    </div>

    @* --- Quick Action Boxes --- *@
    <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(250px, 1fr));gap:15px;margin-bottom:20px">
        <div class="routing-card border-navy" style="cursor:pointer" @onclick='() => Nav.NavigateTo("/migration/backlog")'>
            <div style="font-size:24px;color:var(--navy);margin-bottom:8px"><i class="bi bi-file-earmark-spreadsheet"></i></div>
            <div style="font-weight:700">ฟอร์มนำเข้า Backlog</div>
            <div style="font-size:12px;color:var(--text-muted)">อัปโหลดไฟล์ Excel/CSV อัตโนมัติ</div>
        </div>
        <div class="routing-card border-orange" style="cursor:pointer" @onclick='() => Nav.NavigateTo("/migration/validation")'>
            <div style="font-size:24px;color:var(--orange);margin-bottom:8px"><i class="bi bi-shield-check"></i></div>
            <div style="font-weight:700">ตรวจสอบความซ้ำซ้อน</div>
            <div style="font-size:12px;color:var(--text-muted)">สแกนเลขที่ซ้ำหรือไฟล์บกพร่อง</div>
        </div>
        <div class="routing-card border-green" style="cursor:pointer" @onclick='() => Nav.NavigateTo("/migration/documents")'>
            <div style="font-size:24px;color:var(--green);margin-bottom:8px"><i class="bi bi-files"></i></div>
            <div style="font-weight:700">แตกไฟล์เอกสาร (File Split)</div>
            <div style="font-size:12px;color:var(--text-muted)">จัดการเอกสาร PDF จำนวนหลายพันแผ่น</div>
        </div>
    </div>

    @* --- Live Processing Board --- *@
    <div class="detail-card mb-4">
        <div class="detail-card-title">
             <i class="bi bi-diagram-3-fill"></i> งานโอนย้ายข้อมูลที่กำลังทำงาน (Active Migration Jobs)
        </div>
        
        <div style="display:flex;flex-direction:column;gap:15px">
            @foreach(var job in MigrationData.ActiveJobs)
            {
                var progress = MigrationData.GetProgressPercentage(job);
                <div style="border:1px solid var(--border-color);border-radius:8px;padding:15px;background:#f8fafc">
                    <div style="display:flex;justify-content:space-between;margin-bottom:8px">
                        <div>
                            <span style="font-weight:700;color:var(--navy-deep);margin-right:10px">@job.JobId</span>
                            <span style="font-size:14px">ระบบต้นทาง: @job.SourceSystem</span>
                        </div>
                        <div>
                            @if(job.Status == "running")
                            {
                                <span class="complaints-status-chip urgent"><i class="bi bi-arrow-repeat" style="animation: spin 1s linear infinite;"></i> กำลังประมวลผล</span>
                            }
                            else if (job.Status == "completed")
                            {
                                <span class="complaints-status-chip closed">เสร็จสมบูรณ์</span>
                            }
                            else
                            {
                                <span class="complaints-status-chip gray">รอดำเนินการ</span>
                            }
                        </div>
                    </div>

                    <div style="display:flex;align-items:center;gap:15px;margin-bottom:5px">
                        <div style="flex:1;background:#e2e8f0;height:12px;border-radius:6px;overflow:hidden">
                            <div style="background:@(job.Status == "completed" ? "var(--green)" : "var(--navy)");height:100%;width:@progress%;transition:width 1s"></div>
                        </div>
                        <div style="font-size:14px;font-weight:700;width:50px;text-align:right">@progress%</div>
                    </div>
                    
                    <div style="display:flex;justify-content:space-between;font-size:12px;color:var(--text-muted)">
                        <div>ประมวลผลแล้ว: <strong>@job.ProcessedRecords.ToString("N0")</strong> / @job.TotalRecords.ToString("N0") รายการ @(job.ErrorRecords > 0 ? $"(พบข้อผิดพลาด {job.ErrorRecords} รายการ)" : "")</div>
                        <div>@(job.Status == "running" ? $"เหลือเวลาประเมิน: {job.ETA}" : "")</div>
                    </div>
                </div>
            }
        </div>
        
        <style>
            @@keyframes spin {
                100% { transform: rotate(360deg); }
            }
        </style>
    </div>
</div>
