@page "/migration/documents"
@inject NavigationManager Nav

<div class="routing-page-wrap">
    <div class="complaints-page-header">
        <div>
            <div class="complaints-title">
                <i class="bi bi-file-earmark-pdf-fill" style="color:var(--red)"></i>
                <span>เครื่องมือบริหารจัดการไฟล์เอกสารขนาดใหญ่ (Document Splitting Tool)</span>
            </div>
            <div class="complaints-subtitle">
                เครื่องมือบีบอัดและแบ่งหน้าไฟล์ PDF สำหรับสำนวนอภิมหาโปรเจกต์ (ป้องกินการแครชของ Server ตามข้อกำหนด)
            </div>
        </div>
        <div class="complaints-actions">
             <button class="btn-outline-navy" @onclick='() => Nav.NavigateTo("/migration")'>
                <i class="bi bi-arrow-left"></i> กลับไป Dashboard
            </button>
        </div>
    </div>

    <div class="row">
        @* --- Config --- *@
        <div class="col-md-5 mb-4">
            <div class="detail-card h-100 mb-0">
                <div class="detail-card-title"><i class="bi bi-gear-fill"></i> ตั้งค่าการแยกไฟล์ (Splitting Criteria)</div>
                <div style="background:#f8fafc;padding:15px;border-radius:8px;border:1px solid #e2e8f0;margin-bottom:15px">
                    <label class="form-label-custom">เลือกสำนวนที่ต้องการจัดการไฟล์</label>
                    <select class="form-select-custom mb-3">
                        <option>สน.0101/2560 (ไฟล์สแกนหลักฐานรวม 4,500 หน้า)</option>
                        <option>สน.0522/2558 (ไฟล์สแกนคำให้การรวม 2,100 หน้า)</option>
                    </select>

                    <label class="form-label-custom">จำนวนหน้าสูงสุดต่อ 1 ก้อนไฟล์ย่อย (Chunks)</label>
                    <select class="form-select-custom mb-2">
                        <option>200 หน้า (แนะนำ - เหมาะสมเครือข่าย)</option>
                        <option>300 หน้า</option>
                        <option>500 หน้า (ลดจำนวนไฟล์ แต่โหลดนานขึ้น)</option>
                    </select>
                </div>
                
                <button class="btn-navy" style="width:100%;height:40px"><i class="bi bi-magic" style="margin-right:5px"></i> เริ่มกระบวนการตัดแบ่งไฟล์ (Split!)</button>
            </div>
        </div>

        @* --- Output Monitor --- *@
        <div class="col-md-7 mb-4">
            <div class="detail-card h-100 mb-0">
                <div class="detail-card-title"><i class="bi bi-journal-check"></i> ผลลัพธ์จากการแบ่งไฟล์</div>
                <div style="background:#f0fdf4;border-left:4px solid var(--green);padding:15px;border-radius:0 8px 8px 0;margin-bottom:20px">
                    <div style="font-weight:700;color:var(--green)">สำเร็จ: สน.0101/2560_Full.pdf ย้ายเสร็จสิ้น</div>
                    <div style="font-size:13px;color:var(--text-muted)">
                         ไฟล์ต้นฉบับ 4,500 หน้า ถูกแบ่งออกเป็น 23 ไฟล์ย่อย ข้อมูลดัชนีถูกเขียนลงฐานอ้างอิงของ E-CMIS เรียบร้อยระบบพร้อมทำงาน
                    </div>
                </div>

                <div style="font-weight:700;margin-bottom:10px;font-size:13px">ดัชนีไฟล์ย่อย (Sub-Files Index)</div>
                <div style="max-height:220px;overflow-y:auto;border:1px solid #cbd5e1;border-radius:6px;background:#fff">
                    <table class="table table-sm m-0" style="font-size:12px">
                        <thead style="position:sticky;top:0;background:#f8fafc">
                            <tr>
                                <th>ชื่อไฟล์ย่อย</th>
                                <th>รายการหน้า</th>
                                <th>ขนาดไฟล์</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for(int i=1; i<=5; i++)
                            {
                                <tr>
                                    <td><i class="bi bi-file-pdf" style="color:var(--red)"></i> สน.0101/2560_Part@(i).pdf</td>
                                    <td>หน้า @(((i-1)*200)+1) - @(i*200)</td>
                                    <td>24.5 MB</td>
                                </tr>
                            }
                            <tr>
                                <td colspan="3" style="text-align:center;color:#aaa">... และอีก 18 ไฟล์ ...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

            </div>
        </div>
    </div>
</div>
