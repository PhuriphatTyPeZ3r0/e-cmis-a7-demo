@page "/migration/backlog"
@inject NavigationManager Nav

<div class="routing-page-wrap">
    <div class="complaints-page-header">
        <div>
            <div class="complaints-title">
                <i class="bi bi-file-earmark-excel" style="color:var(--green)"></i>
                <span>นำเข้าข้อมูล Backlog ช่วงวิกฤต</span>
            </div>
            <div class="complaints-subtitle">
                อัปโหลดไฟล์ Google Sheets / CSV และสั่งให้ระบบรันเลข Running Number ของสำนวนต่อเนื่องอัตโนมัติ
            </div>
        </div>
        <div class="complaints-actions">
             <button class="btn-outline-navy" @onclick='() => Nav.NavigateTo("/migration")'>
                <i class="bi bi-arrow-left"></i> กลับไป Dashboard
            </button>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="detail-card h-100 mb-0">
                <div class="detail-card-title"><i class="bi bi-cloud-arrow-up"></i> กล่องข้อกำหนดการอัปโหลดไฟล์</div>
                <div style="background:#f8fafc;border:2px dashed #cbd5e1;border-radius:8px;padding:40px 20px;text-align:center;margin-bottom:20px">
                    <i class="bi bi-file-earmark-spreadsheet" style="font-size:48px;color:var(--green)"></i>
                    <div style="font-weight:700;margin-top:10px">ลากและวางไฟล์ .csv หรือ .xlsx ที่นี่</div>
                    <div style="font-size:12px;color:var(--text-muted);margin-top:5px">เฉพาะไฟล์ข้อมูล Backlog ระหว่างวันที่ 19 ธ.ค. - 19 ก.พ. เท่านั้น</div>
                    <button class="btn-outline-navy mt-3">เลือกไฟล์จากเครื่อง</button>
                </div>
                
                <div style="font-size:13px;color:var(--text-muted)">
                    <i class="bi bi-info-circle"></i> การอัปโหลดล้มเหลวหากไม่มีคอลัมน์ภาคบังคับ: ชื่อผู้ถูกกล่าวหา, ข้อหา, วันที่เกิดเหตุ
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="detail-card h-100 mb-0">
                <div class="detail-card-title"><i class="bi bi-magic"></i> การรันเลขสำนวนอัตโนมัติ (Auto Running Number)</div>
                <p style="font-size:14px">ระบบตรวจพบว่าเลขสำนวนล่าสุดก่อนระบบล่มคือ: <strong style="color:var(--navy);font-size:16px">สน.0520/2566</strong></p>
                <div style="background:#fff9e6;border-left:4px solid var(--orange);padding:15px;border-radius:4px;margin-bottom:20px">
                    <div style="font-weight:700;color:#b45309;margin-bottom:5px">คำเตือนการออกหมายเลขใหม่</div>
                    <div style="font-size:13px;color:#b45309">
                        เมื่อเปิดทำงานโหมด Auto Running ระบบจะหยิบรายการทั้งหมดในไฟล์ Spreadsheet แจ้งรหัสเรียงกันไปตั้งแต่ "สน.0521/2566" เป็นต้นไป 
                        <strong>โปรดมั่นใจว่าไฟล์ถูกจัดเรียงตามวันที่/เวลาที่เรื่องเข้าอย่างถูกต้องแล้ว</strong>
                    </div>
                </div>

                <div style="display:flex;align-items:center;gap:15px">
                    <button class="btn-navy" style="flex:1" disabled><i class="bi bi-play-circle-fill"></i> เตรียมพร้อมและเริ่มบันทึกฐานข้อมูล</button>
                    <div style="font-size:12px;color:var(--text-muted)">(ปุ่มจะใช้งานได้เมื่ออัปโหลดไฟล์เสร็จสิ้น)</div>
                </div>
            </div>
        </div>
    </div>
</div>
