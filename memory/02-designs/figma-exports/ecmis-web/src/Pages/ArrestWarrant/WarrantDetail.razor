@page "/arrest-warrant/{Id:int}"
@using EcmisWeb.Data
@inject NavigationManager Nav

@if (w is null)
{
    <div class="detail-page-wrap" style="text-align:center;padding:60px">
        <i class="bi bi-file-earmark-x" style="font-size:48px;color:var(--orange)"></i>
        <div style="font-size:18px;font-weight:700;margin-top:12px">ไม่พบข้อมูลหมายจับ</div>
        <button class="btn-navy" style="margin-top:16px" @onclick='() => Nav.NavigateTo("/arrest-warrant")'>กลับ</button>
    </div>
}
else
{
    var daysLeft = WarrantData.DaysUntilExpiry(w.ExpiryDate);
    var isCritical = w.Status == "active" && daysLeft <= 365;

    <div class="detail-page-wrap">
        @* — Header — *@
        <div class="detail-header">
            <div>
                <div class="detail-caseno">
                    <i class="bi bi-file-earmark-person-fill" style="color:var(--navy-mid)"></i>
                    ข้อมูลหมายจับเลขที่: @w.WarrantNo
                </div>
                <div class="detail-meta-row mt-2">
                    <span class="category-chip cat-discipline">
                        เขตพื้นที่: @w.Region
                    </span>
                    <span style="font-size:12px;color:var(--text-muted)">
                        <i class="bi bi-person-fill"></i> ผู้ถูกออกหมายจับ: @w.SuspectName
                    </span>
                    <span style="font-size:12px;color:var(--text-muted)">
                        <i class="bi bi-link-45deg"></i> อ้างอิงคดี: @w.LinkedCaseNo
                    </span>
                </div>
            </div>
            <div class="detail-actions">
                <button class="btn-outline-navy" @onclick='() => Nav.NavigateTo("/arrest-warrant")'>
                    <i class="bi bi-arrow-left"></i> กลับตารางรายการ
                </button>
            </div>
        </div>

        <div class="detail-grid" style="grid-template-columns: 2fr 1fr">
            
            @* — Left Column: Warrant Info & Verification — *@
            <div style="display:flex;flex-direction:column;gap:14px">
                
                @* Warrant Core info *@
                <div class="detail-card mb-0">
                    <div class="detail-card-title">
                        <div class="icon-box @(w.Status == "active" ? (isCritical ? "orange" : "navy") : "green")">
                            <i class="bi bi-fingerprint"></i>
                        </div>
                        รายละเอียดหมายจับ
                    </div>
                    
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:14px">
                        <div>
                            <div style="font-size:11px;color:var(--text-muted)">ข้อหาแพ่ง/อาญา</div>
                            <div style="font-size:14px;font-weight:600">@w.Charge</div>
                        </div>
                        <div>
                            <div style="font-size:11px;color:var(--text-muted)">สถานะปัจจุบัน</div>
                            <div>
                                <span class="complaints-status-chip @WarrantData.StatusClass(w.Status)">
                                    @WarrantData.StatusLabel(w.Status)
                                </span>
                            </div>
                        </div>
                        <div>
                            <div style="font-size:11px;color:var(--text-muted)">วันที่ออกหมาย</div>
                            <div style="font-size:14px">@w.IssueDate</div>
                        </div>
                        <div>
                            <div style="font-size:11px;color:var(--text-muted)">วันที่หมดอายุความ</div>
                            <div style="font-size:14px">@w.ExpiryDate</div>
                        </div>
                    </div>

                    @* Statute of limitations progress bar *@
                    @if(w.Status == "active")
                    {
                        <div style="background:@(isCritical ? "#fff5f5" : "#f8f9fa");border:@(isCritical ? "1px solid #ffcccc" : "1px solid #eee");padding:12px;border-radius:10px">
                            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
                                <span style="font-size:13px;font-weight:700;color:@(isCritical ? "var(--red)" : "var(--navy-deep)")">
                                    <i class="bi bi-hourglass-split"></i> อายุความหมายจับ (Statute of Limitations)
                                </span>
                                <span style="font-size:12px;color:var(--text-muted)">
                                    เหลือเวลาอีก <strong style="color:@(isCritical ? "var(--red)" : "var(--blue)")">@daysLeft วัน</strong>
                                </span>
                            </div>
                            <div class="sla-bar" style="height:12px;border-radius:6px;background:#e9ecef">
                                @{
                                    DateTime issueDate;
                                    DateTime expiryDate;
                                    double percentLeft = 0;
                                    if(DateTime.TryParse(w.IssueDate, out issueDate) && DateTime.TryParse(w.ExpiryDate, out expiryDate))
                                    {
                                        var totalLife = (expiryDate - issueDate).TotalDays;
                                        if(totalLife > 0)
                                        {
                                            percentLeft = Math.Min(100, Math.Max(0, (daysLeft / totalLife) * 100));
                                        }
                                    }
                                    var fillClass = isCritical ? "background:var(--red)" : "background:var(--blue)";
                                }
                                <div style="width:@percentLeft%;height:100%;border-radius:6px;@fillClass;transition:width 1s ease-in-out"></div>
                            </div>
                            @if(isCritical)
                            {
                                <div style="font-size:11px;color:var(--red);margin-top:6px;font-weight:600">
                                    <i class="bi bi-exclamation-triangle-fill"></i> โปรดเร่งรัดติดตามการจับกุมโดยด่วน หมายจับใกล้ระงับผล!
                                </div>
                            }
                        </div>
                    }

                </div>

                @* Verification Flow by กบค. *@
                <div class="detail-card mb-0">
                    <div class="detail-card-title">
                        <div class="icon-box @(w.VerificationStatus == "approved" ? "green" : (w.VerificationStatus == "pending_verify" ? "orange" : "danger"))">
                            <i class="bi bi-shield-check"></i>
                        </div>
                        กระบวนการตรวจสอบข้อมูลโดย กองบริหารคดี (ส่วนกลาง)
                    </div>

                    @if(w.VerificationStatus == "pending_verify")
                    {
                        <div style="background:#fff9e6;padding:12px;border-radius:8px;border:1px solid #ffeeba;margin-bottom:14px">
                            <div style="font-size:13px;font-weight:700;color:#856404;margin-bottom:4px">
                                รอตรวบสอบความถูกต้อง (Pending Verification)
                            </div>
                            <div style="font-size:12px;color:#856404">เขตพื้นที่ได้นำเข้าข้อมูลหมายจับฉบับนี้เข้าสู่ระบบ กรุณาตรวจสอบข้อมูลกับฐานข้อมูลศาลและกดอนุมัติ</div>
                        </div>

                        <div style="display:flex;gap:10px">
                            <button class="btn-navy" style="flex:1;background:var(--green);border:none" @onclick="ApproveWarrant">
                                <i class="bi bi-check-circle-fill"></i> ยืนยันข้อมูลถูกต้อง (Approve)
                            </button>
                            <button class="btn-outline-navy" style="flex:1;color:var(--red);border-color:var(--red)" @onclick="() => showRejectModal = true">
                                <i class="bi bi-x-circle-fill"></i> ตีกลับให้เขตแก้ไข (Reject)
                            </button>
                        </div>
                    }
                    else if (w.VerificationStatus == "approved")
                    {
                        <div style="display:flex;align-items:center;gap:10px;color:var(--green);font-weight:700">
                            <i class="bi bi-check-circle-fill" style="font-size:24px"></i> ข้อมูลหมายจับผ่านการตรวจสอบเรียบร้อยแล้ว
                        </div>
                    }
                    else if (w.VerificationStatus == "rejected")
                    {
                        <div style="display:flex;align-items:center;gap:10px;color:var(--red);font-weight:700">
                            <i class="bi bi-x-circle-fill" style="font-size:24px"></i> ถูกตีกลับให้พื้นที่แก้ไข (รอการส่งกลับมาใหม่)
                        </div>
                    }
                </div>

            </div>

            @* — Right Column: API Integration Mockup — *@
            <div style="display:flex;flex-direction:column;gap:14px">
                <div class="detail-card mb-0" style="background:#0f172a;color:#fff;border:none">
                    <div class="detail-card-title border-bottom-0 pb-0" style="justify-content:center">
                        <i class="bi bi-arrow-repeat" style="font-size:24px;color:#38bdf8;margin-bottom:8px;display:block;text-align:center"></i>
                    </div>
                    <div style="text-align:center;font-size:14px;font-weight:700;color:#38bdf8;margin-bottom:14px">
                        MOU: National Police DB
                    </div>
                    
                    <div style="font-size:12px;color:#94a3b8;line-height:1.5;margin-bottom:16px;text-align:center">
                        ระบบจำลองการซิงค์ข้อมูลกับสำนักงานตำรวจแห่งชาติ (RTP) แบบ Real-time เพื่ออัปเดตสถานะการจับกุม
                    </div>

                    @if(isSyncing)
                    {
                        <div style="text-align:center;padding:20px 0">
                            <div class="spinner-border text-info" role="status" style="width: 2rem; height: 2rem;"></div>
                            <div style="font-size:12px;margin-top:10px;color:#38bdf8">กำลังดึงข้อมูล...</div>
                        </div>
                    }
                    else
                    {
                        <button class="btn btn-outline-light" style="width:100%;border-color:#38bdf8;color:#38bdf8" disabled="@(w.Status == "closed")" @onclick="SyncWithPoliceAPI">
                            <i class="bi bi-cloud-download"></i> อัปเดตสถานะจับกุม (Sync)
                        </button>
                    }

                    @if(syncSuccess)
                    {
                        <div style="margin-top:16px;padding:10px;background:rgba(16, 185, 129, 0.2);border:1px solid #10b981;border-radius:6px;font-size:12px;text-align:center;color:#34d399">
                            <i class="bi bi-check-circle"></i> ซิงค์สำเร็จ! ผู้ต้องหาถูกจับกุมแล้ว (อัปเดตสถานะเป็น Closed อัตโนมัติ)
                        </div>
                    }
                </div>
            </div>

        </div>
    </div>
}

@if(showRejectModal)
{
    <div style="position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.5);display:flex;justify-content:center;align-items:center;z-index:999">
        <div style="background:#fff;padding:24px;border-radius:12px;width:100%;max-width:400px">
            <h5 style="margin-top:0;margin-bottom:16px;color:var(--red)"><i class="bi bi-exclamation-triangle-fill"></i> ระบุเหตุผลการตีกลับ</h5>
            <textarea class="form-control-custom mb-3" rows="3" placeholder="ระบุเหตุผลที่ให้เขตพื้นที่แก้ไขข้อมูล (เช่น เลขประจำตัว ปชช. ไม่ตรงกัับหมายศาล)"></textarea>
            <div style="display:flex;gap:10px;justify-content:flex-end">
                <button class="btn-outline-navy" @onclick="() => showRejectModal = false">ยกเลิก</button>
                <button class="btn-navy" style="background:var(--red);border:none" @onclick="RejectWarrant">ยืนยันตีกลับ</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    
    private WarrantRecord? w;
    private bool showRejectModal = false;
    private bool isSyncing = false;
    private bool syncSuccess = false;

    protected override void OnParametersSet()
    {
        w = WarrantData.GetById(Id);
    }

    private void ApproveWarrant()
    {
        if(w != null)
        {
            w = w with { VerificationStatus = "approved" };
        }
    }

    private void RejectWarrant()
    {
        if(w != null)
        {
            w = w with { VerificationStatus = "rejected" };
            showRejectModal = false;
        }
    }

    private async Task SyncWithPoliceAPI()
    {
        isSyncing = true;
        // Mock network delay 2.5s
        await Task.Delay(2500);
        isSyncing = false;
        syncSuccess = true;
        if(w != null)
        {
            w = w with { Status = "closed" };
        }
    }
}
