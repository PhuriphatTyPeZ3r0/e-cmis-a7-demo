@using law_page.Components.Shared
@using law_page.Components.Pages
@{
    ViewData["Title"] = "งานกฎหมายในทางคดี";
}

@* All views are rendered together in one page (SPA pattern).
   app.js switchView() toggles the CSS class "active-view" to show/hide each view. *@

<component type="typeof(MudBlazor.MudThemeProvider)" render-mode="ServerPrerendered" />
<component type="typeof(MudBlazor.MudPopoverProvider)" render-mode="ServerPrerendered" />
<component type="typeof(MudBlazor.MudDialogProvider)" render-mode="ServerPrerendered" />
<component type="typeof(MudBlazor.MudSnackbarProvider)" render-mode="ServerPrerendered" />

<component type="typeof(EcmisCaseRegistryView)" render-mode="ServerPrerendered" />
<component type="typeof(EcmisDisclosureView)" render-mode="ServerPrerendered" />
<component type="typeof(EcmisAdminCasesView)" render-mode="ServerPrerendered" />
<component type="typeof(EcmisDashboardView)" render-mode="ServerPrerendered" />
<component type="typeof(EcmisPocView)" render-mode="ServerPrerendered" />
<component type="typeof(ComponentDemo)" render-mode="ServerPrerendered" />

<div id="view-coming-soon" class="app-view p-5 text-center" style="margin-top: 100px;">
    <h3 class="fw-bold text-primary mb-3">
        <i class="bi bi-tools text-warning me-2"></i> กำลังพัฒนา (Coming Soon)
    </h3>
    <p class="text-muted" id="coming-soon-text">อยู่ระหว่างการออกแบบและพัฒนาฟีเจอร์นี้</p>
</div>
