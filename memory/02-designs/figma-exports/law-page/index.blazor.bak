    function searchAndShowCaseFromSource(sourceId) {
        const normalized = sourceId.replace(/\s/g, '').toLowerCase();
        const found = DB_CASES_101.find(c => c.id.replace(/\s/g, '').toLowerCase() === normalized);
        if (found) {
            selectAndShowCaseDetail(found.id);
        } else {
            alert(`ไม่พบเลขสำนวนต้นเรื่อง ${sourceId} ในฐานระบบสารบบปัจจุบัน`);
        }
    }

    // ==============================================
    // 6. DASHBOARD & CHARTS (CHART.JS INTEGRATION)
    // ==============================================
    function renderDashboardStatsAndCharts() {
        document.getElementById('db-stat-101').innerText = DB_CASES_101.length;
        document.getElementById('db-stat-102').innerText = DB_REQUESTS_102.length + DB_APPEALS_102.length;
        document.getElementById('db-stat-103').innerText = DB_ADMIN_CASES_103.length;
        
        const wins = DB_ADMIN_CASES_103.filter(a => a.result === 'ชนะคดี').length;
        const losses = DB_ADMIN_CASES_103.filter(a => a.result === 'แพ้คดี').length;
        const totalClosed = wins + losses;
        const rate = totalClosed > 0 ? ((wins / totalClosed) * 100).toFixed(1) : '100.0';
        document.getElementById('db-win-rate').innerText = `${rate}%`;

        for (let key in dashboardCharts) {
            if (dashboardCharts[key]) dashboardCharts[key].destroy();
        }

        const ctx1 = document.getElementById('chart-cases-type').getContext('2d');
        const typeCounts = { 'ไม่ฟ้อง': 0, 'ถอนฟ้อง': 0, 'ไม่อุทธรณ์': 0, 'ไม่ฎีกา': 0 };
        DB_CASES_101.forEach(c => {
            if (typeCounts[c.type] !== undefined) typeCounts[c.type]++;
        });

        dashboardCharts.chart1 = new Chart(ctx1, {
            type: 'doughnut',
            data: {
                labels: Object.keys(typeCounts),
                datasets: [{
                    data: Object.values(typeCounts),
                    backgroundColor: ['#0D1B3E', '#D5B45B', '#0E7C7B', '#C0392B'],
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom', labels: { boxWidth: 12, font: { family: 'Sarabun', size: 11 } } }
                }
            }
        });

        const ctx2 = document.getElementById('chart-requests-monthly').getContext('2d');
        dashboardCharts.chart2 = new Chart(ctx2, {
            type: 'bar',
            data: {
                labels: ['ม.ค.', 'ก.พ.', 'มี.ค.', 'เม.ย.', 'พ.ค.', 'มิ.ย.'],
                datasets: [
                    {
                        label: 'คำร้องขอข้อมูล',
                        data: [12, 19, 14, 15, 18, 8],
                        backgroundColor: '#1A2F6B'
                    },
                    {
                        label: 'คำอุทธรณ์',
                        data: [2, 4, 1, 3, 2, 2],
                        backgroundColor: '#D5B45B'
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: { beginAtZero: true, grid: { color: '#E3E9F4' } },
                    x: { grid: { display: false } }
                },
                plugins: {
                    legend: { position: 'bottom', labels: { boxWidth: 12, font: { family: 'Sarabun', size: 11 } } }
                }
            }
        });

        const ctx3 = document.getElementById('chart-admin-results').getContext('2d');
        dashboardCharts.chart3 = new Chart(ctx3, {
            type: 'pie',
            data: {
                labels: ['ชนะคดี', 'แพ้คดี', 'จำหน่ายคดี', 'อยู่ระหว่างศาล'],
                datasets: [{
                    data: [wins, losses, DB_ADMIN_CASES_103.filter(a => a.result === 'จำหน่ายคดี').length, DB_ADMIN_CASES_103.filter(a => a.result === '—').length],
                    backgroundColor: ['#1B7A4A', '#C0392B', '#6B7A99', '#D5B45B']
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom', labels: { boxWidth: 12, font: { family: 'Sarabun', size: 11 } } }
                }
            }
        });
    }

    // ==============================================
    // 7. COMPLIANCE & AUDIT LOG TRANSACTION RECORDER
    // ==============================================
    function logAuditEvent(actionType, description) {
        const now = new Date();
        const randHash = Array.from({length: 32}, () => Math.floor(Math.random()*16).toString(16)).join('');
        
        const log = {
            timestamp: now.toLocaleString('th-TH'),
            user: 'thanthita (นิติกร)',
            action: actionType,
            details: description,
            ip: '10.230.12.109',
            hash: randHash
        };

        DB_AUDIT_LOGS.unshift(log);
        if (DB_AUDIT_LOGS.length > 1000) DB_AUDIT_LOGS.pop();
        localStorage.setItem('ecmis_audit_logs', JSON.stringify(DB_AUDIT_LOGS));
    }

    function openAuditLogModal() {
        const body = document.getElementById('audit-log-results-body');
        if (!body) return;
        body.innerHTML = '';

        if (DB_AUDIT_LOGS.length === 0) {
            body.innerHTML = '<tr><td colspan="6" class="text-center text-muted">ไม่พบข้อมูลบันทึกเหตุการณ์ความปลอดภัยในฐานข้อมูล</td></tr>';
        } else {
            DB_AUDIT_LOGS.forEach(log => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td>${log.timestamp}</td>
                    <td class="fw-bold">${log.user}</td>
                    <td><span class="badge bg-secondary">${log.action}</span></td>
                    <td>${log.details}</td>
                    <td class="font-monospace">${log.ip}</td>
                    <td><small class="font-monospace text-muted" title="${log.hash}">${log.hash.substring(0, 16)}...</small></td>
                `;
                body.appendChild(tr);
            });
        }

        const myModal = new bootstrap.Modal(document.getElementById('auditLogModal'));
        myModal.show();
    }

    function triggerManualAuditLog() {
        logAuditEvent('COMPLIANCE_CHECK', `ผู้ใช้ตรวจสอบความครบถ้วนของข้อมูลสำนวนคดี ${currentSelectedCase ? currentSelectedCase.id : ''}`);
        openAuditLogModal();
    }

    function clearAuditLogDatabase() {
        DB_AUDIT_LOGS = [];
        localStorage.setItem('ecmis_audit_logs', JSON.stringify([]));
        alert("ล้างประวัติการบันทึก Audit Logs เรียบร้อยแล้ว!");
        openAuditLogModal();
    }

    // ==============================================
    // 8. DATA INTEGRATION - PULL DATA POPUPS
    // ==============================================
    function openActivity5SelectorFor101() {
        integrationTargetInputIdMap = {
            no: 'form-101-no',
            accused: 'form-101-accused',
            black: 'form-101-black',
            red: 'form-101-red',
            court: 'form-101-court'
        };
        showActivity5Modal();
    }

    function openActivity5SelectorFor103() {
        integrationTargetInputIdMap = {
            black: 'form-103-black',
            red: 'form-103-red',
            plaintiff: 'form-103-plaintiff',
            source: 'form-103-source',
            court: 'form-103-court'
        };
        showActivity5Modal();
    }

    function showActivity5Modal() {
        const body = document.getElementById('activity5-results-body');
        if (!body) return;
        body.innerHTML = '';

        MOCK_ACTIVITY_5.forEach(rec => {
            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td><b>${rec.caseNo}</b></td>
                <td>${rec.accused}</td>
                <td>${rec.charge}</td>
                <td>${rec.office}</td>
                <td><button class="btn btn-sm btn-grad-gold py-0" onclick="confirmActivity5Pull('${rec.caseNo}')">ดึงข้อมูล</button></td>
            `;
            body.appendChild(tr);
        });

        const newCaseModal = bootstrap.Modal.getInstance(document.getElementById('newCaseModal'));
        const newAdminModal = bootstrap.Modal.getInstance(document.getElementById('newAdminCaseModal'));
        if (newCaseModal) newCaseModal.hide();
        if (newAdminModal) newAdminModal.hide();

        const act5Modal = new bootstrap.Modal(document.getElementById('activity5Modal'));
        act5Modal.show();
    }

    function confirmActivity5Pull(caseNo) {
        const rec = MOCK_ACTIVITY_5.find(r => r.caseNo === caseNo);
        if (rec) {
            if (integrationTargetInputIdMap.no) {
                document.getElementById(integrationTargetInputIdMap.no).value = rec.caseNo.replace('ปปท.ส.', 'ปปท.');
                document.getElementById(integrationTargetInputIdMap.accused).value = rec.accused;
                document.getElementById(integrationTargetInputIdMap.black).value = rec.blackId;
                document.getElementById(integrationTargetInputIdMap.red).value = rec.redId;
                document.getElementById(integrationTargetInputIdMap.court).value = rec.office;
            } else if (integrationTargetInputIdMap.source) {
                document.getElementById(integrationTargetInputIdMap.black).value = rec.blackId.replace('อท', 'บ');
                document.getElementById(integrationTargetInputIdMap.red).value = rec.redId;
                document.getElementById(integrationTargetInputIdMap.plaintiff).value = rec.accused;
                document.getElementById(integrationTargetInputIdMap.source).value = rec.caseNo.replace('ปปท.ส.', 'ปปท.');
                document.getElementById(integrationTargetInputIdMap.court).value = 'ศาลปกครองกลาง';
            }

            logAuditEvent('INTEGRATION_SYNC', `ดึงเชื่อมข้อมูลสำเร็จจากระบบไต่สวน (Activity 5): เลขสำนวน ${rec.caseNo}`);
            
            bootstrap.Modal.getInstance(document.getElementById('activity5Modal')).hide();
            
            if (integrationTargetInputIdMap.no) {
                new bootstrap.Modal(document.getElementById('newCaseModal')).show();
            } else {
                new bootstrap.Modal(document.getElementById('newAdminCaseModal')).show();
            }
        }
    }

    function searchActivity5Records() {
        const query = document.getElementById('search-activity5-input').value.toLowerCase().trim();
        const body = document.getElementById('activity5-results-body');
        if (!body) return;
        body.innerHTML = '';

        const filtered = MOCK_ACTIVITY_5.filter(rec => 
            rec.caseNo.toLowerCase().includes(query) || 
            rec.accused.toLowerCase().includes(query) || 
            rec.charge.toLowerCase().includes(query)
        );

        if (filtered.length === 0) {
            body.innerHTML = `<tr><td colspan="5" class="text-center text-muted">ไม่พบข้อมูลที่ค้นหา</td></tr>`;
            return;
        }

        filtered.forEach(rec => {
            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td><b>${rec.caseNo}</b></td>
                <td>${rec.accused}</td>
                <td>${rec.charge}</td>
                <td>${rec.office}</td>
                <td><button class="btn btn-sm btn-grad-gold py-0" onclick="confirmActivity5Pull('${rec.caseNo}')">ดึงข้อมูล</button></td>
            `;
            body.appendChild(tr);
        });
    }

    // ==============================================
    // 9. DIGITAL SIGNATURE WRITING PAD & SIMULATION
    // ==============================================
    function setupSignaturePad() {
        const canvas = document.getElementById('signature-pad-canvas');
        if (!canvas) return;

        signatureCtx = canvas.getContext('2d');
        
        canvas.width = canvas.parentElement.clientWidth;
        canvas.height = canvas.parentElement.clientHeight;

        canvas.addEventListener('mousedown', startDrawing);
        canvas.addEventListener('mousemove', draw);
        canvas.addEventListener('mouseup', stopDrawing);
        canvas.addEventListener('mouseout', stopDrawing);

        canvas.addEventListener('touchstart', (e) => {
            const touch = e.touches[0];
            startDrawing({ clientX: touch.clientX, clientY: touch.clientY });
        });
        canvas.addEventListener('touchmove', (e) => {
            e.preventDefault();
            const touch = e.touches[0];
            draw({ clientX: touch.clientX, clientY: touch.clientY });
        });
        canvas.addEventListener('touchend', stopDrawing);
    }

    function startDrawing(e) {
        signatureDrawing = true;
        const rect = document.getElementById('signature-pad-canvas').getBoundingClientRect();
        signatureCtx.beginPath();
        signatureCtx.moveTo(e.clientX - rect.left, e.clientY - rect.top);
    }

    function draw(e) {
        if (!signatureDrawing) return;
        const rect = document.getElementById('signature-pad-canvas').getBoundingClientRect();
        signatureCtx.lineWidth = 2.5;
        signatureCtx.lineCap = 'round';
        signatureCtx.strokeStyle = 'var(--primary-dark)';
        signatureCtx.lineTo(e.clientX - rect.left, e.clientY - rect.top);
        signatureCtx.stroke();
    }

    function stopDrawing() {
        signatureDrawing = false;
    }

    function clearSignatureCanvas() {
        const canvas = document.getElementById('signature-pad-canvas');
        signatureCtx.clearRect(0, 0, canvas.width, canvas.height);
    }

    function openSignatureModal(signerIndex) {
        pendingSignerIndex = signerIndex;
        const c = currentSelectedCase;
        const signer = c.signatures[signerIndex];

        document.getElementById('sig-modal-signer-name').innerText = signer.name;
        document.getElementById('sig-modal-signer-role').innerText = signer.role;
        document.getElementById('sig-modal-pin').value = '123456';
        
        setTimeout(setupSignaturePad, 200);

        const modal = new bootstrap.Modal(document.getElementById('signatureModal'));
        modal.show();
    }

    function confirmDigitalSignature() {
        const pin = document.getElementById('sig-modal-pin').value;
        if (pin.length < 6) {
            alert("กรุณากรอกรหัส PIN 6 หลักเพื่อยืนยันตัวตนด้วยใบรับรองดิจิทัล!");
            return;
        }

        const c = currentSelectedCase;
        const sig = c.signatures[pendingSignerIndex];
        
        const randHash = Array.from({length: 32}, () => Math.floor(Math.random()*16).toString(16)).join('');
        const now = new Date();

        sig.status = 'signed';
        sig.date = `${now.toLocaleDateString('th-TH')} ${now.toLocaleTimeString('th-TH', {hour: '2-digit', minute:'2-digit'})}`;
        sig.hash = randHash;

        if (pendingSignerIndex === 2) {
            c.step = 5;
            c.status = 'รอมติบอร์ด ป.ป.ท.';
            c.timeline.push({
                date: now.toLocaleDateString('th-TH'),
                desc: 'เสนอความเห็นของ ผอ.กองกฎหมาย เข้าสู่วาระการประชุมคณะกรรมการ ป.ป.ท. ชี้ขาด'
            });
        }

        saveDatabase101();
        logAuditEvent('DIGITAL_SIGNATURE', `ลงลายมือชื่อดิจิทัลใบความเห็นสำเร็จ: ผู้ลงนาม ${sig.name} (${sig.role}) สำหรับสำนวน ${c.id}`);

        bootstrap.Modal.getInstance(document.getElementById('signatureModal')).hide();
        alert(`ลงลายมือชื่อดิจิทัลสําเร็จ!\nCryptographic Hash: ${randHash}`);
        
        renderOpinionApprovalWorkflow();
    }

    // ==============================================
    // 10. DYNAMIC FORM SUBMISSIONS (CRUD STATE)
    // ==============================================
    function submitNewCase(e) {
        e.preventDefault();
        
        const id = document.getElementById('form-101-no').value.trim();
        const type = document.getElementById('form-101-type').value;
        const blackId = document.getElementById('form-101-black').value.trim() || '—';
        const redId = document.getElementById('form-101-red').value.trim() || '—';
        const accuser = document.getElementById('form-101-accuser').value.trim() || 'ป.ป.ท.';
        const accused = document.getElementById('form-101-accused').value.trim();
        const attorney = document.getElementById('form-101-attorney').value.trim() || 'สนง.อัยการปราบฯ กลาง';
        const court = document.getElementById('form-101-court').value.trim() || 'ศาลอาญาคดีทุจริตฯ กลาง';
        const responsible = document.getElementById('form-101-responsible').value;
        const dueDate = document.getElementById('form-101-due').value;

        const newCase = {
            id, type, accuser, accused, blackId, redId,
            office: attorney, court, responsible,
            status: 'ลงทะเบียนมอบหมายสำนวน',
            dueDate, step: 2,
            timeline: [{ date: new Date().toLocaleDateString('th-TH'), desc: 'ลงทะเบียนมอบหมายสำนวนเข้าสารบบ ป.ป.ท.' }],
            docs: []
        };

        DB_CASES_101.unshift(newCase);
        saveDatabase101();
        
        logAuditEvent('CASE_REGISTRY_CREATE', `ลงทะเบียนรับสำนวนคดีใหม่เข้าสารบบ: เลขสำนวน ${id}`);
        
        bootstrap.Modal.getInstance(document.getElementById('newCaseModal')).hide();
        document.getElementById('new-case-form').reset();
        
        alert("ลงทะเบียนสำนวนคดีใหม่เรียบร้อยแล้ว!");
        renderCases101Table();
    }

    function submitNewAppeal(e) {
        e.preventDefault();

        const type = document.getElementById('form-102-type').value;
        const id = document.getElementById('form-102-no').value.trim();
        const name = document.getElementById('form-102-appellant').value.trim();
        const division = document.getElementById('form-102-division').value.trim();
        const receivedDate = document.getElementById('form-102-received').value;
        const duration = parseInt(document.getElementById('form-102-duration').value);

        const due = new Date(receivedDate);
        due.setDate(due.getDate() + duration);
        const dueDateStr = due.toISOString().split('T')[0];

        if (type === 'คำร้องขอข้อมูล') {
            const newReq = {
                id, type, name, division, receivedDate, dueDate: dueDateStr, decision: '—', status: 'รอเสนอ', docsCount: 1
            };
            DB_REQUESTS_102.unshift(newReq);
            saveDatabase102();
            logAuditEvent('DISCLOSURE_REQUEST_CREATE', `รับคำร้องขอข้อมูลข่าวสารใหม่: เลขที่ ${id}`);
        } else {
            const newApp = {
                id, type, name, sourceNo: 'สขร. ' + id.split(' ')[1] || 'สขร. 000/69',
                receivedDate, dueDate: dueDateStr, sgOpinion: '—', boardDecision: '—', docsCount: 2, status: 'รอเสนอเลขาธิการ', isPublic: false
            };
            DB_APPEALS_102.unshift(newApp);
            saveDatabase102();
            logAuditEvent('DISCLOSURE_APPEAL_CREATE', `รับคำอุทธรณ์คําสั่งไม่เปิดเผยข้อมูลใหม่: เลขที่ ${id}`);
        }

        bootstrap.Modal.getInstance(document.getElementById('newAppealModal')).hide();
        document.getElementById('new-appeal-form').reset();

        alert("บันทึกรับเรื่องเข้าสารบบข้อมูลข่าวสารเรียบร้อยแล้ว!");
        renderDisclosureTable();
    }

    function submitNewAdminCase(e) {
        e.preventDefault();

        const id = document.getElementById('form-103-black').value.trim();
        const redId = document.getElementById('form-103-red').value.trim() || '—';
        const court = document.getElementById('form-103-court').value;
        const type = document.getElementById('form-103-type').value;
        const plaintiff = document.getElementById('form-103-plaintiff').value.trim();
        const defendant = document.getElementById('form-103-defendant').value.trim();
