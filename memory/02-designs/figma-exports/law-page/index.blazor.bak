                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted" style="font-size:12px;">ผู้ถูกฟ้องคดี (ป.ป.ท. หรือ อื่นๆ) <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="form-103-defendant" value="สำนักงาน ป.ป.ท. (ผู้ถูกฟ้องคดี)" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted" style="font-size:12px;">มูลเหตุแห่งการฟ้องคดี (ป.ป.ท. อ้างอิง)</label>
                            <input type="text" class="form-control" id="form-103-source" placeholder="เช่น คดีไต่สวนเดิม ปปท. 87/67">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted" style="font-size:12px;">ผู้รับผิดชอบสำนวน (นิติกร) <span class="text-danger">*</span></label>
                            <select class="form-select" id="form-103-responsible" required>
                                <option value="วรรณา">วรรณา</option>
                                <option value="ธนกร">ธนกร</option>
                                <option value="อรทัย">อรทัย</option>
                                <option value="ศิริพร">ศิริพร</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted" style="font-size:12px;">ปีงบประมาณที่รับเรื่อง <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" id="form-103-year" value="2569" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted" style="font-size:12px;">วันนัดไต่สวน/ฟังคำสั่งนัดแรก</label>
                            <input type="date" class="form-control" id="form-103-date">
                        </div>
                    </div>
                    <div class="modal-footer px-0 pb-0">
                        <button type="button" class="btn btn-outline-navy" data-bs-dismiss="modal">ยกเลิก</button>
                        <button type="submit" class="btn btn-grad-navy">บันทึกข้อมูลคดี</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- ============================================== -->
<!-- MODAL 6: DIGITAL SIGNATURE (e-Approval Simulator) -->
<!-- ============================================== -->
<div class="modal fade" id="signatureModal" tabindex="-1" aria-hidden="true" style="z-index: 1200;">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-navy text-white" style="background: var(--primary-dark);">
                <h6 class="modal-title fw-bold text-white"><i class="bi bi-shield-check"></i> ยืนยันการลงลายมือชื่อดิจิทัล (Digital Signature)</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info py-2" style="font-size:11.5px;">
                    <i class="bi bi-info-circle-fill"></i> ระบบใช้ใบรับรองอิเล็กทรอนิกส์ในระดับความปลอดภัยสูง (PKI) มาตรฐาน ISO 27001
                </div>
                
                <div class="mb-3">
                    <label class="form-label text-muted" style="font-size:12px;">ผู้ลงนาม:</label>
                    <div class="fw-bold text-value text-dark" id="sig-modal-signer-name">กำลังโหลด...</div>
                    <div class="text-muted" style="font-size:11.5px;" id="sig-modal-signer-role">กำลังโหลด...</div>
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted" style="font-size:12px;">วาดลายเซ็นหรือใช้ลายมือชื่อดิจิทัลที่มีอยู่:</label>
                    <div class="signature-canvas-container">
                        <canvas id="signature-pad-canvas"></canvas>
                        <button type="button" class="btn btn-sm btn-white border position-absolute" style="bottom: 8px; right: 8px; font-size:10.5px;" onclick="clearSignatureCanvas()">ล้างค่า</button>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted" style="font-size:12px;">กรอกรหัสผ่านยืนยันตัวตน (PIN Code) <span class="text-danger">*</span></label>
                    <input type="password" class="form-control form-control-sm" id="sig-modal-pin" placeholder="รหัส PIN 6 หลัก" maxlength="6" value="123456">
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4">
                    <span class="text-muted" style="font-size:10.5px;"><i class="bi bi-lock-fill"></i> เข้ารหัสด้วย SHA-256</span>
                    <button class="btn btn-grad-gold px-4 py-1" onclick="confirmDigitalSignature()">ลงนามดิจิทัล</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ============================================== -->
<!-- MODAL 7: COMPLIANCE AUDIT LOGS VIEWER -->
<!-- ============================================== -->
<div class="modal fade" id="auditLogModal" tabindex="-1" aria-hidden="true" style="z-index: 1200;">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h6 class="modal-title fw-bold text-white"><i class="bi bi-shield-check"></i> สารบบบันทึกเหตุการณ์ประมวลความปลอดภัย (ISO 27001 Audit Log)</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-success py-2 d-flex justify-content-between align-items-center" style="font-size:11.5px;">
                    <span><i class="bi bi-info-circle-fill"></i> บันทึกเข้ารหัสความปลอดภัยเพื่อใช้ตรวจรับรองมาตรฐานกฎหมาย 10 ปี</span>
                    <button class="btn btn-sm btn-outline-success py-0" style="font-size:10px;" onclick="clearAuditLogDatabase()">ล้างประวัติ (สำหรับทดสอบ)</button>
                </div>
                <div class="table-responsive" style="max-height:400px; overflow-y:auto;">
                    <table class="table table-hover table-striped table-bordered mb-0" style="font-size:11.5px;">
                        <thead class="table-dark">
                            <tr>
                                <th>วัน-เวลาบันทึก</th>
                                <th>ผู้ใช้งาน</th>
                                <th>ประเภทคำสั่ง</th>
                                <th>รายละเอียดธุรกรรมคดี</th>
                                <th>IP Address</th>
                                <th>Verification Hash (SHA-256)</th>
                            </tr>
                        </thead>
                        <tbody id="audit-log-results-body">
                            <!-- Populated dynamically -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

