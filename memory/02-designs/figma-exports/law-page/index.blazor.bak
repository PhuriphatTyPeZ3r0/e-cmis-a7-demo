        const newAdmin = {
            id, redId, court, type, plaintiff, defendant, sourceCase, responsible, status: 'เสนอบอร์ดมอบอำนาจ', result: '—', nextDate: dateVal, year
        };

        DB_ADMIN_CASES_103.unshift(newAdmin);
