                            <label class="form-label text-muted" style="font-size:12px;">ผู้กล่าวหา</label>
                            <input type="text" class="form-control" id="form-101-accuser" value="สำนักงาน ป.ป.ท.">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted" style="font-size:12px;">ผู้ถูกกล่าวหา / จำเลย <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="form-101-accused" placeholder="ชื่อ-สกุล ผู้ถูกกล่าวหา" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted" style="font-size:12px;">พนักงานอัยการเจ้าของเรื่อง</label>
                            <input type="text" class="form-control" id="form-101-attorney" placeholder="สำนักงานอัยการ">
                        </div>
