        logAuditEvent('ADMIN_CASE_CREATE', `บันทึกหมายเรียกศาลปกครองคดีใหม่: หมายเลขคดีดำ ${id}`);

        bootstrap.Modal.getInstance(document.getElementById('newAdminCaseModal')).hide();
        document.getElementById('new-admin-case-form').reset();

        alert("บันทึกคดีปกครองใหม่เข้าระบบสำเร็จ!");
