        { caseNo: 'ปปท.ส. 042/2568', accused: 'นายสมบัติ ใจงาม', accuser: 'สำนักงาน ป.ป.ท.', charge: 'ทุจริตต่อหน้าที่โครงการก่อสร้างถนน', blackId: 'อท 41/68', redId: '—', office: 'ศาลอาญาคดีทุจริตฯ ภาค 4' },
        { caseNo: 'ปปท.ส. 109/2568', accused: 'นางสาวประภา รักษ์ดี', accuser: 'กรมทรัพยากรน้ำ', charge: 'ละเว้นการปฏิบัติหน้าที่โดยมิชอบ', blackId: 'อท 92/68', redId: 'อ 12/69', office: 'ศาลอาญาคดีทุจริตฯ ภาค 3' },
        { caseNo: 'ปปท.ส. 211/2568', accused: 'นายสุรชัย มั่งมี', accuser: 'ป.ป.ท.', charge: 'เบียดบังเงินงบประมาณสวัสดิการ', blackId: 'อท 105/68', redId: '—', office: 'ศาลอาญาคดีทุจริตฯ ภาค 5' }
    ];

    const MOCK_ACTIVITY_7 = [
        { meetingNo: 'มติบอร์ด ป.ป.ท. 12/2569', date: '2 มิ.ย. 2569', resolution: 'เห็นแย้งอัยการ (ให้ฟ้องคดี)', caseId: 'ปปท. 108/2569' },
        { meetingNo: 'มติบอร์ด ป.ป.ท. 15/2569', date: '15 มิ.ย. 2569', resolution: 'เห็นควรไม่อุทธรณ์คำพิพากษาศาลชั้นต้น', caseId: 'ปปท. 093/2568' }
    ];

    // Seed mock local storage databases
    if (!localStorage.getItem('ecmis_cases101')) localStorage.setItem('ecmis_cases101', JSON.stringify(SEED_CASES_101));
    if (!localStorage.getItem('ecmis_appeals102')) localStorage.setItem('ecmis_appeals102', JSON.stringify(SEED_APPEALS_102));
    if (!localStorage.getItem('ecmis_requests102')) localStorage.setItem('ecmis_requests102', JSON.stringify(SEED_REQUESTS_102));
    if (!localStorage.getItem('ecmis_admin_cases103')) localStorage.setItem('ecmis_admin_cases103', JSON.stringify(SEED_ADMIN_CASES_103));
    if (!localStorage.getItem('ecmis_audit_logs')) localStorage.setItem('ecmis_audit_logs', JSON.stringify([]));

    // Stateful Database Objects loaded from storage
    let DB_CASES_101 = JSON.parse(localStorage.getItem('ecmis_cases101'));
    let DB_APPEALS_102 = JSON.parse(localStorage.getItem('ecmis_appeals102'));
    let DB_REQUESTS_102 = JSON.parse(localStorage.getItem('ecmis_requests102'));
    let DB_ADMIN_CASES_103 = JSON.parse(localStorage.getItem('ecmis_admin_cases103'));
    let DB_AUDIT_LOGS = JSON.parse(localStorage.getItem('ecmis_audit_logs'));

    let currentSelectedCase = null;
    let currentSelectedAgendaIndex = null;
    let activeDisclosureSubTab = 'requests'; // requests or appeals
    let signatureCanvas = null, signatureCtx = null, signatureDrawing = false;
    let pendingSignerIndex = null;
    let integrationTargetInputIdMap = {};
    let dashboardCharts = {};

    document.addEventListener('DOMContentLoaded', function () {
        setupNavigationTriggers();
        setupFormDropdowns();
        setupSignaturePad();
        
        // Initialize view
        switchView('10.1');

        // Set Last Update text
        const now = new Date();
        document.getElementById('last-update-101').innerText = `อัปเดตล่าสุด: ${now.toLocaleDateString('th-TH')} ${now.toLocaleTimeString('th-TH')}`;
    });

    // ==============================================
    // 1. STATEFUL VIEW MANAGER & SIDEBAR NAVIGATION
    // ==============================================
    function setupNavigationTriggers() {
        const navLinks = document.querySelectorAll('.sidebar .nav-link');
        
        navLinks.forEach(link => {
            link.addEventListener('click', function (e) {
                e.preventDefault();
                navLinks.forEach(l => l.classList.remove('active'));
                this.classList.add('active');

                const viewTitle = this.querySelector('span').innerText.trim();
                
                if (viewTitle === 'สำนวนคดีชั้นอัยการ/ศาล') {
                    switchView('10.1');
                } else if (viewTitle === 'คำร้องขอเปิดเผยข้อมูล') {
                    switchView('10.2');
                } else if (viewTitle === 'คดีปกครอง') {
                    switchView('10.3');
                } else if (viewTitle === 'วาระประชุม/มติบอร์ด') {
                    switchView('10.2-meeting');
                } else if (viewTitle === 'Dashboard') {
                    switchView('dashboard');
                }

                // Auto close mobile offcanvas
                const sidebarOffcanvas = document.getElementById('sidebarOffcanvas');
                if (sidebarOffcanvas) {
                    const offcanvasInstance = bootstrap.Offcanvas.getInstance(sidebarOffcanvas);
                    if (offcanvasInstance) {
                        offcanvasInstance.hide();
                    }
                }
            });
        });
    }

    function switchView(viewName) {
        document.querySelectorAll('.app-view').forEach(v => v.classList.remove('active-view'));
        
        const breadcrumbRoot = "งานกฎหมายในทางคดี";
        let breadcrumbCurrent = "";

        if (viewName === '10.1') {
            document.getElementById('view-10-1-registry').classList.add('active-view');
            breadcrumbCurrent = "สำนวนคดีชั้นอัยการและชั้นศาล";
            renderCases101Table();
        } else if (viewName === '10.1-detail') {
            document.getElementById('view-10-1-detail').classList.add('active-view');
            breadcrumbCurrent = `สำนวนคดี › รายละเอียด (${currentSelectedCase ? currentSelectedCase.id : ''})`;
            renderCaseDetail();
        } else if (viewName === '10.1-opinion') {
            document.getElementById('view-10-1-opinion').classList.add('active-view');
            breadcrumbCurrent = `สำนวนคดี › บันทึกความเห็น (${currentSelectedCase ? currentSelectedCase.id : ''})`;
            renderOpinionApprovalWorkflow();
        } else if (viewName === '10.2') {
            document.getElementById('view-10-2-disclosure').classList.add('active-view');
            breadcrumbCurrent = "พิจารณาคำร้องขอเปิดเผยข้อมูลข่าวสาร";
            renderDisclosureTable();
        } else if (viewName === '10.2-meeting') {
            document.getElementById('view-10-2-meeting').classList.add('active-view');
            breadcrumbCurrent = "วาระประชุมคณะอนุกรรมการกลั่นกรองฯ";
            renderMeetingAgendas();
        } else if (viewName === '10.3') {
            document.getElementById('view-10-3-admin-cases').classList.add('active-view');
            breadcrumbCurrent = "การจัดการและควบคุมงานคดีปกครอง";
            renderAdminCasesTable();
        } else if (viewName === 'dashboard') {
            document.getElementById('view-dashboard').classList.add('active-view');
            breadcrumbCurrent = "Dashboard วิเคราะห์สถิติคดี";
            renderDashboardStatsAndCharts();
        }

        document.getElementById('breadcrumb-current').innerText = breadcrumbCurrent;
        logAuditEvent('VIEW_NAVIGATION', `เปิดหน้ามุมมอง: ${breadcrumbCurrent}`);
    }

    // ==============================================
    // 2. DATA BINDING - RENDERING DYNAMIC VIEWS
    // ==============================================

    function renderCases101Table() {
        const body = document.getElementById('cases-table-body');
        if (!body) return;
        body.innerHTML = '';
        
        let filtered = DB_CASES_101;
        
        const search = document.getElementById('filter-101-search').value.toLowerCase().trim();
        const type = document.getElementById('filter-101-type').value;
        const step = document.getElementById('filter-101-step').value;
        const office = document.getElementById('filter-101-office').value;
        const responsible = document.getElementById('filter-101-responsible').value;

        if (search) {
            filtered = filtered.filter(c => 
                c.id.toLowerCase().includes(search) || 
                c.accused.toLowerCase().includes(search) || 
                c.blackId.toLowerCase().includes(search) || 
                c.redId.toLowerCase().includes(search)
            );
        }
        if (type) filtered = filtered.filter(c => c.type === type);
        if (step) {
            if (step === 'อัยการ') filtered = filtered.filter(c => c.step <= 3 || c.status.includes('อัยการ'));
            else if (step === 'ศาล') filtered = filtered.filter(c => c.step === 4 || c.step === 5 || c.status.includes('ศาล'));
            else if (step === 'สิ้นสุด') filtered = filtered.filter(c => c.step === 7 || c.status.includes('สิ้นสุด') || c.status.includes('ถึงที่สุด'));
        }
        if (office) filtered = filtered.filter(c => c.office === office);
        if (responsible) filtered = filtered.filter(c => c.responsible === responsible);

        renderKPIs101();

        if (filtered.length === 0) {
            body.innerHTML = `<tr><td colspan="9" class="text-center text-muted py-4">ไม่พบข้อมูลสำนวนคดีตามที่ค้นหา</td></tr>`;
            return;
        }

        filtered.forEach(c => {
            const tr = document.createElement('tr');
            
            const dateDiff = Math.ceil((new Date(c.dueDate) - new Date()) / (1000 * 60 * 60 * 24));
            let ageHtml = '';
            if (c.status === 'คดีถึงที่สุด' || c.status === 'ปิดสำนวน' || dateDiff < 0) {
                ageHtml = '<div class="text-value fw-normal">สิ้นสุดแล้ว</div>';
            } else if (dateDiff <= 30) {
                ageHtml = `<div class="text-value fw-bold text-danger">อีก ${dateDiff} วัน!</div>`;
            } else {
                ageHtml = `<div class="text-value fw-normal">${formatDateThai(c.dueDate)}</div>`;
            }

            let badgeClass = 'status-navy';
            if (c.status.includes('ศาล')) badgeClass = 'status-orange';
            else if (c.status.includes('อัยการ')) badgeClass = 'status-teal';
            else if (c.status.includes('ถึงที่สุด') || c.status.includes('ปิด')) badgeClass = 'status-green';
            else if (c.status.includes('อายุความ') || c.status.includes('ด่วน')) badgeClass = 'status-red';

            tr.innerHTML = `
                <td><div class="fw-bold text-value" style="color: var(--primary-light);">${c.id}</div></td>
                <td><div class="text-value fw-normal">${c.type}</div></td>
                <td>
                    <div class="text-value fw-normal">${c.accuser}</div>
                    <div class="text-sub">${c.accused}</div>
                </td>
                <td>
                    <div class="text-value fw-normal">${c.blackId}</div>
                    <div class="text-sub">${c.redId}</div>
                </td>
                <td>
                    <div class="text-value fw-normal">${c.office}</div>
                </td>
                <td>
                    <div class="d-flex align-items-center gap-2">
                        <div class="avatar-sm">${c.responsible.charAt(0)}</div>
                        <span class="text-value fw-normal">${c.responsible}</span>
                    </div>
                </td>
                <td><div class="status-badge ${badgeClass}">${c.status}</div></td>
                <td>${ageHtml}</td>
                <td>
                    <div class="d-flex gap-1">
                        <button class="btn btn-action-view" onclick="selectAndShowCaseDetail('${c.id}')">ดู</button>
                        <button class="btn btn-action-save" onclick="openEditCaseModal('${c.id}')">บันทึกมติ</button>
                    </div>
                </td>
            `;
            body.appendChild(tr);
        });
    }

    function renderKPIs101() {
        const container = document.getElementById('kpi-cards-101');
        if (!container) return;

        const total = DB_CASES_101.length;
        const prosecutionCount = DB_CASES_101.filter(c => c.status.includes('อัยการ') || c.step <= 3).length;
        const courtCount = DB_CASES_101.filter(c => c.status.includes('ศาล') || c.step === 4 || c.step === 5).length;
        
        let urgentCount = 0;
        DB_CASES_101.forEach(c => {
            const dateDiff = Math.ceil((new Date(c.dueDate) - new Date()) / (1000 * 60 * 60 * 24));
            if (dateDiff > 0 && dateDiff <= 30 && c.status !== 'คดีถึงที่สุด') {
                urgentCount++;
            }
        });

        container.innerHTML = `
            <div class="col-6 col-md-3">
                <div class="kpi-card kpi-navy h-100">
                    <div class="fw-bold text-muted" style="font-size: 12px;">สำนวนทั้งหมด</div>
                    <div class="fw-bold" style="color: var(--primary-dark); font-size: 26px; margin-top: 4px;">${total}</div>
                    <div style="color: var(--text-muted); font-size: 10.5px; margin-top: 4px;">ปีงบประมาณ 2569</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="kpi-card kpi-teal h-100">
                    <div class="fw-bold text-muted" style="font-size: 12px;">อยู่ระหว่างชั้นอัยการ</div>
                    <div class="fw-bold" style="color: var(--primary-dark); font-size: 26px; margin-top: 4px;">${prosecutionCount}</div>
                    <div style="color: var(--text-muted); font-size: 10.5px; margin-top: 4px;">ความเห็นแย้ง 1 เรื่อง</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="kpi-card kpi-orange h-100">
                    <div class="fw-bold text-muted" style="font-size: 12px;">อยู่ระหว่างชั้นศาล</div>
                    <div class="fw-bold" style="color: var(--primary-dark); font-size: 26px; margin-top: 4px;">${courtCount}</div>
                    <div style="color: var(--text-muted); font-size: 10.5px; margin-top: 4px;">ชั้นต้น · อุทธรณ์ · ฎีกา</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="kpi-card ${urgentCount > 0 ? 'kpi-red' : 'kpi-navy'} h-100" onclick="filterUrgent101()" style="cursor:pointer;">
                    <div class="fw-bold text-muted" style="font-size: 12px;">ใกล้ครบกำหนด ≤ 30 วัน</div>
                    <div class="fw-bold" style="color: ${urgentCount > 0 ? '#C0392B' : 'var(--primary-dark)'}; font-size: 26px; margin-top: 4px;">${urgentCount}</div>
                    <div style="color: var(--text-muted); font-size: 10.5px; margin-top: 4px;">คลิกเพื่อกรองรายการคดี</div>
                </div>
            </div>
        `;
    }

    function selectAndShowCaseDetail(caseId) {
        currentSelectedCase = DB_CASES_101.find(c => c.id === caseId);
        switchView('10.1-detail');
    }

    function renderCaseDetail() {
        if (!currentSelectedCase) return;
        const c = currentSelectedCase;

        document.getElementById('detail-case-no').innerText = c.id;
        document.getElementById('detail-case-type').innerText = c.type;
        document.getElementById('detail-case-status').innerText = c.status;

        const dateDiff = Math.ceil((new Date(c.dueDate) - new Date()) / (1000 * 60 * 60 * 24));
        const remElement = document.getElementById('detail-case-remaining');
        const alarmDays = document.getElementById('alarm-days');
        const alarmDate = document.getElementById('alarm-date');
        const alarmBar = document.getElementById('alarm-bar');

        if (dateDiff < 0) {
            remElement.innerText = "อายุความสิ้นสุดแล้ว";
            remElement.className = "status-badge status-navy";
            alarmDays.innerText = "0";
            alarmDate.innerText = formatDateThai(c.dueDate);
            alarmBar.style.width = '100%';
            alarmBar.className = 'progress-bar bg-secondary';
        } else {
            remElement.innerText = `อายุความคงเหลือ ${dateDiff} วัน`;
            remElement.className = dateDiff <= 30 ? "status-badge status-red" : "status-badge status-yellow";
            alarmDays.innerText = dateDiff;
            alarmDate.innerText = formatDateThai(c.dueDate);
            
            const totalAgeDays = 365;
            const progressPercent = Math.max(0, Math.min(100, (1 - (dateDiff / totalAgeDays)) * 100));
            alarmBar.style.width = `${progressPercent}%`;
            alarmBar.className = dateDiff <= 30 ? 'progress-bar bg-danger' : 'progress-bar bg-warning';
        }

        document.getElementById('detail-case-parties').innerText = `ผู้กล่าวหา: ${c.accuser} · ผู้ถูกกล่าวหา: ${c.accused} · คดีดำ ${c.blackId} · คดีแดง ${c.redId}`;
        document.getElementById('detail-case-court').innerText = `${c.court} · ผู้รับผิดชอบ: นาย${c.responsible} สุขใจ (นิติกรชำนาญการ)`;

        const stepperFill = document.getElementById('detail-stepper-fill');
        const activeStep = c.step || 1;
        const progressPercentage = ((activeStep - 1) / 6) * 100;
        stepperFill.style.width = `${progressPercentage}%`;

        for (let i = 1; i <= 7; i++) {
            const stepEl = document.getElementById(`step-${i}`);
            if (i < activeStep) {
                stepEl.className = 'step-item completed';
                stepEl.querySelector('.step-circle').innerHTML = '<i class="bi bi-check-lg"></i>';
            } else if (i === activeStep) {
                stepEl.className = 'step-item active';
                stepEl.querySelector('.step-circle').innerText = i;
            } else {
                stepEl.className = 'step-item';
                stepEl.querySelector('.step-circle').innerText = i;
            }
        }

        document.getElementById('meta-type').innerText = c.type;
        document.getElementById('meta-no').innerText = c.id;
        document.getElementById('meta-blackred').innerText = `${c.blackId} · ${c.redId}`;
        document.getElementById('meta-date').innerText = c.timeline[0] ? c.timeline[0].date : '—';
        document.getElementById('meta-attorney').innerText = c.office;
        document.getElementById('meta-court').innerText = c.court;
        document.getElementById('meta-division').innerText = 'กองกฎหมาย กลุ่มงานคดี';
        document.getElementById('meta-due').innerText = formatDateThai(c.dueDate);

        const partiesBody = document.getElementById('detail-parties-body');
        partiesBody.innerHTML = `
            <tr>
                <td><span class="text-primary fw-bold">ผู้กล่าวหา</span></td>
                <td>${c.accuser}</td>
                <td>—</td>
                <td><span class="badge bg-secondary">โจทก์</span></td>
            </tr>
            <tr>
                <td><span class="text-danger fw-bold">ผู้ถูกกล่าวหา</span></td>
                <td>${c.accused}</td>
                <td>3-1002-xxxxx-xx-1</td>
                <td><span class="badge bg-dark">จำเลยที่ 1</span></td>
            </tr>
        `;

        const docsList = document.getElementById('detail-docs-list');
        docsList.innerHTML = '';
        if (!c.docs || c.docs.length === 0) {
            docsList.innerHTML = '<div class="text-center py-3 text-muted">ไม่มีไฟล์เอกสารแนบในขณะนี้</div>';
        } else {
            c.docs.forEach((doc, idx) => {
                const item = document.createElement('div');
                item.className = 'list-group-item d-flex justify-content-between align-items-center border-0 border-bottom px-0 py-2';
                
                const ext = doc.name.split('.').pop().toUpperCase();
                const badgeColor = ext === 'PDF' ? 'bg-danger' : 'bg-primary';

                item.innerHTML = `
                    <div class="d-flex align-items-center gap-3">
                        <div class="badge ${badgeColor} d-flex align-items-center justify-content-center" style="width:36px; height:36px; font-size:10px;">${ext}</div>
                        <div>
                            <div class="fw-bold" style="font-size:13px;">${doc.name}</div>
                            <div class="text-sub">${doc.size} · ${doc.uploader} · ${doc.date}</div>
                        </div>
                    </div>
                    <button class="btn btn-sm btn-outline-navy py-1 px-3" onclick="simulateFileDownload('${doc.name}')">ดาวน์โหลด</button>
                `;
                docsList.appendChild(item);
            });
        }

        const auditTrailContainer = document.getElementById('detail-audit-trail');
        auditTrailContainer.innerHTML = '';
        if (c.timeline && c.timeline.length > 0) {
            c.timeline.forEach((t, index) => {
                const isLast = index === c.timeline.length - 1;
                const div = document.createElement('div');
                div.className = `audit-item ${isLast ? 'active' : ''}`;
                div.innerHTML = `
                    <div class="text-sub font-monospace">${t.date}</div>
                    <div class="fw-bold mt-1 text-dark" style="font-size:12px;">${t.desc}</div>
                `;
                auditTrailContainer.appendChild(div);
            });
        }
    }

    function renderOpinionApprovalWorkflow() {
        if (!currentSelectedCase) return;
        const c = currentSelectedCase;

        if (!c.signatures) {
            c.signatures = [
                { name: 'นายธนกร สุขใจ', role: 'นิติกรชำนาญการ · ผู้จัดทำ', status: 'signed', date: '18 พ.ค. 14:30', hash: '8f9c2d1b7a4c9e8d...e7a4' },
                { name: 'นางสาวอรทัย พูนสุข', role: 'ผอ.กลุ่มงานคดี', status: 'signed', date: '19 พ.ค. 09:12', hash: '3e4f1a2b5d6c7e8f...d6c7' },
                { name: 'นายวีระ ชอบธรรม', role: 'ผอ.กองกฎหมาย', status: 'pending', date: 'ครบกำหนดวันนี้', hash: '' },
                { name: 'เลขาธิการ ป.ป.ท.', role: 'เสนอเข้าวาระบอร์ด ป.ป.ท.', status: 'pending', date: 'ยังไม่ถึงลำดับ', hash: '' }
            ];
            saveDatabase101();
        }

        const container = document.getElementById('approval-route-list');
        container.innerHTML = '';

        c.signatures.forEach((sig, index) => {
            const card = document.createElement('div');
            card.className = 'd-flex align-items-start gap-3 mb-4';
            
            let statusBadge = '';
            if (sig.status === 'signed') {
                statusBadge = `
                    <div class="badge bg-success-subtle text-success border border-success p-1 px-2 mt-2" style="font-size:11px;">
                        ลงนามแล้ว · ${sig.date}
                    </div>
                    <div class="text-muted mt-1" style="font-size:10px;"><i class="bi bi-shield-check text-success"></i> SHA-256: <code>${sig.hash}</code></div>
                `;
            } else if (sig.status === 'pending') {
                const isCurrentSigner = c.signatures.findIndex(s => s.status === 'pending') === index;
                if (isCurrentSigner) {
                    statusBadge = `
                        <div class="d-flex flex-column gap-1 mt-2">
                            <div class="badge bg-warning-subtle text-warning border border-warning p-1 px-2" style="font-size:11px; width:fit-content;">
                                รอดำเนินการ (${sig.date})
                            </div>
                            <button class="btn btn-sm btn-grad-gold mt-2 py-1" onclick="openSignatureModal(${index})"><i class="bi bi-pencil-fill"></i> ลงนามลายมือชื่อดิจิทัล</button>
                        </div>
                    `;
                } else {
                    statusBadge = `
                        <div class="badge bg-secondary-subtle text-secondary border border-secondary p-1 px-2 mt-2" style="font-size:11px;">
                            ${sig.date}
                        </div>
                    `;
                }
            }

            card.innerHTML = `
                <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold bg-navy" style="width:32px; height:32px; background:var(--primary-dark); font-size: 13px;">
                    ${sig.name.charAt(3)}
                </div>
                <div class="lh-sm">
                    <div class="fw-bold" style="font-size:13px; color: var(--primary-dark);">${sig.name}</div>
                    <div class="text-muted" style="font-size:11px; margin-top:2px;">${sig.role}</div>
                    ${statusBadge}
                </div>
            `;
            container.appendChild(card);
        });
    }

    // ==============================================
    // 3. 10.2 DISCLOSURE REQUESTS & APPEALS TAB BINDING
    // ==============================================
    function toggleDisclosureSubTab(tabName) {
        activeDisclosureSubTab = tabName;
        
        const btnRequests = document.getElementById('tab-disclosure-requests');
        const btnAppeals = document.getElementById('tab-disclosure-appeals');
        const tableTitle = document.getElementById('table-title-102');
        const btnAdd = document.getElementById('btn-add-102');

        if (tabName === 'requests') {
            btnRequests.classList.add('active');
            btnAppeals.classList.remove('active');
            tableTitle.innerText = "รายการคำร้องขอข้อมูลข่าวสาร (LAW002.01)";
            btnAdd.innerText = "+ รับคำร้องใหม่";
            btnAdd.setAttribute('data-bs-target', '#newAppealModal');
        } else {
            btnRequests.classList.remove('active');
            btnAppeals.classList.add('active');
            tableTitle.innerText = "รายการคำอุทธรณ์คำสั่งไม่เปิดเผย (LAW002.02)";
            btnAdd.innerText = "+ รับคำอุทธรณ์ใหม่";
        }

        renderDisclosureTable();
    }

    function renderDisclosureTable() {
        renderKPIs102();

        const head = document.getElementById('disclosure-table-head');
        const body = document.getElementById('disclosure-table-body');
        if (!body) return;
        
        body.innerHTML = '';

        const search = document.getElementById('filter-102-search').value.toLowerCase().trim();
        const status = document.getElementById('filter-102-status').value;
        const result = document.getElementById('filter-102-result').value;

        if (activeDisclosureSubTab === 'requests') {
            head.innerHTML = `
                <tr>
                    <th>เลขสำนวนคำร้อง</th>
                    <th>ชื่อผู้ร้องขอข้อมูล</th>
                    <th>กอง/สำนักเจ้าของเรื่อง</th>
                    <th>วันที่รับ</th>
                    <th>ครบกำหนดพิจารณา</th>
                    <th>ผลการพิจารณา</th>
                    <th>สถานะการดำเนินการ</th>
                    <th>ไฟล์แนบ</th>
                    <th>จัดการ</th>
                </tr>
            `;

            let filtered = DB_REQUESTS_102;
            if (search) {
                filtered = filtered.filter(r => 
                    r.id.toLowerCase().includes(search) || 
                    r.name.toLowerCase().includes(search) || 
                    r.division.toLowerCase().includes(search)
                );
            }
            if (status) filtered = filtered.filter(r => r.status.includes(status));
            if (result) filtered = filtered.filter(r => r.decision.includes(result));

            if (filtered.length === 0) {
                body.innerHTML = `<tr><td colspan="9" class="text-center text-muted py-4">ไม่พบข้อมูลคำร้องขอข้อมูลข่าวสาร</td></tr>`;
                return;
            }

            filtered.forEach(r => {
                const tr = document.createElement('tr');
                
                let badgeClass = 'status-navy';
                if (r.status.includes('แล้ว')) badgeClass = 'status-green';
                else if (r.status.includes('เกิน')) badgeClass = 'status-red';

                tr.innerHTML = `
                    <td><div class="fw-bold text-value" style="color: var(--primary-light);">${r.id}</div></td>
                    <td><div class="text-value fw-normal">${r.name}</div></td>
                    <td><div class="text-value fw-normal">${r.division}</div></td>
                    <td><div class="text-value fw-normal">${formatDateThai(r.receivedDate)}</div></td>
                    <td><div class="text-value fw-normal">${formatDateThai(r.dueDate)}</div></td>
                    <td><div class="status-badge ${r.decision === 'เปิดเผย' ? 'status-teal' : (r.decision === 'ไม่เปิดเผย' ? 'status-red' : 'status-navy')}">${r.decision || '—'}</div></td>
                    <td><div class="status-badge ${badgeClass}">${r.status}</div></td>
                    <td><span class="text-value fw-bold"><i class="bi bi-file-earmark-pdf"></i> ${r.docsCount || 0}</span></td>
                    <td>
                        <div class="d-flex gap-1">
                            <button class="btn btn-action-view" onclick="simulateDisclosureDetail('${r.id}')">ดู</button>
                            <button class="btn btn-action-save" onclick="openRecordResultModal102('${r.id}', 'request')">บันทึกผล</button>
                        </div>
                    </td>
                `;
                body.appendChild(tr);
            });
        } else {
            head.innerHTML = `
                <tr>
                    <th>เลขที่อุทธรณ์</th>
                    <th>ชื่อผู้อุทธรณ์</th>
                    <th>อ้างอิงคำร้องเดิม</th>
                    <th>รับ / ครบกำหนด</th>
                    <th>ความเห็นเลขาธิการ</th>
                    <th>มติคณะกรรมการ ป.ป.ท.</th>
                    <th>ไฟล์แนบ</th>
                    <th>สถานะ</th>
                    <th>เปิดเผยสาธารณะ</th>
                    <th>จัดการ</th>
                </tr>
            `;

            let filtered = DB_APPEALS_102;
            if (search) {
                filtered = filtered.filter(a => 
                    a.id.toLowerCase().includes(search) || 
                    a.name.toLowerCase().includes(search) || 
                    a.sourceNo.toLowerCase().includes(search)
                );
            }
            if (status) filtered = filtered.filter(a => a.status.includes(status));
            if (result) filtered = filtered.filter(a => a.boardDecision.includes(result) || a.sgOpinion.includes(result));

            if (filtered.length === 0) {
                body.innerHTML = `<tr><td colspan="10" class="text-center text-muted py-4">ไม่พบข้อมูลคำอุทธรณ์</td></tr>`;
                return;
            }

            filtered.forEach(a => {
                const tr = document.createElement('tr');
                
                let badgeClass = 'status-navy';
                if (a.status.includes('แล้ว')) badgeClass = 'status-green';
                else if (a.status.includes('เกิน')) badgeClass = 'status-red';
                else if (a.status.includes('บอร์ด')) badgeClass = 'status-yellow';

                tr.innerHTML = `
                    <td><div class="fw-bold text-value" style="color: var(--primary-light);">${a.id}</div></td>
                    <td><div class="text-value fw-normal">${a.name}</div></td>
                    <td><div class="text-value fw-normal text-decoration-underline" style="color:var(--primary-light); cursor:pointer;" onclick="simulateDisclosureDetail('${a.sourceNo}')">${a.sourceNo}</div></td>
                    <td>
                        <div class="text-value fw-normal">${formatDateThai(a.receivedDate)}</div>
                        <div class="text-sub text-danger text-value">ครบ ${formatDateThai(a.dueDate)}</div>
                    </td>
                    <td><div class="status-badge ${a.sgOpinion.includes('ยืน') ? 'status-red' : (a.sgOpinion.includes('เปิด') ? 'status-teal' : 'status-navy')}">${a.sgOpinion}</div></td>
                    <td><div class="status-badge ${a.boardDecision.includes('เห็นชอบ') ? 'status-teal' : (a.boardDecision.includes('ยืน') ? 'status-red' : 'status-navy')}">${a.boardDecision}</div></td>
                    <td><span class="text-value fw-bold"><i class="bi bi-file-earmark-pdf"></i> ${a.docsCount || 0}</span></td>
                    <td><div class="status-badge ${badgeClass}">${a.status}</div></td>
                    <td>
                        <div class="form-check form-switch d-flex justify-content-center">
                            <input class="form-check-input" type="checkbox" role="switch" ${a.isPublic ? 'checked' : ''} onchange="toggleAppealPublic('${a.id}', this.checked)">
                        </div>
                    </td>
                    <td>
                        <div class="d-flex gap-1">
                            <button class="btn btn-action-view" onclick="simulateDisclosureDetail('${a.id}')">ดู</button>
                            <button class="btn btn-action-save" onclick="openRecordResultModal102('${a.id}', 'appeal')">บันทึกผล</button>
                        </div>
                    </td>
                `;
                body.appendChild(tr);
            });
        }
    }

    function renderKPIs102() {
        const container = document.getElementById('kpi-cards-102');
        if (!container) return;

        const reqCount = DB_REQUESTS_102.length;
        const appCount = DB_APPEALS_102.length;
        const pendingSgCount = DB_APPEALS_102.filter(a => a.status === 'รอเสนอเลขาธิการ').length;
        const pendingBoardCount = DB_APPEALS_102.filter(a => a.status === 'รอบอร์ดพิจารณา').length;
        const overdueCount = DB_REQUESTS_102.filter(r => r.status.includes('เกิน')).length + DB_APPEALS_102.filter(a => a.status.includes('เกิน')).length;

        container.innerHTML = `
            <div class="col-6 col-md-3">
                <div class="kpi-card kpi-navy h-100">
                    <div class="fw-bold text-muted" style="font-size: 12px;">คำร้อง / คำอุทธรณ์ทั้งหมด</div>
                    <div class="fw-bold" style="color: var(--primary-dark); font-size: 26px; margin-top: 4px;">${reqCount + appCount}</div>
                    <div style="color: var(--text-muted); font-size: 10.5px; margin-top: 4px;">คำร้อง ${reqCount} · อุทธรณ์ ${appCount} เรื่อง</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="kpi-card kpi-teal h-100">
                    <div class="fw-bold text-muted" style="font-size: 12px;">รอเสนอเลขาธิการพิจารณา</div>
                    <div class="fw-bold" style="color: var(--primary-dark); font-size: 26px; margin-top: 4px;">${pendingSgCount}</div>
                    <div style="color: var(--text-muted); font-size: 10.5px; margin-top: 4px;">ระยะเวลาเฉลี่ยรอพิจารณา 8 วัน</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="kpi-card kpi-orange h-100" onclick="switchView('10.2-meeting')" style="cursor:pointer;">
                    <div class="fw-bold text-muted" style="font-size: 12px;">รอบอร์ดพิจารณา (อนุกลั่นกรอง)</div>
                    <div class="fw-bold" style="color: var(--primary-dark); font-size: 26px; margin-top: 4px;">${pendingBoardCount}</div>
                    <div style="color: var(--text-muted); font-size: 10.5px; margin-top: 4px;">คลิกเปิดห้องวาระการประชุมบอร์ด</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="kpi-card ${overdueCount > 0 ? 'kpi-red' : 'kpi-navy'} h-100">
                    <div class="fw-bold text-muted" style="font-size: 12px;">เกินกำหนดระยะเวลาดำเนินงาน</div>
                    <div class="fw-bold" style="color: ${overdueCount > 0 ? '#C0392B' : 'var(--primary-dark)'}; font-size: 26px; margin-top: 4px;">${overdueCount}</div>
                    <div style="color: var(--text-muted); font-size: 10.5px; margin-top: 4px;">มีระบบเตือนนิติกรเร่งพิจารณา</div>
                </div>
            </div>
        `;
    }

    function toggleAppealPublic(appealId, val) {
        const a = DB_APPEALS_102.find(ap => ap.id === appealId);
        if (a) {
            a.isPublic = val;
            saveDatabase102();
            logAuditEvent('SECURITY_PERMISSION', `เปลี่ยนสิทธิ์การเข้าถึงแบบเปิดเผยสาธารณะของอุทธรณ์ ${appealId} เป็น ${val}`);
        }
    }

    // ==============================================
    // 4. 10.2 BOARD MEETING RESOLUTIONS & VOTING
    // ==============================================
    function renderMeetingAgendas() {
        const body = document.getElementById('meeting-agenda-body');
        if (!body) return;
        body.innerHTML = '';

        const agendaAppeals = DB_APPEALS_102.filter(a => a.status === 'รอบอร์ดพิจารณา' || a.status === 'แจ้งผลอุทธรณ์แล้ว');

        if (agendaAppeals.length === 0) {
            body.innerHTML = `<tr><td colspan="4" class="text-center text-muted py-4">ไม่มีคำอุทธรณ์ที่อยู่ระหว่างเสนอวาระบอร์ดพิจารณา</td></tr>`;
            return;
        }

        agendaAppeals.forEach((a, index) => {
            const tr = document.createElement('tr');
            tr.style.cursor = 'pointer';
            if (currentSelectedAgendaIndex === index) {
                tr.className = 'table-warning';
            }
            tr.onclick = () => selectMeetingAgenda(index, a);

            tr.innerHTML = `
                <td><b>4.${index + 1}</b></td>
                <td>
                    <div class="fw-bold">${a.id}</div>
                    <div class="text-sub">${a.name}</div>
                </td>
                <td><div class="text-value fw-normal text-value">อุทธรณ์กรณีไม่เปิดเผยข้อมูลเรื่อง ${a.sourceNo}</div></td>
                <td>
                    <div class="status-badge ${a.boardDecision === 'เห็นชอบ' ? 'status-teal' : (a.boardDecision.includes('ยืน') ? 'status-red' : 'status-yellow')}">
                        ${a.boardDecision !== '—' ? a.boardDecision : 'รอพิจารณา'}
                    </div>
                </td>
            `;
            body.appendChild(tr);
        });

        if (currentSelectedAgendaIndex !== null) {
            const selectedAppeal = agendaAppeals[currentSelectedAgendaIndex];
            renderMeetingResolutionForm(selectedAppeal);
        }
    }

    function selectMeetingAgenda(index, appeal) {
        currentSelectedAgendaIndex = index;
        renderMeetingAgendas();
    }

    function renderMeetingResolutionForm(appeal) {
        const container = document.getElementById('meeting-resolve-panel');
        container.innerHTML = `
            <h6 class="fw-bold text-primary mb-3"><i class="bi bi-pen-fill"></i> บันทึกมติบอร์ด — วาระ 4.${currentSelectedAgendaIndex + 1} (${appeal.id})</h6>
            <hr>
            
            <div class="mb-3">
                <label class="form-label text-muted" style="font-size:12px;">มติคณะอนุกรรมการกลั่นกรอง <span class="text-danger">*</span></label>
                <div class="d-flex flex-column gap-2">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="board-vote" id="vote-allow" value="เห็นชอบ" ${appeal.boardDecision === 'เห็นชอบ' ? 'checked' : ''}>
                        <label class="form-check-label" style="font-size:12.5px;" for="vote-allow">เห็นชอบตามคำร้องอุทธรณ์ (ให้เปิดเผยข้อมูล)</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="board-vote" id="vote-deny" value="ยืนตามคำสั่ง" ${appeal.boardDecision.includes('ยืน') ? 'checked' : ''}>
                        <label class="form-check-label" style="font-size:12.5px;" for="vote-deny">ยืนตามคำสั่งเดิม (ไม่เปิดเผยข้อมูล)</label>
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label text-muted" style="font-size:12px;">รายละเอียด / เหตุผลในการมีมติชี้ขาด</label>
                <textarea class="form-control" id="board-vote-comment" style="height:100px; font-size:12.5px;" placeholder="ระบุเหตุผลประกอบมติคณะอนุกรรมการกลั่นกรอง…"></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label text-muted" style="font-size:12px;">อัปเดตไฟล์มติสรุปการประชุม (PDF/Word)</label>
                <div class="input-group input-group-sm">
                    <input type="file" class="form-control" id="board-vote-file" disabled>
                    <span class="input-group-text bg-light text-muted" style="font-size:10px;">ข้ามได้</span>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <button class="btn btn-sm btn-outline-navy" onclick="currentSelectedAgendaIndex = null; renderMeetingAgendas();">ยกเลิก</button>
                <button class="btn btn-sm btn-grad-gold px-3" onclick="submitBoardResolution('${appeal.id}')"><i class="bi bi-shield-check"></i> บันทึกมติ + ลงนามดิจิทัล</button>
            </div>
        `;
    }

    function submitBoardResolution(appealId) {
        const voteEl = document.querySelector('input[name="board-vote"]:checked');
        if (!voteEl) {
            alert("กรุณาเลือกมติพิจารณา!");
            return;
        }

        const voteVal = voteEl.value;
        const comment = document.getElementById('board-vote-comment').value;

        const appeal = DB_APPEALS_102.find(a => a.id === appealId);
        if (appeal) {
            appeal.boardDecision = voteVal;
            appeal.status = 'แจ้งผลอุทธรณ์แล้ว';
            appeal.isPublic = true;
            saveDatabase102();
            
            logAuditEvent('MEETING_RESOLUTION', `บันทึกมติคณะอนุกรรมการชี้ขาดอุทธรณ์ ${appealId} มีมติ: ${voteVal}. หมายเหตุ: ${comment}`);

            alert(`บันทึกมติของบอร์ด อุทธรณ์ ${appealId} เรียบร้อยแล้ว!`);
            currentSelectedAgendaIndex = null;
            renderMeetingAgendas();
            renderDisclosureTable();
        }
    }

    // ==============================================
    // 5. 10.3 ADMINISTRATIVE COURT CASES BINDING
    // ==============================================
    function renderAdminCasesTable() {
        renderKPIs103();

        const body = document.getElementById('admin-cases-table-body');
        if (!body) return;
        body.innerHTML = '';

        let filtered = DB_ADMIN_CASES_103;

        const search = document.getElementById('filter-103-search').value.toLowerCase().trim();
        const court = document.getElementById('filter-103-court').value;
        const type = document.getElementById('filter-103-type').value;
        const result = document.getElementById('filter-103-result').value;

        if (search) {
            filtered = filtered.filter(a => 
                a.id.toLowerCase().includes(search) || 
                a.plaintiff.toLowerCase().includes(search) || 
                a.sourceCase.toLowerCase().includes(search)
            );
        }
        if (court) filtered = filtered.filter(a => a.court === court);
        if (type) filtered = filtered.filter(a => a.type === type);
        if (result) {
            if (result === 'ชนะคดี' || result === 'แพ้คดี' || result === 'จำหน่ายคดี') {
                filtered = filtered.filter(a => a.result === result);
            } else {
                filtered = filtered.filter(a => a.result === '—');
            }
        }

        if (filtered.length === 0) {
            body.innerHTML = `<tr><td colspan="10" class="text-center text-muted py-4">ไม่พบข้อมูลคดีปกครองตามค้นหา</td></tr>`;
            return;
        }

        filtered.forEach(a => {
            const tr = document.createElement('tr');

            let badgeClass = 'status-navy';
            if (a.status.includes('อัยการ')) badgeClass = 'status-teal';
            else if (a.status.includes('ที่สุด') || a.status.includes('จำหน่าย')) badgeClass = 'status-green';
            else if (a.status.includes('กลุ่มงาน')) badgeClass = 'status-orange';

            let resultBadge = '—';
            if (a.result === 'ชนะคดี') resultBadge = `<span class="badge bg-success-subtle text-success border border-success px-2">ชนะคดี</span>`;
            else if (a.result === 'แพ้คดี') resultBadge = `<span class="badge bg-danger-subtle text-danger border border-danger px-2">แพ้คดี</span>`;
            else if (a.result === 'จำหน่ายคดี') resultBadge = `<span class="badge bg-secondary-subtle text-secondary border border-secondary px-2">จำหน่าย</span>`;

            tr.innerHTML = `
                <td>
                    <div class="fw-bold text-value" style="color:var(--primary-light);">${a.id}</div>
                    <div class="text-sub">${a.redId}</div>
                </td>
                <td>
                    <div class="text-value fw-normal">${a.court}</div>
                </td>
                <td><span class="status-badge ${a.type === 'ชั้นต้น' ? 'status-navy' : 'status-orange'}">${a.type}</span></td>
                <td>
                    <div class="text-value fw-normal">${a.plaintiff}</div>
                    <div class="text-sub">${a.defendant}</div>
                </td>
                <td>
                    <div class="text-value fw-bold text-decoration-underline" style="color:var(--primary-light); cursor:pointer;" onclick="searchAndShowCaseFromSource('${a.sourceCase}')">${a.sourceCase}</div>
                </td>
                <td>
                    <div class="d-flex align-items-center gap-2">
                        <div class="avatar-sm">${a.responsible.charAt(0)}</div>
                        <span class="text-value fw-normal">${a.responsible}</span>
                    </div>
                </td>
                <td><div class="status-badge ${badgeClass}">${a.status}</div></td>
                <td>${resultBadge}</td>
                <td><div class="text-value fw-normal">${a.nextDate}</div></td>
                <td>
                    <div class="d-flex gap-1">
                        <button class="btn btn-action-view" onclick="simulateAdminCaseDetail('${a.id}')">ดู</button>
                        <button class="btn btn-action-save" onclick="openRecordResultModal103('${a.id}')">ผลศาล</button>
                    </div>
                </td>
            `;
            body.appendChild(tr);
        });
    }

    function renderKPIs103() {
        const container = document.getElementById('kpi-cards-103');
        if (!container) return;

        const total = DB_ADMIN_CASES_103.length;
        const pendingCount = DB_ADMIN_CASES_103.filter(a => a.result === '—').length;
        const winCount = DB_ADMIN_CASES_103.filter(a => a.result === 'ชนะคดี').length;
        const lossCount = DB_ADMIN_CASES_103.filter(a => a.result === 'แพ้คดี').length;

        container.innerHTML = `
            <div class="col-6 col-md-3">
                <div class="kpi-card kpi-navy h-100">
                    <div class="fw-bold text-muted" style="font-size: 12px;">คดีปกครองทั้งหมด</div>
                    <div class="fw-bold" style="color: var(--primary-dark); font-size: 26px; margin-top: 4px;">${total}</div>
                    <div style="color: var(--text-muted); font-size: 10.5px; margin-top: 4px;">ปีงบประมาณ 2569</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="kpi-card kpi-teal h-100">
                    <div class="fw-bold text-muted" style="font-size: 12px;">อยู่ระหว่างศาลพิจารณา</div>
                    <div class="fw-bold" style="color: var(--primary-dark); font-size: 26px; margin-top: 4px;">${pendingCount}</div>
                    <div style="color: var(--text-muted); font-size: 10.5px; margin-top: 4px;">ชั้นต้น และชั้นศาลปกครองสูงสุด</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="kpi-card kpi-orange h-100">
                    <div class="fw-bold text-muted" style="font-size: 12px;">ชนะคดี (สถิติรวม)</div>
                    <div class="fw-bold" style="color: var(--primary-dark); font-size: 26px; margin-top: 4px;">${winCount}</div>
                    <div style="color: var(--text-muted); font-size: 10.5px; margin-top: 4px;">สถิติการชนะคดี ป.ป.ท.</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="kpi-card kpi-navy h-100">
                    <div class="fw-bold text-muted" style="font-size: 12px;">แพ้คดี (สถิติรวม)</div>
                    <div class="fw-bold" style="color: var(--primary-dark); font-size: 26px; margin-top: 4px;">${lossCount}</div>
                    <div style="color: var(--text-muted); font-size: 10.5px; margin-top: 4px;">ใช้ยื่นอุทธรณ์ต่อศาลสูง</div>
                </div>
            </div>
        `;
