        document.getElementById('filter-102-search').value = '';
        document.getElementById('filter-102-status').value = '';
        document.getElementById('filter-102-result').value = '';
        document.getElementById('filter-102-fulltext').value = '';
        renderDisclosureTable();
    }

    function applyFilters103() { renderAdminCasesTable(); }
    function clearFilters103() {
        document.getElementById('filter-103-search').value = '';
        document.getElementById('filter-103-court').value = '';
        document.getElementById('filter-103-type').value = '';
        document.getElementById('filter-103-result').value = '';
        renderAdminCasesTable();
    }
</script>

<!-- Bootstrap 5 JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const toggleBtn = document.querySelector('.sidebar-toggle-btn');
        const layoutContainer = document.querySelector('.layout-container');
        const sidebarOffcanvas = document.getElementById('sidebarOffcanvas');
        
        // Initialize Bootstrap Tooltips
        const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
        const tooltipList = [...tooltipTriggerList].map(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl));
        
        function updateToggleIcon() {
            const icon = toggleBtn.querySelector('i');
            if (!icon) return;
            
            if (window.innerWidth >= 1200) {
                // Desktop: list if collapsed, close X if expanded
                if (layoutContainer.classList.contains('sidebar-collapsed')) {
                    icon.className = 'bi bi-list';
                } else {
                    icon.className = 'bi bi-x-lg';
                }
            } else {
                // Mobile/Tablet: list if offcanvas closed, close X if open
                if (sidebarOffcanvas && sidebarOffcanvas.classList.contains('show')) {
                    icon.className = 'bi bi-x-lg';
                } else {
                    icon.className = 'bi bi-list';
                }
            }
        }
        
        if (toggleBtn && layoutContainer) {
            toggleBtn.addEventListener('click', function (e) {
                // Toggle sidebar-collapsed class on desktop only (>= 1200px)
                if (window.innerWidth >= 1200) {
                    e.preventDefault();
                    e.stopPropagation();
                    
                    layoutContainer.classList.toggle('sidebar-collapsed');
                    const isCollapsed = layoutContainer.classList.contains('sidebar-collapsed');
                    localStorage.setItem('sidebarCollapsed', isCollapsed);
                    
                    updateToggleIcon();
                    
                    // Manage tooltip state dynamically
                    tooltipList.forEach(tooltip => {
                        if (isCollapsed) {
                            tooltip.enable();
                        } else {
                            tooltip.disable();
                            tooltip.hide();
                        }
                    });
                }
            });
            
            // Listen to Bootstrap offcanvas events to toggle icon on mobile
            if (sidebarOffcanvas) {
                sidebarOffcanvas.addEventListener('shown.bs.offcanvas', updateToggleIcon);
                sidebarOffcanvas.addEventListener('hidden.bs.offcanvas', updateToggleIcon);
            }
            
            // Update icon on window resize
            window.addEventListener('resize', updateToggleIcon);
            
            // Initialize state on page load
            const savedState = localStorage.getItem('sidebarCollapsed');
            if (savedState === 'true' && window.innerWidth >= 1200) {
                layoutContainer.classList.add('sidebar-collapsed');
                tooltipList.forEach(tooltip => tooltip.enable());
            } else {
                tooltipList.forEach(tooltip => tooltip.disable());
            }
            
            // Ensure correct initial icon
            updateToggleIcon();
        }
    });
</script>

</body>
</html>