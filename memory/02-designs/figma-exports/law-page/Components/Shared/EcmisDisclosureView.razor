                                <option value="คำร้องขอข้อมูล">คำร้องขอข้อมูลข่าวสาร (สขร.)</option>
                                <option value="คำอุทธรณ์">คำอุทธรณ์คำสั่งไม่เปิดเผย</option>
                            </select>
                        </div>
