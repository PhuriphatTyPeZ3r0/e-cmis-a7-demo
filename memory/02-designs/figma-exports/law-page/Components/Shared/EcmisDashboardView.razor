<!-- VIEW: DASHBOARD & REPORTING -->
<div id="view-dashboard" class="app-view">
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-6">
            <div class="sc-header-card sc-navy">
                <div class="card-banner">สำนวนคดีอัยการ/ศาล</div>
                <div class="card-num" id="db-stat-101">248</div>
                <div class="card-sub">ปีงบประมาณ 2569</div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="sc-header-card sc-orange">
                <div class="card-banner">คำร้องเปิดเผยข้อมูล</div>
                <div class="card-num" id="db-stat-102">86</div>
                <div class="card-sub">สำเร็จลุล่วง 91.2%</div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="sc-header-card sc-navy">
                <div class="card-banner">คดีปกครองที่ฟ้องศาล</div>
                <div class="card-num" id="db-stat-103">37</div>
                <div class="card-sub">อยู่ระหว่างดำเนินการ 34 เรื่อง</div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="sc-header-card sc-teal">
                <div class="card-banner">อัตราการชนะคดีปกครอง</div>
                <div class="card-num" id="db-win-rate">75.0%</div>
                <div class="card-sub">ชั้นต้นและสูงสุด</div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="db-chart-card">
                <h6 class="fw-bold text-primary mb-3" style="font-size: 13px;">สถิติจำแนกตามประเภทสำนวน (10.1)</h6>
                <div style="position: relative; height: 210px; width: 100%;">
                    <canvas id="chart-cases-type"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="db-chart-card">
                <h6 class="fw-bold text-primary mb-3" style="font-size: 13px;">สถิติจำแนกการยื่นคำร้อง/อุทธรณ์ในแต่ละเดือน (10.2)</h6>
                <div style="position: relative; height: 210px; width: 100%;">
                    <canvas id="chart-requests-monthly"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="db-chart-card">
                <h6 class="fw-bold text-primary mb-3" style="font-size: 13px;">อัตราการชนะ/แพ้คดีปกครองของสำนักงาน (10.3)</h6>
                <div style="position: relative; height: 210px; width: 100%;">
                    <canvas id="chart-admin-results"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- TOR 10.3.5 — สถิติคดีปกครอง: ระยะเวลาแต่ละขั้นตอน + ผลคดีแยกตามชั้นศาล -->
    <div class="table-container p-4 mb-4">
        <h6 class="fw-bold text-primary mb-3"><i class="bi bi-stopwatch"></i> สถิติคดีปกครอง: ระยะเวลาดำเนินการแต่ละขั้นตอน &amp; ผลคดีแยกตามชั้นศาล (TOR 10.3.5)</h6>

        <div class="text-muted mb-2" style="font-size:12px;">ระยะเวลาเฉลี่ยในการดำเนินการแต่ละขั้นตอน (วัน)</div>
        <div class="row g-3 mb-4" id="admin-stage-stats">
            <div class="col-md-3">
                <div class="kpi-card p-3 text-center" style="border:1px solid #E3E9F4;">
                    <div class="text-muted" style="font-size:11px;">รับเรื่อง → มอบหมาย</div>
                    <h3 class="fw-bold mt-1 text-primary" id="stage-t1">—</h3>
                    <div class="text-muted" style="font-size:10px;">วัน (เฉลี่ย)</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="kpi-card p-3 text-center" style="border:1px solid #E3E9F4;">
                    <div class="text-muted" style="font-size:11px;">มอบหมาย → ดำเนินงาน</div>
                    <h3 class="fw-bold mt-1 text-primary" id="stage-t2">—</h3>
                    <div class="text-muted" style="font-size:10px;">วัน (เฉลี่ย)</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="kpi-card p-3 text-center" style="border:1px solid #E3E9F4;">
                    <div class="text-muted" style="font-size:11px;">ดำเนินงาน → ผลคดี</div>
                    <h3 class="fw-bold mt-1 text-primary" id="stage-t3">—</h3>
                    <div class="text-muted" style="font-size:10px;">วัน (เฉลี่ย)</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="kpi-card p-3 text-center" style="border:1px solid #E3E9F4; background: rgba(26,47,107,0.03);">
                    <div class="text-muted" style="font-size:11px;">รวมทั้งกระบวนการ</div>
                    <h3 class="fw-bold mt-1 text-primary" id="stage-total">—</h3>
                    <div class="text-muted" style="font-size:10px;">วัน (เฉลี่ย)</div>
                </div>
            </div>
        </div>

        <div class="text-muted mb-2" style="font-size:12px;">สถิติผลชนะ/แพ้คดี แยกตามชั้นศาล และคดีถึงที่สุด</div>
        <div class="table-responsive">
            <table class="table table-bordered align-middle text-center mb-0" style="font-size:12.5px;">
                <thead class="table-light">
                    <tr>
                        <th class="text-start">ชั้นศาล</th>
                        <th>ทั้งหมด</th>
                        <th class="text-success">ชนะคดี</th>
                        <th class="text-danger">แพ้คดี</th>
                        <th>จำหน่ายคดี</th>
                        <th>อยู่ระหว่างพิจารณา</th>
                        <th>คดีถึงที่สุด</th>
                    </tr>
                </thead>
                <tbody id="admin-court-level-stats">
                    <!-- rows rendered by renderAdminStageStats() -->
                </tbody>
            </table>
        </div>
        <p class="text-muted mt-2 mb-0" style="font-size:10.5px;"><i class="bi bi-info-circle"></i> ระยะเวลาแต่ละขั้นตอนคำนวณจากบันทึกเวลา (timestamp) ของสถานะงานในสารบบคดีปกครอง</p>
    </div>

    <div class="table-container p-4">
        <h6 class="fw-bold text-primary mb-3"><i class="bi bi-file-earmark-bar-graph"></i> ประมวลผลและสืบค้นข้อมูลสรุปผลรายงานเชิงวิเคราะห์ (TOR 10.1.13)</h6>
        <div class="row g-3 mb-3">
            <div class="col-md-4">
                <label class="form-label text-muted" style="font-size:12px;">เลือกรูปแบบรายงาน</label>
                <select class="form-select" id="report-format-select">
                    <option value="quantitative">รายงานเชิงปริมาณ (สถิติตัวเลขสำนวนและการดำเนินคดีแยกตามศาล/กอง)</option>
                    <option value="qualitative">รายงานเชิงคุณภาพ (แบบสรุปคำวินิจฉัยชี้ขาดของ อสส. และคำพิพากษาศาล 3 ชั้น)</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label text-muted" style="font-size:12px;">ช่วงปีงบประมาณ</label>
                <select class="form-select" id="report-year-select">
                    <option>ปีงบประมาณ 2569</option>
                    <option>ปีงบประมาณ 2568</option>
                    <option>ปีงบประมาณ 2567</option>
                </select>
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <div class="d-flex gap-2 w-100">
                    <button class="btn btn-grad-navy w-50" onclick="generateReportPreview()"><i class="bi bi-eye"></i> แสดงพรีวิว</button>
                    <button class="btn btn-outline-navy w-50 text-value" onclick="triggerReportExportWord()"><i class="bi bi-download"></i> ดาวน์โหลด Word</button>
                </div>
            </div>
        </div>

        <!-- Report Preview Container -->
        <div class="border rounded p-4 bg-light" id="report-preview-container" style="display:none; font-family: 'Sarabun', sans-serif;">
            <!-- Report preview content dynamically injected here -->
        </div>
    </div>
</div>
