<button class="btn @GetButtonClass() @Class" style="@Style" type="@Type" disabled="@Disabled" @onclick="OnClick">
    @if (!string.IsNullOrEmpty(Icon))
    {
        <i class="bi @Icon me-2"></i>
    }
    @ChildContent
    @if (ChildContent == null)
    {
        @Text
    }
</button>

@code {
    [Parameter] public string Text { get; set; } = "";
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public string Style { get; set; } = "";
    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool IsOutline { get; set; }
    [Parameter] public string Variant { get; set; } = "navy"; // navy, gold, danger, warning, success, secondary, light
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }

    private string GetButtonClass()
    {
        if (Variant == "navy" || Variant == "gold")
        {
            if (Variant == "gold" && IsOutline)
            {
                // Fallback since there is no btn-outline-gold in style.css, use outline-warning or outline-secondary
                return "btn-outline-warning";
            }
            return IsOutline ? $"btn-outline-{Variant}" : $"btn-grad-{Variant}";
        }
        // Fallback to bootstrap classes
        return IsOutline ? $"btn-outline-{Variant}" : $"btn-{Variant}";
    }
}
